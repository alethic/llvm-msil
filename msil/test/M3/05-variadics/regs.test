# A SysV va_list in the state a native va_start leaves it (arguments in the register save area and in the overflow area) is read correctly by compiled va_arg, as is the va_list of an expanded call.
# The program of the variadics recon (recon/p3/variadics-files/regs.c,
# plan 5.15.2 'Boundaries': a native va_list with a live reg_save_area is
# read correctly). The MSIL ABI's own va_lists always say 'registers used
# up' (gp_offset 48, fp_offset 176) and keep every argument in the overflow
# area, but a va_list that native code builds (the one glibc hands to a C
# callback taking a va_list, or one passed to an exported function) has its
# first variadic integers and doubles in the register save area. clang's
# inline lowering of va_arg reads both, and the program builds such a
# va_list by hand: gp_offset 8 (one named integer register used), fp_offset
# 48, five integers and three doubles in the save area and the sixth integer
# in the overflow area, then walks it; and it walks the va_list of an
# expanded call of its own variadic function with the same argument kinds.
# The va_list fields are glibc's x86-64 layout, so the test runs only on the
# Linux triple. Plan 5.15.2, 5.17.13 (M26, M3/05-variadics).
# REQUIRES: msil-triple-linux
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/regs.c
# RUN: %{msil_prog}
#--- regs.c
#include <stdarg.h>
#include <stdio.h>
static long long walk(const char *k, va_list ap) {
  long long acc = 0;
  for (; *k; k++)
    acc = acc * 10 + (*k == 'd' ? (long long)va_arg(ap, double) : va_arg(ap, int));
  return acc;
}
static long long walk_v(const char *k, ...) {
  va_list ap;
  va_start(ap, k);
  long long r = walk(k, ap);
  va_end(ap);
  return r;
}
int main(void) {
  /* 1 fixed GPR used (k), so gp_offset = 8; ints 1..5 in the rsi..r9 slots,
     doubles 6 and 7 in the xmm0 and xmm1 slots. */
  unsigned long long rsa[22];
  for (int i = 0; i < 22; i++)
    rsa[i] = 0xdeadbeefdeadbeefull;
  for (int i = 0; i < 5; i++)
    rsa[1 + i] = (unsigned long long)(i + 1);
  double d6 = 6.0, d7 = 7.0;
  __builtin_memcpy(&rsa[6], &d6, 8);
  __builtin_memcpy(&rsa[8], &d7, 8);
  /* The 6th int (8) no longer fits in a GPR: overflow area. The third
     double (9.0) was in xmm2: save area offset 80. */
  unsigned long long ovf[2] = {8, 0};
  double d9 = 9.0;
  __builtin_memcpy(&rsa[10], &d9, 8);
  va_list ap;
  ap[0].gp_offset = 8;
  ap[0].fp_offset = 48;
  ap[0].overflow_arg_area = ovf;
  ap[0].reg_save_area = rsa;
  printf("regs %lld\n", walk("iiiiiddid", ap));
  printf("expanded %lld\n", walk_v("iiiiiddid", 1, 2, 3, 4, 5, 6.0, 7.0, 8, 9.0));
  return 0;
}
