# A variadic explicit import (import_module/import_name) is called with fixed arity per call site, with each double variadic argument passed as its 64-bit pattern (Win64): msvcrt.dll's sprintf.
# Plan 5.15.2: a variadic declaration with an import module counts as
# listed (msil-ld never renames an explicit import's entry), so each call is
# a fixed-arity call with its own IL signature, and on Windows triples every
# double variadic argument becomes 'bitcast double to i64', because the
# Win64 convention passes a variadic double in both the integer and the
# floating-point register, and a P/Invoke whose parameter is int64 puts it
# where the callee's va_arg reads it (variadics recon 2.2). msvcrt.dll's
# sprintf is a real native variadic export; the native build calls the
# UCRT's sprintf instead, which prints the same text for these values (all
# exact in binary, so the rounding modes of the two C libraries agree). Two
# call sites with different argument lists give two signatures. msvcrt.dll
# exists on Windows only, so the test runs only on the Windows triple. The
# recon's winfp.c (recon/p3/variadics-files/winfp.c), extended. Plan 5.15.2,
# 5.17.13 (M26, M3/05-variadics).
# REQUIRES: msil-triple-windows
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/winfp.c
# RUN: %{msil_prog}
#--- winfp.c
#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#ifdef __MSIL__
/* msvcrt.dll's sprintf is a real native variadic export; called with fixed
   arity, with doubles as their i64 bits. */
int msvcrt_sprintf(char *, const char *, ...)
    __attribute__((import_module("msvcrt.dll"), import_name("sprintf")));
#else
#define msvcrt_sprintf sprintf
#endif
int main(void) {
  char b[128];
  int n = msvcrt_sprintf(b, "%f|%f|%d|%f|%f", 2.5, -1.25, 7, 0.125, 1e10);
  puts(b);
  int m = msvcrt_sprintf(b, "%s=%d %s=%.3f %x %c", "seven", 7, "half", 0.5, 0xbeef, '!');
  puts(b);
  printf("lengths %d %d\n", n, m);
  return 0;
}
