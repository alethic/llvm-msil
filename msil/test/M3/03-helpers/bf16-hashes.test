# __bf16 conversions and __bf16 arguments and results match native code on every bf16 value, on a fixed sample of floats, on every rounding boundary and on named cases.
# Recon fp-helpers' f16/f16conv.c part D and the bf16 columns of part S
# (fp-helpers 3.2, plan 5.14.3 A4, M25.h), with __bf16 passed and returned by
# value (an M25 capability, plan 5.17.13):
#   D  every bf16 -> float (65,536); float -> bf16 on a fixed sample of 2^20
#      floats (bits 31..12 count through every value, bits 11..0 are
#      pseudo-random), NaN inputs hashed separately; float -> bf16 on every
#      midpoint between two bf16 values and one float ulp below and above
#      it; double -> bf16 on 2^16 pseudo-random doubles and on a bf16
#      midpoint +-1 double ulp next to each;
#   S  named floats and doubles (NaN payloads, subnormals, overflow, ties),
#      printed in full, and one conversion through a pointer.
# Each part prints a hash of the result bits and the number of results.
# Every conversion sits in a noinline function of its own translation unit
# (conv.c) and gets run-time inputs, so no conversion is folded at compile
# time. MSIL converts float -> bf16 with the helper archive's __truncsfbf2,
# double -> bf16 with __truncdfbf2 and bf16 -> float inline (M24); native
# x86-64 code converts float -> bf16 and bf16 -> float inline (rounding to
# nearest even and quieting every NaN: float 7fa00000, a signaling NaN whose
# low 16 bits are zero, gives 7fe0) and calls compiler-rt's __truncdfbf2 for
# double -> bf16. The transcript is native code's (5.17.3: the Windows DLL C
# runtime with Visual Studio's compiler-rt, E7h with the native compiler-rt
# archive). The program calls helper-archive members, so it has no -S
# reference (5.17.13).
# msil-ld's --lto-emit-asm text refuses a helper call (A9), so the test
# does not run with msil_link_output=il.
# UNSUPPORTED: msil-link-output=il
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/main.c %t/conv.c
# RUN: %{msil_prog}
#--- conv.h
float b2f(__bf16 b);
__bf16 f2b(float f);
__bf16 d2b(double d);
void f2b_ptr(__bf16 *p, float f);
#--- conv.c
#include "conv.h"
__attribute__((noinline)) float b2f(__bf16 b) { return (float)b; }
__attribute__((noinline)) __bf16 f2b(float f) { return (__bf16)f; }
__attribute__((noinline)) __bf16 d2b(double d) { return (__bf16)d; }
__attribute__((noinline)) void f2b_ptr(__bf16 *p, float f) { *p = (__bf16)f; }
#--- main.c
#include <stdint.h>
#include "conv.h"
int puts(const char *);

static char line[200];
static int len;
static void out_s(const char *t) {
  while (*t)
    line[len++] = *t++;
}
static void out_x(uint64_t v, int digits) {
  line[len++] = ' ';
  for (int i = digits - 1; i >= 0; --i)
    line[len++] = "0123456789abcdef"[(v >> (4 * i)) & 15];
}
static void out_nl(void) {
  line[len] = 0;
  puts(line);
  len = 0;
}

typedef struct {
  uint64_t h, n;
} hash_t;
static hash_t hinit(void) {
  hash_t x = {0xcbf29ce484222325ull, 0};
  return x;
}
static void hadd(hash_t *x, uint64_t v) {
  x->h = (x->h ^ v) * 0x100000001b3ull;
  x->h ^= x->h >> 29;
  x->n++;
}
static void hprint(const char *name, hash_t x) {
  out_s(name);
  out_x(x.h, 16);
  out_x(x.n, 12);
  out_nl();
}

static uint32_t f2u(float f) { uint32_t u; __builtin_memcpy(&u, &f, 4); return u; }
static float u2f(uint32_t u) { float f; __builtin_memcpy(&f, &u, 4); return f; }
static uint64_t d2u(double d) { uint64_t u; __builtin_memcpy(&u, &d, 8); return u; }
static double u2d(uint64_t u) { double d; __builtin_memcpy(&d, &u, 8); return d; }
static uint16_t b2u(__bf16 b) { uint16_t u; __builtin_memcpy(&u, &b, 2); return u; }
static __bf16 u2b(uint16_t u) { __bf16 b; __builtin_memcpy(&b, &u, 2); return b; }

static uint64_t rng = 0x9E3779B97F4A7C15ull;
static uint64_t next(void) {
  rng ^= rng << 13;
  rng ^= rng >> 7;
  rng ^= rng << 17;
  return rng;
}
static int is_nan32(uint32_t u) { return (u & 0x7f800000u) == 0x7f800000u && (u & 0x7fffffu); }

static void partD(void) {
  hash_t he = hinit(), hs = hinit(), hn = hinit(), hm = hinit(), hd = hinit();
  for (uint32_t u = 0; u < 65536; ++u)
    hadd(&he, f2u(b2f(u2b((uint16_t)u))));
  for (uint32_t i = 0; i < (1u << 20); ++i) {
    uint32_t u = (i << 12) | (uint32_t)(next() >> 52);
    hadd(is_nan32(u) ? &hn : &hs, b2u(f2b(u2f(u))));
  }
  for (uint32_t u = 0; u < 65536; ++u) {
    uint32_t m = (u << 16) | 0x8000u; // the midpoint above bf16 u, a float
    hadd(&hm, b2u(f2b(u2f(m - 1))));
    hadd(&hm, b2u(f2b(u2f(m))));
    hadd(&hm, b2u(f2b(u2f(m + 1))));
  }
  for (uint32_t i = 0; i < (1u << 16); ++i) {
    uint64_t r = next();
    hadd(&hd, b2u(d2b(u2d(r))));
    double mid = (double)u2f(((uint32_t)(r >> 32) & 0xffff0000u) | 0x8000u);
    hadd(&hd, b2u(d2b(u2d(d2u(mid) + 1))));
    hadd(&hd, b2u(d2b(u2d(d2u(mid) - 1))));
  }
  hprint("D bf16->f32", he);
  hprint("D f32->bf16 sample", hs);
  hprint("D f32->bf16 sample NaN", hn);
  hprint("D f32->bf16 midpoints", hm);
  hprint("D f64->bf16", hd);
}

// Named inputs, read through volatile objects.
static volatile const uint16_t bs[] = {0x0001, 0x007f, 0x0080, 0x3f80, 0x7f7f, 0x7f80,
                                       0x7f81, 0x7fc0, 0xff81, 0x8000};
static volatile const uint32_t fs[] = {0x7f800001u, 0x7fa00000u, 0x7fc00000u, 0x7fc00001u,
                                       0x7fffe000u, 0xff812345u, 0x477ff000u, 0x477fefffu,
                                       0x477ff001u, 0x33000000u, 0x33000001u, 0x32ffffffu,
                                       0x38800000u, 0x387fe000u, 0x3f801000u, 0x3f803000u,
                                       0x3f808000u, 0x3f818000u, 0x3f808001u, 0x7f7fffffu,
                                       0x00008000u, 0x80018000u};
static volatile const uint64_t ds[] = {0x7ff0000000000001ull, 0x7ff8000000000001ull,
                                       0x7ff4000000000000ull, 0x3f30040000000001ull,
                                       0x40effe0000000000ull, 0x3e70000000000000ull,
                                       0x3e70000000000001ull, 0x3ff0100000000000ull,
                                       0x3ff0100000000001ull, 0x47efffffe0000000ull};

static void partS(void) {
  for (unsigned i = 0; i < sizeof bs / sizeof bs[0]; ++i) {
    out_s("S bf");
    out_x(bs[i], 4);
    out_s(" ->f32");
    out_x(f2u(b2f(u2b(bs[i]))), 8);
    out_nl();
  }
  for (unsigned i = 0; i < sizeof fs / sizeof fs[0]; ++i) {
    out_s("S f");
    out_x(fs[i], 8);
    out_s(" ->bf");
    out_x(b2u(f2b(u2f(fs[i]))), 4);
    out_nl();
  }
  for (unsigned i = 0; i < sizeof ds / sizeof ds[0]; ++i) {
    out_s("S d");
    out_x(ds[i], 16);
    out_s(" ->bf");
    out_x(b2u(d2b(u2d(ds[i]))), 4);
    out_nl();
  }
  __bf16 b;
  f2b_ptr(&b, u2f(fs[17]));
  out_s("S f");
  out_x(fs[17], 8);
  out_s(" ->bf through a pointer");
  out_x(b2u(b), 4);
  out_nl();
}

int main(void) {
  partD();
  partS();
  return 0;
}
