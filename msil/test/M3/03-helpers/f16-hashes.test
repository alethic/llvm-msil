# _Float16 conversions through the helper archive (__extendhfsf2, __truncsfhf2, __truncdfhf2) match native compiler-rt exhaustively on every half, on every rounding boundary of double -> _Float16, and on named NaN, subnormal, overflow and rounding cases.
# Recon fp-helpers' f16/f16conv.c (fp-helpers 3.2, plan 5.14.3 A4, M25.h),
# with the parts of 3.2 that fit a test's time:
#   A  every half -> float and -> double (65,536 each);
#   B  float -> _Float16 on a fixed sample of 2^20 floats (bits 31..12 count
#      through every value, bits 11..0 are pseudo-random) and on every float
#      midpoint between two finite halves, one float ulp below and above it,
#      both signs; NaN inputs hash separately;
#   C  double -> _Float16 on the rounding boundaries of every finite half:
#      the midpoint and +-1, +-2 double ulps, both signs (317,440
#      conversions), and the double-rounding traps (a double next to a
#      midpoint that is a float, also converted through float);
#   S  named halves, floats and doubles, printed in full.
# Each part prints a hash of the result bits and the number of results.
# Every conversion sits in a noinline function of its own translation unit
# (conv.c) and gets run-time inputs, so it is a real helper call at every
# level and through LTO, and no conversion is folded at compile time (the
# compiler would quiet a signaling NaN that compiler-rt keeps, fp-helpers
# 3.2). The program calls helper-archive members, so it has no -S reference
# (5.17.13); the transcript is native compiler-rt's (5.17.3).
# msil-ld's --lto-emit-asm text refuses a helper call (A9), so the test
# does not run with msil_link_output=il.
# UNSUPPORTED: msil-link-output=il
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/main.c %t/conv.c
# RUN: %{msil_prog}
#--- conv.h
float h2f(_Float16 h);
double h2d(_Float16 h);
_Float16 f2h(float f);
_Float16 d2h(double d);
#--- conv.c
#include "conv.h"
__attribute__((noinline)) float h2f(_Float16 h) { return (float)h; }
__attribute__((noinline)) double h2d(_Float16 h) { return (double)h; }
__attribute__((noinline)) _Float16 f2h(float f) { return (_Float16)f; }
__attribute__((noinline)) _Float16 d2h(double d) { return (_Float16)d; }
#--- main.c
#include <stdint.h>
#include "conv.h"
int puts(const char *);

static char line[200];
static int len;
static void out_s(const char *t) {
  while (*t)
    line[len++] = *t++;
}
static void out_x(uint64_t v, int digits) {
  line[len++] = ' ';
  for (int i = digits - 1; i >= 0; --i)
    line[len++] = "0123456789abcdef"[(v >> (4 * i)) & 15];
}
static void out_nl(void) {
  line[len] = 0;
  puts(line);
  len = 0;
}

typedef struct {
  uint64_t h, n;
} hash_t;
static hash_t hinit(void) {
  hash_t x = {0xcbf29ce484222325ull, 0};
  return x;
}
static void hadd(hash_t *x, uint64_t v) {
  x->h = (x->h ^ v) * 0x100000001b3ull;
  x->h ^= x->h >> 29;
  x->n++;
}
static void hprint(const char *name, hash_t x) {
  out_s(name);
  out_x(x.h, 16);
  out_x(x.n, 12);
  out_nl();
}

static uint32_t f2u(float f) { uint32_t u; __builtin_memcpy(&u, &f, 4); return u; }
static float u2f(uint32_t u) { float f; __builtin_memcpy(&f, &u, 4); return f; }
static uint64_t d2u(double d) { uint64_t u; __builtin_memcpy(&u, &d, 8); return u; }
static double u2d(uint64_t u) { double d; __builtin_memcpy(&d, &u, 8); return d; }
static uint16_t h2u(_Float16 h) { uint16_t u; __builtin_memcpy(&u, &h, 2); return u; }
static _Float16 u2h(uint16_t u) { _Float16 h; __builtin_memcpy(&h, &u, 2); return h; }

static uint64_t rng = 0x9E3779B97F4A7C15ull;
static uint64_t next(void) {
  rng ^= rng << 13;
  rng ^= rng >> 7;
  rng ^= rng << 17;
  return rng;
}
static int is_nan32(uint32_t u) { return (u & 0x7f800000u) == 0x7f800000u && (u & 0x7fffffu); }

static void partA(void) {
  hash_t hf = hinit(), hd = hinit();
  for (uint32_t u = 0; u < 65536; ++u) {
    _Float16 h = u2h((uint16_t)u);
    hadd(&hf, f2u(h2f(h)));
    hadd(&hd, d2u(h2d(h)));
  }
  hprint("A h->f32", hf);
  hprint("A h->f64", hd);
}

static void partB(void) {
  hash_t hs = hinit(), hn = hinit(), hm = hinit();
  for (uint32_t i = 0; i < (1u << 20); ++i) {
    uint32_t u = (i << 12) | (uint32_t)(next() >> 52);
    uint16_t r = h2u(f2h(u2f(u)));
    hadd(is_nan32(u) ? &hn : &hs, r);
  }
  for (uint32_t u = 0; u < 0x7c00; ++u) { // finite non-negative halves
    float lo = h2f(u2h((uint16_t)u)), hi = h2f(u2h((uint16_t)(u + 1)));
    uint32_t m = f2u((lo + hi) / 2); // exact in float
    for (int k = -1; k <= 1; ++k) {
      hadd(&hm, h2u(f2h(u2f(m + (uint32_t)k))));
      hadd(&hm, h2u(f2h(u2f((m + (uint32_t)k) | 0x80000000u))));
    }
  }
  hprint("B f32->h sample", hs);
  hprint("B f32->h sample NaN", hn);
  hprint("B f32->h midpoints", hm);
}

static void partC(void) {
  hash_t hb = hinit(), ht = hinit();
  for (uint32_t u = 0; u < 0x7c00; ++u) { // finite non-negative halves
    double lo = h2d(u2h((uint16_t)u)), hi = h2d(u2h((uint16_t)(u + 1)));
    double mid = (lo + hi) / 2; // exact in double
    uint64_t m = d2u(mid);
    for (int k = -2; k <= 2; ++k) {
      double d = u2d(m + (uint64_t)(int64_t)k);
      hadd(&hb, h2u(d2h(d)));
      hadd(&hb, h2u(d2h(-d)));
    }
    // Just above and below a midpoint that is a float: rounding the double
    // to float first would land on the midpoint and round to even.
    float mf = (float)mid;
    if ((double)mf == mid) {
      double up = u2d(m + 1), dn = u2d(m - 1);
      hadd(&ht, h2u(d2h(up)) | ((uint32_t)h2u(f2h((float)up)) << 16));
      hadd(&ht, h2u(d2h(dn)) | ((uint32_t)h2u(f2h((float)dn)) << 16));
    }
  }
  hprint("C f64->h bounds", hb);
  hprint("C f64->h dbl-round", ht);
}

// Named inputs, read through volatile objects.
static volatile const uint16_t hs[] = {0x0001, 0x03ff, 0x0400, 0x3c00, 0x7bff, 0x7c00, 0x7c01,
                                       0x7d00, 0x7e00, 0x7fff, 0xfc01, 0xfe00, 0x8000};
static volatile const uint32_t fs[] = {0x7f800001u, 0x7fa00000u, 0x7fc00000u, 0x7fc00001u,
                                       0x7fffe000u, 0xff812345u, 0x477ff000u, 0x477fefffu,
                                       0x477ff001u, 0x33000000u, 0x33000001u, 0x32ffffffu,
                                       0x38800000u, 0x387fe000u, 0x3f801000u, 0x3f803000u};
static volatile const uint64_t ds[] = {0x7ff0000000000001ull, 0x7ff8000000000001ull,
                                       0x7ff4000000000000ull, 0x3f30040000000001ull,
                                       0x40effe0000000000ull, 0x3e70000000000000ull,
                                       0x3e70000000000001ull};

static void partS(void) {
  for (unsigned i = 0; i < sizeof hs / sizeof hs[0]; ++i) {
    _Float16 h = u2h(hs[i]);
    out_s("S h");
    out_x(hs[i], 4);
    out_s(" ->f32");
    out_x(f2u(h2f(h)), 8);
    out_s(" ->f64");
    out_x(d2u(h2d(h)), 16);
    out_nl();
  }
  for (unsigned i = 0; i < sizeof fs / sizeof fs[0]; ++i) {
    out_s("S f");
    out_x(fs[i], 8);
    out_s(" ->h");
    out_x(h2u(f2h(u2f(fs[i]))), 4);
    out_nl();
  }
  for (unsigned i = 0; i < sizeof ds / sizeof ds[0]; ++i) {
    out_s("S d");
    out_x(ds[i], 16);
    out_s(" ->h");
    out_x(h2u(d2h(u2d(ds[i]))), 4);
    out_nl();
  }
}

int main(void) {
  partA();
  partB();
  partC();
  partS();
  return 0;
}
