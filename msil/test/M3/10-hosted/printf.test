# printf through the real <stdio.h>: integer, character, string and floating-point conversions with flags, widths, precisions and length modifiers, '*' arguments, many arguments and printf's result.
# From M26 the printf family runs (plan 5.17.13, M3/10-hosted): on Linux
# triples printf is glibc's, a native variadic call that msil-ld binds to
# its va_list variant vprintf, to which the expanded call passes a SysV
# va_list over a buffer in the caller's frame; on windows-msvc triples it is
# the UCRT's inline definition, compiled into the program as a variadic
# definition, which calls __stdio_common_vfprintf with a char* va_list. The
# conversions print the same text in glibc and the UCRT: no %a, %p, %n,
# NaN or 'long' (32 bits on Windows triples), and the floating-point
# conversions print values whose correctly rounded text both libraries
# agree on (no exactly representable half is rounded away: the UCRT rounds
# those to even only with its standard-rounding option, which
# 05-variadics/ucrt-rounding.test checks). Each line is followed by printf's
# result, the number of characters it wrote. Plan 5.15.2, 5.17.13 (M26,
# M3/10-hosted).
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/main.c
# RUN: %{msil_prog}
#--- main.c
#include <inttypes.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>

static void result(int n) { printf("  -> %d\n", n); }

int main(void) {
  result(printf("plain text, no conversion\n"));
  result(printf("%d %i %u %x %X %o %c %s %%\n", -42, 17, 3000000000u, 0xbeefu, 0xcafeu, 8u, 'Z', "str"));
  result(printf("[%5d] [%-5d] [%05d] [%+d] [% d] [%+.3d] [%.0d]\n", 42, 42, 42, 42, 42, 7, 0));
  result(printf("[%#x] [%#o] [%#X] [%8.3x] [%-#10x]\n", 255u, 8u, 255u, 10u, 4096u));
  result(printf("[%10s] [%-10s] [%.3s] [%-6.2s] [%c%c%c]\n", "right", "left", "truncate", "ab", 'x', 'y', 'z'));
  result(printf("[%*d] [%-*d] [%.*f] [%*.*s]\n", 6, 12, 6, 12, 2, 3.14159, 8, 3, "abcdef"));
  result(printf("%hhd %hhu %hd %hu %lld %llu %llx\n", (signed char)-100, (unsigned char)200, (short)-30000,
                (unsigned short)60000, -9000000000000000000LL, 18000000000000000000ull, 0x123456789abcdefull));
  result(printf("%zu %td %jd %ju\n", sizeof(int[10]), (ptrdiff_t)-7, (intmax_t)-123456789012LL,
                (uintmax_t)987654321098ull));
  result(printf("%" PRId64 " %" PRIu32 " %" PRIx16 "\n", (int64_t)-5, (uint32_t)4000000000u, (uint16_t)0xabcd));
  result(printf("%f %.2f %10.4f %-10.1f| %+.3f %08.2f\n", 1.5, 3.14159, -2.71828, 9.99, 0.5, -1.25));
  result(printf("%e %.3E %.0e %g %G %g %g %.10g\n", 12345.678, 0.000123, 5e10, 0.0001, 1e-10, 100000.0, 1e6,
                1.0 / 3));
  result(printf("%.20f %.17g %f %f\n", 0.1, 0.1, 1e300 * 1e10, -1e300 * 1e10));
  result(printf("%f %.3f %g\n", (double)1.25f, (double)-0.0f, 1e-320));
  result(printf("%d %f %d %f %d %f %d %f %d %f %d %f %d %f %d %f %d %f %d %f\n", 1, 0.5, 2, 1.5, 3, 2.5, 4, 3.5,
                5, 4.5, 6, 5.5, 7, 6.5, 8, 7.5, 9, 8.5, 10, 9.5));
  result(printf("%s|%s|%s\n", "", "a string of some length that is longer than sixty-four characters, to be sure",
                "end"));
  result(printf("%5.1f%%\n", 99.5));
  return 0;
}
