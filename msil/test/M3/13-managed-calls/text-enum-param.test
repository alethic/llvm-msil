# RUN: %if msil-run-netfx %{ %{ep_netfx} %}
# Every run's transcript: the status line alone.
# CHECK-NOT: {{.}}
# CHECK:     [unhandled exception: System.InvalidProgramException]
# The stub's message, in the runtime's report on stderr.
# STRUCT:    {{^Unhandled [Ee]xception[.:] }}System.InvalidProgramException: managed call 'date_add': parameter 1 passes 64 bits for 'System.TimeSpan', which is not an enum of that width{{$}}
# WIDTH:     {{^Unhandled [Ee]xception[.:] }}System.InvalidProgramException: managed call 'date_specify_kind': parameter 2 passes 64 bits for 'System.DateTimeKind', which is not an enum of that width{{$}}
# CATCH:     {{^Unhandled [Ee]xception[.:] }}System.InvalidProgramException: managed call 'open_file': parameter 2 passes 64 bits for 'System.IO.FileMode', which is not an enum of that width{{$}}
# PRIMITIVE: {{^Unhandled [Ee]xception[.:] }}System.InvalidProgramException: managed call 'abs32': parameter 1 passes 32 bits for 'System.Int32', which is not an enum of that width{{$}}
#--- say.h
/* Only puts and putchar print: clang -S text binds no other C library
   function (plan D14's standalone import table). */
int puts(const char *s);
int putchar(int c);

typedef struct mc_object *mc_handle; /* an opaque handle (plan 5.20.9) */

/* Prints "<what> <v>": reached only without the checks. */
static void say(const char *what, long long v) {
  char digits[24];
  int n = 0;
  unsigned long long u =
      v < 0 ? 0 - (unsigned long long)v : (unsigned long long)v;
  while (*what)
    putchar(*what++);
  putchar(' ');
  if (v < 0)
    putchar('-');
  do {
    digits[n++] = (char)('0' + u % 10);
    u /= 10;
  } while (u);
  while (n)
    putchar(digits[--n]);
  putchar('\n');
}
#--- struct.c
#include "say.h"

__attribute__((msil_method("valuetype System.DateTime", ".ctor",
                           "instance void(int32, int32, int32)")))
mc_handle new_date(int year, int month, int day);

__attribute__((msil_method("valuetype System.DateTime", "get_Ticks",
                           "instance int64()")))
long long date_ticks(mc_handle date);

/* Wrong: System.TimeSpan is a struct, not an enum; the integer stands for
   its ticks. */
__attribute__((msil_method(
    "valuetype System.DateTime", "Add",
    "instance valuetype System.DateTime(valuetype System.TimeSpan)")))
mc_handle date_add(mc_handle date, long long span);

int main(void) {
  mc_handle date = new_date(2024, 5, 6);
  mc_handle later = date_add(date, 10000000);
  say("ticks added", date_ticks(later) - date_ticks(date));
  return 1;
}
#--- width.c
#include "say.h"

__attribute__((msil_method("valuetype System.DateTime", ".ctor",
                           "instance void(int64)")))
mc_handle new_date(long long ticks);

__attribute__((msil_method("valuetype System.DateTime", "get_Kind",
                           "instance valuetype System.DateTimeKind()")))
int date_kind(mc_handle date);

/* Wrong: System.DateTimeKind is an int32 enum, passed as a 64-bit
   integer. */
__attribute__((msil_method("valuetype System.DateTime", "SpecifyKind",
                           "valuetype System.DateTime(valuetype "
                           "System.DateTime, valuetype System.DateTimeKind)")))
mc_handle date_specify_kind(mc_handle date, long long kind);

int main(void) {
  /* DateTimeKind.Utc (1). */
  say("kind", date_kind(date_specify_kind(new_date(0), 1)));
  return 1;
}
#--- catch.c
#include "say.h"

/* Wrong: System.IO.FileMode is an int32 enum, passed as a 64-bit integer;
   the entries list System.InvalidProgramException too, which never maps the
   test's exception. */
__attribute__((msil_method("System.IO.FileStream", ".ctor",
                           "instance void(string, valuetype "
                           "System.IO.FileMode, valuetype System.IO.FileAccess)"),
               msil_catch("System.IO.FileNotFoundException", 2),
               msil_catch("System.InvalidProgramException", 99)))
mc_handle open_file(const char *path, long long mode, int access, int *err);

int main(void) {
  int err = 0;
  /* FileMode.Open (3) and FileAccess.Read (1) of a file that does not
     exist. */
  mc_handle file = open_file("no-such-file.txt", 3, 1, &err);
  say("err", err);
  return file ? 2 : 1;
}
#--- primitive.c
#include "say.h"

/* Wrong: the primitive value type System.Int32 is never an enum (Math::Abs
   takes 'int32'), so this stub always throws. */
__attribute__((msil_method("System.Math", "Abs",
                           "int32(valuetype System.Int32)")))
int abs32(int value);

int main(void) {
  say("abs", abs32(-5));
  return 1;
}
