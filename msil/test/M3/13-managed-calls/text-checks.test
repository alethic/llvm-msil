# Every run's transcript.
# CHECK:      year 2024
# CHECK-NEXT: day of week 1
# CHECK-NEXT: kind 1
# CHECK-NEXT: length 5
# CHECK-NEXT: missing file handle 0
# CHECK-NEXT: missing file err 2
# CHECK-NEXT: 0L compared with 5 -1
# CHECK-NEXT: string length 5
# CHECK-NEXT: FILETIME dwLowDateTime 0
# CHECK-NEXT: FILETIME layout CharSet 2
# CHECK-NEXT: list count 2
# CHECK-NEXT: stream readable 1
# CHECK-NEXT: disposed stream readable 0
# CHECK-NEXT: HandleRef handle 4660
# CHECK-NEXT: handles freed: 12
# CHECK-NEXT: [exit 0]
#--- main.c
/* Only puts and putchar print: clang -S text binds no other C library
   function (plan D14's standalone import table). */
int puts(const char *s);
int putchar(int c);

typedef struct mc_object *mc_handle; /* an opaque handle (plan 5.20.9) */

/* 'this-val': DateTime is a value type, and TYPE says so. */
__attribute__((msil_method("valuetype System.DateTime", ".ctor",
                           "instance void(int32, int32, int32)")))
mc_handle new_date(int year, int month, int day);

__attribute__((msil_method("valuetype System.DateTime", "get_Year",
                           "instance int32()")))
int date_year(mc_handle date);

/* An 'enum' result: System.DayOfWeek is an int32 enum, read as an int. */
__attribute__((msil_method("valuetype System.DateTime", "get_DayOfWeek",
                           "instance valuetype System.DayOfWeek()")))
int date_day_of_week(mc_handle date);

/* An 'enum' parameter: System.DateTimeKind is an int32 enum, passed as an
   int (the DateTime is the 'boxed' row). */
__attribute__((msil_method("valuetype System.DateTime", "SpecifyKind",
                           "valuetype System.DateTime(valuetype "
                           "System.DateTime, valuetype System.DateTimeKind)")))
mc_handle date_specify_kind(mc_handle date, int kind);

__attribute__((msil_method("valuetype System.DateTime", "get_Kind",
                           "instance valuetype System.DateTimeKind()")))
int date_kind(mc_handle date);

/* 'this-obj': StringBuilder is a reference type, and TYPE says so. */
__attribute__((msil_method("System.Text.StringBuilder", ".ctor",
                           "instance void(string)")))
mc_handle new_builder(const char *text);

__attribute__((msil_method("System.Text.StringBuilder", "get_Length",
                           "instance int32()")))
int builder_length(mc_handle builder);

/* 'enum' parameters in a stub with msil_catch: FileMode and FileAccess are
   int32 enums passed as ints, and the filter maps the exception. */
__attribute__((msil_method("System.IO.FileStream", ".ctor",
                           "instance void(string, valuetype "
                           "System.IO.FileMode, valuetype System.IO.FileAccess)"),
               msil_catch("System.IO.FileNotFoundException", 2)))
mc_handle open_file(const char *path, int mode, int access, int *err);

/* TYPEs whose kind is fixed: the primitive value type System.Int64
   ('this-val') and System.String ('this-obj'). */
__attribute__((msil_method("System.Type", "GetType",
                           "class System.Type(string)")))
mc_handle type_named(const char *name);

__attribute__((msil_method("System.Activator", "CreateInstance",
                           "object(class System.Type)")))
mc_handle create_instance(mc_handle type);

__attribute__((msil_method("valuetype System.Int64", "CompareTo",
                           "instance int32(int64)")))
int long_compare(mc_handle boxed, long long other);

__attribute__((msil_method("System.String", "Concat",
                           "string(string, string)")))
mc_handle concat(const char *a, const char *b);

__attribute__((msil_method("System.String", "get_Length", "instance int32()")))
int string_length(mc_handle s);

/* Instance fields: 'this-val' (a FILETIME's dwLowDateTime) and 'this-obj'
   with an 'enum' result (StructLayoutAttribute's CharSet, an int32 enum,
   read as an int), from Type::get_StructLayoutAttribute ('this-obj'). */
#define FILETIME "valuetype System.Runtime.InteropServices.ComTypes.FILETIME"
#define LAYOUT "System.Runtime.InteropServices.StructLayoutAttribute"

__attribute__((msil_method(FILETIME, "dwLowDateTime", "instance field int32")))
int filetime_low(mc_handle filetime);

__attribute__((msil_method("System.Type", "get_StructLayoutAttribute",
                           "instance class " LAYOUT "()")))
mc_handle type_layout(mc_handle type);

__attribute__((msil_method(LAYOUT, "CharSet",
                           "instance field valuetype "
                           "System.Runtime.InteropServices.CharSet")))
int layout_charset(mc_handle layout);

/* 'this-obj' with interfaces, reference types like classes:
   ICollection::get_Count on an ArrayList and IDisposable::Dispose on a
   MemoryStream, whose CanRead (Stream::get_CanRead, 'this-obj') turns false
   when it is disposed; both come from classes' constructors ('obj'). */
__attribute__((msil_method("System.Collections.ArrayList", ".ctor",
                           "instance void()")))
mc_handle new_list(void);

__attribute__((msil_method("System.Collections.ArrayList", "Add",
                           "instance int32(object)")))
int list_add(mc_handle list, mc_handle item);

__attribute__((msil_method("System.Collections.ICollection", "get_Count",
                           "instance int32()")))
int collection_count(mc_handle collection);

__attribute__((msil_method("System.IO.MemoryStream", ".ctor",
                           "instance void()")))
mc_handle new_stream(void);

__attribute__((msil_method("System.IO.Stream", "get_CanRead",
                           "instance bool()")))
int stream_can_read(mc_handle stream);

__attribute__((msil_method("System.IDisposable", "Dispose", "instance void()")))
void dispose(mc_handle disposable);

/* A value type's constructor whose parameters are a delegate constructor's,
   an object and a native int: HandleRef, which TYPE names a value type. */
#define HANDLE_REF "valuetype System.Runtime.InteropServices.HandleRef"

__attribute__((msil_method(HANDLE_REF, ".ctor",
                           "instance void(object, native int)")))
mc_handle new_handle_ref(mc_handle wrapper, void *handle);

__attribute__((msil_method(HANDLE_REF, "get_Handle", "instance native int()")))
void *handle_ref_handle(mc_handle ref);

__attribute__((msil_method("valuetype System.Runtime.InteropServices.GCHandle",
                           "Free", "instance void()")))
void handle_free(mc_handle handle);

/* Prints "<what> <v>". */
static void say(const char *what, long long v) {
  char digits[24];
  int n = 0;
  unsigned long long u =
      v < 0 ? 0 - (unsigned long long)v : (unsigned long long)v;
  while (*what)
    putchar(*what++);
  putchar(' ');
  if (v < 0)
    putchar('-');
  do {
    digits[n++] = (char)('0' + u % 10);
    u /= 10;
  } while (u);
  while (n)
    putchar(digits[--n]);
  putchar('\n');
}

int main(void) {
  mc_handle date = new_date(2024, 5, 6); /* a Monday */
  say("year", date_year(date));
  say("day of week", date_day_of_week(date));
  mc_handle utc = date_specify_kind(date, 1); /* DateTimeKind.Utc */
  say("kind", date_kind(utc));
  mc_handle builder = new_builder("hello");
  say("length", builder_length(builder));
  int err = 0;
  /* FileMode.Open (3) and FileAccess.Read (1) of a file that does not
     exist: no handle, and the code of FileNotFoundException. */
  mc_handle file = open_file("no-such-file.txt", 3, 1, &err);
  say("missing file handle", file != 0);
  say("missing file err", err);
  /* A boxed 0L from Activator::CreateInstance(typeof(long)). */
  mc_handle type = type_named("System.Int64");
  mc_handle zero = create_instance(type);
  say("0L compared with 5", long_compare(zero, 5));
  mc_handle text = concat("hel", "lo");
  say("string length", string_length(text));
  /* A default (zeroed) FILETIME, and the StructLayoutAttribute of its type:
     CharSet.Ansi (2). */
  mc_handle filetime_type =
      type_named("System.Runtime.InteropServices.ComTypes.FILETIME");
  mc_handle filetime = create_instance(filetime_type);
  say("FILETIME dwLowDateTime", filetime_low(filetime));
  mc_handle layout = type_layout(filetime_type);
  say("FILETIME layout CharSet", layout_charset(layout));
  /* An ArrayList that holds the String and the StringBuilder. */
  mc_handle list = new_list();
  list_add(list, text);
  list_add(list, builder);
  say("list count", collection_count(list));
  mc_handle stream = new_stream();
  say("stream readable", stream_can_read(stream));
  dispose(stream);
  say("disposed stream readable", stream_can_read(stream));
  /* A HandleRef of the stream and the address 0x1234. */
  mc_handle ref = new_handle_ref(stream, (void *)0x1234);
  say("HandleRef handle", (__INTPTR_TYPE__)handle_ref_handle(ref));
  handle_free(ref);
  handle_free(stream);
  handle_free(list);
  handle_free(layout);
  handle_free(filetime);
  handle_free(filetime_type);
  handle_free(text);
  handle_free(zero);
  handle_free(type);
  handle_free(builder);
  handle_free(utc);
  handle_free(date);
  puts("handles freed: 12");
  return 0;
}
