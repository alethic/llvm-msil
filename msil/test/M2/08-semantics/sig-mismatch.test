# Matrix case sig-mismatch: a prototype that disagrees with the definition (native 41).
# recon/p2/objfmt-binding-files/sigmismatch/caller.c declares f(int, int) and
# calls f(40, 2); callee.c defines f(int) (judge-c-fidelity J4b). Natively the
# extra argument is ignored; under LTO the merged module calls f with a type
# that differs from its definition, which MSILFixFunctionBitcasts adapts, and
# never a JIT-time InvalidProgramException (the recon's object prototype
# printed 127). On the object path msil-ld checks caller.c's MemberRef
# int32(int32, int32) against callee.c's int32(int32) (plan 5.9.8): an
# adapter drops the extra argument, with a warning naming both objects. From
# M20 the LTO path warns too, with the same text without the ' in <file>'
# parts, exactly once at -O0 and -O2: msil-ld's LTO applies the table before
# LTO optimization too (section 12 row 'Plan 5.9.8 (LTO path) and the D30 row
# of 2026-10-21 amended'). Plan 5.9.16 row sig-mismatch (M14 lto; M20 obj:
# adapter and warning).
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/caller.c %t/callee.c
# RUN: %{msil_prog}
# RUN: %if msil-prog-pipeline=obj %{ %msil_prog_build --level O0 --workdir %t.warn.O0.d --src %{msil_srcs} 2>&1 | FileCheck %s --check-prefix=OBJ --implicit-check-not="signature mismatch" --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" %}
# RUN: %if msil-prog-pipeline=obj %{ %msil_prog_build --level O2 --workdir %t.warn.O2.d --src %{msil_srcs} 2>&1 | FileCheck %s --check-prefix=OBJ --implicit-check-not="signature mismatch" --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" %}
# RUN: %if msil-prog-pipeline=lto %{ %msil_prog_build --level O0 --workdir %t.warn.O0.d --src %{msil_srcs} 2>&1 | FileCheck %s --check-prefix=LTO --implicit-check-not="signature mismatch" --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" %}
# RUN: %if msil-prog-pipeline=lto %{ %msil_prog_build --level O2 --workdir %t.warn.O2.d --src %{msil_srcs} 2>&1 | FileCheck %s --check-prefix=LTO --implicit-check-not="signature mismatch" --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" %}
# OBJ:      {{^}}msil-ld: warning: function signature mismatch: f{{$}}
# OBJ-NEXT: {{^}}>>> defined as int32(int32) in {{.*}}callee.o{{$}}
# OBJ-NEXT: {{^}}>>> called as int32(int32, int32) in {{.*}}caller.o{{$}}
# OBJ-NEXT: {{^}}>>> adapter: {{.+}}
# LTO:      {{^}}msil-ld: warning: {{.*}}function signature mismatch: f{{$}}
# LTO-NEXT: {{^}}>>> defined as int32(int32){{$}}
# LTO-NEXT: {{^}}>>> called as int32(int32, int32){{$}}
# LTO-NEXT: {{^}}>>> adapter: {{.+}}
#--- caller.c
int f(int, int);         /* disagrees with the definition in callee.c (C undefined behaviour, but common) */
int main(void) { return f(40, 2) & 0xff; }
#--- callee.c
int f(int a) { return a + 1; }
