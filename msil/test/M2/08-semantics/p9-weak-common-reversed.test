# Matrix case p9-weak-common, other order: the common comes first (native 1).
# The probes of p9-weak-common with p9b.c's common cw linked before p9a.c's
# weak definition, which must not replace it (plan 5.9.5: a Common is
# replaced only by a non-WEAK definition), so main returns 1.
# recon/p2/judge-c-fidelity-files/probes/p9a.c and p9b.c (common through
# __attribute__((common))). Plan 5.9.16 row p9-weak-common, both orders (M14,
# M20).
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/p9b.c %t/p9a.c
# RUN: %{msil_prog}
#--- p9a.c
/* p9a.c: a weak definition ... */
__attribute__((weak)) int cw = 5;
int get(void) { return cw; }
#--- p9b.c
/* p9b.c: ... and a common (tentative, __attribute__((common))) definition of the same name */
int cw __attribute__((common));
int get(void);
int main(void) { return get() * 10 + 1; }   /* lld/ELF: the common wins, 1; the weak value would give 51 */
