# Matrix case narrow-result-mismatch: narrow unsigned results called through int prototypes (native 200 and 50000).
# a.c declares int f(void) and int g(void); b.c defines unsigned char
# f(void), which returns 200, and unsigned short g(void), which returns
# 50000. Both sides of each call return int32 in CIL (plan 5.9.8's value
# classes), so the object link binds a.c's MemberRefs directly and the LTO
# link's MSILFixFunctionBitcasts finds the same direct match: no warning on
# either pipeline, at -O0 and -O2 (pinned below). Narrow results follow plan
# section 12's row 'Narrow results after upstream merge U2': since upstream
# 05c3ff5c8c06 clang marks no char, short or _BitInt result zeroext or
# signext on the Linux MSIL triples, as on the Windows ones, so on both
# triples the upper bits of the int32 that carries such a result are
# unspecified and a caller that declares the narrow type narrows the result
# itself; a bool result stays zeroext. The IR checks pin that on both
# triples: b.c's f and g return plain i8 and i16, and ir.c's bool result
# zeroext i1. a.c's int prototypes skip the narrowing, so a.c reads the
# int32 as the callee leaves it, and both pipelines leave the values of the
# low 8 and 16 bits there (the object path's callee returns the constants
# zero-extended; the LTO path's MSILFixFunctionBitcasts zero-extends a
# narrow result that is not signext, which no clang output is any more):
# the object and the LTO path print the same transcript (Q8), never the
# sign-extended -56 and -15536 that the LTO path printed before M20's fix
# (M20 review-r1).
# Natively the callee writes only al or ax: x86-64 code generation leaves
# the upper bits of eax unspecified on both ABIs, so a.c reads whatever they
# held. zero() runs first and clears eax, which makes the native transcript
# 200 and 50000 at every level on both oracles (without it the Windows oracle
# read a stale pointer in the upper bits, a different value on every run).
# Plan 5.9.8 ('so the object and LTO paths agree') and 5.9.16.
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/a.c %t/b.c
# RUN: %{msil_prog}
# RUN: %msil_prog_build --level O0 --workdir %t.warn.O0.d --src %{msil_srcs} 2>&1 | FileCheck %s --check-prefix=LINK --implicit-check-not="warning:" --implicit-check-not="signature mismatch" --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
# RUN: %msil_prog_build --level O2 --workdir %t.warn.O2.d --src %{msil_srcs} 2>&1 | FileCheck %s --check-prefix=LINK --implicit-check-not="warning:" --implicit-check-not="signature mismatch" --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
# LINK: {{^}}msil-prog: {{.*}} obj/a.o obj/b.o -o prog.exe{{$}}
# RUN: %clang --target=x86_64-pc-windows-msvc-msil -O0 -S -emit-llvm %t/ir.c -o - | FileCheck %s --check-prefix=IR
# RUN: %clang --target=x86_64-unknown-linux-gnu-msil -O0 -S -emit-llvm %t/ir.c -o - | FileCheck %s --check-prefix=IR
# IR: {{^}}define i32 @zero()
# IR: {{^}}define i8 @f()
# IR: {{^}}define i16 @g()
# IR: {{^}}define zeroext i1 @t()
#--- a.c
#include "msil_test.h"
int zero(void);           /* defined in b.c: clears eax natively */
int f(void);              /* defined in b.c as unsigned char f(void) */
int g(void);              /* defined in b.c as unsigned short g(void) */
int main(void) {
  int z = zero();
  int r = f();            /* 200 */
  int s = g();            /* 50000 */
  put_kv("f()", r);
  put_kv("g()", s);
  return (r + s + z) & 0xff;
}
#--- b.c
int zero(void) { return 0; }
unsigned char f(void) { return 200; }
unsigned short g(void) { return 50000; }
#--- ir.c
/* b.c and a bool result, for the IR checks only (not part of the program). */
#include "b.c"
_Bool t(void) { return 1; }
