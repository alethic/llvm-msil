# 65,600 functions and 65,600 globals in two objects: the members past the per-type limits move to '<msil>Spill<N>' classes.
# gen.py writes big0.c and big1.c, each with 32,800 initialized globals g_<i>
# and the 32,800 functions f_<i> that read them, and 41 functions per file
# that call 800 of them each; big1.c also has big_sum(), which calls those
# 82 functions, so a link with --gc-sections (the default) keeps every one of
# them. main.c sums them and takes the address of four of them. The linked
# output needs more than <Module> may hold, 65,524 methods and 65,534 fields
# with the linker's own members counted, so msil-ld moves the rest into
# '<msil>Spill1', ... classes (private abstract sealed auto ansi, flags
# 0x00000180, extending the core library's System.Object: without references
# the built-in table's [mscorlib]System.Object, plan 5.11.7; with the .NET 8
# or .NET 10 pack [System.Runtime]System.Object); a spill class's address
# fields are not initonly, because <Module>::.cctor stores them, and once a
# spill class exists every '<msil>fn_' field is assembly instead of private
# (plan 5.9.12). <Module> keeps .cctor and '<msil>Main'. The program is split
# across translation units because a CIL object cannot spill: the object
# writer has no spill classes (plan 5.9.12 spills only msil-ld outputs), so
# one translation unit with all 65,600 functions stops clang -c with 'cannot
# write CLI metadata: type '<Module>' has 65683 methods (limit 65524)' (the
# single-object limit is a known limit, plan section 12, 2026-10-26), while
# each of these objects stays far below the limits. The program verifies,
# force-JITs and runs at the real limits (msil-ld's
# --msil-type-member-limit lowers them only in lld/test/MSIL/obj-spill.test),
# at -O0 only, against the native transcript and, under msil_run_netfx=1, on
# the .NET Framework. The steps of %{msil_prog_O0} are written out because
# verifying an image of about 6.8 MB and 131,000 members takes minutes: the
# neutralized pass of msil-verify.py, without whose ildasm listing PEVerify's
# report on the image copy ('ldsflda' of '<msil>image' in <Module>::.cctor)
# is not accepted, spends about 90 s in ildasm alone, past the composites'
# 60-s limit per child process, so %msil_verify gets --timeout 1200 here
# (about 6 minutes in all on this host). %msil_canon of the image pins the
# spill classes. It needs the lit parameter msil_scale_tests=1 (feature
# msil-scale-tests), which only lit-legs.ps1's obj leg sets (plan 5.12.2).
# msil/utils/equiv-allowed.txt keeps its 'skip O4' line for this test
# (--lto-emit-asm text has no per-type limit), which only a composite would
# use. Plan 5.12.2 (msil_scale_tests), 5.9.12.
# REQUIRES: msil-scale-tests
# RUN: rm -rf %t %t.O0.d %t.O0.native.d && split-file %s %t
# RUN: %python %t/gen.py %t
# RUN: %msil_prog_build --level O0 --workdir %t.O0.d --out %t.O0.d/prog.exe --src %t/main.c %t/big0.c %t/big1.c
# RUN: %msil_verify --timeout 1200 %t.O0.d/prog.exe
# RUN: %if msil-jitall %{ %msil_jitall %t.O0.d/prog.exe %}
# RUN: %msil_exec --expect %S/%{s:stem} --out %t.O0.out %t.O0.d/prog.exe
# RUN: %if msil-native-oracle %{ %msil_prog_build --mode native --level O0 --workdir %t.O0.native.d --out %t.O0.native.d/prog.%if msil-wsl %{elf%} %else %{exe%} --src %t/main.c %t/big0.c %t/big1.c && %msil_exec --native --expect %S/%{s:stem} --out %t.O0.native.out %t.O0.native.d/prog.%if msil-wsl %{elf%} %else %{exe%} %}
# RUN: %if msil-run-netfx %{ %msil_exec --netfx --expect %S/%{s:stem} --out %t.O0.netfx.out %t.O0.d/prog.exe %}
# RUN: %msil_canon %t.O0.d/prog.exe > %t.canon.txt
# RUN: FileCheck %s --check-prefix=CANON --input-file=%t.canon.txt -DCORLIB=%if msil-ref=net8 || msil-ref=net10 %{System.Runtime%} %else %{mscorlib%}
# RUN: FileCheck %s --check-prefix=FNACC --input-file=%t.canon.txt
# The first spill class, with a public, not initonly, address field and a
# public method; the classes sort after <Module> ('<msil>S' before
# '<msil>i...', the image type).
# CANON:      {{^}}.class '<Module>' flags=0x{{[0-9A-F]+}}{{$}}
# CANON-NOT:  {{^}}.class
# CANON:      {{^}}  .method '.cctor' void() flags=0x{{[0-9A-F]+}} impl=0x{{[0-9A-F]+}}{{$}}
# CANON-NOT:  {{^}}.class
# CANON:      {{^}}  .method '<msil>Main' {{.+}}{{$}}
# CANON:      {{^}}.class '<msil>Spill1' flags=0x00000180 extends {{\[}}[[CORLIB]]{{\]}}System.Object{{$}}
# CANON-NOT:  {{^}}.class
# CANON:      {{^}}  .field '{{g_[0-9]+}}' native int flags=0x0016{{$}}
# CANON-NOT:  {{^}}.class
# CANON:      {{^}}  .method '{{f_[0-9]+}}' int32() flags=0x0016 impl=0x0000{{$}}
# With a spill class every '<msil>fn_' field is assembly: 0x0013 in a spill
# class, 0x0033 (initonly) if it stays in <Module>; none is private (0x0011,
# 0x0031, Phase 1's access).
# FNACC-NOT:  {{^}}  .field '<msil>fn_{{[^']*}}' native int flags=0x00{{11|31}}{{$}}
# FNACC:      {{^}}  .field '<msil>fn_f_{{[0-3]}}' native int flags=0x00{{13|33}}{{$}}
# FNACC-NOT:  {{^}}  .field '<msil>fn_{{[^']*}}' native int flags=0x00{{11|31}}{{$}}
#--- gen.py
# Writes big0.c and big1.c: N initialized globals and the N functions that
# read them, split evenly, with the chunk functions that call every one of
# them in the file that defines them; big_sum() in the last file calls every
# chunk. The values, and so the transcript, are those of the one-file
# program this test had before M21.
import os
import sys

N = 65600
CHUNK = 800
FILES = 2
PER_FILE = N // FILES
CHUNKS = N // CHUNK
for k in range(FILES):
    first, last = k * PER_FILE, (k + 1) * PER_FILE
    with open(os.path.join(sys.argv[1], "big%d.c" % k), "w", newline="\n") as f:
        for i in range(first, last):
            f.write("int g_%d = %d;\n" % (i, i % 251 + 1))
        for i in range(first, last):
            f.write("int f_%d(void) { return g_%d; }\n" % (i, i))
        for c in range(first // CHUNK, last // CHUNK):
            f.write("long long chunk_%d(void) {\n  long long s = 0;\n" % c)
            for i in range(c * CHUNK, (c + 1) * CHUNK):
                f.write("  s += f_%d();\n" % i)
            f.write("  return s;\n}\n")
        if k == FILES - 1:
            for c in range(CHUNKS):
                if c < first // CHUNK:
                    f.write("long long chunk_%d(void);\n" % c)
            f.write("long long big_sum(void) {\n  long long s = 0;\n")
            for c in range(CHUNKS):
                f.write("  s += chunk_%d();\n" % c)
            f.write("  return s;\n}\n")
#--- main.c
#include "msil_test.h"
long long big_sum(void);
int f_0(void), f_1(void), f_2(void), f_3(void);
int (*const some[4])(void) = {f_0, f_1, f_2, f_3};
int main(void) {
  long long s = big_sum();
  int t = 0;
  for (int i = 0; i < 4; ++i)
    t += some[i]();
  put_kv("sum", s);
  put_kv("first four", t);
  return (int)((s + t) & 0xff);
}
