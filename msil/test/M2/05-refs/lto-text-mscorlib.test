# With the .NET 8 pack, -S and --lto-emit-asm text keep [mscorlib] while an LTO image binds to the pack, and --lto-emit-asm still checks the references.
# Text is never bound (plan 5.11.8; bcl-binding 5.11): clang -S keeps Phase
# 1's runnable contract (one .assembly extern mscorlib, every BCL member
# through [mscorlib]), and msil-ld --lto-emit-asm prints the same scopes even
# with --reference, while it still loads the references and applies their
# checks, so a set without a core library fails there with plan 5.11.9's text
# as in a PE link. An LTO link that writes the PE (the lto pipeline's default)
# binds as an object link does (plan 5.9.13): the image of p1prog has the
# three AssemblyRefs of rows-net8.test, in first-use order. The commands are
# explicit, so every leg checks them, whatever its pipeline. Plan 5.11.8,
# 5.11.9.
# REQUIRES: msil-refpack=net8, msil-cil-dump
# RUN: rm -rf %t && split-file %s %t && mkdir -p %t/out
# RUN: %clang_msil %{msil_cflags} -O2 -S %t/p1prog.c -o %t/out/p1prog.il
# RUN: FileCheck %s --check-prefix=TEXT --input-file=%t/out/p1prog.il --implicit-check-not=".assembly extern" --implicit-check-not="[System."
# RUN: %clang_msil %{msil_cflags} -O2 -flto -c %t/p1prog.c -o %t/out/p1prog.o
# REDEFINE: %{msil_ref_flags} = -Wl,--reference=%{msil_ref_dir_net8}
# RUN: %clang_msil %{msil_ldflags} -O2 -Wl,--lto-emit-asm %t/out/p1prog.o -o %t/out/lto.il
# RUN: FileCheck %s --check-prefix=TEXT --input-file=%t/out/lto.il --implicit-check-not=".assembly extern" --implicit-check-not="[System."
# RUN: %clang_msil %{msil_ldflags} -O2 %t/out/p1prog.o -o %t/out/lto.exe
# RUN: %msil_cil_dump --tables %t/out/lto.exe > %t/out/tables.txt
# RUN: FileCheck %s --check-prefix=THREE --input-file=%t/out/tables.txt
# RUN: %python %S/Inputs/refrows.py %t/out/tables.txt > %t/out/rows.txt
# RUN: FileCheck %s --check-prefix=ROWS --input-file=%t/out/rows.txt --implicit-check-not="-> mscorlib" --implicit-check-not="-> nested" --implicit-check-not="-> 0x"
# REDEFINE: %{msil_ref_flags} = -Wl,--reference=%{msil_ref_dir_net8}/mscorlib.dll
# RUN: not %clang_msil %{msil_ldflags} -O2 -Wl,--lto-emit-asm %t/out/p1prog.o -o %t/out/bad.il 2>&1 | FileCheck %s --check-prefix=BAD --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
# TEXT:     {{^}}.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }{{$}}
# TEXT-DAG: {{^}}  call void [mscorlib]System.Buffer::MemoryCopy(void*, void*, int64, int64){{$}}
# TEXT-DAG: {{^}}  call void [mscorlib]System.Threading.Interlocked::MemoryBarrier(){{$}}
# TEXT-DAG: {{^}}.class private explicit ansi sealed '<msil>image_t' extends [mscorlib]System.ValueType{{$}}
# TEXT-DAG: {{^}}  call native int [mscorlib]System.Runtime.InteropServices.Marshal::AllocHGlobal(native int){{$}}
# TEXT-DAG: {{^}}  call string[] [mscorlib]System.Environment::GetCommandLineArgs(){{$}}
# TEXT-DAG: {{^}}  call native int [mscorlib]System.Runtime.InteropServices.Marshal::StringToHGlobalAnsi(string){{$}}
# THREE:    {{^}}Table: AssemblyRef rows=3 rowsize={{[0-9]+}}{{$}}
# ROWS-DAG: {{^}}assemblyref {{[1-3]}} System.Runtime 8.0.0.0 token=b03f5f7f11d50a3a flags=0x00000000 culture='' hash=-{{$}}
# ROWS-DAG: {{^}}assemblyref {{[1-3]}} System.Runtime.InteropServices 8.0.0.0 token=b03f5f7f11d50a3a flags=0x00000000 culture='' hash=-{{$}}
# ROWS-DAG: {{^}}assemblyref {{[1-3]}} System.Threading 8.0.0.0 token=b03f5f7f11d50a3a flags=0x00000000 culture='' hash=-{{$}}
# ROWS-DAG: {{^}}typeref System.Buffer -> System.Runtime{{$}}
# ROWS-DAG: {{^}}typeref System.Threading.Interlocked -> System.Threading{{$}}
# ROWS-DAG: {{^}}typeref System.Runtime.InteropServices.Marshal -> System.Runtime.InteropServices{{$}}
# ROWS-DAG: {{^}}typeref System.Environment -> System.Runtime{{$}}
# ROWS-DAG: {{^}}typeref System.ValueType -> System.Runtime{{$}}
# ROWS:     {{^}}first use: {{.+}}{{$}}
# BAD:      {{^}}msil-ld: error: the references contain no core library (an assembly that defines System.Object and references no other assembly); given: {{.*}}mscorlib{{.*}} (facade, forwards System.Object to System.Runtime){{.*}}{{$}}
# BAD:      clang: error: {{.*}}command failed with exit code 1 (use -v to see invocation)
#--- p1prog.c
/* llvm/docs/MSIL/recon/p2/bcl-binding-files/runtime/p1prog.c, the program of
   bcl-binding 1.2 and 3.2. */
/* Exercises every BCL member Phase 1 emits: the data segment (AllocHGlobal
   and the RVA image type extending System.ValueType), argv
   (GetCommandLineArgs, AllocHGlobal, StringToHGlobalAnsi), a variable-length
   memmove (Buffer::MemoryCopy) and a fence (Interlocked::MemoryBarrier). */
#include <stddef.h>
int puts(const char *);
static char buf[64] = "hello";
const char *table[] = {buf, "world"};
int main(int argc, char **argv) {
  size_t n = (size_t)argc + 3;
  __builtin_memmove(buf + 1, buf, n);
  __atomic_thread_fence(__ATOMIC_SEQ_CST);
  puts(table[1]);
  return argv[0][0] != 0 ? 42 : 1;
}
