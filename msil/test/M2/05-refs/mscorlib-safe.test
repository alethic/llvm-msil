# TABLE-DAG:  {{^}}method native int [mscorlib]System.Runtime.InteropServices.Marshal::StringToHGlobalAnsi(string){{$}}
# TABLE-DAG:  {{^}}method string[] [mscorlib]System.Environment::GetCommandLineArgs(){{$}}
# TABLE-DAG:  {{^}}method void [mscorlib]System.Buffer::MemoryCopy(void*, void*, int64, int64){{$}}
# TABLE-DAG:  {{^}}method void [mscorlib]System.Threading.Interlocked::MemoryBarrier(){{$}}
# TABLE-DAG:  {{^}}method native int [mscorlib]System.Runtime.InteropServices.Marshal::StringToHGlobalUni(string){{$}}
# TABLE-DAG:  {{^}}type [mscorlib]System.EntryPointNotFoundException{{$}}
# TABLE-DAG:  {{^}}method instance void [mscorlib]System.EntryPointNotFoundException::.ctor(string){{$}}
# TABLE-DAG:  {{^}}type [mscorlib]System.Object{{$}}
# UNSAFE-OUT: {{^}}check-mscorlib-safe: 2 entries from {{.*}}unsafe.txt{{$}}
# UNSAFE-OUT: {{^}}check-mscorlib-safe: {{[a-z0-9-]+}} ({{.+}}): 1 of 2 entries resolve; failing: entry 2 (System.TypeLoadException){{$}}
# UNSAFE-ERR: {{^}}check-mscorlib-safe: FAIL: {{[a-z0-9-]+}}: entry 2 'method native int [mscorlib]System.Runtime.InteropServices.NativeLibrary::Load(string)': System.TypeLoadException: Could not load type 'System.Runtime.InteropServices.NativeLibrary' from assembly 'mscorlib, Version=4.0.0.0, {{.+}}{{$}}
# WRONGSIG-OUT: {{^}}check-mscorlib-safe: 2 entries from {{.*}}wrongsig.txt{{$}}
# WRONGSIG-OUT: {{^}}check-mscorlib-safe: {{[a-z0-9-]+}} ({{.+}}): 1 of 2 entries resolve; failing: entry 2 (System.MissingMethodException){{$}}
# WRONGSIG-ERR: {{^}}check-mscorlib-safe: FAIL: {{[a-z0-9-]+}}: entry 2 'method native int [mscorlib]System.Runtime.InteropServices.Marshal::AllocHGlobal(int64)': System.MissingMethodException: Method not found: 'IntPtr System.Runtime.InteropServices.Marshal.AllocHGlobal(Int64)'.{{$}}
