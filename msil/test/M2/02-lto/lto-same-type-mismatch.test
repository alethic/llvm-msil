# LTO reports sret and byval mismatches whose IR call type equals the definition's (forced -flto).
# def.c defines struct big sr(int), which returns its 24-byte struct through
# a hidden sret pointer on both x86_64 triples, and call.c calls it through
# void sr(void *, int): the IR function types are the same, void(ptr, i32),
# and only the sret attribute differs. On Linux triples def.c also defines
# int bv(struct b32), and call.c calls it through int bv(struct b24): both
# pass the struct byval, so the IR type is i32(ptr) on both sides and only
# the byval size differs (Windows triples pass both structs by reference,
# so bv is left out there). 5.9.8's table makes both errors (SRET on one
# side only; BYVAL of another size), and the object path reports them
# (lld/test/MSIL/obj-signatures.test pins them for objects). Under -flto
# MSILFixFunctionBitcasts (module flag msil-lto) applies the same table to
# the merged module, so the link stops with the same errors, 5.9.8's texts
# without the ' in <file>' parts, each exactly once, at -O0 and -O2 (compile
# and link at the same level); before M20's fix the LTO link took a call
# whose IR type matched the definition for a direct match and linked
# silently. Natively both calls are undefined behaviour, so the test has no
# transcript. Plan 5.9.8 ('so the object and LTO paths agree').
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_cflags} = -std=gnu17 -ffreestanding -Werror=return-type -I%msil_inputs -flto
# RUN: mkdir -p %t/lto
# RUN: %clang_msil %{msil_cflags} -O0 -c %t/def.c -o %t/lto/def.O0.o
# RUN: %clang_msil %{msil_cflags} -O0 -c %t/call.c -o %t/lto/call.O0.o
# RUN: not %clang_msil %{msil_ldflags} -O0 %t/lto/def.O0.o %t/lto/call.O0.o -o %t/lto/O0.exe > %t/lto/O0.txt 2>&1
# RUN: %clang_msil %{msil_cflags} -O2 -c %t/def.c -o %t/lto/def.O2.o
# RUN: %clang_msil %{msil_cflags} -O2 -c %t/call.c -o %t/lto/call.O2.o
# RUN: not %clang_msil %{msil_ldflags} -O2 %t/lto/def.O2.o %t/lto/call.O2.o -o %t/lto/O2.exe > %t/lto/O2.txt 2>&1
# DEFINE: %{mm_check} = FileCheck %s --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" --implicit-check-not="_bitcast_invalid"
# RUN: %{mm_check} --check-prefix=SR --input-file=%t/lto/O0.txt
# RUN: %{mm_check} --check-prefix=SR --input-file=%t/lto/O2.txt
# RUN: %if msil-triple-linux %{ %{mm_check} --check-prefix=BV --input-file=%t/lto/O0.txt %}
# RUN: %if msil-triple-linux %{ %{mm_check} --check-prefix=BV --input-file=%t/lto/O2.txt %}
# RUN: %{mm_check} --check-prefix=%if msil-triple-linux %{COUNT2%} %else %{COUNT1%} --input-file=%t/lto/O0.txt --implicit-check-not="signature mismatch" --implicit-check-not="warning:"
# RUN: %{mm_check} --check-prefix=%if msil-triple-linux %{COUNT2%} %else %{COUNT1%} --input-file=%t/lto/O2.txt --implicit-check-not="signature mismatch" --implicit-check-not="warning:"
# SR:               {{^}}msil-ld: error: {{.*}}function signature mismatch: sr{{$}}
# SR-NEXT:          {{^}}>>> defined as void(native int, int32){{$}}
# SR-NEXT:          {{^}}>>> called as void(native int, int32){{$}}
# SR-NEXT:          {{^}}>>> {{([^a]|a[^d]).*}}
# BV:               {{^}}msil-ld: error: {{.*}}function signature mismatch: bv{{$}}
# BV-NEXT:          {{^}}>>> defined as int32(native int){{$}}
# BV-NEXT:          {{^}}>>> called as int32(native int){{$}}
# BV-NEXT:          {{^}}>>> {{([^a]|a[^d]).*}}
# COUNT1-COUNT-1:   {{^}}msil-ld: error: {{.*}}function signature mismatch: {{sr|bv}}{{$}}
# COUNT1:           clang: error: {{.*}}command failed with exit code 1 (use -v to see invocation)
# COUNT2-COUNT-2:   {{^}}msil-ld: error: {{.*}}function signature mismatch: {{sr|bv}}{{$}}
# COUNT2:           clang: error: {{.*}}command failed with exit code 1 (use -v to see invocation)
#--- def.c
struct big {
  long long a, b, c;
};
struct big sr(int x) { /* sret on both triples */
  struct big r = {x, 2, 3};
  return r;
}
#ifndef _WIN32
struct b32 {
  long long a, b, c, d;
};
int bv(struct b32 p) { return (int)(p.a + p.d); } /* byval, 32 bytes */
#endif
#--- call.c
void sr(void *out, int x); /* def.c defines struct big sr(int x) */
#ifndef _WIN32
struct b24 {
  long long a, b, c;
};
int bv(struct b24 p);      /* def.c defines int bv(struct b32 p) */
#endif
int main(void) {
  long long buf[3] = {0, 0, 0};
  sr(buf, 4);
  int r = (int)buf[0] * 10 + (int)buf[2];
#ifndef _WIN32
  struct b24 s = {7, 8, 9};
  r += bv(s) & 1;
#endif
  return r & 0xff;
}
