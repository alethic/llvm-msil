# A function that no input and no native library defines is a named link error.
# main.c calls msil_no_such_function, which neither the program nor the
# default libraries (on windows-msvc ucrt.lib, kernel32.lib, oldnames.lib and
# --ucrtbase-imports; on linux-gnu libc.so.6 and libm.so.6 through the
# sysroot) define; natively a link error. msil-ld binds the other calls
# (puts, strlen) natively and reports the undefined one after LTO (plan
# 5.9.6, 5.10.10 step 5): 'undefined symbol: <name>' followed by a
# '>>> referenced by <file>:(<method>)' line naming main (plan 5.9.14), never a
# DllNotFound or EntryPointNotFound exception at run time. Those
# '>>> referenced by' lines are the LTO link's, so that check runs only when
# %{msil_prog} links bitcode. On the object path (M20) msil-ld reports the
# same symbol after late binding (plan 5.9.6 step 4) with a line that names
# main.o and main. Plan 5.10.15 (an undefined symbol), recon tests-p2 3.5,
# M15, M20.
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/main.c
# RUN: %if msil-prog-pipeline=lto %{ %{msil_prog_fail_O0} 2>&1 | FileCheck %s --check-prefix=LTO --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" --implicit-check-not=strlen --implicit-check-not="symbol: puts" %}
# RUN: %if msil-prog-pipeline=lto %{ %{msil_prog_fail_O2} 2>&1 | FileCheck %s --check-prefix=LTO --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" --implicit-check-not=strlen --implicit-check-not="symbol: puts" %}
# RUN: %if msil-prog-pipeline=obj %{ %{msil_prog_fail_O0} 2>&1 | FileCheck %s --check-prefix=OBJ --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" --implicit-check-not=strlen --implicit-check-not="symbol: puts" %}
# RUN: %if msil-prog-pipeline=obj %{ %{msil_prog_fail_O2} 2>&1 | FileCheck %s --check-prefix=OBJ --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" --implicit-check-not=strlen --implicit-check-not="symbol: puts" %}
# LTO:      {{^}}msil-ld: error: undefined symbol: msil_no_such_function{{$}}
# LTO-NEXT: {{^}}>>> referenced by {{.+}}:(main){{$}}
# LTO:      clang: error: {{.*}}command failed with exit code 1 (use -v to see invocation)
# OBJ:      {{^}}msil-ld: error: undefined symbol: msil_no_such_function{{$}}
# OBJ-NEXT: {{^}}>>> referenced by {{.*}}main.o:(main){{$}}
# OBJ:      clang: error: {{.*}}command failed with exit code 1 (use -v to see invocation)
#--- main.c
typedef __SIZE_TYPE__ size_t;
int puts(const char *s);
size_t strlen(const char *s);
int msil_no_such_function(int v);

int main(void) {
  puts("linking");
  return msil_no_such_function((int)strlen("abc"));
}
