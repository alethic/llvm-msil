# Native data imports: variables of a test-built native library, read and written through their real addresses.
# native.c is linked into native.dll (with its import library native.lib) on
# Windows triples or libnative.so on Linux triples, as native-lib.test does;
# %{msil_native_libs} gives both builds '-L%t -lnative', and %{msil_deps}
# ships the library next to the program for verification, the force-JIT and
# every run. main.c declares the library's variables extern (dllimport on
# Windows triples, which the native link needs for data from a DLL) and uses
# them as data. Each one is a native data import (plan 5.10.12, Q15, from
# M20; M15-M19 had the link error 'importing native data symbol ... is not
# supported yet'): the variable keeps its address field, which
# '<msil>init_dataimports'(), called from <Module>::.cctor before the data
# relocations and the constructors, fills through '<msil>dataimport' (the
# kernel32 pair LoadLibraryW and GetProcAddress on Windows triples, dlopen
# and dlsym bound from the C library on Linux triples). So the program and
# the library see the same objects: main.c reads the initial values, writes
# a scalar and an array element, and the library's functions read them back;
# on Linux triples an initialized pointer to an imported variable is a data
# relocation against that address field (C does not allow it for a
# dllimport variable, so Windows triples set the pointer at run time). Plan
# 5.10.12, 5.10.15 (M20: data imports), recon tests-p2 3.5.
# RUN: rm -rf %t && split-file %s %t
# RUN: %if msil-triple-windows %{ %clang_native -O2 -c %t/native.c -o %t/native.obj && %lld_link -dll -noentry -nodefaultlib %t/native.obj -out:%t/native.dll %} %else %{ %clang_native -O2 -fPIC -c %t/native.c -o %t/native.o && %ld_lld -shared -soname libnative.so %t/native.o -o %t/libnative.so %}
# REDEFINE: %{msil_srcs} = %t/main.c
# REDEFINE: %{msil_native_libs} = -L%t -lnative
# REDEFINE: %{msil_deps} = %if msil-triple-windows %{%t/native.dll%} %else %{%t/libnative.so%}
# RUN: %{msil_prog}
#--- native.c
#ifdef _WIN32
#define EXPORT __declspec(dllexport)
#else
#define EXPORT __attribute__((visibility("default")))
#endif

EXPORT int nat_counter = 5;
EXPORT int nat_table[4] = {10, 20, 30, 40};
EXPORT const char nat_text[] = "text in the native library";
EXPORT int nat_get_counter(void) { return nat_counter; }
EXPORT int nat_sum_table(void) {
  return nat_table[0] + nat_table[1] + nat_table[2] + nat_table[3];
}
#--- main.c
#include "msil_test.h"
#if defined(_WIN32)
#define IMPORT __declspec(dllimport)
#else
#define IMPORT
#endif
IMPORT extern int nat_counter;
IMPORT extern int nat_table[4];
IMPORT extern const char nat_text[];
int nat_get_counter(void);
int nat_sum_table(void);
#if defined(_WIN32)
int *counter_ptr;
#else
int *counter_ptr = &nat_counter;
#endif

int main(void) {
#if defined(_WIN32)
  counter_ptr = &nat_counter;
#endif
  put_kv("nat_counter", nat_counter);
  put_kv("nat_table[2]", nat_table[2]);
  put_str(nat_text);
  nat_counter += 7;
  nat_table[2] = 300;
  put_kv("nat_get_counter", nat_get_counter());
  put_kv("nat_sum_table", nat_sum_table());
  *counter_ptr = 1;
  put_kv("nat_get_counter", nat_get_counter());
  put_kv("same address", counter_ptr == &nat_counter);
  return nat_sum_table() & 0xff;
}
