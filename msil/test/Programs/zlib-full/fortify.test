# zlib 1.3.2 in full, hosted, with glibc's -D_FORTIFY_SOURCE=2: example.test's program through the fortified printf family.
# example.test's program (example.c with all 15 library files in libz.a),
# compiled with -D_FORTIFY_SOURCE=2 added to its flags for the MSIL build and
# the hosted native build alike. For clang, glibc's headers then define
# printf, fprintf, sprintf and snprintf as static overloadable variadic
# functions with a pass_object_size first parameter that call
# __vprintf_chk, __vfprintf_chk, __vsprintf_chk and __vsnprintf_chk of
# libc.so.6 with a va_list, make vsnprintf a call of __vsnprintf_chk, and
# check memcpy, strcpy and read
# (llvm/docs/MSIL/recon/p3/hosted-libc.md section 6.2): variadic
# definitions from a real header, which M26's ExpandVariadics expands in
# example.c, next to zlib's own gzprintf, whose gzvprintf calls the checked
# vsnprintf. glibc fortifies only an optimized compile (at -O0 its
# features.h warns and leaves the checks out, which is example.test's
# build), so this test builds at -O2 alone, whatever the leg's levels. The
# transcript is example.test's (%{msil_expect} names its expected files).
# Linux triples only: _FORTIFY_SOURCE is glibc's. Plan 5.17.15 (M26).
# REQUIRES: msil-corpus-zlib, msil-triple-linux
# REDEFINE: %{msil_expect} = %S/example
# REDEFINE: %{msil_srcs} = %{msil_corpus}/zlib-1.3.2/test/example.c
# REDEFINE: %{msil_archives} = z=%{msil_corpus}/zlib-1.3.2/adler32.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/compress.c,%{msil_corpus}/zlib-1.3.2/crc32.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/deflate.c,%{msil_corpus}/zlib-1.3.2/gzclose.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/gzlib.c,%{msil_corpus}/zlib-1.3.2/gzread.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/gzwrite.c,%{msil_corpus}/zlib-1.3.2/infback.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/inffast.c,%{msil_corpus}/zlib-1.3.2/inflate.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/inftrees.c,%{msil_corpus}/zlib-1.3.2/trees.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/uncompr.c,%{msil_corpus}/zlib-1.3.2/zutil.c
# REDEFINE: %{msil_copts} = -I%{msil_corpus}/zlib-1.3.2 -DZ_HAVE_UNISTD_H \
# REDEFINE:   -D_LARGEFILE64_SOURCE=1 -D_FORTIFY_SOURCE=2
# RUN: %{msil_prog_O2}
