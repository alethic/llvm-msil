# RUN: %if msil-run-netfx %{ %msil_exec --netfx -- %t.O0.d/prog.exe %{readfile:%t/O0/netfx.arg} | FileCheck %s --check-prefix=QUIET %}
# RUN: %if msil-run-netfx %{ %python %S/minigzip-data.py cmp %t/O0/msil/data.gz %t/O0/netfx/data.gz | FileCheck %s --check-prefix=SAME %}
# RUN: %if msil-run-netfx %{ %if msil-native-oracle %{ cp %t/O0/native/data.gz %t/O0/netfx-d/data.gz %} %else %{ cp %t/O0/msil/data.gz %t/O0/netfx-d/data.gz %} %}
# RUN: %if msil-run-netfx %{ %msil_exec --netfx -- %t.O0.d/prog.exe -d %{readfile:%t/O0/netfx-d.arg} | FileCheck %s --check-prefix=QUIET %}
# RUN: %if msil-run-netfx %{ %python %S/minigzip-data.py cmp %t/input %t/O0/netfx-d/data | FileCheck %s --check-prefix=INPUTSIZE %}
# RUN: %if msil-also-run %{ %{minigzip_also_run_O0} %}

