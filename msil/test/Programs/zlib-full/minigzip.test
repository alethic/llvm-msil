# RUN: %msil_verify %t.O2.d/prog.exe
# RUN: %if msil-jitall %{ %msil_jitall %t.O2.d/prog.exe %}
# RUN: %msil_exec -- %t.O2.d/prog.exe %{readfile:%t/O2/msil.arg} | FileCheck %s --check-prefix=QUIET
# RUN: %if msil-native-oracle %{ %msil_prog_build --mode native %{msil_oracle_flags} --level O2 --workdir %t.O2.native.d --out %t.O2.native.d/prog.exe --src %{msil_srcs} --archives='%{msil_archives}' %}
# RUN: %if msil-native-oracle %{ %msil_exec --native -- %t.O2.native.d/prog.exe %{readfile:%t/O2/native.arg} | FileCheck %s --check-prefix=QUIET %}
# RUN: %if msil-native-oracle %{ %python %S/minigzip-data.py cmp %t/O2/native/data.gz %t/O2/msil/data.gz | FileCheck %s --check-prefix=SAME %}
# RUN: %if msil-native-oracle %{ cp %t/O2/native/data.gz %t/O2/msil-d/data.gz %} %else %{ cp %t/O2/msil/data.gz %t/O2/msil-d/data.gz %}
# RUN: %msil_exec -- %t.O2.d/prog.exe -d %{readfile:%t/O2/msil-d.arg} | FileCheck %s --check-prefix=QUIET
# RUN: %python %S/minigzip-data.py cmp %t/input %t/O2/msil-d/data | FileCheck %s --check-prefix=INPUTSIZE
