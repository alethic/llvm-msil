# RUN: %if msil-run-netfx %{ %python %S/minigzip-data.py cmp %t/O2/msil/data.gz %t/O2/netfx/data.gz | FileCheck %s --check-prefix=SAME %}
# RUN: %if msil-run-netfx %{ %if msil-native-oracle %{ cp %t/O2/native/data.gz %t/O2/netfx-d/data.gz %} %else %{ cp %t/O2/msil/data.gz %t/O2/netfx-d/data.gz %} %}
# RUN: %if msil-run-netfx %{ %msil_exec --netfx -- %t.O2.d/prog.exe -d %{readfile:%t/O2/netfx-d.arg} | FileCheck %s --check-prefix=QUIET %}
# RUN: %if msil-run-netfx %{ %python %S/minigzip-data.py cmp %t/input %t/O2/netfx-d/data | FileCheck %s --check-prefix=INPUTSIZE %}
# RUN: %if msil-also-run %{ %{minigzip_also_run_O2} %}

# QUIET-NOT: {{.}}
# QUIET: {{^}}[exit 0]{{$}}
# QUIET-NOT: {{.}}
# SAME: {{^}}same: {{[0-9]+}} bytes{{$}}
# INPUTSIZE: {{^}}same: 2097152 bytes{{$}}
