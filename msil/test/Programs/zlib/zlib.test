# zlib 1.3.2 (Z_SOLO) as a static library: 12 deflate/inflate round trips through an arena allocator.
# zlib_main.c deflates one input at levels 1, 6 and 9 with four strategies,
# inflates each stream and compares, and prints the input's Adler-32 and
# CRC-32 and each stream's size and hash. libz.a holds the nine core files that
# Z_SOLO builds without the default allocators (compress.c and uncompr.c need
# them), so the link extracts members lazily; libsup.a is the support library.
# Built as a multi-TU program with static archives (%{msil_archives}: one per
# library plus libsup.a, the support library of ../support) from the corpus
# cache (%{msil_corpus}, filled by msil/utils/corpus/fetch.py), with the shim
# headers of ../shim in both builds (%{msil_copts}), at every level of the leg,
# and compared with the native build of the same sources; the error count is
# the exit status, so the transcript ends [exit 0]. Plan 5.12.9 (M23).
# ../det/zlib.test repeats these REDEFINE lines for %{msil_det}.
# REQUIRES: msil-corpus-zlib
# REDEFINE: %{msil_srcs} = %S/../zlib/zlib_main.c
# REDEFINE: %{msil_archives} = z=%{msil_corpus}/zlib-1.3.2/adler32.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/crc32.c,%{msil_corpus}/zlib-1.3.2/deflate.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/infback.c,%{msil_corpus}/zlib-1.3.2/inffast.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/inflate.c,%{msil_corpus}/zlib-1.3.2/inftrees.c, \
# REDEFINE:   %{msil_corpus}/zlib-1.3.2/trees.c,%{msil_corpus}/zlib-1.3.2/zutil.c; \
# REDEFINE:   sup=%S/../support/sup_arena.c,%S/../support/sup_malloc.c,%S/../support/sup_memcmp.c, \
# REDEFINE:   %S/../support/sup_memset.c,%S/../support/sup_memcpy.c,%S/../support/sup_strlen.c, \
# REDEFINE:   %S/../support/sup_out.c
# REDEFINE: %{msil_copts} = -isystem %S/../shim -I%S/../support -I%{msil_corpus}/zlib-1.3.2 \
# REDEFINE:   -DZ_SOLO -Werror=implicit-function-declaration -w
# RUN: %{msil_prog}
