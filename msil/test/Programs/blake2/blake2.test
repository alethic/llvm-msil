# BLAKE2 reference code as a static library: the keyed known-answer tests of blake2b, blake2s, blake2bp and blake2sp.
# blake2_main.c checks 4 x 256 keyed vectors of the corpus tree's
# testvectors/blake2-kat.h and prints the mismatch count of each family (all
# 0). libb2.a holds the six reference sources; blake2-impl.h takes memset's
# address, which in the MSIL build is the support archive's (sup_memset.c), as
# is the memcmp the driver calls.
# Built as a multi-TU program with static archives (%{msil_archives}: one per
# library plus libsup.a, the support library of ../support) from the corpus
# cache (%{msil_corpus}, filled by msil/utils/corpus/fetch.py), with the shim
# headers of ../shim in both builds (%{msil_copts}), at every level of the leg,
# and compared with the native build of the same sources; the error count is
# the exit status, so the transcript ends [exit 0]. Plan 5.12.9 (M23).
# ../det/blake2.test repeats these REDEFINE lines for %{msil_det}.
# REQUIRES: msil-corpus-blake2
# REDEFINE: %{msil_srcs} = %S/../blake2/blake2_main.c
# REDEFINE: %{msil_archives} = b2=%{msil_corpus}/blake2-ed1974ea8343/ref/blake2b-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2s-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2bp-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2sp-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2xb-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2xs-ref.c;sup=%S/../support/sup_arena.c, \
# REDEFINE:   %S/../support/sup_malloc.c,%S/../support/sup_memcmp.c,%S/../support/sup_memset.c, \
# REDEFINE:   %S/../support/sup_memcpy.c,%S/../support/sup_strlen.c,%S/../support/sup_out.c
# REDEFINE: %{msil_copts} = -isystem %S/../shim -I%S/../support \
# REDEFINE:   -I%{msil_corpus}/blake2-ed1974ea8343/ref \
# REDEFINE:   -I%{msil_corpus}/blake2-ed1974ea8343/testvectors \
# REDEFINE:   -Werror=implicit-function-declaration -w
# RUN: %{msil_prog}
