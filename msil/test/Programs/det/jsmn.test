# Two builds of the jsmn program give identical objects, archives and image.
# %{msil_det} builds the program of ../jsmn/jsmn.test twice at -O2, in two
# directories from relative paths, and compares every CIL object (bitcode under
# lto), the archives that llvm-ar writes and msil-ld's image byte for byte
# (plan 5.12.4, 5.12.9; M23). check-recipe.py fails when the REDEFINE lines
# here differ from that test's, so both build the same program.
# REQUIRES: msil-corpus-jsmn
# REDEFINE: %{msil_srcs} = %S/../jsmn/jsmn_main.c %S/../jsmn/jsmn_impl.c
# REDEFINE: %{msil_archives} = sup=%S/../support/sup_arena.c,%S/../support/sup_malloc.c, \
# REDEFINE:   %S/../support/sup_memcmp.c,%S/../support/sup_memset.c,%S/../support/sup_memcpy.c, \
# REDEFINE:   %S/../support/sup_strlen.c,%S/../support/sup_out.c
# REDEFINE: %{msil_copts} = -isystem %S/../shim -I%S/../support -I%{msil_corpus}/jsmn-25647e692c79 \
# REDEFINE:   -DJSMN_PARENT_LINKS -DJSMN_STRICT -Werror=implicit-function-declaration -w
# RUN: %python %S/check-recipe.py %s %S/../jsmn/jsmn.test
# RUN: %{msil_det}
