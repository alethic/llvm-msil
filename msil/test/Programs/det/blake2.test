# Two builds of the blake2 program give identical objects, archives and image.
# %{msil_det} builds the program of ../blake2/blake2.test twice at -O2, in two
# directories from relative paths, and compares every CIL object (bitcode under
# lto), the archives that llvm-ar writes and msil-ld's image byte for byte
# (plan 5.12.4, 5.12.9; M23). check-recipe.py fails when the REDEFINE lines
# here differ from that test's, so both build the same program.
# REQUIRES: msil-corpus-blake2
# REDEFINE: %{msil_srcs} = %S/../blake2/blake2_main.c
# REDEFINE: %{msil_archives} = b2=%{msil_corpus}/blake2-ed1974ea8343/ref/blake2b-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2s-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2bp-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2sp-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2xb-ref.c, \
# REDEFINE:   %{msil_corpus}/blake2-ed1974ea8343/ref/blake2xs-ref.c;sup=%S/../support/sup_arena.c, \
# REDEFINE:   %S/../support/sup_malloc.c,%S/../support/sup_memcmp.c,%S/../support/sup_memset.c, \
# REDEFINE:   %S/../support/sup_memcpy.c,%S/../support/sup_strlen.c,%S/../support/sup_out.c
# REDEFINE: %{msil_copts} = -isystem %S/../shim -I%S/../support \
# REDEFINE:   -I%{msil_corpus}/blake2-ed1974ea8343/ref \
# REDEFINE:   -I%{msil_corpus}/blake2-ed1974ea8343/testvectors \
# REDEFINE:   -Werror=implicit-function-declaration -w
# RUN: %python %S/check-recipe.py %s %S/../blake2/blake2.test
# RUN: %{msil_det}
