# Two builds of the lz4 program give identical objects, archives and image.
# %{msil_det} builds the program of ../lz4/lz4.test twice at -O2, in two
# directories from relative paths, and compares every CIL object (bitcode under
# lto), the archives that llvm-ar writes and msil-ld's image byte for byte
# (plan 5.12.4, 5.12.9; M23). check-recipe.py fails when the REDEFINE lines
# here differ from that test's, so both build the same program.
# REQUIRES: msil-corpus-lz4
# REDEFINE: %{msil_srcs} = %S/../lz4/lz4_main.c
# REDEFINE: %{msil_archives} = lz4=%{msil_corpus}/lz4-1.10.0/lib/lz4.c, \
# REDEFINE:   %{msil_corpus}/lz4-1.10.0/lib/lz4hc.c;sup=%S/../support/sup_arena.c, \
# REDEFINE:   %S/../support/sup_malloc.c,%S/../support/sup_memcmp.c,%S/../support/sup_memset.c, \
# REDEFINE:   %S/../support/sup_memcpy.c,%S/../support/sup_strlen.c,%S/../support/sup_out.c
# REDEFINE: %{msil_copts} = -isystem %S/../shim -I%S/../support -I%{msil_corpus}/lz4-1.10.0/lib \
# REDEFINE:   -DLZ4_FREESTANDING=1 -DLZ4_memcpy=__builtin_memcpy -DLZ4_memset=__builtin_memset \
# REDEFINE:   -DLZ4_memmove=__builtin_memmove -DLZ4_FORCE_SW_BITCOUNT -DLZ4_USER_MEMORY_FUNCTIONS \
# REDEFINE:   -Werror=implicit-function-declaration -w
# RUN: %python %S/check-recipe.py %s %S/../lz4/lz4.test
# RUN: %{msil_det}
