# setjmp and longjmp within one assembly on msil64-unknown-dotnet: a jump out of a call returns its value at the site and longjmp(b, 0) returns 1; a volatile local keeps the value stored after the site; jumps out of two levels of calls, through a managed function pointer, through a copy of the buffer and from another translation unit reach the right site; two sites in one function and a site in a loop keep their own labels; sigsetjmp with the constant mask 0 and siglongjmp jump as setjmp and longjmp do.
# The first portable setjmp/longjmp test (P-1r row R1: M27's gate stays
# host-only). MSILLowerSjLj (plan 5.15.4, M27) lowers every site and every
# longjmp of the program as on the host triples: a site stores the MSJ1
# prefix in the buffer (here the portable C library's opaque 200-byte
# jmp_buf and sigjmp_buf from the sysroot's <setjmp.h>, 8-aligned), each
# call after it that may longjmp goes through a wrapper with a filter, and
# __msil_longjmp arms the status block that the prefix names and throws.
# Nothing is keyed by the buffer's address, so a jump through a memcpy'd copy
# (c.dll's memcpy) reaches the original site. On this triple every function
# pointer is managed (ldftn and calli, P-1a), so the jump through a pointer
# crosses only managed frames. A sigsetjmp site whose mask is the constant 0
# saves no mask and references no sigprocmask (c.dll has none before the
# signal design; sigsetjmp-mask.test pins the link error of a nonzero mask).
# The expected values follow C17 7.13 (longjmp(b, 0) makes setjmp return 1,
# 7.13.2.1p4; a volatile automatic object changed between the site and the
# jump keeps its last stored value, 7.13.2.1p3). Each failed group sets one
# bit of the exit status.
# A link that writes --lto-emit-asm text cannot import c.dll
# (msil_link_output=il), so the test needs linked images.
# UNSUPPORTED: msil-link-output=il
# REDEFINE: %{msil_expected_rule} = windows,linux: portable: no stdout before P-2; the program checks itself
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/main.c %t/other.c
# RUN: %{msil_prog}
#--- other.c
#include <setjmp.h>

/* A jump from another translation unit (another object of the program). */
__attribute__((noinline)) void other_jump(jmp_buf b, int v) { longjmp(b, v); }
#--- main.c
#include <setjmp.h>
#include <string.h>

void other_jump(jmp_buf b, int v);

static unsigned fails;
#define CHECK(bit, cond)                                                       \
  do {                                                                         \
    if (!(cond))                                                               \
      fails |= 1u << (bit);                                                    \
  } while (0)

static jmp_buf jb, outer, inner;
static sigjmp_buf sjb;

__attribute__((noinline)) static void jump(jmp_buf b, int v) { longjmp(b, v); }

__attribute__((noinline)) static void deeper(int v) { jump(outer, v); }
__attribute__((noinline)) static void deep(int v) {
  deeper(v);
  jump(outer, -1); /* never reached */
}

/* Through a pointer: a managed method pointer on this triple. */
static void (*volatile jumper)(jmp_buf, int) = jump;

/* Two sites in one function: a jump to the second, then one to the first;
   returns 10 * (the first site's value) + (the second's). */
__attribute__((noinline)) static int two_sites(void) {
  volatile int stage = 0, second = 0;
  int r = setjmp(jb);
  if (stage == 0) {
    stage = 1;
    int s = setjmp(inner);
    if (s == 0)
      jump(inner, 4);
    second = s;
    jump(jb, 3);
  }
  return 10 * r + second;
}

/* A site in a loop of jumps: five jumps back to one site. */
__attribute__((noinline)) static int loop_site(void) {
  volatile int count = 0;
  int r = setjmp(jb);
  if (r < 5) {
    count = count + 1;
    jump(jb, r + 1);
  }
  return count * 10 + r;
}

int main(void) {
  /* 0: the value of the jump, and longjmp(b, 0) returning 1. */
  int r = setjmp(jb);
  if (r == 0)
    jump(jb, 7);
  CHECK(0, r == 7);
  r = setjmp(jb);
  if (r == 0)
    jump(jb, 0);
  CHECK(0, r == 1);

  /* 1: a volatile local keeps the value stored after the site. */
  volatile int kept = 1;
  r = setjmp(jb);
  if (r == 0) {
    kept = 42;
    jump(jb, 2);
  }
  CHECK(1, r == 2 && kept == 42);

  /* 2: out of two levels of calls. */
  r = setjmp(outer);
  if (r == 0)
    deep(9);
  CHECK(2, r == 9);

  /* 3: through a function pointer. */
  r = setjmp(jb);
  if (r == 0)
    jumper(jb, 11);
  CHECK(3, r == 11);

  /* 4: through a copy of the buffer. */
  jmp_buf copy;
  r = setjmp(jb);
  if (r == 0) {
    memcpy(copy, jb, sizeof(jmp_buf));
    jump(copy, 12);
  }
  CHECK(4, r == 12);

  /* 5: from another translation unit. */
  r = setjmp(jb);
  if (r == 0)
    other_jump(jb, 13);
  CHECK(5, r == 13);

  /* 6: two sites in one function, and a site in a loop. */
  CHECK(6, two_sites() == 34);
  CHECK(6, loop_site() == 55);

  /* 7: sigsetjmp with the constant mask 0, and siglongjmp. */
  r = sigsetjmp(sjb, 0);
  if (r == 0)
    siglongjmp(sjb, 14);
  CHECK(7, r == 14);
  return (int)fails;
}
