#
# (8) The same names through the sysroot's headers. <math.h>'s C23 macros
# iscanonical and issignaling (llvm-libc-macros/math-function-macros.h, as
# upstream ships it) expand to a _Generic selection of functions that no
# header declares, so a use is an undeclared-identifier error naming the
# selection's first function, with a note naming the macro. <stdlib.h>
# declares no l64a: a call is an undeclared-function error in C17 and a use
# of an undeclared identifier in C23 (which has no implicit declarations).
# RUN: not %clang_portable %{msil_portable_libc_cflags} -std=c17 -fsyntax-only %t/canon.c > %t/canon.log 2>&1
# RUN: FileCheck %s --check-prefix=CANON --input-file %t/canon.log --implicit-check-not=error: --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
# CANON: canon.c:{{[0-9]+}}:{{[0-9]+}}: error: use of undeclared identifier '{{iscanonical[a-z0-9]*}}'{{$}}
# CANON: note: expanded from macro 'iscanonical'{{$}}
# CANON: canon.c:{{[0-9]+}}:{{[0-9]+}}: error: use of undeclared identifier '{{issignaling[a-z0-9]*}}'{{$}}
# CANON: note: expanded from macro 'issignaling'{{$}}
# CANON: {{^}}2 errors generated.
# RUN: not %clang_portable %{msil_portable_libc_cflags} -std=c17 -fsyntax-only %t/l64a.c > %t/l64a.c17.log 2>&1
# RUN: FileCheck %s --check-prefix=L64A17 --input-file %t/l64a.c17.log --implicit-check-not=error: --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
# L64A17: l64a.c:{{[0-9]+}}:{{[0-9]+}}: error: call to undeclared function 'l64a'; ISO C99 and later do not support implicit function declarations
# L64A17: {{^}}1 error generated.
# RUN: not %clang_portable %{msil_portable_libc_cflags} -std=c23 -fsyntax-only %t/l64a.c > %t/l64a.c23.log 2>&1
# RUN: FileCheck %s --check-prefix=L64A23 --input-file %t/l64a.c23.log --implicit-check-not=error: --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
# L64A23: l64a.c:{{[0-9]+}}:{{[0-9]+}}: error: use of undeclared identifier 'l64a'{{$}}
# L64A23: {{^}}1 error generated.
#
# (9) llvm-libc's generated <math.h> (math-function-macros.h) defines none
# of C17 7.12.14's comparison macros (isgreater, isgreaterequal, isless,
# islessequal, islessgreater, isunordered), an upstream gap that P-1b
# records (Status.md) instead of adding an upstream conflict surface: a use
# is a call to an undeclared function, a compile error in C17.
# RUN: not %clang_portable %{msil_portable_libc_cflags} -std=c17 -fsyntax-only %t/cmp.c > %t/cmp.log 2>&1
# RUN: FileCheck %s --check-prefix=CMP --input-file %t/cmp.log --implicit-check-not=error: --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
# CMP: cmp.c:{{[0-9]+}}:{{[0-9]+}}: error: call to undeclared function 'isless'; ISO C99 and later do not support implicit function declarations
# CMP: cmp.c:{{[0-9]+}}:{{[0-9]+}}: error: call to undeclared function 'isunordered'; ISO C99 and later do not support implicit function declarations
# CMP: {{^}}2 errors generated.
#--- own.c
/* No header: the program declares the functions itself, as C allows. */
typedef unsigned long size_t;
typedef long long time_t;
typedef int wchar_t;
struct tm;
void *malloc(size_t size);
void exit(int status);
int printf(const char *format, ...);
int rand(void);
struct tm *localtime(const time_t *timer);
int swprintf(wchar_t *s, size_t n, const wchar_t *format, ...);
char *strptime(const char *s, const char *format, struct tm *tm);
int fetestexcept(int excepts);
char *strsignal(int sig);

int main(int argc, char **argv) {
  (void)argv;
  if (argc > 100) {
    time_t t = 0;
    wchar_t w[4];
    char *p = malloc(16);
    printf("%p\n", p);
    if (localtime(&t) || swprintf(w, 4, L"x") > 0 || strptime("1", "%d", 0))
      exit(rand());
    if (fetestexcept(argc) || strsignal(argc))
      return 1;
  }
  return 0;
}
#--- hdr.c
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <wchar.h>

int main(int argc, char **argv) {
  (void)argv;
  if (argc > 100) {
    time_t t = 0;
    wchar_t w[4];
    struct tm tmv;
    char *p = malloc(16);
    printf("%p\n", p);
    if (localtime(&t) || swprintf(w, 4, L"x") > 0 || strptime("1", "%d", &tmv))
      exit(rand());
    if (strsignal(argc))
      return 1;
  }
  return 0;
}
#--- data.c
#include <errno.h>
#include <stdio.h>
#include <time.h>

/* Only the headers declare the objects; a use is a link error. */
int main(int argc, char **argv) {
  (void)argv;
  if (argc > 100) {
    if (stdin == 0 || stdout == 0 || stderr == 0)
      return 1;
    if (daylight || timezone || tzname[0] == 0)
      return 2;
    if (program_invocation_name == 0 || program_invocation_short_name == 0)
      return 3;
  }
  return 0;
}
#--- cxx.cpp
// C++ through the sysroot's headers: <stdlib.h> declares no malloc.
#include <stdlib.h>

int main() {
  void *p = malloc(4);
  return p != nullptr;
}
#--- assert.c
/* NDEBUG unset: assert expands to a call of __assert_fail. */
#undef NDEBUG
#include <assert.h>

int main(int argc, char **argv) {
  (void)argv;
  assert(argc == 1);
  return 0;
}
#--- fenv.c
#include <fenv.h>

int main(void) { return fetestexcept(FE_ALL_EXCEPT); }
#--- gone.c
/* No header: the program declares the functions itself. */
int iscanonical(double x);
int issignaling(double x);
char *l64a(long value);

int main(int argc, char **argv) {
  (void)argv;
  if (argc > 100)
    return iscanonical(1.0) + issignaling(2.0) + (l64a(argc) != 0);
  return 0;
}
#--- canon.c
#include <math.h>

int f(double d) { return iscanonical(d); }
int g(double d) { return issignaling(d); }
#--- l64a.c
#include <stdlib.h>

int f(long v) { return l64a(v) != 0; }
#--- cmp.c
#include <math.h>

int f(double a, double b) { return isless(a, b); }
int g(double a, double b) { return isunordered(a, b); }
