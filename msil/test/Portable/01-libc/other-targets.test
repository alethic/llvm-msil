# P-1b's hooks in llvm-libc's public headers stay invisible to other targets: compiled from the repository's libc/include for x86_64-unknown-none and riscv32-unknown-elf, struct tm is upstream's 36 bytes without tm_gmtoff or tm_zone, math_errhandling is MATH_ERRNO | MATH_ERREXCEPT, MB_CUR_MAX is 1, the 36 original generic errno numbers are unchanged and the appended POSIX names are there (the one intended change); on powerpc-unknown-elf, a target with no branch, fenv_t.h and __jmp_buf.h still reach their final #error.
# Plan 5.19.14 (the changed upstream libc files, each keyed on dotnet's own
# macros: __dotnet__ or __msil32__/__msil64__ in the public llvm-libc-macros
# and llvm-libc-types headers, never __MSIL__ or __ELF__), 5.19.5 and
# section 12's row 'Upstream conflict surface' (the generic errno set gains
# 44 POSIX names and the aliases EWOULDBLOCK and EOPNOTSUPP for every target
# of the generic family; no existing number changes), 5.19.6 and section
# 12's row 'Contract 5.19.6, 5.19.14 and 5.13.5 amended (MB_CUR_MAX as
# built)' (other targets keep upstream's 1), and the review focus of P-1b
# (every P-1b libc branch but the generic errno names is invisible to other
# targets). The headers are the repository's (%S/../../../../libc/include),
# not the sysroot's, so the test needs no sysroot and compiles nothing for
# the portable triple; clang's frontend knows these targets whatever
# backends the build has. The expected values are upstream's: nine int
# members of struct tm (C17 7.27.1p4) and the 36 numbers of
# generic-error-number-macros.h before P-1b. A key widened beyond dotnet
# (for example '|| defined(__ELF__)' in struct_tm.h) fails the probe on
# riscv32-unknown-elf. Nothing links or runs.
# RUN: rm -rf %t && split-file %s %t
# RUN: %clang --target=x86_64-unknown-none -ffreestanding -fsyntax-only -std=c17 -I %S/../../../../libc/include %t/probe.c
# RUN: %clang --target=riscv32-unknown-elf -ffreestanding -fsyntax-only -std=c17 -I %S/../../../../libc/include %t/probe.c
#
# struct tm has no tm_gmtoff (or tm_zone) member there.
# RUN: not %clang --target=riscv32-unknown-elf -ffreestanding -fsyntax-only -std=c17 -I %S/../../../../libc/include %t/gmtoff.c 2>&1 | FileCheck %s --check-prefix=GMTOFF --implicit-check-not=error: --implicit-check-not="PLEASE submit"
# RUN: not %clang --target=x86_64-unknown-none -ffreestanding -fsyntax-only -std=c17 -I %S/../../../../libc/include %t/gmtoff.c 2>&1 | FileCheck %s --check-prefix=GMTOFF --implicit-check-not=error: --implicit-check-not="PLEASE submit"
# GMTOFF: gmtoff.c:{{[0-9]+}}:{{[0-9]+}}: error: no member named 'tm_gmtoff' in 'struct tm'
# GMTOFF: gmtoff.c:{{[0-9]+}}:{{[0-9]+}}: error: no member named 'tm_zone' in 'struct tm'
# GMTOFF: {{^}}2 errors generated.
#
# A target with no branch of its own reaches each header's final #error.
# RUN: not %clang --target=powerpc-unknown-elf -ffreestanding -fsyntax-only -std=c17 -I %S/../../../../libc/include %t/fenv.c 2>&1 | FileCheck %s --check-prefix=FENV --implicit-check-not=error: --implicit-check-not="PLEASE submit"
# FENV: llvm-libc-types{{[/\]}}fenv_t.h:{{[0-9]+}}:{{[0-9]+}}: error: "fenv_t not defined for your platform"
# FENV: {{^}}1 error generated.
# RUN: not %clang --target=powerpc-unknown-elf -ffreestanding -fsyntax-only -std=c17 -I %S/../../../../libc/include %t/jmpbuf.c 2>&1 | FileCheck %s --check-prefix=JMPBUF --implicit-check-not=error: --implicit-check-not="PLEASE submit"
# JMPBUF: llvm-libc-types{{[/\]}}__jmp_buf.h:{{[0-9]+}}:{{[0-9]+}}: error: "__jmp_buf not available for your target architecture."
# JMPBUF: {{^}}1 error generated.
#--- probe.c
#include "llvm-libc-macros/generic-error-number-macros.h"
#include "llvm-libc-macros/limits-macros.h"
#include "llvm-libc-macros/math-macros.h"
#include "llvm-libc-macros/stdlib-macros.h"
#include "llvm-libc-types/fenv_t.h"
#include "llvm-libc-types/struct_tm.h"

#if defined(__dotnet__) || defined(__msil32__) || defined(__msil64__)
#error "the probe is for targets other than the portable ones"
#endif

/* struct_tm.h: upstream's nine ints (tm_gmtoff and tm_zone only on Linux). */
_Static_assert(sizeof(struct tm) == 36, "struct tm is nine ints");
_Static_assert(sizeof(struct tm) == 9 * sizeof(int), "struct tm is nine ints");

/* math-macros.h: both error mechanisms (the __dotnet__ key drops
   MATH_ERREXCEPT on the portable targets only). */
_Static_assert(math_errhandling == (MATH_ERRNO | MATH_ERREXCEPT), "math_errhandling");

/* stdlib-macros.h: upstream's MB_CUR_MAX (4 on __dotnet__ only). */
_Static_assert(MB_CUR_MAX == 1, "MB_CUR_MAX");

/* fenv_t.h: x86_64 and riscv keep their own branches. */
_Static_assert(sizeof(fenv_t) > 0, "fenv_t");

/* generic-error-number-macros.h: the 36 original numbers, unchanged. */
_Static_assert(EPERM == 1 && ENOENT == 2 && ESRCH == 3 && EINTR == 4, "errno");
_Static_assert(EIO == 5 && ENXIO == 6 && E2BIG == 7 && ENOEXEC == 8, "errno");
_Static_assert(EBADF == 9 && ECHILD == 10 && EAGAIN == 11 && ENOMEM == 12, "errno");
_Static_assert(EACCES == 13 && EFAULT == 14 && ENOTBLK == 15 && EBUSY == 16, "errno");
_Static_assert(EEXIST == 17 && EXDEV == 18 && ENODEV == 19 && ENOTDIR == 20, "errno");
_Static_assert(EISDIR == 21 && EINVAL == 22 && ENFILE == 23 && EMFILE == 24, "errno");
_Static_assert(ENOTTY == 25 && ETXTBSY == 26 && EFBIG == 27 && ENOSPC == 28, "errno");
_Static_assert(ESPIPE == 29 && EROFS == 30 && EMLINK == 31 && EPIPE == 32, "errno");
_Static_assert(EDOM == 33 && ERANGE == 34 && EOVERFLOW == 35 && EILSEQ == 84, "errno");

/* The appended POSIX names, the one intended change for every target of
   the generic family (5.19.5's numbers). */
_Static_assert(ENAMETOOLONG == 36 && ENOLCK == 37 && ENOSYS == 38 && ENOTEMPTY == 39, "errno+");
_Static_assert(ELOOP == 40 && ENOMSG == 42 && EIDRM == 43 && ENOSTR == 60, "errno+");
_Static_assert(ENODATA == 61 && ETIME == 62 && ENOSR == 63 && ENOLINK == 67, "errno+");
_Static_assert(EPROTO == 71 && EMULTIHOP == 72 && EBADMSG == 74 && EDEADLK == 75, "errno+");
_Static_assert(ENOTSOCK == 88 && EDESTADDRREQ == 89 && EMSGSIZE == 90 && EPROTOTYPE == 91, "errno+");
_Static_assert(ENOPROTOOPT == 92 && EPROTONOSUPPORT == 93 && ENOTSUP == 95 && EAFNOSUPPORT == 97, "errno+");
_Static_assert(EADDRINUSE == 98 && EADDRNOTAVAIL == 99 && ENETDOWN == 100 && ENETUNREACH == 101, "errno+");
_Static_assert(ENETRESET == 102 && ECONNABORTED == 103 && ECONNRESET == 104 && ENOBUFS == 105, "errno+");
_Static_assert(EISCONN == 106 && ENOTCONN == 107 && ETIMEDOUT == 110 && ECONNREFUSED == 111, "errno+");
_Static_assert(EHOSTUNREACH == 113 && EALREADY == 114 && EINPROGRESS == 115 && ESTALE == 116, "errno+");
_Static_assert(EDQUOT == 122 && ECANCELED == 125 && EOWNERDEAD == 130 && ENOTRECOVERABLE == 131, "errno+");
_Static_assert(EWOULDBLOCK == EAGAIN && EOPNOTSUPP == ENOTSUP, "errno+");
#--- gmtoff.c
#include "llvm-libc-types/struct_tm.h"

long gmtoff(const struct tm *t) { return t->tm_gmtoff; }
const char *zone(const struct tm *t) { return t->tm_zone; }
#--- fenv.c
#include "llvm-libc-types/fenv_t.h"
#--- jmpbuf.c
#include "llvm-libc-types/__jmp_buf.h"
