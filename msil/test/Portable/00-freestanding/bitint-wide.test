# _BitInt wider than __int128 on msil64-unknown-dotnet: _BitInt(200) and unsigned _BitInt(129) multiply, divide and remainder (expanded inline, no helper), as parameters and results of noinline functions, through a function pointer, as initialized globals, and through a variadic function read with va_arg.
# Plan 5.18.2 PC2 (TargetInfo's getMaxBitIntWidth: _BitInt up to the IR
# limit on the portable triples, as on the host triples; BitIntMaxAlign 128)
# and PC4 (a _BitInt wider than __int128 is passed indirect, by pointer,
# and so is its va_arg slot), PC5 (ExpandVariadics' MSILPortable slots
# agree with clang's va_arg for it). ops.c holds one operation per noinline
# function, so each is a real call with wide arguments and results at every
# level; main.c builds the inputs from volatile 64-bit words and compares
# the results' words (bits 192-199 are the top word of a _BitInt(200)).
# The expected words are exact integer arithmetic (truncating division,
# remainder with the dividend's sign, unsigned results modulo 2^129); no
# signed operation overflows. Each failed group sets one bit of the exit
# status.
# REDEFINE: %{msil_expected_rule} = windows,linux: portable: no stdout before P-2; the program checks itself
# RUN: rm -rf %t && split-file %s %t
# REDEFINE: %{msil_srcs} = %t/main.c %t/ops.c
# RUN: %{msil_prog}
#--- ops.h
// _BitInt is C23; the directory compiles as gnu17, where clang accepts it
// as an extension.
#pragma clang diagnostic ignored "-Wbit-int-extension"
#include <stdarg.h>
#define NOINLINE __attribute__((noinline))
typedef _BitInt(200) i200;
typedef unsigned _BitInt(200) u200;
typedef unsigned _BitInt(129) u129;
typedef unsigned long long u64;
i200 mul200(i200 a, i200 b);
i200 div200(i200 a, i200 b);
i200 rem200(i200 a, i200 b);
u129 mul129(u129 a, u129 b);
u129 div129(u129 a, u129 b);
u129 rem129(u129 a, u129 b);
u129 neg129(u129 a);
i200 mix200(int tag, i200 a, long c, u129 b, char e);
u64 vfold(const char *types, ...);
static inline u64 fold(u64 h, u64 v) { return h * 1000003u ^ v; }
static inline u64 fold200(u64 h, i200 v) {
  u200 u = (u200)v;
  return fold(fold(fold(fold(h, (u64)u), (u64)(u >> 64)), (u64)(u >> 128)),
              (u64)(u >> 192));
}
static inline u64 fold129(u64 h, u129 v) {
  return fold(fold(fold(h, (u64)v), (u64)(v >> 64)), (u64)(v >> 128));
}
#--- ops.c
#include "ops.h"
NOINLINE i200 mul200(i200 a, i200 b) { return a * b; }
NOINLINE i200 div200(i200 a, i200 b) { return a / b; }
NOINLINE i200 rem200(i200 a, i200 b) { return a % b; }
NOINLINE u129 mul129(u129 a, u129 b) { return a * b; }
NOINLINE u129 div129(u129 a, u129 b) { return a / b; }
NOINLINE u129 rem129(u129 a, u129 b) { return a % b; }
NOINLINE u129 neg129(u129 a) { return -a; }
// Mixed scalar and wide parameters: each keeps its own slot.
NOINLINE i200 mix200(int tag, i200 a, long c, u129 b, char e) {
  return a + (i200)tag + (i200)c + (i200)b + (i200)e;
}
// One va_arg per type letter: i int, w _BitInt(200), u unsigned
// _BitInt(129), q __int128, d double. _BitInt arguments are not promoted.
NOINLINE u64 vfold(const char *types, ...) {
  va_list ap;
  va_start(ap, types);
  u64 h = 17;
  for (const char *t = types; *t; ++t) {
    switch (*t) {
    case 'i': h = fold(h, (u64)(long long)va_arg(ap, int)); break;
    case 'w': h = fold200(h, va_arg(ap, i200)); break;
    case 'u': h = fold129(h, va_arg(ap, u129)); break;
    case 'q': {
      unsigned __int128 q = (unsigned __int128)va_arg(ap, __int128);
      h = fold(fold(h, (u64)q), (u64)(q >> 64));
      break;
    }
    case 'd': {
      double d = va_arg(ap, double);
      u64 bits;
      __builtin_memcpy(&bits, &d, 8);
      h = fold(h, bits);
      break;
    }
    default: h = 0; break;
    }
  }
  va_end(ap);
  return h;
}
#--- main.c
#include "ops.h"

static unsigned fails;
#define CHECK(bit, cond)                                                       \
  do {                                                                         \
    if (!(cond))                                                               \
      fails |= 1u << (bit);                                                    \
  } while (0)

// Each input's words, low first; the third holds bits 128-191.
static volatile u64 v_w[][3] = {
    {0x6789abcdef012345ull, 0x00002bcdef012345ull, 0}, // A (110 bits)
    {0x56789abcdef01357ull, 0x0000000000001234ull, 0}, // B (77 bits)
    {0xfedcba9876543210ull, 0x0706050403020100ull, 0x3f2e1d0c0b0a0908ull}, // N
    {0x0000000000000007ull, 0x23456789abcdef01ull, 1}, // D (129 bits)
    {0x0123456789abcdefull, 0xfedcba9876543210ull, 1}, // X (129 bits)
    {0xffffffff00000001ull, 0x0000000000000001ull, 0}, // Y (65 bits)
    {5, 0, 1},                                         // Z = 2^128 + 5
};

static u200 mk(int i) {
  return ((u200)v_w[i][2] << 128) | ((u200)v_w[i][1] << 64) | v_w[i][0];
}
static int eq200(i200 v, u64 w0, u64 w1, u64 w2, u64 w3) {
  u200 u = (u200)v;
  return (u64)u == w0 && (u64)(u >> 64) == w1 && (u64)(u >> 128) == w2 &&
         (u64)(u >> 192) == w3;
}
static int eq129(u129 v, u64 w0, u64 w1, u64 w2) {
  return (u64)v == w0 && (u64)(v >> 64) == w1 && (u64)(v >> 128) == w2;
}

// Initialized wide globals.
static i200 g_big = -((i200)1 << 190) + 3;
static u129 g_top = ((u129)1 << 128) | 9;

int main(void) {
  i200 a = -(i200)mk(0), b = (i200)mk(1), n = -(i200)mk(2), d = (i200)mk(3);
  u129 x = (u129)mk(4), y = (u129)mk(5), z = (u129)mk(6);
  const u64 M = 0xffffffffffffffffull;

  /* 0: _BitInt(200) multiply across the words (-A * B, 187 bits). */
  i200 p = mul200(a, b);
  CHECK(0, eq200(p, 0x07bdddf3ca4ee48dull, 0x92f3f67c3e27ed45ull,
                 0xfce290918dfd5715ull, 0xff));
  CHECK(0, mul200(p, 1) == p && mul200(-a, -b) == p && mul200(b, 0) == 0);

  /* 1: _BitInt(200) divide and remainder by a 77-bit divisor. */
  i200 q = div200(n, b), r = rem200(n, b);
  CHECK(1, eq200(q, 0xddbe63b437b21a89ull, 0xfffc87878786a4c2ull, M, 0xff));
  CHECK(1, eq200(r, 0x41ce726eb5bc9e61ull, 0xfffffffffffff548ull, M, 0xff));
  CHECK(1, q * b + r == n);

  /* 2: _BitInt(200) divide and remainder by a 129-bit divisor, both signs. */
  CHECK(2, eq200(div200(n, d), 0xc87878786a4c2ddcull, M, M, 0xff));
  CHECK(2, eq200(rem200(n, d), 0x85d7fa1ca1968cecull, 0xd71706e7c6b56d24ull,
                 M, 0xff));
  CHECK(2, eq200(div200(-n, -d), 0xc87878786a4c2ddcull, M, M, 0xff));
  CHECK(2, eq200(rem200(-n, -d), 0x7a2805e35e697314ull, 0x28e8f918394a92dbull,
                 0, 0));

  /* 3: unsigned _BitInt(129): multiply modulo 2^129, divide, remainder. */
  CHECK(3, eq129(mul129(x, y), 0x7777777889abcdefull, 0x8acf135788888886ull, 1));
  CHECK(3, eq129(mul129(x, x), 0xdca5e20890f2a521ull, 0x446efc86a6f7108cull, 0));
  CHECK(3, eq129(div129(x, y), 0xff6e5d4cbae147adull, 0, 0));
  CHECK(3, eq129(rem129(x, y), 0xbc962fc7ceca8642ull, 1, 0));
  CHECK(3, eq129(div129(x, z), 1, 0, 0));
  CHECK(3, eq129(rem129(x, z), 0x0123456789abcdeaull, 0xfedcba9876543210ull, 0));
  CHECK(3, eq129(neg129(z), M - 4, M, 0));

  /* 4: mixed parameters, a function pointer and the initialized globals. */
  CHECK(4, mix200(-7, a, 1000L, x, 9) == a + (i200)x + 1002);
  i200 (*fp)(i200, i200) = div200;
  CHECK(4, fp(n, b) == q);
  CHECK(4, eq200(g_big, 3, 0, 0xc000000000000000ull, 0xff) && eq129(g_top, 9, 0, 1));

  /* 5: variadic: wide values after odd and even numbers of 8-byte slots. */
  u64 h = fold200(fold(17, (u64)(long long)-3), n);
  h = fold129(h, x);
  h = fold200(h, p);
  CHECK(5, vfold("iwuw", -3, n, x, p) == h);
  unsigned __int128 q128 = ((unsigned __int128)v_w[2][1] << 64) | v_w[2][0];
  double dv = 2.5;
  u64 dbits;
  __builtin_memcpy(&dbits, &dv, 8);
  u64 h2 = fold129(17, y);
  h2 = fold(fold(h2, (u64)q128), (u64)(q128 >> 64));
  h2 = fold200(h2, d);
  h2 = fold(h2, dbits);
  h2 = fold129(h2, z);
  CHECK(5, vfold("uqwdu", y, (__int128)q128, d, dv, z) == h2);

  return (int)fails;
}
