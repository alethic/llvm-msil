# 'switch' on a native int (plan D35) must fail msil-verify even when an
# allowed error comes first in the same method. Each module puts one allowed
# first error of plan D21 in front of the switch
# (Inputs/masked-switch-*.il): the D13 frame prologue (localloc) and a 'br', a
# read of a local without init and a 'br', or a load through a native int.
# ILVerify stops at that first error, so a wrapper that only filters its
# messages never sees the switch (and PEVerify accepts a native int switch);
# the neutralized pass of msil-verify.py (pass 2, which needs ildasm) does.
# The control module has the same three first errors before 'conv.i4;
# switch' and passes.
# REQUIRES: msil-ilverify, msil-ildasm

# RUN: %ilasm -dll -output=%t.frame.dll %S/Inputs/masked-switch-frame.il
# RUN: not %msil_verify %t.frame.dll > %t.frame.log 2>&1
# RUN: %{harness_check} contains %t.frame.log "StackUnexpected.*::select\(.*\[found Native Int\]\[expected Int32\]"

# RUN: %ilasm -dll -output=%t.local.dll %S/Inputs/masked-switch-local.il
# RUN: not %msil_verify %t.local.dll > %t.local.log 2>&1
# RUN: %{harness_check} contains %t.local.log "StackUnexpected.*::select\(.*\[found Native Int\]\[expected Int32\]"

# RUN: %ilasm -dll -output=%t.ldind.dll %S/Inputs/masked-switch-ldind.il
# RUN: not %msil_verify %t.ldind.dll > %t.ldind.log 2>&1
# RUN: %{harness_check} contains %t.ldind.log "StackUnexpected.*::select\(.*\[found Native Int\]\[expected Int32\]"

# RUN: %ilasm -dll -output=%t.ok.dll %S/Inputs/masked-switch-ok.il
# RUN: %msil_verify %t.ok.dll
