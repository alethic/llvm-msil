# RUN: %{harness_check} contains %t.static.log "^msil-prog: \S*clang\S* --target=x86_64-pc-windows-msvc -std=gnu17 .* -O2 -c \S*hosted-exit-windows\.c -o obj/hosted-exit-windows\.o$"
