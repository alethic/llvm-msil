# RUN: %msil_exec --native --expect %S/Inputs/hosted-exit-windows --out %t.static.out %t.static.d/prog.exe
# RUN: llvm-readobj --coff-imports %t.static.d/prog.exe > %t.static.imports
# RUN: %{harness_check} contains %t.static.imports "^  Name: KERNEL32\.dll$"
# RUN: %{harness_check} lacks %t.static.imports "VCRUNTIME140" "api-ms-win-crt-"
