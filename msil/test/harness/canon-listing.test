#--- coverage.il
// The second input of canon-listing.test: what canonical listing v1 prints
// (plan 5.7.10) beyond Inputs/canon-listing.il. The test prepends a UTF-8
// BOM and assembles it with %ilasm -exe.
//
// - an entry point (the 'entrypoint' header line);
// - NS.Outer: a namespaced class with a nested class ('NS.Outer/Inner'),
//   the interface NS.IShape (.implements), a literal field (const) and a
//   property with a getter (.property, .get);
// - NS.Lay: explicit layout (.layout pack/size, the field's offset);
// - a field name with a quote, a control byte, a backslash and DEL (\' \x01
//   \\ \x7F); ilasm reads octal escapes in quoted names;
// - 'a😀' declared before 'a～': UTF-8 order lists 'a' U+FF5E first, and a
//   UTF-16 ordinal comparison (U+D83D before U+FF5E) would not;
// - 'arrays': an SZARRAY (int32[]) and general arrays of every shape that
//   ilasm writes; ilasm's int32[5] is lower bound 0 and size 5 (int32[0...4]);
// - 'main': ldc.r4, ldc.r8, ldc.i8, a negative ldc.i4.s, a generic method
//   call (a MethodSpec), ldtoken of two TypeSpecs and of a nested TypeRef, an
//   ldstr with a quote, a backslash and a newline (a byte array, because ilasm
//   drops an escaped backslash), and a filter clause inside a finally clause.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly coverage { }
.module coverage.exe

.class interface public abstract auto ansi NS.IShape { }

.class public auto ansi sealed NS.Outer extends [mscorlib]System.Object implements NS.IShape
{
  .field public static literal int32 'K' = int32(7)
  .class nested public auto ansi sealed Inner extends [mscorlib]System.Object { }
  .method public specialname instance int32 get_P() cil managed
  {
    ldc.i4.s -5
    ret
  }
  .property instance int32 P() { .get instance int32 NS.Outer::get_P() }
}

.class public explicit ansi sealed NS.Lay extends [mscorlib]System.ValueType
{
  .pack 4
  .size 16
  .field [8] public int32 'x'
}

.field public static int32 'q\'\001\134\177'

.method public static void 'a😀'() cil managed { ret }
.method public static void 'a～'() cil managed { ret }

.method public static void 'arrays'(int32[] a, int32[...] b, int32[0...] c, int32[5...10] d,
                                    int32[5] e, int32[,] f, int32[0...3,0...4] g,
                                    int32[0...3,-1...] h) cil managed { ret }

