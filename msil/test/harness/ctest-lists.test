# lto
# RUN: %if msil-ld && msil-ar && msil-triple-windows && msil-native-oracle %{ %{harness_check} exits 1 %{harness_lit} -a --param msil_runner=local --param msil_linux_sysroot= --param msil_opt_levels=O0,O2 --param msil_pipeline=lto --param msil_corpus_dir=%t.corpus --param msil_ctest_copy=%t.exec %S/prog/Inputs/nested-ctest > %t.exec-lto.log 2>&1 %}
