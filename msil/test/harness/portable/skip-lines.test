# RUN: %{harness_check} exits 1 %python %S/../../../utils/msil-prog.py --clang='%python %S/Inputs/no-cc.py' --triple msil32-unknown-dotnet --level O2 --pipeline lto --link-output pe --workdir %t/p4 --out %t/p4/prog.exe --also-il %t/p4.il --equiv-out %t/p4-equiv.exe --equiv-skip %t/allow.txt --test %s --src %t/main.c > %t/2d.log 2>&1
# RUN: %{harness_check} contains %t/2c.log "\Amsil-prog: .*no-cc\.py\S* --target=msil64-unknown-dotnet -O0 -c "
# RUN: %{harness_check} contains %t/2d.log "\Amsil-prog: .*no-cc\.py\S* --target=msil32-unknown-dotnet .*-flto"
# RUN: %{harness_check} lacks %t/2c.log "skipped"
# RUN: %{harness_check} lacks %t/2d.log "skipped"
# RUN: %{harness_check} exits 2 %python %S/../../../utils/msil-prog.py --clang='%python %S/Inputs/no-cc.py' --triple msil64-unknown-dotnet --level O2 --pipeline obj --workdir %t/p5 --equiv-skip %t/bad-x86.txt --test %s --src %t/main.c > %t/2e.log 2>&1
# RUN: %{harness_check} contains %t/2e.log "^msil-prog: error: --equiv-skip: \S*bad-x86\.txt:1: the triple x86_64-unknown-dotnet of the skip line is not an MSIL triple \(it does not end in -msil and is not a portable triple such as msil64-unknown-dotnet\)$"
# RUN: %{harness_check} exits 2 %python %S/../../../utils/msil-prog.py --clang='%python %S/Inputs/no-cc.py' --triple msil64-unknown-dotnet --level O2 --pipeline obj --workdir %t/p6 --equiv-skip %t/bad-os.txt --test %s --src %t/main.c > %t/2f.log 2>&1
# RUN: %{harness_check} contains %t/2f.log "^msil-prog: error: --equiv-skip: \S*bad-os\.txt:1: the triple msil64-unknown-linux of the skip line is not an MSIL triple \(it does not end in -msil and is not a portable triple such as msil64-unknown-dotnet\)$"
# RUN: %{harness_check} lacks %t/2e.log "no-cc:"
# RUN: %{harness_check} lacks %t/2f.log "no-cc:"

#--- allow.txt
# Skip lines for this test, qualified by the portable triples.
skip O3@msil64-unknown-dotnet:O2 msil/test/harness/portable/skip-lines.test msil64 at -O2
skip O3@msil32-unknown-dotnet msil/test/harness/portable/skip-lines.test msil32 at every level
skip O4@msil64-unknown-dotnet msil/test/harness/portable/skip-lines.test O4 on msil64
#--- bad-x86.txt
skip O3@x86_64-unknown-dotnet:O2 msil/test/harness/portable/skip-lines.test no portable triple
#--- bad-os.txt
skip O3@msil64-unknown-linux:O2 msil/test/harness/portable/skip-lines.test no MSIL triple
#--- main.c
int main(void) { return 0; }
