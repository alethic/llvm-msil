# RUN: %{harness_check} contains %t/2a.log "\Amsil-prog: O3 skipped: msil64 at -O2\nmsil-prog: .*no-cc\.py\S* --target=msil64-unknown-dotnet -O2 -c \.\./main\.c -o obj/main\.o\nno-cc: --target=msil64-unknown-dotnet " "^msil-prog: error: the compile of \S*main\.c failed \(exit status 3\)$"
# RUN: %{harness_check} exits 1 %python %S/../../../utils/msil-prog.py --clang='%python %S/Inputs/no-cc.py' --triple msil32-unknown-dotnet --level O1 --pipeline obj --workdir %t/p2 --out %t/p2/prog.exe --equiv-out %t/p2-equiv.exe --equiv-skip %t/allow.txt --test %s --src %t/main.c > %t/2b.log 2>&1
# RUN: %{harness_check} contains %t/2b.log "\Amsil-prog: O3 skipped: msil32 at every level\n" "--target=msil32-unknown-dotnet -O1 -c "
