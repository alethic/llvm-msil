# RUN: %{harness_check} contains %t/2b.log "fatal: msil: --param msil_triple=x86_64-unknown-dotnet does not end in -msil and is not a portable triple \(msil64-unknown-dotnet\)$"
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_triple=msil64-unknown-dotnet --param msil_native_oracle=required --param msil_probe_cache= %S/Inputs/nested-portable > %t/2c.log 2>&1
# RUN: %{harness_check} contains %t/2c.log "fatal: msil: native oracle unavailable: the portable triple msil64-unknown-dotnet has no native triple, so no native oracle$"
# RUN: %{harness_lit} --show-tests --param msil_triple=msil64-unknown-dotnet --param msil_native_oracle=1 --param msil_probe_cache= %S/Inputs/nested-portable > %t/2d.log 2>&1
# RUN: %{harness_check} contains %t/2d.log "warning: msil: native oracle unavailable: the portable triple msil64-unknown-dotnet has no native triple, so no native oracle$" "^  MSIL :: harness/portable/Inputs/nested-portable/flags\.test$"
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_triple=msil64-unknown-dotnet --param msil_require_portable=2 --param msil_probe_cache= %S/Inputs/nested-portable > %t/2e.log 2>&1
# RUN: %{harness_check} contains %t/2e.log "fatal: msil: --param msil_require_portable=2 is not a boolean \(use 0 or 1\)$"
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_triple=msil64-unknown-dotnet --param msil_require_x86=2 --param msil_probe_cache= %S/Inputs/nested-portable > %t/2f.log 2>&1
# RUN: %{harness_check} contains %t/2f.log "fatal: msil: --param msil_require_x86=2 is not a boolean \(use 0 or 1\)$"

