# RUN: %if msil-portable && msil-portable-builtins && msil-portable-sysroot %{ %{harness_check} contains %t/3a.log "^  MSIL :: harness/portable/Inputs/nested-portable/flags\.test$" %}
# RUN: %if !msil-portable || !msil-portable-builtins || !msil-portable-sysroot %{ %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_triple=msil64-unknown-dotnet --param msil_require_portable=1 --param msil_probe_cache= %S/Inputs/nested-portable > %t/3a.log 2>&1 %}
# RUN: %if !msil-portable || !msil-portable-builtins || !msil-portable-sysroot %{ %{harness_check} contains %t/3a.log "fatal: msil: msil_require_portable=1, but " %}
# RUN: %if !msil-portable %{ %{harness_check} contains %t/3a.log "msil_require_portable=1, but no portable toolchain: 'cl[a]ng --target=msil64-unknown-dotnet -nostdlib' cannot build a program" %}
