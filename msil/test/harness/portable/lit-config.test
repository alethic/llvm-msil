# RUN: %if !msil-dotnet-x86 %{ %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_triple=msil64-unknown-dotnet --param msil_require_x86=1 --param msil_probe_cache= %S/Inputs/nested-portable > %t/3b.log 2>&1 %}
