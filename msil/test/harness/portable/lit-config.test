# RUN: %if !msil-portable-sysroot %{ %{harness_check} contains %t/3a.log "no portable sysroot \S+/lib/clang-runtimes/msil64-unknown-dotnet \(it lacks \S+.*; build it with 'python msil/utils/build/build-libc\.py', plan 5\.19\.3\)" %}
