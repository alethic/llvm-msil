# RUN: rm %t/rule.expected
# RUN: %{harness_check} exits 1 %{harness_update_expected} --target msil64-unknown-dotnet --check %t/rule.test > %t/2d.log
# RUN: %{harness_check} contains %t/2d.log "\AMISSING: \S*rule\.expected \(hand-written under %%{msil_expected_rule}: portable: no stdout before P-2; the program checks itself\)\n\Z"
