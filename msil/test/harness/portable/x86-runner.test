# RUN: %if msil-netfx %{ %msil_exec --netfx --out %t/nf32.out %t/ps32.exe %}
# RUN: %if msil-netfx %{ %{harness_check} equals %t/nf32.out "[exit 4]" %}
# RUN: %if msil-netfx %{ %msil_exec --netfx --out %t/nf-guard32.out --stderr-out %t/nf-guard32.err %t/guard32.exe %}
