# RUN: %{harness_check} equals %t/ps8.out "[exit 4]"
# RUN: %msil_dotnet_x86 --runtime-major 10 --out %t/ps10.out %t/ps.dll
# RUN: %{harness_check} equals %t/ps10.out "[exit 4]"
# RUN: %msil_exec --out %t/ps64.out %t/ps.dll
# RUN: %{harness_check} equals %t/ps64.out "[exit 8]"

# (3)
# RUN: %msil_dotnet_x86 --runtime-major 8 --out %t/guard8.out --stderr-out %t/guard8.err %t/guard.dll
# RUN: %{harness_check} contains %t/guard8.out "\A\[unhandled exception: System\.(TypeInitializationException|PlatformNotSupportedException)\]\n\Z"
# RUN: %{harness_check} contains %t/guard8.err "System\.PlatformNotSupportedException: guard is built for msil64-unknown-dotnet and needs a 64-bit \.NET process; this process is 32-bit$"
# RUN: %msil_dotnet_x86 --runtime-major 10 --out %t/guard10.out --stderr-out %t/guard10.err %t/guard.dll
# RUN: %{harness_check} contains %t/guard10.out "\A\[unhandled exception: System\.(TypeInitializationException|PlatformNotSupportedException)\]\n\Z"
# RUN: %{harness_check} contains %t/guard10.err "System\.PlatformNotSupportedException: guard is built for msil64-unknown-dotnet and needs a 64-bit \.NET process; this process is 32-bit$"
# RUN: %{harness_check} lacks %t/guard8.err "little-endian"
# RUN: %msil_exec --out %t/guard64.out %t/guard.dll
# RUN: %{harness_check} equals %t/guard64.out "[exit 42]"

