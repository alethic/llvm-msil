# calibrate.py (plan 5.17.8, M24): --combine START END prints the gate's load
# factor 'gate load factor <F>', F = max(1.0, (factor_start + factor_end) / 2),
# from two files that --label start and --label end wrote; --self-test and
# --combine run on any host. calibrate-label.test checks --label.
# (1) --self-test passes every case (among them --out under a parent two
# levels deep that does not exist).
# (2) --combine on written files: factors 1.4 and 2.0 give 1.70; 0.6 and 1.0
# give 1.00, never less; 0.8 and 1.6 give 1.20, so the floor applies to the
# mean and not to each factor (that would give 1.30).
# (3) The failure path: a missing file, a file that is not JSON, a factor
# that is missing or not a number, and usage errors exit 2.

# RUN: rm -rf %t && mkdir -p %t

# (1)
# RUN: %python %S/../../../utils/ci/calibrate.py --self-test > %t/1.log
# RUN: %{harness_check} contains %t/1.log "\Acalibrate: self-test: (\d+) of \1 cases passed\n\Z"

# (2)
# RUN: %{harness_check} write %t/start-a.json '{"version": 1, "label": "start", "factor": 1.4}'
# RUN: %{harness_check} write %t/end-a.json '{"version": 1, "label": "end", "factor": 2.0}'
# RUN: %python %S/../../../utils/ci/calibrate.py --combine %t/start-a.json %t/end-a.json > %t/2a.log
# RUN: %{harness_check} contains %t/2a.log "\Agate load factor 1\.70\n\Z"
# RUN: %{harness_check} write %t/start-b.json '{"version": 1, "label": "start", "factor": 0.6}'
# RUN: %{harness_check} write %t/end-b.json '{"version": 1, "label": "end", "factor": 1.0}'
# RUN: %python %S/../../../utils/ci/calibrate.py --combine %t/start-b.json %t/end-b.json > %t/2b.log
# RUN: %{harness_check} contains %t/2b.log "\Agate load factor 1\.00\n\Z"
# RUN: %{harness_check} write %t/start-c.json '{"version": 1, "label": "start", "factor": 0.8}'
# RUN: %{harness_check} write %t/end-c.json '{"version": 1, "label": "end", "factor": 1.6}'
# RUN: %python %S/../../../utils/ci/calibrate.py --combine %t/start-c.json %t/end-c.json > %t/2c.log
# RUN: %{harness_check} contains %t/2c.log "\Agate load factor 1\.20\n\Z"

# (3)
# RUN: %{harness_check} exits 2 %python %S/../../../utils/ci/calibrate.py --combine %t/start-a.json %t/no-such.json > %t/3a.log 2>&1
# RUN: %{harness_check} contains %t/3a.log "^calibrate\.py: cannot read \S*no-such\.json: "
# RUN: %{harness_check} write %t/not-json.json "factor 1.4"
# RUN: %{harness_check} exits 2 %python %S/../../../utils/ci/calibrate.py --combine %t/not-json.json %t/end-a.json > %t/3b.log 2>&1
# RUN: %{harness_check} contains %t/3b.log "^calibrate\.py: cannot read \S*not-json\.json: "
# RUN: %{harness_check} write %t/no-factor.json '{"version": 1, "label": "end", "seconds": 3.0}'
