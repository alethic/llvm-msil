# RUN: %if msil-ll-opt-O1 %{ %{harness_check} contains %t.log "^# executed command: .*msil-verify\.py'? --roundtrip --ildasm .*\.microsoft\.netcore\.ildasm.%{legs_tools_version}.* --ilasm .*\.microsoft\.netcore\.ilasm.%{legs_tools_version}.* '?--output=.*rt-levels-ir\.ll\.tmp\.O1\.rt\.dll'? .*rt-levels-ir\.ll\.tmp\.O1\.dll'?$" "^# executed command: .*msil-run\.py'? --expect-os .* --out .*rt-levels-ir\.ll\.tmp\.O1\.rt\.out'? .*rt-levels-ir\.ll\.tmp\.O1\.rt\.dll'?$" %}
# RUN: %if msil-ll-opt-O2 %{ %{harness_check} contains %t.log "^# executed command: .*msil-verify\.py'? --roundtrip --ildasm .*\.microsoft\.netcore\.ildasm.%{legs_tools_version}.* --ilasm .*\.microsoft\.netcore\.ilasm.%{legs_tools_version}.* '?--output=.*rt-levels-ir\.ll\.tmp\.O2\.rt\.dll'? .*rt-levels-ir\.ll\.tmp\.O2\.dll'?$" "^# executed command: .*msil-run\.py'? --expect-os .* --out .*rt-levels-ir\.ll\.tmp\.O2\.rt\.out'? .*rt-levels-ir\.ll\.tmp\.O2\.rt\.dll'?$" %}
# RUN: %if msil-ll-opt-O3 %{ %{harness_check} contains %t.log "^# executed command: .*msil-verify\.py'? --roundtrip --ildasm .*\.microsoft\.netcore\.ildasm.%{legs_tools_version}.* --ilasm .*\.microsoft\.netcore\.ilasm.%{legs_tools_version}.* '?--output=.*rt-levels-ir\.ll\.tmp\.O3\.rt\.dll'? .*rt-levels-ir\.ll\.tmp\.O3\.dll'?$" "^# executed command: .*msil-run\.py'? --expect-os .* --out .*rt-levels-ir\.ll\.tmp\.O3\.rt\.out'? .*rt-levels-ir\.ll\.tmp\.O3\.rt\.dll'?$" %}
# RUN: %{harness_lit} -a --param msil_pipeline=asm --param msil_opt_levels=O2 %S/Inputs/nested-roundtrip/rt-levels-ir.ll > %t.off.log 2>&1
# RUN: %{harness_check} contains %t.off.log "^PASS: MSIL :: harness/legs/Inputs/nested-roundtrip/rt-levels-ir\.ll " "^# executed command: .*msil-run\.py'? --expect-os .*rt-levels-ir\.ll\.tmp\.O2\.dll'?$"
# RUN: %{harness_check} lacks %t.off.log "--roundtrip" "\.rt\.dll"
