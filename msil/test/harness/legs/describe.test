# RUN: %{harness_check} contains %t/1.log "^legs-check: lit-legs\.ps1: \d+ legs, \d+ lit runs: OK$" "^legs-check: [$]p3Tests: (\S+ )*msil/test/M1/02-fp/strict-i128\.c( |$)" "^legs-check: hosted programs: msil/test/Programs/zlib-full( |$)"
# RUN: %{harness_check} contains %t/describe.json '"name": "programs-hosted",\s*"tag": "Quick"' '"name": "programs-hosted-wsl",\s*"tag": "Quick"' '"name": "ctest-lto",\s*"tag": "Exit"' '"clang/test/Sema/msil-long-double-format\.c",\s*"llvm/test/Transforms/ExpandVariadics/msil-abi\.ll"'
# RUN: %{harness_check} contains %t/describe.json '"name": "portable-smoke",\s*"tag": "Portable"' '"name": "portable-smoke-wsl",\s*"tag": "Portable"' '"clang/test/Preprocessor/init-msil-portable\.c"' '"clang/test/Driver/msil-dotnet\.c"'


