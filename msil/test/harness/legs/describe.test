# RUN: %{harness_check} contains %t/describe.json '"name": "portable-smoke",\s*"tag": "Portable"' '"name": "portable-smoke-wsl",\s*"tag": "Portable"' '"clang/test/Preprocessor/init-msil-portable\.c"' '"clang/test/Driver/msil-dotnet\.c"'


