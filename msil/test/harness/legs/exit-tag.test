# RUN: not %python %S/Inputs/legs-check.py rows ps1 %t/describe.json %t/rows-exit --exit --plant hosted=Exit > %t/3c.log
# RUN: %{harness_check} contains %t/3c.log "^legs-check: error: the run's legs \[(?![^]]*'hosted')[^]]*\], not \[[^]]*'hosted'[^]]*\]$"
# RUN: not %python %S/Inputs/legs-check.py rows ps1 %t/describe.json %t/rows-wsl --wsl --plant ctest-wsl=Exit > %t/3d.log
# RUN: %{harness_check} contains %t/3d.log "^legs-check: error: the run's legs \[[^]]*'ctest-wsl'[^]]*\], not \[(?![^]]*'ctest-wsl')[^]]*\]$"
# RUN: %python %S/Inputs/legs-check.py rows ps1 %t/describe.json %t/rows-wsl-exit --wsl --exit --plant ctest-wsl=Exit
