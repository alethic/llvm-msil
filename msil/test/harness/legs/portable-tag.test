# RUN: %python %S/Inputs/legs-check.py tags ps1 %t/list.txt %t/describe.json > %t/1.log
# RUN: %{harness_check} contains %t/1.log "^legs-check: \d+ legs, the list's tags are the JSON's \(.*Portable 2, .*\); Exit legs: " "^legs-check: Portable legs: portable-smoke, portable-smoke-wsl$"
