# msil/utils/build/build-builtins.py (plan 5.14.3 A2, M25), the build of the
# helper archives clang_rt.builtins, run black-box:
# (1) its offline self-test (stand-in clang and llvm-ar in a temporary
#     directory) exits 0 with its final line and reports its checks of
#     --list, the archive layout and its determinism, the stamps, --check, a
#     failed compile, the native oracle's source list and the repository's
#     sources.txt;
# (2) --list --all prints one '<triple> <member> <source>' line per member
#     (a member name ending in .c.o, a '/'-separated repository-relative
#     source)
#     for the six --all triples and no other, and plain --list for the two
#     default triples only; every triple has the f16 conversion
#     extendhfsf2.c (A4). No triple lists compiler-rt's atomic.c, a source
#     whose functions pass __int128 (A5's '*ti*': a basename with ti<digit>,
#     ti[sdxt]f or [sdxt]fti, which is exactly compiler-rt's TI sources; the
#     Linux triples' int_util.c has 'ti' in its name and is none of them) or
#     a hosted source (A5: emutls.c, enable_execute_stack.c, eprintf.c,
#     clear_cache.c, trampoline_setup.c, os_version_check.c,
#     apple_versioning.c); msil/lib/builtins/msil_longdouble.c has members on
#     exactly the triples for which msil-ld's hasWideNativeLongDouble holds
#     (A4: the three Linux triples and x86_64-w64-windows-gnu-msil), never on
#     the two windows-msvc triples. The failure paths: every pattern that a
#     list must lack finds its line in a list that has them, written in the
#     list's format (a backslash path or a line without a source breaks the
#     format check, which keeps the '/'-anchored patterns from passing on a
#     list that they cannot read), and that list lacks the four wide
#     triples' msil_longdouble.c lines;
# (3) --check against an empty --out exits 1, names both default triples'
#     archives as missing, says how to build them and writes nothing. It
#     takes this build's directory, the one above %clang's bin/, through
#     Inputs/rtlib/build-dir-of.py (--check hashes that build's clang and
#     llvm-ar into the stamps it compares, so it needs the real build
#     directory);
# (4) a usage error exits 2 with a 'build-builtins.py: error:' line and
#     lists, runs and writes nothing: --jobs 0, --check with --list, --out
#     with --list, a triple that is not an MSIL triple, --self-test with
#     another option, an unknown option and a --build-dir without bin/clang.

# DEFINE: %{bb} = "%python" "%S/../../utils/build/build-builtins.py"
# DEFINE: %{bb_format} = "^(?!\S+-msil [^/\x5c ]+\.c\.o [^\x5c ]+/[^/\x5c ]+\.c$).+$"
# DEFINE: %{bb_triples} = "^(?!(x86_64-pc-windows-msvc|aarch64-pc-windows-msvc|x86_64-unknown-linux-gnu|x86_64-unknown-linux-musl|aarch64-unknown-linux-gnu|x86_64-w64-windows-gnu)-msil ).+$"
# DEFINE: %{bb_default} = "^(?!(x86_64-pc-windows-msvc|x86_64-unknown-linux-gnu)-msil ).+$"
# DEFINE: %{bb_atomic} = "/atomic\.c$"
# DEFINE: %{bb_ti} = "/[^/ ]*ti[0-9][^/ ]*\.c$" "/[^/ ]*ti[sdxt]f[^/ ]*\.c$" "/[^/ ]*[sdxt]fti[^/ ]*\.c$"
# DEFINE: %{bb_hosted} = "/emutls\.c$" "/enable_execute_stack\.c$" "/eprintf\.c$" "/clear_cache\.c$" "/trampoline_setup\.c$" "/os_version_check\.c$" "/apple_versioning\.c$"
# DEFINE: %{bb_ld_msvc} = "^\S+-windows-msvc-msil \S+ \S*msil_longdouble\.c$"
# DEFINE: %{bb_ld_other} = "^(?!(x86_64-unknown-linux-gnu|x86_64-unknown-linux-musl|aarch64-unknown-linux-gnu|x86_64-w64-windows-gnu)-msil )\S+ \S+ \S*msil_longdouble\.c$"
# DEFINE: %{bb_ld_wide} = "^x86_64-unknown-linux-gnu-msil \S+ msil/lib/builtins/msil_longdouble\.c$" "^x86_64-unknown-linux-musl-msil \S+ msil/lib/builtins/msil_longdouble\.c$" "^aarch64-unknown-linux-gnu-msil \S+ msil/lib/builtins/msil_longdouble\.c$" "^x86_64-w64-windows-gnu-msil \S+ msil/lib/builtins/msil_longdouble\.c$"

