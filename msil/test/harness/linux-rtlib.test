# RUN: %{harness_check} write %t/glibc/usr/lib/x86_64-linux-gnu/libc_nonshared.a
# RUN: %{harness_check} write %t/glibc/usr/lib/x86_64-linux-gnu/libc.so
# The stand-in archive: one native member (compiled as the builtins are,
# freestanding and -fPIC), in %t/rt and, under its auto name, in %t/e7rt.
# RUN: %{rt_cc} --as cc --target=x86_64-unknown-linux-gnu -std=gnu17 -ffreestanding -Werror=return-type -I%S/../Inputs -fPIC -O2 -c %t/rt.c -o %t/rt/rt.o
# RUN: %{rt_cc} --as ar rcs %{rt_file} %t/rt/rt.o
# RUN: cat %{rt_file} > %t/e7rt/usr/lib/x86_64-linux-gnu/libclang_rt.builtins-x86_64.a

