# RUN: %{harness_check} write %t/e7rt/usr/lib/x86_64-linux-gnu/libc.so.6
# RUN: %{harness_check} write %t/e7rt/usr/lib/x86_64-linux-gnu/libgcc_s.so.1
# RUN: %{harness_check} write %t/glibc/usr/include/stdio.h
# RUN: %{harness_check} write %t/glibc/usr/lib/x86_64-linux-gnu/crt1.o
