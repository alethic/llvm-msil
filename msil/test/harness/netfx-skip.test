# RUN: %{harness_check} equals %t.1a.log "msil-run: netfx run skipped: the attribute that the Framework lacks"
# RUN: %{harness_check} missing %t.d/skip.out
# RUN: not %msil_exec --netfx --expect %t.d/wrong --out %t.d/run.out %t.d/exit-42.exe > %t.1b.log 2>&1
# RUN: %{harness_check} contains %t.1b.log "does not match \S*wrong\.expected"
# RUN: %{harness_check} equals %t.d/run.out "[exit 42]"
# RUN: %msil_exec --netfx --expect %S/Inputs/exit-42 %t.d/exit-42.exe
# RUN: %{harness_check} exits 2 %msil_exec --skip-netfx 'a reason' --expect %S/Inputs/exit-42 %t.d/exit-42.exe > %t.1c.log 2>&1
# RUN: %{harness_check} contains %t.1c.log "error: --skip-netfx needs --netfx$"
# RUN: %{harness_check} exits 2 %msil_exec --netfx --skip-netfx '' --expect %S/Inputs/exit-42 %t.d/exit-42.exe > %t.1d.log 2>&1
# RUN: %{harness_check} contains %t.1d.log "error: --skip-netfx needs a reason$"
# RUN: %{harness_check} lacks %t.1c.log "skipped"
# RUN: %{harness_check} lacks %t.1d.log "skipped"

