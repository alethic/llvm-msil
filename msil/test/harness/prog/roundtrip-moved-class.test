#--- marker.il
// The .assembly directive after the classes: ilasm writes the TypeDefs in
// source order (marker, then Marker), and the reassembly of ildasm's listing,
// whose .assembly block comes first, defines Marker at the .custom.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.module marker.dll
.class public abstract auto ansi sealed marker extends [mscorlib]System.Object
{
  .method public static int32 answer() cil managed
  {
    .maxstack 1
    ldc.i4.s 42
    ret
  }
}
.class private auto ansi sealed beforefieldinit Marker extends [mscorlib]System.Attribute
{
  .method public hidebysig specialname rtspecialname instance void .ctor(uint8[] A_0) cil managed
  {
    .maxstack 1
    ldarg.0
    call instance void [mscorlib]System.Attribute::.ctor()
    ret
  }
}
.assembly marker
{
  .custom instance void Marker::.ctor(uint8[]) = ( 01 00 02 00 00 00 41 42 00 00 )
  .ver 0:0:0:0
}
