# RUN: %{harness_check} exits 1 %{msil_det} > %t/3.log 2>&1
# RUN: %{harness_check} contains %t/3.log "^msil-prog: --det: prog\.exe differs between a and b " "^msil-prog: error: --det: builds a and b differ"
# RUN: %{harness_check} lacks %t/3.log "\.o differs" "\.a differs" "inputs differs"

# (4)
