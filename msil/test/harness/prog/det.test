# RUN: %{harness_check} contains %t/2.log "^msil-prog: --det: obj/plant-obj\.o differs between a and b \(\d+ and \d+ bytes, first difference at offset \d+\)$" "^msil-prog: error: --det: builds a and b differ \(see above\)$"
# RUN: %{harness_check} lacks %t/2.log "main\.o differs" "prog\.exe differs" "identical"

# (3)
