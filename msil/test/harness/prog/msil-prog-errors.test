# RUN: %{harness_check} contains %t/2g.log "^msil-prog: error: --llc takes -O0 to -O3, not --level Os$"
# RUN: %{harness_check} exits 2 %msil_prog_build --mode native --equiv-out %t/x.exe --level O2 --workdir %t/w --src %t/main.c > %t/2h.log 2>&1
