# RUN: %{harness_check} contains %t/2b.log "^msil-prog: error: --equiv-out is a second msil-ld image; it needs --link-output pe$"
# RUN: %{harness_check} exits 2 %msil_prog_build --equiv-skip %t/allowed.txt --level O2 --workdir %t/w --src %t/main.c > %t/2c.log 2>&1
# RUN: %{harness_check} contains %t/2c.log "^msil-prog: error: --equiv-skip and --test go together$"
# RUN: %{harness_check} exits 2 %msil_prog_build --test %s --level O2 --workdir %t/w --src %t/main.c > %t/2d.log 2>&1
# RUN: %{harness_check} contains %t/2d.log "^msil-prog: error: --equiv-skip and --test go together$"
# RUN: %{harness_check} exits 2 %msil_prog_build --equiv-skip %t/bad-allowed.txt --test %s --level O2 --workdir %t/w --src %t/main.c > %t/2e.log 2>&1
# RUN: %{harness_check} contains %t/2e.log "^msil-prog: error: --equiv-skip: \S*bad-allowed\.txt:1: expected 'skip <oracle>\[@<triple>\]\[:<level>\] <test path> <reason>' with the oracle O3, O4 or O6$"
# RUN: %{harness_check} exits 2 %msil_prog_build --equiv-skip %t/bad-qualified.txt --test %s --level O2 --workdir %t/w --src %t/main.c > %t/2e2.log 2>&1
# RUN: %{harness_check} contains %t/2e2.log "^msil-prog: error: --equiv-skip: \S*bad-qualified\.txt:1: the triple x86_64-pc-windows-msvc of the skip line is not an MSIL triple \(it does not end in -msil\)$"
# RUN: %{harness_check} exits 2 %msil_prog_build --pipeline lto --llc=%t/main.c --level O2 --workdir %t/w --src %t/main.c > %t/2f.log 2>&1
# RUN: %{harness_check} contains %t/2f.log "^msil-prog: error: --llc compiles IR sources to CIL objects; it needs --pipeline obj$"
