#--- main.c
// prog-value: 1
#--- ir.ll
; prog-value: 2
#--- allowed.txt
skip O3 msil/test/harness/prog/msil-prog-errors.test never used
#--- bad-allowed.txt
skip O5 msil/test/harness/prog/msil-prog-errors.test not an oracle
#--- bad-qualified.txt
skip O3@x86_64-pc-windows-msvc:O2 msil/test/harness/prog/msil-prog-errors.test a native triple
