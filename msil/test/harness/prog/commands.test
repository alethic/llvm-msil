#--- allow-o3.txt
# A skip line for this test's O3 comparison.
skip O3 msil/test/harness/prog/commands.test the reason of the O3 line
#--- allow-dir.txt
skip O3 msil/test/harness/ every harness test
#--- allow-o4.txt
assembly-hash --assembly-hash=ignore # an entry beside the skip line
skip O4 msil/test/harness/prog/commands.test the reason of the O4 line
#--- allow-other.txt
skip O3 msil/test/harness/prog/other.test another test
skip O3 msil/test/harness/pro/ a directory that only starts like this one
#--- ir.ll
; prog-value: 32
define i32 @f() {
  ret i32 32
}
#--- main.c
// prog-value: 1
#--- util.c
// prog-value: 2
#--- stock.c
// prog-value: 4
#--- a1.c
// prog-value: 8
#--- a2.c
// prog-value: 16
