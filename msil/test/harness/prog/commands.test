# RUN: %{harness_check} contains %t/n.log "^msil-prog: .* --as cc .*--target=x86_64-unknown-linux-gnu -std=gnu17 \S.* -O2 -c \.\./main\.c -o obj/main\.o$" "^msil-prog: .* --as cc .*--target=x86_64-unknown-linux-gnu -std=gnu17 \S.* -O2 -c \.\./stock\.c -o stock/stock\.o$" "^msil-prog: .* --as cc .*--target=x86_64-unknown-linux-gnu -std=gnu17 \S.* -O2 -c \.\./a2\.c -o ar/one/a2\.o$" "^msil-prog: .* --as ar rcs ar/one/libone\.a ar/one/a1\.o ar/one/a2\.o$"
# RUN: %{harness_check} contains %t/n.log "^msil-prog: .* --as cc .*--target=x86_64-unknown-linux-gnu -fuse-ld=lld obj/main\.o obj/util\.o stock/stock\.o -Lar/one -lone -Wl,--stand-in-native -lm -o \S+prog\.exe$"
# RUN: %{harness_check} lacks %t/n.log "-flto" "-fno-ms-volatile" "stand-in-extra" "nodefaultlibs" "--sysroot" "lto-emit-asm" "--ld-path" "ilasm\.exe\"? -nologo"
# RUN: %{harness_check} contains %t/n/prog.exe.inputs "\Aobject obj/main\.o main\.c 1\nobject obj/util\.o util\.c 2\nobject stock/stock\.o stock\.c 4\nmember ar/one/libone\.a a1\.o 8\nmember ar/one/libone\.a a2\.o 16\narg -Wl,--stand-in-native\narg -lm\n\Z"

