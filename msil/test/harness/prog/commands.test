# RUN: %if msil-triple-windows %{ %{harness_check} contains %t/m.log "^msil-prog: .* --as cc .*--target=x86_64-pc-windows-msvc -std=gnu17 \S.* -O1 -flto -fno-ms-volatile -c \.\./stock\.c -o stock/stock\.o$" "^msil-prog: .* --as cc .*--target=x86_64-pc-windows-msvc -std=gnu17 \S.* -O1 -flto -fno-ms-volatile -c \.\./a2\.c -o ar/one/a2\.o$" %}
# RUN: %if msil-triple-linux %{ %{harness_check} contains %t/m.log "^msil-prog: .* --as cc .*--target=x86_64-unknown-linux-gnu -std=gnu17 \S.* -O1 -flto -c \.\./stock\.c -o stock/stock\.o$" "^msil-prog: .* --as cc .*--target=x86_64-unknown-linux-gnu -std=gnu17 \S.* -O1 -flto -c \.\./a2\.c -o ar/one/a2\.o$" %}
# RUN: %{harness_check} contains %t/m.log "^msil-prog: .* --as cc .*--target=\S+-msil -std=gnu17 \S.* -O1 -flto -c \.\./a1\.c -o ar/one/a1\.o$" "^msil-prog: .* --as ar rcs ar/one/libone\.a ar/one/a1\.o ar/one/a2\.o$"
# RUN: %if msil-triple-windows || !msil-linux-sysroot %{ %{harness_check} contains %t/m.log "^msil-prog: .* --as cc .*--target=\S+-msil --ld-path=\S+ -O1 obj/main\.o obj/util\.o stock/stock\.o -Lar/one -lone -Wl,--stand-in-extra -Wl,--another -Wl,--stand-in-native -Wl,--lto-emit-asm -o prog\.il$" %}
# RUN: %if msil-triple-linux && msil-linux-sysroot %{ %{harness_check} contains %t/m.log "^msil-prog: .* --as cc .*--target=\S+-msil --ld-path=\S+ -O1 --sysroot=\S+ obj/main\.o obj/util\.o stock/stock\.o -Lar/one -lone -Wl,--stand-in-extra -Wl,--another -Wl,--stand-in-native -Wl,--lto-emit-asm -o prog\.il$" %}
