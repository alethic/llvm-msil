# RUN: %{harness_check} contains %t/m.log "^msil-prog: .*msil-run\.py\"? --tool .* -nologo -quiet( -pe64 -x64)? -exe -output=\S+prog\.exe \S+prog\.il$"
# RUN: %{harness_check} lacks %t/m.log "fuse-ld" "-fdebug-compilation-dir" "msil-prog: error" "nodefaultlibs"
# RUN: %{harness_check} contains %t/m/prog.il.inputs "^arg -Wl,--another\narg -Wl,--stand-in-native\nld-path "
# RUN: %{harness_check} contains %t/also.il "^\.assembly 'prog' " "ldc\.i4 31$"

