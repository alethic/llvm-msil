# RUN: %{harness_check} contains %t/1a.log "^O6 skipped: the reason of the O6 line$"
# RUN: %{harness_check} lacks %t/1a.log "^O6: " "^msil-verify: O6: " "disallowed"
# RUN: %msil_verify --equiv-skip %t/o6-dir.txt --test %s --md-baseline %t/a.exe %t/b.exe > %t/1b.log 2>&1
# RUN: %{harness_check} contains %t/1b.log "^O6 skipped: every test of harness/prog$"

# (2)
