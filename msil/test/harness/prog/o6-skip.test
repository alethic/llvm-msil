# RUN: %if msil-cil-dump && msil-ld && msil-ar %{ %{harness_check} lacks %t/7a.log "skipped" "--allow scopes" %}
# RUN: %if msil-cil-dump && msil-ld && msil-ar %{ %{harness_lit} -a --param msil_runner=local --param msil_linux_sysroot= --param msil_pipeline=obj --param msil_equiv=1 --param msil_references=%t %S/Inputs/nested/refs/o6-c.c > %t/7b.log 2>&1 %}
# RUN: %if msil-cil-dump && msil-ld && msil-ar %{ %{harness_check} contains %t/7b.log "^PASS: MSIL :: harness/prog/Inputs/nested/refs/o6-c\.c " "^# executed command: .*msil-equiv\.py'? .* --oracle O3 .* --allow pinvoke-module --allow pinvoke-access --allow scopes '?\S*o6-c\.c\.tmp\.O2\.d/equiv/prog\.exe'? " "^# \| msil-equiv: O3: \S+ and \S+ are equal \(\d+ lines; allowed: assembly-hash, ilasm-params, ilasm-initlocals, snan-quiet, pinvoke-module, pinvoke-access, scopes\)$" %}

#--- o6-this.txt
# A skip line for this test's O6 oracle.
skip O6 msil/test/harness/prog/o6-skip.test the reason of the O6 line
#--- o6-dir.txt
skip O6 msil/test/harness/prog/ every test of harness/prog
#--- o6-other.txt
skip O6 msil/test/harness/prog/other.test another test
skip O6 msil/test/harness/pro/ a directory that only starts like this one
#--- o3-this.txt
skip O3 msil/test/harness/prog/o6-skip.test an O3 line for this test
skip O4 msil/test/harness/prog/o6-skip.test an O4 line for this test
#--- bad-oracle.txt
skip O7 msil/test/harness/prog/o6-skip.test no such oracle
#--- main.c
