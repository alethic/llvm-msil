# RUN: %{harness_check} exits 1 %msil_verify --equiv-skip %t/o3-this.txt --test %s --md-baseline %t/a.exe %t/b.exe > %t/2b.log 2>&1
# RUN: %{harness_check} exits 1 %msil_verify --equiv-skip %t/o6-qualified.txt --test %s --triple %msil_triple --level O0 --md-baseline %t/a.exe %t/b.exe > %t/2c.log 2>&1
# RUN: %{harness_check} exits 1 %msil_verify --equiv-skip %t/o6-qualified.txt --test %s --triple other-%msil_triple --level O2 --md-baseline %t/a.exe %t/b.exe > %t/2d.log 2>&1
# RUN: %{harness_check} exits 1 %msil_verify --md-baseline %t/a.exe %t/b.exe > %t/2e.log 2>&1
# RUN: %{harness_check} contains %t/2a.log "^O6: peverify /md: \[MD\]\(0x80131B17\): .* \[Field 'D'::'w'\] \(not reported for the baseline a\.exe\)$"
# RUN: %{harness_check} contains %t/2b.log "^O6: peverify /md: \[MD\]\(0x80131B17\): .* \[Field 'D'::'w'\]"
# RUN: %{harness_check} contains %t/2c.log "^O6: peverify /md: \[MD\]\(0x80131B17\): .* \[Field 'D'::'w'\]"
# RUN: %{harness_check} contains %t/2d.log "^O6: peverify /md: \[MD\]\(0x80131B17\): .* \[Field 'D'::'w'\]"
# RUN: %{harness_check} contains %t/2e.log "^O6: peverify /md: \[MD\]\(0x80131B17\): .* \[Field 'D'::'w'\]"
# RUN: %{harness_check} lacks %t/2a.log "skipped"
# RUN: %{harness_check} lacks %t/2b.log "skipped"
# RUN: %{harness_check} lacks %t/2c.log "skipped"
