# RUN: %msil_prog_build --level O2 --workdir %t/p --out %t/p/prog.exe --equiv-out %t/p-equiv.exe --equiv-skip %t/o6-this.txt --test %s --src %t/main.c --pipeline obj > %t/6.log 2>&1
# RUN: %{harness_check} contains %t/6.log " -Wl,--no-gc-sections -o equiv/prog\.exe$"
