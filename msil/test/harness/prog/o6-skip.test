# RUN: %{harness_check} contains %t/4b.log "^O6 skipped: extern_weak: msil-ld's image has the zero fields '<msil>fn_maybe' and weak_data "
# RUN: %{harness_check} exits 1 %msil_verify --equiv-skip %S/../../../utils/equiv-allowed.txt --test %S/../../M1/11-programs/crc32.c --triple x86_64-pc-windows-msvc-msil --level O2 --md-baseline %t/a.exe %t/b.exe > %t/4c.log 2>&1
# RUN: %{harness_check} contains %t/4c.log "^O6: peverify /md: "
# RUN: %{harness_check} lacks %t/4c.log "skipped"

# (5)
# RUN: %{harness_check} exits 2 %msil_verify --equiv-skip %t/o6-this.txt --test %s %t/b.exe > %t/5a.log 2>&1
# RUN: %{harness_check} contains %t/5a.log "error: --equiv-skip selects the 'skip O6' lines; it needs --md-baseline$"
# RUN: %{harness_check} exits 2 %msil_verify --equiv-skip %t/o6-this.txt --md-baseline %t/a.exe %t/b.exe > %t/5b.log 2>&1
# RUN: %{harness_check} contains %t/5b.log "error: --equiv-skip and --test go together$"
# RUN: %{harness_check} exits 2 %msil_verify --equiv-skip %t/bad-oracle.txt --test %s --md-baseline %t/a.exe %t/b.exe > %t/5c.log 2>&1
# RUN: %{harness_check} contains %t/5c.log "^msil-verify: error: --equiv-skip: \S*bad-oracle\.txt:1: expected 'skip <oracle>"

