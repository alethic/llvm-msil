# RUN: %{harness_check} contains %t.ll-lto.log "^PASS: MSIL :: harness/prog/Inputs/nested/one-ir\.ll " "^# executed command: .*pipeline-cc\.py'? --as llc-msil -mtriple=\S+-msil -O2 \S*one-ir\.ll'? -o \S*one-ir\.ll\.tmp\.O2\.il'?$" "^# executed command: .*msil-run\.py'? --tool .* -nologo -quiet( -pe64 -x64)? -dll '?-output=\S*one-ir\.ll\.tmp\.O2\.dll'? \S*one-ir\.ll\.tmp\.O2\.il'?$" "^# executed command: .*msil-run\.py'? --expect-os .* --expect \S*one-ir'? --out \S*one-ir\.ll\.tmp\.O2\.out'? \S*one-ir\.ll\.tmp\.O2\.dll'?$"
