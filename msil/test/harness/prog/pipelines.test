# RUN: %{harness_check} contains %t.lto.log "^PASS: MSIL :: harness/prog/Inputs/nested/one-source\.c " "^PASS: MSIL :: harness/prog/Inputs/nested/features\.test "
# RUN: %{harness_check} contains %t.lto.log "^# executed command: .*msil-prog\.py'? .* --pipeline lto --link-output pe .* --level O2 --workdir '?\S*one-source\.c\.tmp\.O2\.d'? --out '?\S*one-source\.c\.tmp\.O2\.d/prog\.exe'? --src '?\S*one-source\.c'?$" "^# \| msil-prog: .*prog-cc\.py --as cc .*--target=\S+-msil -std=gnu17 .* -O2 -flto -c \S*one-source\.c -o obj/one-source\.o$" "^# \| msil-prog: .* -O2 obj/one-source\.o -o prog\.exe$"
# RUN: %{harness_check} contains %t.lto.log "^# \| feature msil-pipeline=lto$" "^# \| feature msil-prog-pipeline=lto$" "^# \| feature msil-link-output=pe$"
# RUN: %{harness_check} lacks %t.lto.log "--as clang-msil" " -dll " " -exe -output=" "--lto-emit-asm" "^# \| feature msil-pipeline=(asm|obj)$" "nodefaultlibs" "--dep " "--equiv-out" "--also-il"

# (4)
# RUN: %{harness_lit} -a --param msil_runner=local --param msil_linux_sysroot= --param msil_pipeline=lto --param msil_link_output=il %S/Inputs/nested/one-source.c %S/Inputs/nested/features.test > %t.lto-il.log 2>&1
# RUN: %{harness_check} contains %t.lto-il.log "^PASS: MSIL :: harness/prog/Inputs/nested/one-source\.c " "^PASS: MSIL :: harness/prog/Inputs/nested/features\.test "
# RUN: %{harness_check} contains %t.lto-il.log "^# executed command: .*msil-prog\.py'? .* --pipeline lto --link-output il .* --level O2 --workdir '?\S*one-source\.c\.tmp\.O2\.d'? --out '?\S*one-source\.c\.tmp\.O2\.d/prog\.exe'? --src '?\S*one-source\.c'?$" "^# \| msil-prog: .* -O2 -flto -c \S*one-source\.c -o obj/one-source\.o$" "^# \| msil-prog: .* -O2 obj/one-source\.o -Wl,--lto-emit-asm -o prog\.il$" "^# \| msil-prog: .* -exe -output=\S+prog\.exe \S+prog\.il$"
# RUN: %{harness_check} contains %t.lto-il.log "^# \| feature msil-pipeline=lto$" "^# \| feature msil-prog-pipeline=lto$" "^# \| feature msil-link-output=il$"
# RUN: %{harness_check} lacks %t.lto-il.log "^# \| feature msil-link-output=pe$" "nodefaultlibs" "--dep "

