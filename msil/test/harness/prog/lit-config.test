# The configuration errors of the Phase 2 lit parameters (plan 5.12.1,
# 5.12.2): lit.cfg.py rejects a value that cannot work instead of quietly
# running another pipeline, so a nested lit stops with lit's fatal-error
# status 2 and names the parameter for each of
# (1) msil_pipeline=obj and (2) msil_link_output=pe, which need CIL objects
#     and msil-ld's PE writer (M20);
# (3) an unknown msil_pipeline and (4) an unknown msil_link_output;
# (5) msil_require_link=1 with msil-ld disabled, and (6) with llvm-ar
#     disabled (an empty --param is an explicit 'none');
# (7) msil_pipeline=lto with msil-ld disabled: every %{msil_c} links;
# (8) an msil_ld that names no program.
# The control loads the configuration with msil_require_link=1 and
# msil_pipeline=lto. --show-tests ends every nested lit after discovery, so
# no test of Inputs/nested runs, and an empty msil_linux_sysroot keeps the
# nested configuration from compiling the E7 start.o.
# REQUIRES: msil-ld, msil-ar

# RUN: %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_require_link=1 --param msil_pipeline=lto %S/Inputs/nested > %t.ok.log 2>&1
# RUN: %{harness_check} contains %t.ok.log "^\s*MSIL :: harness/prog/Inputs/nested/features\.test$" "note: msil: pipeline lto \(%\{msil_prog\}: lto, link output il\)$"
# RUN: %{harness_check} lacks %t.ok.log "fatal:"

# (1), (2)
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_pipeline=obj %S/Inputs/nested > %t.1.log 2>&1
# RUN: %{harness_check} contains %t.1.log "fatal: msil: --param msil_pipeline=obj needs CIL objects and msil-ld's PE writer \(plan M20\); use asm or lto$"
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_link_output=pe %S/Inputs/nested > %t.2.log 2>&1
# RUN: %{harness_check} contains %t.2.log "fatal: msil: --param msil_link_output=pe needs msil-ld's PE writer \(plan M20\); use il$"

# (3), (4)
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_pipeline=bogus %S/Inputs/nested > %t.3.log 2>&1
# RUN: %{harness_check} contains %t.3.log "fatal: msil: --param msil_pipeline=bogus: use asm or lto$"
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_link_output=bogus %S/Inputs/nested > %t.4.log 2>&1
# RUN: %{harness_check} contains %t.4.log "fatal: msil: --param msil_link_output=bogus: use il$"

# (5), (6)
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_require_link=1 --param msil_ld= %S/Inputs/nested > %t.5.log 2>&1
# RUN: %{harness_check} contains %t.5.log "fatal: msil: msil_require_link=1, but these are missing: msil-ld \(--param msil_ld=PATH; build the lld target\)$"
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_require_link=1 --param msil_ar= %S/Inputs/nested > %t.6.log 2>&1
# RUN: %{harness_check} contains %t.6.log "fatal: msil: msil_require_link=1, but these are missing: llvm-ar \(--param msil_ar=PATH; build the llvm-ar target\)$"

# (7)
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_pipeline=lto --param msil_ld= %S/Inputs/nested > %t.7.log 2>&1
# RUN: %{harness_check} contains %t.7.log "fatal: msil: --param msil_pipeline=lto links every C test through msil-ld, but these are missing: msil-ld \(--param msil_ld=PATH; build the lld target\)$"

# (8)
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_ld=%t.no-such-msil-ld %S/Inputs/nested > %t.8.log 2>&1
# RUN: %{harness_check} contains %t.8.log "fatal: msil: msil_ld=\S*no-such-msil-ld: no such program$"
