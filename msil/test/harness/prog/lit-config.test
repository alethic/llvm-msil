# The configuration errors of the Phase 2 lit parameters (plan 5.12.1,
# 5.12.2): lit.cfg.py rejects a value that cannot work instead of quietly
# running another pipeline, so a nested lit stops with lit's fatal-error
# status 2 and names the parameter for each of
# (1) msil_link_output=il under asm and under obj, where %{msil_prog} links
#     CIL objects, whose image msil-ld writes itself (M20; M14's errors for
#     msil_pipeline=obj and msil_link_output=pe are gone: both work from
#     M20, as the control shows);
# (2) msil_equiv=1 under asm, and under lto with msil_link_output=il, where
#     there is no msil-ld image to compare (M20);
# (3) an unknown msil_pipeline and (4) an unknown msil_link_output;
# (5) msil_require_link=1 with msil-ld disabled, and (6) with llvm-ar
#     disabled (an empty --param is an explicit 'none');
# (7) msil_pipeline=lto and obj with msil-ld disabled: every %{msil_c} links;
# (8) an msil_ld that names no program;
# (9) an explicit msil_glibc_sysroot without usr/include/stdio.h (M15), so
#     the hosted leg, which names its sysroot, never passes by skipping.
#     With the header the nested configuration has the feature
#     msil-glibc-sysroot and %{msil_glibc_sysroot} names the directory (a
#     nested run of Inputs/nested/features.test echoes both), and an empty
#     value turns the feature off;
# (10) msil_equiv=1 with neither llvm-cil-dump nor mdcanon (the listers of
#     %msil_canon, which O3 and O4 compare; M20).
# The controls load the configuration with msil_require_link=1 under each
# pipeline: asm, obj with msil_equiv=1 and msil_scale_tests=1 (Inputs/nested/
# features.test echoes the features msil-equiv and msil-scale-tests), lto
# (link output pe) with msil_equiv=1, and lto with link output il.
# --show-tests ends every nested lit after discovery, so no test of
# Inputs/nested runs, and an empty msil_linux_sysroot keeps the nested
# configuration from compiling the E7 start.o.
# REQUIRES: msil-ld, msil-ar

# RUN: %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_require_link=1 --param msil_pipeline=asm %S/Inputs/nested > %t.ok-asm.log 2>&1
# RUN: %{harness_check} contains %t.ok-asm.log "^\s*MSIL :: harness/prog/Inputs/nested/features\.test$" "note: msil: pipeline asm \(%\{msil_prog\}: obj, link output pe\)$"
# RUN: %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_require_link=1 --param msil_pipeline=obj --param msil_equiv=1 --param msil_scale_tests=1 %S/Inputs/nested > %t.ok-obj.log 2>&1
# RUN: %{harness_check} contains %t.ok-obj.log "note: msil: pipeline obj \(%\{msil_prog\}: obj, link output pe, equivalence oracles O3, O6\)$"
# RUN: %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_require_link=1 --param msil_pipeline=lto --param msil_equiv=1 %S/Inputs/nested > %t.ok-lto.log 2>&1
# RUN: %{harness_check} contains %t.ok-lto.log "note: msil: pipeline lto \(%\{msil_prog\}: lto, link output pe, equivalence oracles O4\)$"
# RUN: %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_require_link=1 --param msil_pipeline=lto --param msil_link_output=il %S/Inputs/nested > %t.ok-il.log 2>&1
# RUN: %{harness_check} contains %t.ok-il.log "note: msil: pipeline lto \(%\{msil_prog\}: lto, link output il\)$"
# RUN: %{harness_check} lacks %t.ok-asm.log "fatal:"
# RUN: %{harness_check} lacks %t.ok-obj.log "fatal:"
# RUN: %{harness_check} lacks %t.ok-lto.log "fatal:"
# RUN: %{harness_check} lacks %t.ok-il.log "fatal:"
# RUN: %{harness_lit} -a --param msil_runner=local --param msil_linux_sysroot= --param msil_pipeline=obj --param msil_equiv=1 --param msil_scale_tests=1 %S/Inputs/nested/features.test > %t.ok-features.log 2>&1
# RUN: %{harness_check} contains %t.ok-features.log "^PASS: MSIL :: harness/prog/Inputs/nested/features\.test " "^# \| feature msil-equiv$" "^# \| feature msil-scale-tests$" "^# \| feature msil-pipeline=obj$"
# RUN: %{harness_check} lacks %t.ok-asm.log "feature msil-equiv" "feature msil-scale-tests"

# (1)
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_pipeline=asm --param msil_link_output=il %S/Inputs/nested > %t.1a.log 2>&1
# RUN: %{harness_check} contains %t.1a.log "fatal: msil: --param msil_link_output=il: under msil_pipeline=asm %\{msil_prog\} links CIL objects, whose image msil-ld writes itself \(plan 5\.12\.1\); use pe, or msil_pipeline=lto$"
# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_pipeline=obj --param msil_link_output=il %S/Inputs/nested > %t.1b.log 2>&1
