# RUN: %{harness_check} exits 2 %{harness_lit} --show-tests --param msil_linux_sysroot= --param msil_pipeline=lto --param msil_link_output=il --param msil_equiv=1 %S/Inputs/nested > %t.2b.log 2>&1
# RUN: %{harness_check} contains %t.2b.log "fatal: msil: --param msil_equiv=1 compares .* not msil_pipeline=lto with msil_link_output=il$"

