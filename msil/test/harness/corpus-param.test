# RUN: %{harness_check} contains %t.4r.log "fatal: msil: msil_require_corpus=1, but the stamp of \S*nocm lacks coremark; run 'python msil/utils/corpus/fetch\.py --cache \S*nocm' \(or name the entries in --param msil_corpus_skip\)$"
# RUN: %{harness_lit} -a --param msil_linux_sysroot= --param msil_corpus_dir=%t.nocm --param msil_require_corpus=1 --param msil_corpus_skip=coremark %S/Inputs/nested-corpus > %t.4.log 2>&1
# RUN: %{harness_check} contains %t.4.log "note: msil: exit corpus entry coremark is left out on purpose \(msil_corpus_skip\); its tests are UNSUPPORTED$" "^UNSUPPORTED: MSIL :: harness/Inputs/nested-corpus/needs-coremark\.test " "^# \| feature msil-corpus$" "^# \| feature msil-corpus-zlib$"
# RUN: %{harness_check} lacks %t.4.log "^# \| feature msil-corpus-coremark$"

