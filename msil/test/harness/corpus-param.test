# RUN: %{harness_check} contains %t.5.log "fatal: msil: --param msil_corpus_skip: nosuch is not in \S+manifest\.json \(entries: zlib, tinf, monocypher, coremark, lz4, blake2, tweetnacl, kissfft, jsmn, c-testsuite\)$"
# RUN: %{harness_lit} -a --param msil_linux_sysroot= --param msil_corpus_dir= %S/Inputs/nested-corpus > %t.5e.log 2>&1
# RUN: %{harness_check} contains %t.5e.log "note: msil: exit corpus not available \(msil/test/Programs is UNSUPPORTED\): disabled by an empty --param msil_corpus_dir=$" "^UNSUPPORTED: MSIL :: harness/Inputs/nested-corpus/needs-coremark\.test "
