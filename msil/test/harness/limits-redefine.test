# RUN: %{harness_check} write %t.ue/t4.c "// REDEFINE: %%{msil_limits} = --timeout abc" "// RUN: %%{msil_c_O0}" "int main(void) { return 44; }"
# RUN: %{harness_check} write %t.ue/t5.c "// REDEFINE: %%{msil_limits} = --bogus 3" "// RUN: %%{msil_c_O0}" "int main(void) { return 44; }"
