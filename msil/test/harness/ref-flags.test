# RUN: %{harness_check} contains %t/2.log "^# \| msil-prog: .*prog-cc\.py --as cc .*--target=\S+-msil --ld-path=\S+ -O2 obj/main\.o obj/util\.o -o prog\.exe$" "^# \| feature msil-ref=none$" "^# \| ref-flags \[\]$" "^# \| ldflags \[\]$"
# RUN: %{harness_check} lacks %t/2.log "^# \| (msil-prog: |arg ).*--reference" "\[-Wl,--reference" "note: msil: references:" "^# \| feature msil-ref=(path|net48|net8|net10)$"

