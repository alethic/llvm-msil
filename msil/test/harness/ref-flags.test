# RUN: %{harness_check} contains %t/3.log "^PASS: MSIL :: harness/prog/Inputs/nested/refs/refs-prog\.test " "^# \| msil-prog: .*prog-cc\.py --as cc .*--target=\S+-msil -std=gnu17 .* -O2 -flto -c \S*main\.c -o obj/main\.o$" "^# \| msil-prog: .*--target=\S+-msil --ld-path=\S+ -O2 -Wl,--reference=\S*pack obj/main\.o obj/util\.o -o prog\.exe$"

