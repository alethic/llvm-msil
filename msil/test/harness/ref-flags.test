# RUN: %{harness_check} contains %t/1.log "^PASS: MSIL :: harness/prog/Inputs/nested/refs/refs-prog\.test " "^PASS: MSIL :: harness/prog/Inputs/nested/refs/refs-c\.c " "^PASS: MSIL :: harness/prog/Inputs/nested/refs/refs-features\.test "
