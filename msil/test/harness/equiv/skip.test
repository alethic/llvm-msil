#--- o3.txt
# This test's O3 comparison is skipped.
skip O3 msil/test/harness/equiv/skip.test the reason of the O3 line
#--- o4.txt
assembly-hash --assembly-hash=ignore # an entry beside the skip line
skip O4 msil/test/harness/equiv/skip.test the reason of the O4 line
#--- dir.txt
skip O3 msil/test/harness/ every test of the harness
#--- other.txt
skip O3 msil/test/harness/equiv/other.test another test
skip O3 msil/test/harness/equi/ a directory that only starts like this one
skip O3 msil/test/harness/equiv/skip.test.old a longer name
#--- qual.txt
skip O3@x86_64-pc-windows-msvc-msil:O2 msil/test/harness/equiv/skip.test Windows at -O2 only
skip O4@x86_64-unknown-linux-gnu-msil msil/test/harness/equiv/skip.test Linux at every level
skip O4:O1 msil/test/harness/equiv/skip.test every triple at -O1
#--- bad-triple.txt
skip O3@x86_64-pc-windows-msvc:O2 msil/test/harness/equiv/skip.test a native triple
#--- bad-level.txt
skip O3@x86_64-pc-windows-msvc-msil:O4 msil/test/harness/equiv/skip.test an oracle where the level goes
#--- bad-oracle.txt
skip O5:O2 msil/test/harness/equiv/skip.test no such oracle
