# The entry ilasm-initlocals of msil/utils/equiv-allowed.txt (plan 5.12.6;
# M20): both ilasms keep an explicit .maxstack below 8 on a small body
# without .locals by writing a fat header with InitLocals set (plan section
# 12, the M16 row of 2026-10-23), while the MC writer never sets InitLocals
# (D13). The pair comes from the object oracle of plan 5.12.6, which needs no
# msil-ld: A is llc -filetype=obj's CIL object of two functions without
# locals (.maxstack 2 and 1), B ilasm's object of the same module's
# object-form text (llc -msil-object-form, ilasm -dll). With every other entry
# allowed, msil-equiv.py fails (status 1) on exactly the two '.maxstack'
# lines, which B prints with ' initlocals'; with ilasm-initlocals allowed
# too, the objects are equal.
# REQUIRES: msil-registered-target, msil-cil-dump

# RUN: rm -rf %t && split-file %s %t && mkdir -p %t/a %t/b
# RUN: %llc_msil -O2 -filetype=obj %t/small.ll -o %t/a/small.o
# RUN: %llc_msil -O2 -msil-object-form %t/small.ll -o %t/b/small.il
# RUN: %ilasm -dll -output=%t/b/small.o %t/b/small.il
# RUN: not %msil_equiv --allow assembly-hash --allow ilasm-params --allow snan-quiet --allow pinvoke-module --allow pinvoke-access --allow scopes %t/a/small.o %t/b/small.o > %t/without.txt
# RUN: FileCheck %s --check-prefix=WITHOUT --input-file=%t/without.txt
# RUN: %msil_equiv --allow assembly-hash --allow ilasm-params --allow snan-quiet --allow pinvoke-module --allow pinvoke-access --allow scopes --allow ilasm-initlocals %t/a/small.o %t/b/small.o > %t/with.txt
# RUN: FileCheck %s --check-prefix=WITH --input-file=%t/with.txt

# WITHOUT:      msil-equiv: O3: {{.*}}small.o and {{.*}}small.o differ (4 differing lines; allowed: assembly-hash, ilasm-params, snan-quiet, pinvoke-module, pinvoke-access, scopes); the first 4:
# WITHOUT-NEXT: --- {{.*}}a{{[/\\]}}small.o
# WITHOUT-NEXT: +++ {{.*}}b{{[/\\]}}small.o
# WITHOUT-NEXT: @@ {{.*}} @@
# WITHOUT-NEXT: -    .maxstack 2
# WITHOUT-NEXT: +    .maxstack 2 initlocals
# WITHOUT-NEXT: @@ {{.*}} @@
# WITHOUT-NEXT: -    .maxstack 1
# WITHOUT-NEXT: +    .maxstack 1 initlocals
# WITHOUT-NOT:  {{.}}

# WITH: msil-equiv: O3: {{.*}}small.o and {{.*}}small.o are equal ({{[0-9]+}} lines; allowed: assembly-hash, ilasm-params, ilasm-initlocals, snan-quiet, pinvoke-module, pinvoke-access, scopes)

#--- small.ll
define i32 @add1(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

define i32 @seven() {
  ret i32 7
}
