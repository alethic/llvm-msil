# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ cat %S/Inputs/exit-range-prog.c > %t.k/Inputs/kept/b.c %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_update_expected} --clang %t.d/fake-native-44.exe --rtlib none %t.k %t.k/Inputs/kept > %t.c3.log %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_check} contains %t.c3.log '\Awrote .+[/\\]a\.expected\nwrote .+[/\\]Inputs[/\\]kept[/\\]b\.expected\n\Z' %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_check} equals %t.k/a.expected "[exit 44]" %}
