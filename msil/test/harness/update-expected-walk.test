# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %ilasm -exe -output=%t.d/fake-native-44.exe %S/Inputs/fake-native-44.il %S/Inputs/fake-native-cc.il %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ cat %S/Inputs/exit-range-prog.c > %t.w/top.c %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_check} write %t.w/sub/prog.c "// No lit RUN line, so only naming it makes this file a test." "int main(void) { return 0; }" %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_update_expected} --clang %t.d/fake-native-44.exe --rtlib none %t.w/sub %t.w %t.w/sub/prog.c > %t.c1.log %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_check} contains %t.c1.log '\Awrote .+[/\\]top\.expected\nwrote .+[/\\]sub[/\\]prog\.expected\n\Z' %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_check} equals %t.w/top.expected "[exit 44]" %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_check} equals %t.w/sub/prog.expected "[exit 44]" %}
# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_check} write %t.w/sub/prog.expected "[exit 45]" %}
