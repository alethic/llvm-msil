# RUN: %if system-windows && msil-triple-windows && msil-netfx %{ %{harness_check} contains %t.c2.log '\AMISMATCH: .+[/\\]sub[/\\]prog\.c\n(?:[-+@].*\n)+ok: .+[/\\]top\.c\n\Z' "^-\[exit 45\]$" "^\+\[exit 44\]$" %}
