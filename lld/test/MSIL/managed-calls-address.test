# RUN: llvm-as deadcast.ll -o deadcast.bc && opt -module-summary deadcast.ll -o deadcast.thin.bc
# RUN: llvm-as ea.ll -o ea.bc && opt -module-summary ea.ll -o ea.thin.bc
# RUN: llvm-as eb.ll -o eb.bc && opt -module-summary eb.ll -o eb.thin.bc

## The pair at -O0: two lines, each once.
# RUN: not msil-ld a-o0.bc b-o0.bc --reference=refs -o x.exe 2> err.txt && \
# RUN:   %{two} --check-prefix=TM10-PAIR -DA=a-o0.bc -DB=b-o0.bc
# RUN: not msil-ld a-o0.thin.bc b-o0.thin.bc --reference=refs -o x.exe 2> err.txt && \
# RUN:   %{two} --check-prefix=TM10-PAIR -DA=a-o0.thin.bc -DB=b-o0.thin.bc
# RUN: not ls x.exe

## The pair as 'static short f(short)', its calls through a cast pointer
## with a zeroext result of their own: T-M17 alone. One unit's call through
## a cast pointer in a function that nothing calls: T-M17 alone.
