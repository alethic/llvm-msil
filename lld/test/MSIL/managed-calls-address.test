# DEFINE:   not msil-ld ac-%{tr}.bc b-%{tr}.bc --reference=refs -o x.exe 2> err.txt && \
# DEFINE:     %{two} --check-prefixes=TM10-MAIN,TM17 -DIN=b-%{tr}.bc && \
# DEFINE:   not msil-ld a-%{tr}.bc bc-%{tr}.bc --reference=refs -o x.exe 2> err.txt && \
# DEFINE:     %{two} --check-prefixes=TM10-PA,TM17 -DIN=a-%{tr}.bc && \
# DEFINE:   not ls x.exe && not ls x.il
## An address beside a call with an extension of its own: T-M17 alone.
# DEFINE: %{ext} = \
# DEFINE:   not msil-ld extaddr-%{tr}.bc --reference=refs -o x.exe 2> err.txt && \
# DEFINE:     %{one} --check-prefix=TM17 && \
# DEFINE:   not msil-ld extaddr-%{tr}.thin.bc --reference=refs -o x.exe 2> err.txt && \
# DEFINE:     %{one} --check-prefix=TM17 && \
# DEFINE:   not msil-ld --lto-emit-asm extaddr-%{tr}.bc -o x.il 2> err.txt && \
# DEFINE:     %{one} --check-prefix=TM17 && \
# DEFINE:   not ls x.exe && not ls x.il
# REDEFINE: %{tr} = win
# RUN: %{units}
# RUN: %{pa}
# RUN: %{pair}
# RUN: %{cast}
# RUN: %{ext}
# REDEFINE: %{tr} = net
# RUN: %{units}
# RUN: %{pa}
# RUN: %{pair}
# RUN: %{cast}
# RUN: %{ext}

## The other units, as full LTO bitcode and as ThinLTO modules.
# RUN: llvm-as a-o0.ll -o a-o0.bc && opt -module-summary a-o0.ll -o a-o0.thin.bc
# RUN: llvm-as b-o0.ll -o b-o0.bc && opt -module-summary b-o0.ll -o b-o0.thin.bc
# RUN: llvm-as sp.ll -o sp.bc && opt -module-summary sp.ll -o sp.thin.bc
# RUN: llvm-as sp-o0.ll -o sp-o0.bc && opt -module-summary sp-o0.ll -o sp-o0.thin.bc
# RUN: llvm-as s1.ll -o s1.bc && opt -module-summary s1.ll -o s1.thin.bc
# RUN: llvm-as s2.ll -o s2.bc && opt -module-summary s2.ll -o s2.thin.bc
