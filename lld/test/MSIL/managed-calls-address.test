# RUN: llvm-as gb.ll -o gb.bc && opt -module-summary gb.ll -o gb.thin.bc
# RUN: llvm-as gm.ll -o gm.bc && opt -module-summary gm.ll -o gm.thin.bc
# RUN: llvm-as xa.ll -o xa.bc && opt -module-summary xa.ll -o xa.thin.bc
# RUN: llvm-as xb.ll -o xb.bc && opt -module-summary xb.ll -o xb.thin.bc
# RUN: llvm-as xc.ll -o xc.bc && opt -module-summary xc.ll -o xc.thin.bc
# RUN: llvm-as xd.ll -o xd.bc && opt -module-summary xd.ll -o xd.thin.bc
# RUN: llvm-as ya.ll -o ya.bc && opt -module-summary ya.ll -o ya.thin.bc
# RUN: llvm-as yb.ll -o yb.bc && opt -module-summary yb.ll -o yb.thin.bc
# RUN: llvm-as t17a.ll -o t17a.bc && opt -module-summary t17a.ll -o t17a.thin.bc
