## Response files (ImplementationPlan.md 5.9.1, 5.10.3): msil-ld reads @<file>
## as lld does, as UTF-8, so a path with non-ASCII characters inside a
## response file reaches the file system unchanged; that is the encoding the
## clang driver writes for msil-ld (ResponseFileSupport::AtFileUTF8). Quoted
## arguments may contain spaces, and response files may nest. The output is
## the same as with the arguments on the command line.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: mkdir -p café "with space" out/direct out/nested
# RUN: llvm-as main.ll -o café/main.o
# RUN: llvm-as add.ll -o "with space/add.o"

# RUN: msil-ld --lto-emit-asm café/main.o "with space/add.o" -o out/direct/prog.il 2>&1 | count 0
# RUN: msil-ld @link.rsp 2>&1 | count 0
# RUN: FileCheck %s --input-file=out/prog.il
# RUN: cmp out/direct/prog.il out/prog.il
# RUN: msil-ld @nested.rsp 2>&1 | count 0
# RUN: cmp out/prog.il out/nested/prog.il

# CHECK:      {{^}}.assembly 'prog' { .ver 0:0:0:0 }{{$}}
# CHECK:      {{^}}.method public static int32 'main'() cil managed{{$}}
# CHECK:      .entrypoint

## A non-ASCII output name gives a non-ASCII assembly name, written as UTF-8
## after a byte-order mark (decision D11).
# RUN: msil-ld @utf8-out.rsp 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=BOM --input-file=café/naïve.il

# BOM-NOT:    {{.}}
# BOM:        {{^}}{{\xEF\xBB\xBF}}// MSIL module generated by LLVM{{$}}
# BOM:        {{^}}.assembly 'naïve' { .ver 0:0:0:0 }{{$}}

#--- link.rsp
--lto-emit-asm
café/main.o
"with space/add.o"
-o out/prog.il

#--- nested.rsp
--lto-emit-asm @inputs.rsp -o out/nested/prog.il

#--- inputs.rsp
café/main.o "with space/add.o"

#--- utf8-out.rsp
--lto-emit-asm café/main.o "with space/add.o" -o café/naïve.il

#--- main.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %r = call i32 @add3(i32 4)
  ret i32 %r
}

declare i32 @add3(i32)

#--- add.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @add3(i32 %x) {
  %r = add i32 %x, 3
  ret i32 %r
}
