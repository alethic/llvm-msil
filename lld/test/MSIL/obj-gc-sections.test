# RUN: %python %S/Inputs/cctor.py gc.txt | FileCheck %s --check-prefix=GC-CCTOR

# GC:      {{^}}  .field '<msil>image' valuetype '<msil>image_t' flags=0x0111{{$}}
# GC-NEXT: {{^}}    .data 16 bytes{{$}}
# GC-NEXT: {{^}}      01 00 00 00 03 00 00 00 05 00 00 00 06 00 00 00{{$}}
# GC-NEXT: {{^}}  .field '__start_keepme' native int flags=0x{{[0-9A-F]+}}{{$}}
# GC-NEXT: {{^}}  .field 'live_data' native int flags=0x0036{{$}}
# GC-NEXT: {{^}}  .field 'r1' native int flags=0x0033{{$}}
# GC-NEXT: {{^}}  .field 'r2' native int flags=0x0033{{$}}
# GC-NEXT: {{^}}  .field 'used_data' native int flags=0x0033{{$}}
# GC-NEXT: {{^}}  .method '.cctor' void() flags=0x1891 impl=0x0000{{$}}
# GC:      {{^}}  .method 'ctor_fn' void() flags=0x0013 impl=0x0000{{$}}
# GC:      {{^}}  .method 'live_fn' int32() flags=0x0016 impl=0x0000{{$}}
# GC:      {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# GC:      {{^}}  .method 'used_fn' void() flags=0x0013 impl=0x0000{{$}}

# GC-CCTOR-DAG: {{^}}field __start_keepme = data+8{{$}}
# GC-CCTOR-DAG: {{^}}call ctor_fn{{$}}

## --print-gc-sections: the two dead methods and the three dead segments,
## named after their functions and globals.
# RUN: msil-ld --print-gc-sections g1.o -o print/gc.exe > print.txt 2>&1
# RUN: FileCheck %s --check-prefix=PRINT --input-file=print.txt
# RUN: FileCheck %s --check-prefix=PRINT-NUM --input-file=print.txt
# RUN: cmp default/gc.exe print/gc.exe
# PRINT-DAG: {{^}}removing unused section g1.o:(unused_fn){{$}}
# PRINT-DAG: {{^}}removing unused section g1.o:(u_fn){{$}}
# PRINT-DAG: {{^}}removing unused section g1.o:(unused_data){{$}}
# PRINT-DAG: {{^}}removing unused section g1.o:(cu_data){{$}}
# PRINT-DAG: {{^}}removing unused section g1.o:(sc){{$}}
# PRINT-NUM-COUNT-5: {{^}}removing unused section g1.o:({{.*}}){{$}}
# PRINT-NUM-NOT:     {{.}}

## -u keeps u_fn; --gc-sections given explicitly changes nothing.
# RUN: msil-ld --print-gc-sections -u u_fn g1.o -o u.exe > u.txt 2>&1
# RUN: FileCheck %s --check-prefix=U-NUM --input-file=u.txt
# RUN: llvm-cil-dump u.exe | FileCheck %s --check-prefix=U
# RUN: msil-ld --gc-sections g1.o -o explicit/gc.exe 2>&1 | count 0
# RUN: cmp default/gc.exe explicit/gc.exe
# U-NUM-COUNT-4: {{^}}removing unused section g1.o:(
# U-NUM-NOT:     u_fn
# U:             {{^}}  .method 'u_fn' int32() flags=0x0016 impl=0x0000{{$}}

## --no-gc-sections keeps every unit, and prints nothing.
# RUN: msil-ld --no-gc-sections --print-gc-sections g1.o -o all.exe 2>&1 | count 0
# RUN: llvm-cil-dump all.exe | FileCheck %s --check-prefix=ALL
# ALL:      {{^}}    .data 28 bytes{{$}}
# ALL-NEXT: {{^}}      01 00 00 00 02 00 00 00 03 00 00 00 04 00 00 00 05 00 00 00 06 00 00 00 07 00 00 00{{$}}
# ALL-DAG:  {{^}}  .field 'cu_data' native int flags=0x0033{{$}}
# ALL-DAG:  {{^}}  .field 'sc' native int flags=0x0033{{$}}
# ALL-DAG:  {{^}}  .field 'unused_data' native int flags=0x0036{{$}}
# ALL-DAG:  {{^}}  .method 'u_fn' int32() flags=0x0016 impl=0x0000{{$}}
# ALL-DAG:  {{^}}  .method 'unused_fn' int32() flags=0x0016 impl=0x0000{{$}}

## An unreferenced common, named after its symbol.
# RUN: llc -filetype=obj comm.ll -o comm.o
