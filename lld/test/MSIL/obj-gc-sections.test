# COMM-KEPT: {{^}}  .field 'comm_used' native int flags=0x{{[0-9A-F]+}}{{$}}

## (a): explicit sections are kept per object, name and COMDAT group.
# RUN: llc -filetype=obj ex1.ll -o ex1.o
# RUN: llc -filetype=obj ex2.ll -o ex2.o
# RUN: msil-ld --print-gc-sections ex1.o ex2.o -o ex.exe > ex.txt 2>&1
