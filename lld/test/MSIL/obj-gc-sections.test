# RUN:   --implicit-check-not="'grp_myset'" --implicit-check-not="'dead_b'"
# EX-PRINT-DAG: {{^}}removing unused section ex1.o:(nogrp_gset){{$}}
# EX-PRINT-DAG: {{^}}removing unused section ex1.o:(grp_myset){{$}}
# EX-PRINT-DAG: {{^}}removing unused section ex2.o:(dead_b){{$}}
# EX-NUM-COUNT-3: {{^}}removing unused section {{.+}}{{$}}
# EX-NUM-NOT:     {{.}}
# EX-DAG: {{^}}  .field 'dead_s' native int flags=0x{{[0-9A-F]+}}{{$}}
# EX-DAG: {{^}}  .field 'gk' native int flags=0x{{[0-9A-F]+}}{{$}}
# EX-DAG: {{^}}  .field 'gk_dead' native int flags=0x{{[0-9A-F]+}}{{$}}
# EX-DAG: {{^}}  .field 'live_s' native int flags=0x{{[0-9A-F]+}}{{$}}

## (b): on Windows a dead explicit-section segment outside any COMDAT group
## is a root; on Linux it is not.
# RUN: llc -filetype=obj -mtriple=x86_64-pc-windows-msvc-msil w.ll -o w.o
# RUN: llc -filetype=obj -mtriple=x86_64-unknown-linux-gnu-msil w.ll -o wl.o
# RUN: msil-ld --print-gc-sections w.o -o w.exe > w.txt 2>&1
# RUN: FileCheck %s --check-prefix=W-PRINT %{crash} --input-file=w.txt
# RUN: FileCheck %s --check-prefix=W-NUM --input-file=w.txt
# RUN: llvm-cil-dump w.exe | FileCheck %s --check-prefix=W --implicit-check-not="'wc'" \
# RUN:   --implicit-check-not="'wdef'"
# W-PRINT-DAG: {{^}}removing unused section w.o:(wc){{$}}
# W-PRINT-DAG: {{^}}removing unused section w.o:(wdef){{$}}
# W-NUM-COUNT-2: {{^}}removing unused section {{.+}}{{$}}
# W-NUM-NOT:     {{.}}
# W: {{^}}  .field 'wsec' native int flags=0x{{[0-9A-F]+}}{{$}}
# RUN: msil-ld --print-gc-sections wl.o -o wl.exe > wl.txt 2>&1
# RUN: FileCheck %s --check-prefix=WL-PRINT %{crash} --input-file=wl.txt
# RUN: FileCheck %s --check-prefix=WL-NUM --input-file=wl.txt
# WL-PRINT-DAG: {{^}}removing unused section wl.o:(wsec){{$}}
# WL-PRINT-DAG: {{^}}removing unused section wl.o:(wc){{$}}
# WL-PRINT-DAG: {{^}}removing unused section wl.o:(wdef){{$}}
# WL-NUM-COUNT-3: {{^}}removing unused section {{.+}}{{$}}
# WL-NUM-NOT:     {{.}}

## The table roots come from classifySection: '.CRT$XCU' is data on ELF and
## '.tdata' is no table, so both go silently; '.preinit_array' is
## unsupported under ELF rules, so its slot stays and is reported.
# RUN: llc -filetype=obj tab.ll -o tab.o
# RUN: msil-ld --print-gc-sections tab.o -o tab.exe > tab.txt 2>&1
# RUN: FileCheck %s --check-prefix=TAB-PRINT %{crash} --input-file=tab.txt
# RUN: FileCheck %s --check-prefix=TAB-NUM --input-file=tab.txt
# TAB-PRINT-DAG: {{^}}removing unused section tab.o:(crt){{$}}
# TAB-PRINT-DAG: {{^}}removing unused section tab.o:(td){{$}}
# TAB-NUM-COUNT-2: {{^}}removing unused section {{.+}}{{$}}
# TAB-NUM-NOT:     {{.}}
# RUN: not msil-ld --no-gc-sections tab.o -o x.exe 2>&1 | FileCheck %s --check-prefix=TAB-TLS %{crash} \
# RUN:   --implicit-check-not=error:
# TAB-TLS: {{^}}msil-ld: error: thread-local storage is not supported yet: td in tab.o{{$}}
# RUN: llc -filetype=obj pre.ll -o pre.o
# RUN: not msil-ld pre.o -o x.exe 2>&1 | FileCheck %s --check-prefix=PRE %{crash} --implicit-check-not=error:
# PRE: {{^}}msil-ld: error: section '.preinit_array' in pre.o is not supported{{$}}

#--- g1.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@live_data = global i32 1, align 4
@unused_data = global i32 2, align 4
@used_data = internal global i32 3, align 4
@cu_data = internal global i32 4, align 4
@r1 = internal constant i32 5, section "keepme", align 4
@r2 = internal constant i32 6, section "keepme", align 4
@sc = internal constant i32 7, section "other", align 4
@__start_keepme = external global i32
@llvm.used = appending global [2 x ptr] [ptr @used_data, ptr @used_fn], section "llvm.metadata"
@llvm.compiler.used = appending global [1 x ptr] [ptr @cu_data], section "llvm.metadata"
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @ctor_fn, ptr null }]

define internal void @ctor_fn() {
  ret void
}

define internal void @used_fn() {
  ret void
}

define i32 @live_fn() {
  %v = load i32, ptr @live_data
  ret i32 %v
}

define i32 @unused_fn() {
  %v = load i32, ptr @unused_data
  ret i32 %v
}

define i32 @u_fn() {
  ret i32 8
}

define i32 @main() {
  %a = call i32 @live_fn()
  %p = ptrtoint ptr @__start_keepme to i32
  %r = add i32 %a, %p
  ret i32 %r
}

#--- comm.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@comm_unused = common global i32 0, align 4
@comm_used = common global i32 0, align 4

define i32 @main() {
  %v = load i32, ptr @comm_used
  ret i32 %v
}

#--- ex1.ll
target triple = "x86_64-unknown-linux-gnu-msil"

$gk = comdat any
$grp_myset = comdat any

@live_s = internal constant i32 21, section "myset", align 4
@dead_s = internal constant i32 22, section "myset", align 4
@grp_myset = linkonce_odr constant i32 23, section "myset", comdat, align 4
@gk = linkonce_odr constant i32 24, section "gset", comdat, align 4
@gk_dead = linkonce_odr constant i32 25, section "gset", comdat($gk), align 4
@nogrp_gset = internal constant i32 26, section "gset", align 4

define i32 @main() {
  %a = load i32, ptr @live_s
  %b = load i32, ptr @gk
  %r = add i32 %a, %b
  ret i32 %r
}

#--- ex2.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@dead_b = internal constant i32 27, section "myset", align 4

#--- w.ll
$wc = comdat any

@wsec = internal constant i32 31, section "mysec$m", align 4
@wc = linkonce_odr constant i32 32, section "mysec$m", comdat, align 4
@wdef = internal constant i32 33, align 4

define i32 @main() {
  ret i32 0
}

#--- tab.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@crt = internal constant i32 9, section ".CRT$XCU", align 4
@td = internal constant i32 7, section ".tdata", align 4

define i32 @main() {
  ret i32 0
}

#--- pre.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@pa = internal global ptr @early, section ".preinit_array", align 8

define internal void @early() {
  ret void
}

define i32 @main() {
  ret i32 0
}
