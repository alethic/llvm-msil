#--- s1.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; int f(int) __attribute__((msil_method("Contoso.Widget", "Guarded",
;; "int32(int32)"))); int g(int x) { return f(x); }
define i32 @g(i32 noundef %x) {
  %r = call i32 @__msil_mc.f(i32 noundef %x)
  ret i32 %r
}

declare i32 @__msil_mc.f(i32 noundef) #0

attributes #0 = { "msil-managed-type"="Contoso.Widget" "msil-managed-member"="Guarded" "msil-managed-sig"="int32(int32)" "msil-managed-conv"="val;val" }

!msil.managed.calls = !{!0}
!0 = !{!"__msil_mc.f", !"Contoso.Widget", !"Guarded", !"int32(int32)", !"", !"val;val", !""}
#--- s2.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; int f(int) __attribute__((msil_method("Contoso.Point", "Twice",
;; "int32(int32)"))); static int h(int x, int y) { return y ? f(x) : 0; }
;; int k(int x) { return h(x, 0); }, at -O0: h keeps its call of f.
define i32 @k(i32 noundef %x) {
  %r = call i32 @h(i32 noundef %x, i32 noundef 0)
  ret i32 %r
}

define internal i32 @h(i32 noundef %x, i32 noundef %y) {
entry:
  %c = icmp ne i32 %y, 0
  br i1 %c, label %call, label %done

call:
  %r = call i32 @__msil_mc.f(i32 noundef %x)
  br label %done

done:
  %v = phi i32 [ %r, %call ], [ 0, %entry ]
  ret i32 %v
}

declare i32 @__msil_mc.f(i32 noundef) #0

attributes #0 = { "msil-managed-type"="Contoso.Point" "msil-managed-member"="Twice" "msil-managed-sig"="int32(int32)" "msil-managed-conv"="val;val" }

!msil.managed.calls = !{!0}
!0 = !{!"__msil_mc.f", !"Contoso.Point", !"Twice", !"int32(int32)", !"", !"val;val", !""}
#--- s2dead.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; s2.ll at -O2: the optimizer inlined h(x, 0) into k, deleted the dead call
;; of f and then f's declaration, and kept the entry.
define i32 @k(i32 noundef %x) {
  ret i32 0
}

!msil.managed.calls = !{!0}
!0 = !{!"__msil_mc.f", !"Contoso.Point", !"Twice", !"int32(int32)", !"", !"val;val", !""}
#--- sm.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; int g(int), k(int);
;; int main(void) { return 100 + g(-3) * 10 + k(-4); }
declare i32 @g(i32 noundef)
declare i32 @k(i32 noundef)

define i32 @main() {
  %a = call i32 @g(i32 noundef -3)
  %b = call i32 @k(i32 noundef -4)
  %m = mul i32 %a, 10
  %s = add i32 %m, 100
  %t = add i32 %s, %b
  ret i32 %t
}
#--- s1ni.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; s1.ll with __attribute__((noinline)) int g(int x) { return f(x); }
define i32 @g(i32 noundef %x) #1 {
  %r = call i32 @__msil_mc.f(i32 noundef %x)
  ret i32 %r
}

declare i32 @__msil_mc.f(i32 noundef) #0

attributes #0 = { "msil-managed-type"="Contoso.Widget" "msil-managed-member"="Guarded" "msil-managed-sig"="int32(int32)" "msil-managed-conv"="val;val" }
attributes #1 = { noinline }

!msil.managed.calls = !{!0}
!0 = !{!"__msil_mc.f", !"Contoso.Widget", !"Guarded", !"int32(int32)", !"", !"val;val", !""}
#--- s2ni.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; s2.ll with __attribute__((noinline)) int k(int x) { return h(x, 0) + x * x; },
;; at -O0
define i32 @k(i32 noundef %x) #1 {
  %h = call i32 @h(i32 noundef %x, i32 noundef 0)
  %sq = mul i32 %x, %x
  %r = add i32 %h, %sq
  ret i32 %r
}

define internal i32 @h(i32 noundef %x, i32 noundef %y) {
entry:
  %c = icmp ne i32 %y, 0
  br i1 %c, label %call, label %done

call:
  %r = call i32 @__msil_mc.f(i32 noundef %x)
  br label %done

done:
  %v = phi i32 [ %r, %call ], [ 0, %entry ]
  ret i32 %v
}

declare i32 @__msil_mc.f(i32 noundef) #0

attributes #0 = { "msil-managed-type"="Contoso.Point" "msil-managed-member"="Twice" "msil-managed-sig"="int32(int32)" "msil-managed-conv"="val;val" }
