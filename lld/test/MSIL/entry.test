## The entry point in M14 (ImplementationPlan.md 5.9.3, D27): -e/--entry
## default to main, and before M20 main is the only entry point msil-ld
## accepts; any other symbol is
##   --entry=<sym>: an entry point other than main is not supported yet
## whichever spelling named it. main is an LTO root, visible to regular
## objects, so it survives LTO and the backend's '<msil>Main' calls it with
## .entrypoint; like -u, the entry extracts the archive member that defines
## it. A link without a definition of main is an error naming it (5.9.6:
## msil-ld reports an undefined entry), in 5.9.14's undefined-symbol form
## with the entry point as the reference.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-as main.ll -o main.o
# RUN: llvm-as start.ll -o start.o
# RUN: llvm-ar rcs libmain.a main.o

# DEFINE: %{il} = FileCheck %s --check-prefix=IL

# RUN: msil-ld --lto-emit-asm main.o -o d.il 2>&1 | count 0
# RUN: %{il} --input-file=d.il
# RUN: msil-ld --lto-emit-asm -e main main.o -o e.il 2>&1 | count 0
# RUN: %{il} --input-file=e.il
# RUN: msil-ld --lto-emit-asm --entry=main main.o -o entry.il 2>&1 | count 0
# RUN: %{il} --input-file=entry.il
# RUN: msil-ld --lto-emit-asm --entry main main.o -o entry2.il 2>&1 | count 0
# RUN: %{il} --input-file=entry2.il

# IL:      {{^}}.method public static int32 'main'() cil managed{{$}}
# IL:      {{^}}.method private hidebysig static int32 '<msil>Main'(string[] args) cil managed{{$}}
# IL-NEXT: {{^[{]$}}
# IL-NEXT: {{^}}  .entrypoint{{$}}

## The entry symbol extracts main from an archive.
# RUN: msil-ld --lto-emit-asm start.o libmain.a -o lib.il --why-extract=lib.why 2>&1 | count 0
# RUN: %{il} --input-file=lib.il
# RUN: FileCheck %s --check-prefix=WHY --input-file=lib.why

# WHY:      {{^}}reference{{[[:space:]]}}extracted{{[[:space:]]}}symbol{{$}}
# WHY-NEXT: {{^.+}}{{[[:space:]]}}libmain.a(main.o){{[[:space:]]}}main{{$}}

# RUN: not msil-ld --lto-emit-asm --entry=start main.o start.o -o x.il 2>&1 | FileCheck %s --check-prefix=OTHER --implicit-check-not="PLEASE submit"
# RUN: not msil-ld --lto-emit-asm --entry start main.o start.o -o x.il 2>&1 | FileCheck %s --check-prefix=OTHER --implicit-check-not="PLEASE submit"
# RUN: not msil-ld --lto-emit-asm -e start main.o start.o -o x.il 2>&1 | FileCheck %s --check-prefix=OTHER --implicit-check-not="PLEASE submit"
# RUN: not msil-ld --lto-emit-asm -e start start.o -o x.il 2>&1 | FileCheck %s --check-prefix=OTHER --implicit-check-not="PLEASE submit"

# OTHER:    {{^}}msil-ld: error: --entry=start: an entry point other than main is not supported yet{{$}}

# RUN: not msil-ld --lto-emit-asm start.o -o x.il 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOMAIN --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not=error: --implicit-check-not=">>>"

# NOMAIN:      {{^}}msil-ld: error: undefined symbol: main{{$}}
# NOMAIN-NEXT: {{^}}>>> referenced by the entry point{{$}}

#--- main.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  ret i32 0
}

#--- start.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @start() {
  ret i32 0
}
