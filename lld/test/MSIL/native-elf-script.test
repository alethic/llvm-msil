# RUN: FileCheck %s --check-prefix=IL-NONE --input-file=pos.il

## libc_nonshared.a is read through the script: atexit is native code only.
# RUN: not msil-ld --lto-emit-asm --sysroot=sys -L=/usr/lib/x86_64-linux-gnu atexit.o -lc -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=ATEXIT
# ATEXIT:      {{^}}msil-ld: error: symbol 'atexit' is defined only in native object code ({{.*}}libc_nonshared.a(atexit.oS)); MSIL cannot link machine code{{$}}
# ATEXIT-NEXT: {{^}}>>> referenced by atexit.o:(main){{$}}

## A script inside the sysroot whose absolute input is missing there.
# RUN: cp missing-abs.txt sys/usr/lib/x86_64-linux-gnu/libmissing.so
# RUN: not msil-ld --lto-emit-asm --sysroot=sys -L=/usr/lib/x86_64-linux-gnu main.o -lc -lm -lmissing \
# RUN:   -o x.il 2>&1 | %{err} --check-prefix=MISSING-ABS
# MISSING-ABS: {{^}}msil-ld: error: {{.*}}cannot find /lib/x86_64-linux-gnu/libnothere.so.1 inside sys{{$}}

## INPUT with a relative name in the script's directory and -l<name>
## searched in -L, '=' sysroot-relative paths, SEARCH_DIR ignored.
# RUN: mkdir -p grp other
