# GRP-DAG: {{^}}.method assembly hidebysig static pinvokeimpl("libone.so.1" nomangle cdecl) int32 'one'() cil managed preservesig {}{{$}}
# GRP-DAG: {{^}}.method assembly hidebysig static pinvokeimpl("libtwo.so.2" nomangle cdecl) int32 'two'() cil managed preservesig {}{{$}}
# GRP-DAG: {{^}}.method assembly hidebysig static pinvokeimpl("libthree.so.3" nomangle cdecl) int32 'three'() cil managed preservesig {}{{$}}
# GRP-DAG: {{^}}.method assembly hidebysig static pinvokeimpl("libm.so.6" nomangle cdecl) float64 'cbrt'(float64) cil managed preservesig {}{{$}}

## A relative name found nowhere, and a -l<name> found nowhere.
# RUN: cp norel.txt grp/libnorel.so
# RUN: cp nolib.txt grp/libnolib.so
# RUN: not msil-ld --lto-emit-asm grp.o -L grp -L other -lnorel -o x.il 2>&1 | %{err} --check-prefix=NOREL
# RUN: not msil-ld --lto-emit-asm grp.o -L grp -L other -lnolib -o x.il 2>&1 | %{err} --check-prefix=NOLIB
# NOREL: {{^}}msil-ld: error: {{.*}}unable to find libnothere.so.1{{$}}
# NOLIB: {{^}}msil-ld: error: {{.*}}unable to find library -lnothere{{$}}

## Cycles: a script naming itself, on the command line and through -l, and
## two scripts naming each other (the error is libb.so's, whose input
## re-enters liba.so). empty.o references nothing, so the cycle is the only
## error.
# RUN: llvm-as empty.ll -o empty.o
# RUN: not msil-ld --lto-emit-asm empty.o cyc/libloop.so -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=LOOP --implicit-check-not=error:
# RUN: not msil-ld --lto-emit-asm empty.o -L%t/cyc -lloop -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=LOOP --implicit-check-not=error:
# LOOP:      {{^}}msil-ld: error: {{(.*[/\\])?}}libloop.so:1: there is a cycle in linker script inputs{{$}}
# LOOP-NEXT: {{^}}>>> INPUT(libloop.so){{$}}
# LOOP-NEXT: {{^}}>>>       ^{{$}}
# RUN: not msil-ld --lto-emit-asm empty.o cyc/liba.so -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=AB --implicit-check-not=error:
# AB:      {{^}}msil-ld: error: {{(.*[/\\])?}}libb.so:1: there is a cycle in linker script inputs{{$}}
# AB-NEXT: {{^}}>>> INPUT(liba.so){{$}}
# AB-NEXT: {{^}}>>>       ^{{$}}

## Not a cycle: a script read again after its expansion ended.
# RUN: msil-ld --lto-emit-asm --lto-O0 --sysroot=sys -L=/usr/lib/x86_64-linux-gnu main.o -lc -lc -lm \
# RUN:   -o twice.il 2>&1 | count 0
# RUN: %{il} --check-prefix=GLIBC --input-file=twice.il
# RUN: FileCheck %s --check-prefix=IL-NONE --input-file=twice.il
# RUN: msil-ld --lto-emit-asm --lto-O0 --sysroot=sys grp.o -L grp -L other grp/libgrp.so grp/libgrp.so \
# RUN:   -o twice2.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=GRP --input-file=twice2.il

#--- cyc/libloop.so
INPUT(libloop.so)

#--- cyc/liba.so
INPUT(libb.so)

#--- cyc/libb.so
INPUT(liba.so)

#--- empty.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  ret i32 0
}

#--- libc.so.txt
/* GNU ld script
   Use the shared library, but some functions are only in
   the static library, so try that secondarily.  */
OUTPUT_FORMAT(elf64-x86-64)
GROUP ( /lib/x86_64-linux-gnu/libc.so.6 /usr/lib/x86_64-linux-gnu/libc_nonshared.a  AS_NEEDED ( /lib64/ld-linux-x86-64.so.2 ) )

#--- libm.so.txt
/* GNU ld script
*/
OUTPUT_FORMAT(elf64-x86-64)
GROUP ( /lib/x86_64-linux-gnu/libm.so.6  AS_NEEDED ( /lib/x86_64-linux-gnu/libmvec.so.1 ) )

#--- missing-abs.txt
/* GNU ld script */
GROUP ( /lib/x86_64-linux-gnu/libnothere.so.1 )

#--- grp.txt
/* INPUT names a file in this directory and a library in -L; '=' is the
   sysroot; SEARCH_DIR is ignored. */
SEARCH_DIR("=/nowhere")
INPUT ( libone.so.1 -ltwo )
GROUP ( libthree.so.3 =/lib/x86_64-linux-gnu/libm.so.6 )

#--- norel.txt
INPUT ( libnothere.so.1 )

#--- nolib.txt
INPUT ( -lnothere )

#--- one.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: one,   Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }

#--- two.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: two,   Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }

#--- three.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: three, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }

#--- main.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@msg = private constant [3 x i8] c"hi\00"

define i32 @main() {
  %r = call i32 @puts(ptr @msg)
  %c = call double @cbrt(double 8.0)
  %t = call ptr @__tls_get_addr(ptr null)
  %v = call double @_ZGVbN2v_sin(double 0.0)
  %s = fadd double %c, %v
  %i = fptosi double %s to i32
  %x = add i32 %r, %i
  ret i32 %x
}

declare i32 @puts(ptr)
declare double @cbrt(double)
declare ptr @__tls_get_addr(ptr)
;; libmvec's vector function, with a scalar prototype: only its binding
;; matters here.
declare double @_ZGVbN2v_sin(double)

#--- atexit.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  %r = call i32 @atexit(ptr null)
  ret i32 %r
}

declare i32 @atexit(ptr)

#--- grp.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  %a = call i32 @one()
  %b = call i32 @two()
  %c = call i32 @three()
  %d = call double @cbrt(double 8.0)
  %e = fptosi double %d to i32
  %s1 = add i32 %a, %b
  %s2 = add i32 %s1, %c
  %s3 = add i32 %s2, %e
  ret i32 %s3
}

declare i32 @one()
declare i32 @two()
declare i32 @three()
declare double @cbrt(double)
