## The output depends on the reference set, never on its order
## (ImplementationPlan.md 5.11.4, 5.11.6 and 5.9.4; bcl-binding 5.12): the
## same references given in other orders, split across
## directories in either order, mixed with positional ones before or after
## the objects, or linked by a driver that runs twice in one process, give
## byte-identical PEs. The set holds references that bind
## nothing (a facade, FakeNativeLibrary, FakeTypesA), which must not change
## the result either. p1.o binds every Phase 1 member.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llc -filetype=obj p1.ll -o p1.o
# RUN: mkdir d1 d2 all
# RUN: yaml2obj %S/Inputs/fakepack/FakeCore.yaml -o d1/FakeCore.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeInterop.yaml -o d1/FakeInterop.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeFacade.yaml -o d1/FakeFacade.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeThreading.yaml -o d2/FakeThreading.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeNativeLibrary.yaml -o d2/FakeNativeLibrary.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeTypesA.yaml -o d2/FakeTypesA.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeCore.yaml -o all/FakeCore.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeInterop.yaml -o all/FakeInterop.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeFacade.yaml -o all/FakeFacade.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeThreading.yaml -o all/FakeThreading.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeNativeLibrary.yaml -o all/FakeNativeLibrary.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeTypesA.yaml -o all/FakeTypesA.dll

# RUN: mkdir o1 o2 o3 o4 o5 o6 o7
# RUN: msil-ld p1.o --reference=all -o o1/prog.exe 2>&1 | count 0
# RUN: msil-ld p1.o --reference=d1 --reference=d2 -o o2/prog.exe 2>&1 | count 0
# RUN: msil-ld p1.o --reference=d2 --reference=d1 -o o3/prog.exe 2>&1 | count 0
# RUN: msil-ld p1.o --reference=d1/FakeCore.dll --reference=d1/FakeInterop.dll --reference=d1/FakeFacade.dll \
# RUN:   --reference=d2/FakeThreading.dll --reference=d2/FakeNativeLibrary.dll --reference=d2/FakeTypesA.dll \
# RUN:   -o o4/prog.exe 2>&1 | count 0
# RUN: msil-ld p1.o --reference=d2/FakeTypesA.dll --reference=d2/FakeNativeLibrary.dll --reference=d2/FakeThreading.dll \
# RUN:   --reference=d1/FakeFacade.dll --reference=d1/FakeInterop.dll --reference=d1/FakeCore.dll \
# RUN:   -o o5/prog.exe 2>&1 | count 0
# RUN: msil-ld d2/FakeThreading.dll d1/FakeInterop.dll p1.o --reference=d2 d1/FakeCore.dll d1/FakeFacade.dll \
# RUN:   -o o6/prog.exe 2>&1 | count 0
# RUN: msil-ld --reference=d1/FakeFacade.dll d1/FakeCore.dll p1.o d1/FakeInterop.dll --reference=d2 \
# RUN:   -o o7/prog.exe 2>&1 | count 0
