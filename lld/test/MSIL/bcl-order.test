## The driver run twice in one process (LLD_IN_TEST=2, 5.9.1) resets the
## reference set and the binder: the same PE, and no diagnostic.
# RUN: mkdir o8
# RUN: env LLD_IN_TEST=2 msil-ld p1.o --reference=d2 --reference=d1 -o o8/prog.exe 2>&1 | count 0
# RUN: cmp o1/prog.exe o8/prog.exe

## The references were used: the PE is bound, not the built-in table's.
# RUN: mkdir none
# RUN: msil-ld p1.o -o none/prog.exe 2>&1 | count 0
# RUN: not cmp o1/prog.exe none/prog.exe

#--- p1.ll
target triple = "x86_64-pc-windows-msvc-msil"

@buf = global [16 x i8] c"0123456789abcdef", align 1
@ptr = global ptr @buf, align 8

declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)

define void @shift(i64 %n) {
  %p = load ptr, ptr @ptr
  %q = getelementptr i8, ptr %p, i64 1
  call void @llvm.memmove.p0.p0.i64(ptr %q, ptr %p, i64 %n, i1 false)
  fence seq_cst
  ret void
}

define i32 @main(i32 %argc, ptr %argv) {
  %a = sext i32 %argc to i64
  call void @shift(i64 %a)
  %p = load ptr, ptr @ptr
  %c = load i8, ptr %p
  %r = zext i8 %c to i32
  ret i32 %r
}
