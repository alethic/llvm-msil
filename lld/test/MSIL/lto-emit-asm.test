## --lto-emit-asm (ImplementationPlan.md 5.9.13, M14): msil-ld links LLVM
## bitcode with whole-program LTO and writes the ILAsm text of the merged
## module to -o (ilasm turns it into an executable; msil-ld writes the PE from
## M20). The assembly is named after the stem of -o, or by --assembly-name or
## -soname: msil-ld sets the module flag msil-assembly-name, which the
## AsmPrinter uses unless -msil-assembly-name is given (the section 12 row of
## 2026-10-21 amending D28). It is never named after LTO's merged module
## 'ld-temp.o', whose name only the source_filename comment shows.
## Only the entry point main is visible to regular objects, so it stays
## 'public' and gets '<msil>Main' with .entrypoint (D27); every other symbol
## is internalized ('assembly'). The text is deterministic.
## From M15 the text is linked text (5.10.13): a function that a native
## library binds is an 'assembly' P/Invoke named after the library's module
## (5.10.11), never one of D14's public P/Invokes; main stays the only public
## method.

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llvm-as main.ll -o main.o
# RUN: llvm-as add.ll -o add.o
# RUN: mkdir out d1 d2

# DEFINE: %{il} = FileCheck %s --implicit-check-not=".assembly 'ld-temp" \
# DEFINE:   --implicit-check-not=".assembly '"

# RUN: msil-ld --lto-emit-asm --lto-O0 main.o add.o -o out/prog.il 2>&1 | count 0
# RUN: %{il} --check-prefixes=CHECK,PROG --input-file=out/prog.il

# CHECK:       {{^}}// MSIL module generated by LLVM{{$}}
# CHECK:       {{^}}// target triple   = "x86_64-pc-windows-msvc-msil"{{$}}
# CHECK:       {{^}}.assembly extern mscorlib
# PROG-NEXT:   {{^}}.assembly 'prog' { .ver 0:0:0:0 }{{$}}
# DOTS-NEXT:   {{^}}.assembly 'My.App' { .ver 0:0:0:0 }{{$}}
# FOO-NEXT:    {{^}}.assembly 'foo' { .ver 0:0:0:0 }{{$}}
# BAR-NEXT:    {{^}}.assembly 'bar' { .ver 0:0:0:0 }{{$}}
# CHECK-LABEL: {{^}}.method public static int32 'main'() cil managed{{$}}
# CHECK:         call int32 'add3'(int32)
# CHECK-LABEL: {{^}}.method assembly static int32 'add3'(int32) cil managed{{$}}
# CHECK:       {{^  add$}}
# CHECK-LABEL: {{^}}.method private hidebysig static int32 '<msil>Main'(string[] args) cil managed{{$}}
# CHECK-NEXT:  {{^[{]$}}
# CHECK-NEXT:  {{^}}  .entrypoint{{$}}
# CHECK-NEXT:  {{^}}  .maxstack 1{{$}}
# CHECK-NEXT:  {{^}}  call int32 'main'(){{$}}

## Only the last extension of -o is dropped; the extension does not matter.
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o add.o -o out/My.App.il 2>&1 | count 0
# RUN: %{il} --check-prefixes=CHECK,DOTS --input-file=out/My.App.il
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o add.o -o out/prog.exe 2>&1 | count 0
# RUN: %{il} --check-prefixes=CHECK,PROG --input-file=out/prog.exe

## --assembly-name (both spellings) and -soname name the assembly instead.
# RUN: msil-ld --lto-emit-asm --lto-O0 --assembly-name=foo main.o add.o -o out/a1.il 2>&1 | count 0
# RUN: %{il} --check-prefixes=CHECK,FOO --input-file=out/a1.il
# RUN: msil-ld --lto-emit-asm --lto-O0 --assembly-name foo main.o add.o -o out/a2.il 2>&1 | count 0
# RUN: %{il} --check-prefixes=CHECK,FOO --input-file=out/a2.il
# RUN: msil-ld --lto-emit-asm --lto-O0 -soname foo main.o add.o -o out/a3.il 2>&1 | count 0
# RUN: %{il} --check-prefixes=CHECK,FOO --input-file=out/a3.il

## The backend option -msil-assembly-name comes before the module flag.
# RUN: msil-ld --lto-emit-asm --lto-O0 --assembly-name=foo -mllvm -msil-assembly-name=bar \
# RUN:   main.o add.o -o out/a4.il 2>&1 | count 0
# RUN: %{il} --check-prefixes=CHECK,BAR --input-file=out/a4.il
# RUN: msil-ld --lto-emit-asm --lto-O0 --mllvm=-msil-assembly-name=bar main.o add.o -o out/a5.il 2>&1 \
# RUN:   | count 0
# RUN: %{il} --check-prefixes=CHECK,BAR --input-file=out/a5.il

## The same link writes the same text, at -O0 and at the default -O2.
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o add.o -o d1/prog.il
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o add.o -o d2/prog.il
# RUN: cmp d1/prog.il d2/prog.il
# RUN: cmp d1/prog.il out/prog.il
# RUN: msil-ld --lto-emit-asm main.o add.o -o d1/o2.il
# RUN: msil-ld --lto-emit-asm main.o add.o -o d2/o2.il
# RUN: cmp d1/o2.il d2/o2.il
# RUN: FileCheck %s --check-prefix=O2 --input-file=d1/o2.il

# O2:          {{^}}.assembly 'o2' { .ver 0:0:0:0 }{{$}}
# O2:          {{^}}.method public static int32 'main'() cil managed{{$}}
# O2:          .entrypoint

## A Linux triple: the same structure, the triple of the inputs.
# RUN: llvm-as lnx.ll -o lnx.o
# RUN: msil-ld --lto-emit-asm --lto-O0 lnx.o -o out/lnx.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=LNX --input-file=out/lnx.il

# LNX:         {{^}}// target triple   = "x86_64-unknown-linux-gnu-msil"{{$}}
# LNX:         {{^}}.assembly 'lnx' { .ver 0:0:0:0 }{{$}}
# LNX:         {{^}}.method public static int32 'main'() cil managed{{$}}
# LNX:         .entrypoint

## Linked text with a native library: puts from ucrt.lib.
# RUN: llvm-lib /machine:x64 /def:%S/Inputs/native/ucrt-stdio.def /out:ucrt.lib
# RUN: llvm-as hello.ll -o hello.o
# RUN: msil-ld --lto-emit-asm --lto-O0 hello.o ucrt.lib -o d1/hello.il 2>&1 | count 0
# RUN: msil-ld --lto-emit-asm --lto-O0 hello.o ucrt.lib -o d2/hello.il 2>&1 | count 0
# RUN: cmp d1/hello.il d2/hello.il
# RUN: FileCheck %s --check-prefix=NATIVE --implicit-check-not='"ucrtbase"' --input-file=d1/hello.il
# RUN: FileCheck %s --check-prefix=PUBLIC --input-file=d1/hello.il

# NATIVE:      {{^}}.assembly 'hello' { .ver 0:0:0:0 }{{$}}
# NATIVE-DAG:  {{^}}.method public static int32 'main'() cil managed{{$}}
# NATIVE-DAG:  call int32 'puts'(native int)
# NATIVE-DAG:  {{^}}.method assembly hidebysig static pinvokeimpl("api-ms-win-crt-stdio-l1-1-0.dll" nomangle cdecl) int32 'puts'(native int) cil managed preservesig {}{{$}}
# PUBLIC-COUNT-1: {{^}}.method public
# PUBLIC-NOT:     {{^}}.method public

#--- main.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %r = call i32 @add3(i32 4)
  ret i32 %r
}

declare i32 @add3(i32)

#--- add.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @add3(i32 %x) {
  %r = add i32 %x, 3
  ret i32 %r
}

#--- lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  ret i32 7
}

#--- hello.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@msg = private constant [3 x i8] c"hi\00"

define i32 @main() {
  %r = call i32 @puts(ptr @msg)
  ret i32 0
}

declare i32 @puts(ptr)
