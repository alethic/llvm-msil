# RUN: llvm-cil-dump noinc-nogc.exe > noinc-nogc.txt
# RUN: %{opts} noinc-nogc.txt | FileCheck %s --check-prefix=NOINC-NOGC
# NOINC-NOGC-DAG: {{^}}options __local_stdio_printf_options |= 0x24{{$}}
# NOINC-NOGC-DAG: {{^}}options __local_stdio_scanf_options |= 0x2{{$}}
# RUN: FileCheck %s --check-prefix=NOINC --input-file=noinc.txt
# NOINC-DAG: {{^}}    L{{[0-9]+}}: call int32(native int, native int) '<Module>'::'printf'{{$}}
# NOINC-DAG: {{^}}  .method 'printf' int32(native int, native int) flags=0x00{{[0-9A-F]+}} impl=0x0000{{$}}
# NOINC-DAG: {{^}}    .pinvokeimpl 'api-ms-win-crt-stdio-l1-1-0.dll' entry '__stdio_common_vfprintf' flags=0x0201{{$}}

## The member's weak printf with another object's COMDAT printf and
## __local_stdio_printf_options, in both orders. Mix.o calls printf, sprintf
## (only the member defines it) and comdat.o's use_printf, so the printf
## member is extracted in both orders.
# RUN: msil-ld mix.o libucrt-stdio.a comdat.o ucrt.lib -o mix1.exe 2>&1 | count 0
# RUN: llvm-cil-dump mix1.exe > mix1.txt
# RUN: FileCheck %s --check-prefix=MIX-PRINTF --input-file=mix1.txt
# RUN: FileCheck %s --check-prefix=MIX-SPRINTF --input-file=mix1.txt
# RUN: FileCheck %s --check-prefix=MIX-OPTFN --input-file=mix1.txt
# RUN: %{opts} mix1.txt | FileCheck %s --check-prefix=MIX-ONCE
# RUN: msil-ld comdat.o mix.o libucrt-stdio.a ucrt.lib -o mix2.exe 2>&1 | count 0
# RUN: llvm-cil-dump mix2.exe > mix2.txt
# RUN: FileCheck %s --check-prefix=MIX-PRINTF --input-file=mix2.txt
# RUN: FileCheck %s --check-prefix=MIX-SPRINTF --input-file=mix2.txt
# RUN: FileCheck %s --check-prefix=MIX-OPTFN --input-file=mix2.txt
# RUN: %{opts} mix2.txt | FileCheck %s --check-prefix=MIX-ONCE
# MIX-PRINTF-COUNT-1:  {{^}}  .method 'printf' int32(native int, native int) flags=
# MIX-PRINTF-NOT:      {{^}}  .method 'printf'
# MIX-SPRINTF-COUNT-1: {{^}}  .method 'sprintf' int32(native int, native int, native int) flags=
# MIX-SPRINTF-NOT:     {{^}}  .method 'sprintf'
# MIX-OPTFN-COUNT-1:   {{^}}  .method '__local_stdio_printf_options' native int() flags=
# MIX-OPTFN-NOT:       {{^}}  .method '__local_stdio_printf_options'
# MIX-ONCE-COUNT-1:    {{^}}options __local_stdio_printf_options |= 0x24{{$}}
# MIX-ONCE-NOT:        __local_stdio_printf_options
## In the second order comdat.o defines __local_stdio_printf_options before
## the archive is searched, so the options member is never extracted and the
## link defines no __local_stdio_scanf_options.
# RUN: %{opts} mix2.txt | FileCheck %s --check-prefix=MIX2
# RUN: FileCheck %s --check-prefix=MIX2-NOFN --input-file=mix2.txt
# MIX2-NOT:      __local_stdio_scanf_options
# MIX2:          {{^}}options __local_stdio_printf_options |= 0x24{{$}}
# MIX2-NOT:      __local_stdio_scanf_options
# MIX2-NOFN-NOT: '__local_stdio_scanf_options'

#--- opts.py
"""Summarize the module initializer of an llvm-cil-dump listing.

Usage: opts.py <listing>

Prints one line per call that '<Module>::.cctor' makes, in IL order
('call <method>'), except that the UCRT stdio options pattern of plan
5.15.2 (H3),
  call native int() '<Module>'::'<f>'
  dup
  ldind.i8
  <a constant: ldc.i8, or an ldc.i4 form, optionally converted>
  or
  stind.i8
prints as 'options <f> |= 0x<bits>'. Calls of Marshal::AllocHGlobal are
left out. A missing '.cctor' prints 'no .cctor'.
"""

import re
import sys

OPERAND = re.compile(r"^    L\d+: (\S+)(?: (.*))?$")
MEMBER = re.compile(r"'<Module>'::'((?:[^'\\]|\\.)*)'$")


def constant(op, arg):
    if op in ("ldc.i8", "ldc.i4", "ldc.i4.s"):
        return int(arg, 0)
    if op == "ldc.i4.m1":
        return -1
    if op.startswith("ldc.i4."):
        return int(op[len("ldc.i4."):])
    return None


def main():
    body, inside = [], False
    for line in open(sys.argv[1], encoding="utf-8").read().splitlines():
        if line.startswith("  .method '.cctor' "):
            inside = True
            continue
        if inside:
            if not line.startswith("    "):
                break
            m = OPERAND.match(line)
            if m:
                body.append((m.group(1), m.group(2) or ""))
    if not inside:
        print("no .cctor")
        return

    def op_at(k):
        return body[k] if k < len(body) else ("", "")

    out, i = [], 0
    while i < len(body):
        op, arg = body[i]
        if op != "call":
            i += 1
            continue
        m = MEMBER.search(arg)
        name = m.group(1) if m else arg
        if op_at(i + 1)[0] == "dup" and op_at(i + 2)[0] == "ldind.i8":
            bits = constant(*op_at(i + 3))
            k = i + 4
            while op_at(k)[0].startswith("conv."):
                k += 1
            if bits is not None and op_at(k)[0] == "or" and op_at(k + 1)[0] == "stind.i8":
                out.append("options %s |= 0x%x" % (name, bits))
                i = k + 2
                continue
        if "AllocHGlobal" not in arg:
            out.append("call " + name)
        i += 1
    print("\n".join(out))


if __name__ == "__main__":
    main()

#--- win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

#--- lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

#--- body.ll

;; What every TU that includes UCRT's <stdio.h> defines: the two options
;; functions as COMDAT inline functions, each over its own static word.
$__local_stdio_printf_options = comdat any
$__local_stdio_scanf_options = comdat any

@__local_stdio_printf_options._OptionsStorage = internal global i64 0, align 8
@__local_stdio_scanf_options._OptionsStorage = internal global i64 0, align 8
@seen = global i64 0, align 8
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @ctor, ptr null }]

define linkonce_odr ptr @__local_stdio_printf_options() #0 comdat {
  ret ptr @__local_stdio_printf_options._OptionsStorage
}

define linkonce_odr ptr @__local_stdio_scanf_options() #0 comdat {
  ret ptr @__local_stdio_scanf_options._OptionsStorage
}

;; A constructor that reads the printf options word.
define internal void @ctor() {
  %p = call ptr @__local_stdio_printf_options()
  %v = load i64, ptr %p, align 8
  store i64 %v, ptr @seen, align 8
  ret void
}

define i32 @main() {
  %p = call ptr @__local_stdio_printf_options()
  %v = load i64, ptr %p, align 8
  %q = call ptr @__local_stdio_scanf_options()
  %w = load i64, ptr %q, align 8
  %s = or i64 %v, %w
  %r = trunc i64 %s to i32
  ret i32 %r
}

attributes #0 = { noinline nounwind }

#--- req-fr.ll

!llvm.linker.options = !{!0}
!0 = !{!"/DEFAULTLIB:legacy_stdio_float_rounding.lib"}

#--- req-ws.ll

!llvm.linker.options = !{!0}
!0 = !{!"-defaultlib:legacy_stdio_wide_specifiers"}

#--- req-ws-pragma.ll

;; #pragma comment(lib, "legacy_stdio_wide_specifiers"), as clang writes it.
!llvm.linker.options = !{!0}
!0 = !{!"/DEFAULTLIB:legacy_stdio_wide_specifiers.lib"}

#--- req-iso.ll

!llvm.linker.options = !{!0}
!0 = !{!"/DEFAULTLIB:iso_stdio_wide_specifiers"}

#--- req-iso-pragma.ll

;; #pragma comment(lib, "iso_stdio_wide_specifiers"), as clang writes it.
!llvm.linker.options = !{!0}
!0 = !{!"/DEFAULTLIB:iso_stdio_wide_specifiers.lib"}

#--- req-defs.ll

!llvm.linker.options = !{!0}
!0 = !{!"/DEFAULTLIB:LEGACY_STDIO_DEFINITIONS.LIB"}

#--- pf.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

$__local_stdio_printf_options = comdat any

@__local_stdio_printf_options._OptionsStorage = internal global i64 0, align 8

define linkonce_odr ptr @__local_stdio_printf_options() #0 comdat {
  ret ptr @__local_stdio_printf_options._OptionsStorage
}

define i32 @main() {
  %p = call ptr @__local_stdio_printf_options()
  %v = load i64, ptr %p, align 8
  %r = trunc i64 %v to i32
  ret i32 %r
}

attributes #0 = { noinline nounwind }

#--- none.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@word = global i64 0, align 8

define i32 @main() {
  %v = load i64, ptr @word, align 8
  %r = trunc i64 %v to i32
  ret i32 %r
}

#--- lto-body.ll

;; <stdio.h>'s inline functions as clang -flto emits them: the options
;; functions and their callers (here two small stand-ins of the UCRT's
;; _vfprintf_l and _vfscanf_l) are noinline linkonce_odr, each in its COMDAT.
$__local_stdio_printf_options = comdat any
$__local_stdio_scanf_options = comdat any
$printf_opts = comdat any
$scanf_opts = comdat any

@__local_stdio_printf_options._OptionsStorage = internal global i64 0, align 8
@__local_stdio_scanf_options._OptionsStorage = internal global i64 0, align 8

define linkonce_odr ptr @__local_stdio_printf_options() #0 comdat {
  ret ptr @__local_stdio_printf_options._OptionsStorage
}

define linkonce_odr ptr @__local_stdio_scanf_options() #0 comdat {
  ret ptr @__local_stdio_scanf_options._OptionsStorage
}

define linkonce_odr i64 @printf_opts() #0 comdat {
  %p = call ptr @__local_stdio_printf_options()
  %v = load i64, ptr %p, align 8
  ret i64 %v
}

define linkonce_odr i64 @scanf_opts() #0 comdat {
  %p = call ptr @__local_stdio_scanf_options()
  %v = load i64, ptr %p, align 8
  ret i64 %v
}

define i32 @main() {
  %a = call i64 @printf_opts()
  %b = call i64 @scanf_opts()
  %s = or i64 %a, %b
  %r = trunc i64 %s to i32
  ret i32 %r
}

attributes #0 = { noinline nounwind }

#--- ucrt-stdio.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; A stand-in of the helper archive's msil_ucrt_stdio.c member: weak
;; definitions of printf and sprintf over the UCRT's documented entry
;; points, with the options word of __local_stdio_printf_options.
define weak i32 @printf(ptr %fmt, ...) {
  %ap = alloca ptr, align 8
  call void @llvm.va_start.p0(ptr %ap)
  %va = load ptr, ptr %ap, align 8
  %o = call ptr @__local_stdio_printf_options()
  %opts = load i64, ptr %o, align 8
  %out = call ptr @__acrt_iob_func(i32 1)
  %r = call i32 @__stdio_common_vfprintf(i64 %opts, ptr %out, ptr %fmt, ptr null, ptr %va)
  call void @llvm.va_end.p0(ptr %ap)
  ret i32 %r
}

define weak i32 @sprintf(ptr %buf, ptr %fmt, ...) {
  %ap = alloca ptr, align 8
  call void @llvm.va_start.p0(ptr %ap)
  %va = load ptr, ptr %ap, align 8
  %o = call ptr @__local_stdio_printf_options()
  %opts = load i64, ptr %o, align 8
  %r = call i32 @__stdio_common_vsprintf(i64 %opts, ptr %buf, i64 -1, ptr %fmt, ptr null, ptr %va)
  call void @llvm.va_end.p0(ptr %ap)
  ret i32 %r
}

declare ptr @__local_stdio_printf_options()
declare ptr @__acrt_iob_func(i32)
declare i32 @__stdio_common_vfprintf(i64, ptr, ptr, ptr, ptr)
declare i32 @__stdio_common_vsprintf(i64, ptr, i64, ptr, ptr, ptr)
declare void @llvm.va_start.p0(ptr)
declare void @llvm.va_end.p0(ptr)

#--- ucrt-opts.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; A stand-in of msil_ucrt_stdio_options.c: weak definitions, each over its
;; own static word.
@printf_word = internal global i64 0, align 8
@scanf_word = internal global i64 0, align 8

define weak ptr @__local_stdio_printf_options() {
  ret ptr @printf_word
}

define weak ptr @__local_stdio_scanf_options() {
  ret ptr @scanf_word
}

#--- ucrt.def
LIBRARY api-ms-win-crt-stdio-l1-1-0.dll
EXPORTS
  __acrt_iob_func
  __stdio_common_vfprintf
  __stdio_common_vsprintf

#--- noinc.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; int printf(const char *, ...); without <stdio.h>.
@fmt = private constant [4 x i8] c"%d\0A\00"

define i32 @main() {
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 42)
  ret i32 0
}

declare i32 @printf(ptr, ...)

#--- mix.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@fmt = private constant [4 x i8] c"%d\0A\00"
@buf = global [16 x i8] zeroinitializer, align 1

define i32 @main() {
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 42)
  %n = call i32 (ptr, ptr, ...) @sprintf(ptr @buf, ptr @fmt, i32 7)
  %s = call i32 @use_printf()
  ret i32 %s
}

declare i32 @printf(ptr, ...)
declare i32 @sprintf(ptr, ptr, ...)
declare i32 @use_printf()

#--- comdat.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; A TU that includes <stdio.h> and calls printf: the inline printf and
;; __local_stdio_printf_options as COMDAT copies.
$printf = comdat any
$__local_stdio_printf_options = comdat any

@__local_stdio_printf_options._OptionsStorage = internal global i64 0, align 8
@fmt = private constant [4 x i8] c"%d\0A\00"

define linkonce_odr i32 @printf(ptr %fmt, ...) #0 comdat {
  %ap = alloca ptr, align 8
  call void @llvm.va_start.p0(ptr %ap)
  %va = load ptr, ptr %ap, align 8
  %o = call ptr @__local_stdio_printf_options()
  %opts = load i64, ptr %o, align 8
  %out = call ptr @__acrt_iob_func(i32 1)
  %r = call i32 @__stdio_common_vfprintf(i64 %opts, ptr %out, ptr %fmt, ptr null, ptr %va)
  call void @llvm.va_end.p0(ptr %ap)
  ret i32 %r
}

define linkonce_odr ptr @__local_stdio_printf_options() #0 comdat {
  ret ptr @__local_stdio_printf_options._OptionsStorage
}

define i32 @use_printf() {
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 7)
  ret i32 %r
}

declare ptr @__acrt_iob_func(i32)
declare i32 @__stdio_common_vfprintf(i64, ptr, ptr, ptr, ptr)
declare void @llvm.va_start.p0(ptr)
declare void @llvm.va_end.p0(ptr)

attributes #0 = { noinline nounwind }
