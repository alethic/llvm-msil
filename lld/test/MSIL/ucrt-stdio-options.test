# RUN: FileCheck %s --check-prefix=LTO-READS-S --input-file=lto.txt
# LTO-READS-COUNT-2:   call native int() '<Module>'::'__local_stdio_printf_options'{{$}}
# LTO-READS-S-COUNT-2: call native int() '<Module>'::'__local_stdio_scanf_options'{{$}}
