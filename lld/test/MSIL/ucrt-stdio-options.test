# RUN: %{opts} lto-iso.txt | FileCheck %s --check-prefix=LTO-ISO
## Linked text: the definitions survive LTO, and the initializer ORs exactly
## the bits that the image's does, both halves in order: by default (36 and
## 2), with -llegacy_stdio_float_rounding (4 and 2), and with
## -liso_stdio_wide_specifiers or the bitcode's #pragma comment(lib) request
## for it (32 and 0).
# RUN: msil-ld --lto-emit-asm --lto-O2 lto.bc -o lto.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=LTO-TEXT --input-file=lto.il
# LTO-TEXT-DAG:  {{^}}.method {{.*}}static native int '__local_stdio_printf_options'() cil managed
# LTO-TEXT-DAG:  {{^}}.method {{.*}}static native int '__local_stdio_scanf_options'() cil managed
# RUN: FileCheck %s --check-prefix=LTO-BITS -DPF=36 -DSF=2 --input-file=lto.il
# RUN: msil-ld --lto-emit-asm --lto-O2 lto.bc -llegacy_stdio_float_rounding -o lto-fr.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=LTO-BITS -DPF=4 -DSF=2 --input-file=lto-fr.il
# RUN: msil-ld --lto-emit-asm --lto-O2 lto.bc -liso_stdio_wide_specifiers -o lto-iso-l.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=LTO-BITS -DPF=32 -DSF=0 --input-file=lto-iso-l.il
# RUN: msil-ld --lto-emit-asm --lto-O2 lto-iso.bc -o lto-iso.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=LTO-BITS -DPF=32 -DSF=0 --input-file=lto-iso.il
# LTO-BITS:      {{^}}.method private hidebysig specialname rtspecialname static void .cctor() cil managed{{$}}
# LTO-BITS-NOT:  call native int '__local_stdio_
# LTO-BITS:      {{^}}  call native int '__local_stdio_printf_options'(){{$}}
# LTO-BITS-NEXT: {{^}}  dup{{$}}
# LTO-BITS-NEXT: {{^}}  ldind.i8{{$}}
# LTO-BITS-NEXT: {{^}}  ldc.i8 [[PF]]{{$}}
# LTO-BITS-NEXT: {{^}}  or{{$}}
# LTO-BITS-NEXT: {{^}}  stind.i8{{$}}
# LTO-BITS-NEXT: {{^}}  call native int '__local_stdio_scanf_options'(){{$}}
# LTO-BITS-NEXT: {{^}}  dup{{$}}
# LTO-BITS-NEXT: {{^}}  ldind.i8{{$}}
# LTO-BITS-NEXT: {{^}}  ldc.i8 [[SF]]{{$}}
# LTO-BITS-NEXT: {{^}}  or{{$}}
# LTO-BITS-NEXT: {{^}}  stind.i8{{$}}
# LTO-BITS-NOT:  call native int '__local_stdio_
# LTO-BITS:      {{^[}]}} // end of method '.cctor'{{$}}

