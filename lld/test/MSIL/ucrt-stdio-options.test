# DEFAULT-NOT: {{.}}
## The pattern itself, in the listing.
# RUN: FileCheck %s --check-prefix=PATTERN --input-file=both.txt
# PATTERN:      {{^}}  .method '.cctor' void() flags=0x1891 impl=0x0000{{$}}
# PATTERN:      {{^}}    L{{[0-9]+}}: call native int() '<Module>'::'__local_stdio_printf_options'{{$}}
# PATTERN-NEXT: {{^}}    L{{[0-9]+}}: dup{{$}}
# PATTERN-NEXT: {{^}}    L{{[0-9]+}}: ldind.i8{{$}}
# PATTERN-NEXT: {{^}}    L{{[0-9]+}}: ldc.i8 36{{$}}
# PATTERN-NEXT: {{^}}    L{{[0-9]+}}: or{{$}}
# PATTERN-NEXT: {{^}}    L{{[0-9]+}}: stind.i8{{$}}

