#--- ldx-x64.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; long double and _Float64x are double on MSIL triples, and _Float128
;; has no MSIL form: the IR signatures say double, and only the names
;; make these native long double functions.
define i32 @main() {
  %nexttoward = call double @nexttoward(double 1.0, double 2.0)
  %nexttowardf = call float @nexttowardf(float 1.0, double 2.0)
  %wcstold = call double @wcstold(ptr null, ptr null)
  %sqrtf64x = call double @sqrtf64x(double 16.0)
  %lgammaf64x_r = call double @lgammaf64x_r(double 2.0, ptr null)
  %strtof64x_l = call double @strtof64x_l(ptr null, ptr null, ptr null)
  %f32addf64x = call float @f32addf64x(double 1.0, double 2.0)
  %sqrtf128 = call double @sqrtf128(double 16.0)
  ret i32 0
}

declare double @nexttoward(double, double)
declare float @nexttowardf(float, double)
declare double @wcstold(ptr, ptr)
declare double @sqrtf64x(double)
declare double @lgammaf64x_r(double, ptr)
declare double @strtof64x_l(ptr, ptr, ptr)
declare float @f32addf64x(double, double)
declare double @sqrtf128(double)

#--- ldaddr-x64.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; Only the address of expl is taken; the volatile load keeps it live.
@keep_expl = global ptr @expl

define i32 @main() {
  %f = load volatile ptr, ptr @keep_expl
  %c = icmp eq ptr %f, null
  %r = zext i1 %c to i32
  ret i32 %r
}

declare double @expl(double)

#--- ldctl-x64.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; _Float64 and _Float32x are double: these bind.
define i32 @main() {
  %a = call double @sqrtf64(double 16.0)
  %b = call double @sqrtf32x(double %a)
  %i = fptosi double %b to i32
  ret i32 %i
}

declare double @sqrtf64(double)
declare double @sqrtf32x(double)

