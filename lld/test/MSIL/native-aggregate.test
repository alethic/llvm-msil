# RUN: %{err} --implicit-check-not="'plain'" --input-file=out.txt
# RUN: FileCheck %s --check-prefix=ONCE --input-file=out.txt
# RUN: FileCheck %s --check-prefix=SEVEN --implicit-check-not=error: --implicit-check-not="'plain'" \
# RUN:   --input-file=out.txt
# RUN: FileCheck %s --check-prefixes=ERR-NONE,PLAIN-NONE --input-file=out.txt

## Linked text has no '<unknown>:0:0: in function' prefix (5.9.14).
