#--- agg.def
LIBRARY agg.dll
EXPORTS
  ret_pair
  plain

#--- agg.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x80
Symbols:
  - { Name: ret_pair,   Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x00, Size: 8 }
  - { Name: take_i128,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x08, Size: 8 }
  - { Name: take_byval, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x10, Size: 8 }
  - { Name: make_sret,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x18, Size: 8 }
  - { Name: ret_vec,    Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x20, Size: 8 }
  - { Name: ret_half,   Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x28, Size: 8 }
  - { Name: addr_i128,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x30, Size: 8 }
  - { Name: plain,      Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x38, Size: 8 }

#--- main.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

%struct.big = type { i64, i64, i64 }

@b = global %struct.big { i64 1, i64 2, i64 3 }
@fp = global ptr @addr_i128

define i32 @main() {
  %p1 = call { double, double } @ret_pair()
  %p2 = call { double, double } @ret_pair()
  %x = extractvalue { double, double } %p1, 0
  %y = extractvalue { double, double } %p2, 1
  call void @take_i128(i128 5)
  call void @take_byval(ptr byval(%struct.big) align 8 @b)
  %s = alloca %struct.big, align 8
  call void @make_sret(ptr sret(%struct.big) align 8 %s)
  %v = call <2 x float> @ret_vec()
  %h = call half @ret_half()
  %q = call i32 @plain(i32 1)
  %f = load ptr, ptr @fp
  %c = icmp eq ptr %f, null
  %z = zext i1 %c to i32
  %d = fadd double %x, %y
  %i = fptosi double %d to i32
  %r1 = add i32 %i, %q
  %r2 = add i32 %r1, %z
  ret i32 %r2
}

declare { double, double } @ret_pair()
declare void @take_i128(i128)
declare void @take_byval(ptr byval(%struct.big) align 8)
declare void @make_sret(ptr sret(%struct.big) align 8)
declare <2 x float> @ret_vec()
declare half @ret_half()
declare i32 @plain(i32)
declare void @addr_i128(i128)

#--- win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %p = call { double, double } @ret_pair()
  %x = extractvalue { double, double } %p, 0
  %q = call i32 @plain(i32 1)
  %i = fptosi double %x to i32
  %r = add i32 %i, %q
  ret i32 %r
}

declare { double, double } @ret_pair()
declare i32 @plain(i32)

#--- ldmath.def
LIBRARY ldmath.dll
EXPORTS
  sqrtl

#--- ld.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: sqrtl, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: sqrt,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x8, Size: 8 }
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: strtold, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: strtod,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x8, Size: 8 }

#--- ld-sqrtl.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; long double sqrtl(long double): long double is double on MSIL triples.
define i32 @main() {
  %r = call double @sqrtl(double 16.0)
  %i = fptosi double %r to i32
  ret i32 %i
}

declare double @sqrtl(double)

#--- ld-strtold.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@s = private constant [4 x i8] c"2.5\00"

define i32 @main() {
  %r = call double @strtold(ptr @s, ptr null)
  %i = fptosi double %r to i32
  ret i32 %i
}

declare double @strtold(ptr, ptr)

#--- ld-gnu.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-w64-windows-gnu-msil"

define i32 @main() {
  %r = call double @sqrtl(double 16.0)
  %i = fptosi double %r to i32
  ret i32 %i
}

declare double @sqrtl(double)

#--- ld-msvc.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %r = call double @sqrtl(double 16.0)
  %i = fptosi double %r to i32
  ret i32 %i
}

declare double @sqrtl(double)

#--- ld-explicit.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; __attribute__((import_module("libm.so.6"))) long double sqrtl(long double);
define i32 @main() {
  %r = call double @sqrtl(double 16.0)
  %i = fptosi double %r to i32
  ret i32 %i
}

declare double @sqrtl(double) #0

attributes #0 = { "msil-import-module"="libm.so.6" }

#--- ldx.yaml
## The functions of libldx.so.1 (ld.lld links it), for x86_64 and aarch64.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: [[MACHINE]]
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x58
Symbols:
  - { Name: nexttoward,   Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x00, Size: 8 }
  - { Name: nexttowardf,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x08, Size: 8 }
  - { Name: wcstold,      Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x10, Size: 8 }
  - { Name: sqrtf64x,     Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x18, Size: 8 }
  - { Name: lgammaf64x_r, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x20, Size: 8 }
  - { Name: strtof64x_l,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x28, Size: 8 }
  - { Name: f32addf64x,   Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x30, Size: 8 }
  - { Name: sqrtf128,     Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x38, Size: 8 }
