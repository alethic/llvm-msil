# ALIAS-FN-ADDR-NEXT: {{^}}    .maxstack 1{{$}}
# ALIAS-FN-ADDR-NEXT: {{^}}    L0: ldsfld native int '<msil>Data'::'<msil>fn_def_fn'{{$}}
# ALIAS-FN-ADDR-NEXT: {{^}}    L1: ret{{$}}
