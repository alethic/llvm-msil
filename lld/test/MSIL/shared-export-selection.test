# VIS-NEXT: {{^}}  .property 'alias_var' native int() flags=0x0000{{$}}
# VIS-NEXT: {{^}}    .get native int() 'vis'::'<msil>addr_alias_var'{{$}}
# VIS-NEXT: {{^}}  .property 'arr' native int() flags=0x0000{{$}}
