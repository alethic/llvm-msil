# VIS-NEXT: {{^}}  .property 'def_var' native int() flags=0x0000{{$}}
# VIS-NEXT: {{^}}    .get native int() 'vis'::'<msil>addr_def_var'{{$}}
# VIS-NEXT: {{^}}  .property 'prot_var' native int() flags=0x0000{{$}}
# VIS-NEXT: {{^}}    .get native int() 'vis'::'<msil>addr_prot_var'{{$}}
# VIS-NEXT: {{^}}  .property 'weak_var' native int() flags=0x0000{{$}}
# VIS-NEXT: {{^}}    .get native int() 'vis'::'<msil>addr_weak_var'{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_alias_fn' native int() flags=0x0096 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_alias_var' native int() flags=0x0896 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_arr' native int() flags=0x0896 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_cm' native int() flags=0x0896 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_def_fn' native int() flags=0x0096 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_def_var' native int() flags=0x0896 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_prot_fn' native int() flags=0x0096 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_prot_var' native int() flags=0x0896 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_weak_fn' native int() flags=0x0096 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method '<msil>addr_weak_var' native int() flags=0x0896 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method 'alias_fn' int32() flags=0x0016 impl=0x0000{{$}}
