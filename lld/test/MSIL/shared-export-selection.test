# VIS-NEXT: {{^}}  .method 'prot_fn' int32() flags=0x0016 impl=0x0000{{$}}
# VIS-NEXT: {{^}}  .method 'weak_fn' int32() flags=0x0016 impl=0x0000{{$}}
