# VIS-TABLE-DAG:  {{^}}Data 'alias_var' size=4 align=4{{$}}
# VIS-TABLE-DAG:  {{^}}Function WEAK 'weak_fn'{{$}}

## Windows: dllexport in one input selects the dllexport definitions of all
## inputs; --export-all-symbols exports every candidate again.
# RUN: msil-ld -shared win.o other.o -o win.dll 2>&1 | count 0
# RUN: llvm-cil-dump win.dll > win.txt
# RUN: %{listing} members win.txt win | FileCheck %s --check-prefix=DLLEXPORT
