# ALIAS-VAR:      {{^}}  .method '<msil>addr_alias_var' native int() flags=0x0896 impl=0x0000{{$}}
# ALIAS-VAR-NEXT: {{^}}    .maxstack 2{{$}}
# ALIAS-VAR-NEXT: {{^}}    L0: ldsfld native int '<msil>Data'::'arr'{{$}}
# ALIAS-VAR-NEXT: {{^}}    L1: ldc.i4.4{{$}}
# ALIAS-VAR-NEXT: {{^}}    L2: add{{$}}
# ALIAS-VAR-NEXT: {{^}}    L3: ret{{$}}

## The symbol table lists the variables and the weak ones' flags.
# RUN: llvm-cil-dump --link-info vis.dll | FileCheck %s --check-prefix=VIS-TABLE
