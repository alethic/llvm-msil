## The hidden definitions are <Module>'s (def_fn keeps them alive).
# RUN: %{listing} members vis.txt '<Module>' | FileCheck %s --check-prefix=VIS-MODULE \
# RUN:   --implicit-check-not=def_fn --implicit-check-not=prot_fn --implicit-check-not=weak_fn
# VIS-MODULE: {{^}}  .method 'hid_fn' int32() flags=0x00{{13|16}} impl=0x0000{{$}}
