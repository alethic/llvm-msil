## A program with its own copy of inl links against the library without a
## warning, and calls its own copy.
# RUN: msil-ld cdprog.o cd/cd.dll -o cdprog.exe 2>&1 | count 0
# RUN: llvm-cil-dump cdprog.exe | FileCheck %s --check-prefix=CD-PROG --implicit-check-not="[cd]cd::'inl'"
# CD-PROG: {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# CD-PROG: {{^}}    L{{[0-9]+}}: call int32() '<Module>'::'inl'{{$}}
# CD-PROG: {{^}}    L{{[0-9]+}}: call int32() [cd]cd::'plain'{{$}}

## dllexport selects a dllexport COMDAT function (dx, weak_odr as clang
## writes a __declspec(dllexport) inline function; a linkonce_odr definition
## that nothing uses is not even in the object), and not the non-dllexport
## one (inl2).
# RUN: msil-ld -shared cdx.o -o cdx/cdx.dll 2>&1 | count 0
# RUN: llvm-cil-dump cdx/cdx.dll > cdx.txt
# RUN: %{listing} members cdx.txt cdx | FileCheck %s --check-prefix=CDX --implicit-check-not=inl2
# CDX:      {{^}}.class 'cdx' flags=0x00000181 extends [mscorlib]System.Object{{$}}
# CDX-NEXT: {{^}}  .method '<msil>addr_dx' native int() flags=0x0096 impl=0x0000{{$}}
# CDX-NEXT: {{^}}  .method 'dx' int32() flags=0x0016 impl=0x0000{{$}}
# CDX-NOT:  {{.}}

## ELF is unchanged: the COMDAT function is exported.
# RUN: msil-ld -shared cdelf.o -o cdelf/cdelf.dll 2>&1 | count 0
# RUN: llvm-cil-dump cdelf/cdelf.dll > cdelf.txt
# RUN: %{listing} members cdelf.txt cdelf | FileCheck %s --check-prefix=CDELF
# CDELF:      {{^}}.class 'cdelf' flags=0x00000181 extends [mscorlib]System.Object{{$}}
# CDELF-NEXT: {{^}}  .method '<msil>addr_inl' native int() flags=0x0096 impl=0x0000{{$}}
# CDELF-NEXT: {{^}}  .method '<msil>addr_plain' native int() flags=0x0096 impl=0x0000{{$}}
# CDELF-NEXT: {{^}}  .method 'inl' int32() flags=0x0016 impl=0x0000{{$}}
# CDELF-NEXT: {{^}}  .method 'plain' int32() flags=0x0016 impl=0x0000{{$}}
# CDELF-NOT:  {{.}}

#--- vis.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@def_var = global i32 1, align 4
@prot_var = protected global i32 2, align 4
@hid_var = hidden global i32 3, align 4
@cm = common global i32 0, align 4
@weak_var = weak global i32 4, align 4
@arr = global [4 x i32] [i32 1, i32 2, i32 3, i32 4], align 4
@alias_var = alias i32, getelementptr (i8, ptr @arr, i64 4)

define hidden i32 @hid_fn() {
  ret i32 3
}

define i32 @def_fn() {
  %h = call i32 @hid_fn()
  %v = load i32, ptr @hid_var
  %r = add i32 %h, %v
  ret i32 %r
}

define protected i32 @prot_fn() {
  ret i32 2
}

define weak i32 @weak_fn() {
  ret i32 5
}

@alias_fn = alias i32 (), ptr @def_fn

#--- vis2.ll
; A second tentative definition of cm, larger: one export of 8 bytes.
target triple = "x86_64-unknown-linux-gnu-msil"

@cm = common global i64 0, align 8

#--- win.ll
target triple = "x86_64-pc-windows-msvc-msil"

@exp_var = dllexport global i32 1, align 4
@plain_var = global i32 2, align 4

declare i32 @other_fn()

define dllexport i32 @exp_fn() {
  %p = call i32 @plain_fn()
  %o = call i32 @other_fn()
  %v = load i32, ptr @plain_var
  %r = add i32 %p, %o
  %s = add i32 %r, %v
  ret i32 %s
}

define i32 @plain_fn() {
  ret i32 2
}

#--- other.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @other_fn() {
  ret i32 3
}

#--- api.ll
target triple = "x86_64-unknown-linux-gnu-msil"

declare i32 @x_fn()
declare i32 @y_fn()

define i32 @api() {
  %x = call i32 @x_fn()
  %y = call i32 @y_fn()
  %r = add i32 %x, %y
  ret i32 %r
}

#--- xm.ll
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @x_fn() {
  ret i32 1
}

#--- ym.ll
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @y_fn() {
  ret i32 2
}

#--- tls.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@tv = global i32 5, section ".tdata", align 4

define i32 @get() {
  %v = load i32, ptr @tv
  ret i32 %v
}

#--- cd.ll
; What clang -fms-compatibility writes for a string literal, a
; __declspec(selectany) variable and a header inline function, used by
; plain; w is weak but in no COMDAT group.
target triple = "x86_64-pc-windows-msvc-msil"

$"??_C@_05CJBACGMB@hello?$AA@" = comdat any
$sel = comdat any
$inl = comdat any

@"??_C@_05CJBACGMB@hello?$AA@" = linkonce_odr dso_local unnamed_addr constant [6 x i8] c"hello\00", comdat, align 1
@sel = weak_odr dso_local global i32 0, comdat, align 4
@w = weak global i32 1, align 4

define linkonce_odr dso_local i32 @inl() comdat {
  ret i32 4
}

define i32 @plain() {
  %c = load i8, ptr @"??_C@_05CJBACGMB@hello?$AA@", align 1
  %ci = zext i8 %c to i32
  %s = load i32, ptr @sel, align 4
  %i = call i32 @inl()
  %a = add i32 %ci, %s
  %b = add i32 %a, %i
  ret i32 %b
}

#--- cdprog.ll
target triple = "x86_64-pc-windows-msvc-msil"

$inl = comdat any

declare i32 @plain()

define linkonce_odr dso_local i32 @inl() comdat {
  ret i32 4
}

define i32 @main() {
  %i = call i32 @inl()
  %p = call i32 @plain()
  %r = add i32 %i, %p
  ret i32 %r
}

#--- cdx.ll
target triple = "x86_64-pc-windows-msvc-msil"

$dx = comdat any
$inl2 = comdat any

define weak_odr dllexport i32 @dx() comdat {
  %i = call i32 @inl2()
  ret i32 %i
}

define linkonce_odr dso_local i32 @inl2() comdat {
  ret i32 5
}

#--- cdelf.ll
target triple = "x86_64-unknown-linux-gnu-msil"

$inl = comdat any

define linkonce_odr i32 @inl() comdat {
  ret i32 4
}

define i32 @plain() {
  %i = call i32 @inl()
  ret i32 %i
}
