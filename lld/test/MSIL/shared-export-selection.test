# VIS-DATA: {{^}}  .field 'hid_var' native int flags=0x0033{{$}}

## The aliases.
# RUN: %{listing} method vis.txt vis alias_fn | FileCheck %s --check-prefix=ALIAS-FN
# ALIAS-FN:      {{^}}  .method 'alias_fn' int32() flags=0x0016 impl=0x0000{{$}}
# ALIAS-FN-NEXT: {{^}}    .maxstack {{[0-9]+}}{{$}}
# ALIAS-FN-NEXT: {{^}}    L0: call int32() 'vis'::'def_fn'{{$}}
# ALIAS-FN-NEXT: {{^}}    L1: ret{{$}}
