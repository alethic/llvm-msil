## Constrained (strictfp) conversions between i128 and float32 or float64 in
## msil-ld's LTO code generation (ImplementationPlan.md 5.13.6, slot P0;
## M24.c (1); llvm/test/CodeGen/MSIL/strict-i128.ll covers llc). MSILPrepareIR
## runs MSIL::relaxStrictInt128Conversions in every mode, msil-ld's LTO
## backend included, so the merged module's constrained sitofp and uitofp
## with an i128 operand and fptosi and fptoui with an i128 result become
## plain conversions before ExpandIRInsts, which expands them inline. An LTO
## link that writes an image and an --lto-emit-asm link therefore report
## nothing, and neither output names compiler-rt's __floattisf, __floattidf,
## __floatuntisf, __floatuntidf, __fixsfti, __fixdfti, __fixunssfti or
## __fixunsdfti; until M24 each conversion was the backend's error for a
## runtime helper. The bitcode holds the eight conversions as clang emits
## them under '#pragma STDC FENV_ACCESS ON' (strictfp functions and calls,
## round.dynamic, fpexcept.strict), each in a noinline function that main
## calls, for x86_64-unknown-linux-gnu-msil, x86_64-pc-windows-msvc-msil and
## aarch64-unknown-linux-gnu-msil. --save-temps shows that LTO's optimizer
## leaves all eight to code generation (<output>.0.5.precodegen.bc).

# RUN: rm -rf %t && split-file %s %t && cd %t

# DEFINE: %{none} = --implicit-check-not=__floattisf --implicit-check-not=__floattidf \
# DEFINE:   --implicit-check-not=__floatuntisf --implicit-check-not=__floatuntidf \
# DEFINE:   --implicit-check-not=__fixsfti --implicit-check-not=__fixdfti \
# DEFINE:   --implicit-check-not=__fixunssfti --implicit-check-not=__fixunsdfti

## x86_64-unknown-linux-gnu-msil.
# RUN: cat lnx.head body.ll > lnx.ll
# RUN: llvm-as lnx.ll -o lnx.bc
# RUN: msil-ld --save-temps lnx.bc -o lnx.exe 2>&1 | count 0
# RUN: opt -S lnx.exe.0.5.precodegen.bc -o lnx.pre.ll
# RUN: FileCheck %s --check-prefix=PRE --input-file=lnx.pre.ll
# RUN: %if llvm-cil-dump %{ llvm-cil-dump lnx.exe | FileCheck %s --check-prefix=IMAGE %{none} %}
# RUN: msil-ld --lto-emit-asm lnx.bc -o lnx.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=TEXT %{none} --input-file=lnx.il

## x86_64-pc-windows-msvc-msil.
# RUN: cat win.head body.ll > win.ll
# RUN: llvm-as win.ll -o win.bc
# RUN: msil-ld --save-temps win.bc -o win.exe 2>&1 | count 0
# RUN: opt -S win.exe.0.5.precodegen.bc -o win.pre.ll
# RUN: FileCheck %s --check-prefix=PRE --input-file=win.pre.ll
# RUN: %if llvm-cil-dump %{ llvm-cil-dump win.exe | FileCheck %s --check-prefix=IMAGE %{none} %}
# RUN: msil-ld --lto-emit-asm win.bc -o win.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=TEXT %{none} --input-file=win.il

## aarch64-unknown-linux-gnu-msil.
# RUN: cat a64.head body.ll > a64.ll
# RUN: llvm-as a64.ll -o a64.bc
# RUN: msil-ld --save-temps a64.bc -o a64.exe 2>&1 | count 0
# RUN: opt -S a64.exe.0.5.precodegen.bc -o a64.pre.ll
# RUN: FileCheck %s --check-prefix=PRE --input-file=a64.pre.ll
# RUN: %if llvm-cil-dump %{ llvm-cil-dump a64.exe | FileCheck %s --check-prefix=IMAGE %{none} %}
# RUN: msil-ld --lto-emit-asm a64.bc -o a64.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=TEXT %{none} --input-file=a64.il

## The merged module that code generation receives still holds the eight
## constrained calls.
# PRE-DAG: call float @llvm.experimental.constrained.sitofp.f32.i128(i128 {{%.+}}, metadata !"round.dynamic", metadata !"fpexcept.strict")
# PRE-DAG: call double @llvm.experimental.constrained.sitofp.f64.i128(i128 {{%.+}}, metadata !"round.dynamic", metadata !"fpexcept.strict")
# PRE-DAG: call float @llvm.experimental.constrained.uitofp.f32.i128(i128 {{%.+}}, metadata !"round.dynamic", metadata !"fpexcept.strict")
# PRE-DAG: call double @llvm.experimental.constrained.uitofp.f64.i128(i128 {{%.+}}, metadata !"round.dynamic", metadata !"fpexcept.strict")
# PRE-DAG: call i128 @llvm.experimental.constrained.fptosi.i128.f32(float {{%.+}}, metadata !"fpexcept.strict")
# PRE-DAG: call i128 @llvm.experimental.constrained.fptosi.i128.f64(double {{%.+}}, metadata !"fpexcept.strict")
# PRE-DAG: call i128 @llvm.experimental.constrained.fptoui.i128.f32(float {{%.+}}, metadata !"fpexcept.strict")
# PRE-DAG: call i128 @llvm.experimental.constrained.fptoui.i128.f64(double {{%.+}}, metadata !"fpexcept.strict")

## Each conversion keeps its method (i128 as two native int halves, an i128
## result through the hidden result pointer); the plain checks let the
## implicit ones cover the whole output.
# IMAGE:      {{^}}  .method 'fptosi_f32_i128' void(native int, float32) flags=0x0013 impl=0x0000{{$}}
# IMAGE:      {{^}}  .method 'fptosi_f64_i128' void(native int, float64) flags=0x0013 impl=0x0000{{$}}
# IMAGE:      {{^}}  .method 'fptoui_f32_i128' void(native int, float32) flags=0x0013 impl=0x0000{{$}}
# IMAGE:      {{^}}  .method 'fptoui_f64_i128' void(native int, float64) flags=0x0013 impl=0x0000{{$}}
# IMAGE:      {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# IMAGE:      {{^}}  .method 'sitofp_i128_f32' float32(native int, native int) flags=0x0013 impl=0x0000{{$}}
# IMAGE:      {{^}}  .method 'sitofp_i128_f64' float64(native int, native int) flags=0x0013 impl=0x0000{{$}}
# IMAGE:      {{^}}  .method 'uitofp_i128_f32' float32(native int, native int) flags=0x0013 impl=0x0000{{$}}
# IMAGE:      {{^}}  .method 'uitofp_i128_f64' float64(native int, native int) flags=0x0013 impl=0x0000{{$}}

# TEXT:       {{^}}.method assembly static float32 'sitofp_i128_f32'(native int, native int) cil managed{{$}}
# TEXT:       {{^}}.method assembly static float64 'sitofp_i128_f64'(native int, native int) cil managed{{$}}
# TEXT:       {{^}}.method assembly static float32 'uitofp_i128_f32'(native int, native int) cil managed{{$}}
# TEXT:       {{^}}.method assembly static float64 'uitofp_i128_f64'(native int, native int) cil managed{{$}}
# TEXT:       {{^}}.method assembly static void 'fptosi_f32_i128'(native int, float32) cil managed{{$}}
# TEXT:       {{^}}.method assembly static void 'fptosi_f64_i128'(native int, float64) cil managed{{$}}
# TEXT:       {{^}}.method assembly static void 'fptoui_f32_i128'(native int, float32) cil managed{{$}}
# TEXT:       {{^}}.method assembly static void 'fptoui_f64_i128'(native int, float64) cil managed{{$}}
# TEXT:       {{^}}.method public static int32 'main'() cil managed{{$}}

#--- lnx.head
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

#--- win.head
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

#--- a64.head
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "aarch64-unknown-linux-gnu-msil"

#--- body.ll
;; The arguments are volatile loads and the results volatile stores, so
;; nothing folds a conversion.
@i = global i128 1267650600228229401496703205376
@f = global float 1.024000e+03
@d = global double 1.000000e+15
@of = global float 0.000000e+00
@od = global double 0.000000e+00
@oi = global i128 0

define float @sitofp_i128_f32(i128 %x) #1 {
  %r = call float @llvm.experimental.constrained.sitofp.f32.i128(i128 %x, metadata !"round.dynamic", metadata !"fpexcept.strict") #0
  ret float %r
}

define double @sitofp_i128_f64(i128 %x) #1 {
  %r = call double @llvm.experimental.constrained.sitofp.f64.i128(i128 %x, metadata !"round.dynamic", metadata !"fpexcept.strict") #0
  ret double %r
}

define float @uitofp_i128_f32(i128 %x) #1 {
  %r = call float @llvm.experimental.constrained.uitofp.f32.i128(i128 %x, metadata !"round.dynamic", metadata !"fpexcept.strict") #0
  ret float %r
}

define double @uitofp_i128_f64(i128 %x) #1 {
  %r = call double @llvm.experimental.constrained.uitofp.f64.i128(i128 %x, metadata !"round.dynamic", metadata !"fpexcept.strict") #0
  ret double %r
}

define i128 @fptosi_f32_i128(float %x) #1 {
  %r = call i128 @llvm.experimental.constrained.fptosi.i128.f32(float %x, metadata !"fpexcept.strict") #0
  ret i128 %r
}

define i128 @fptosi_f64_i128(double %x) #1 {
  %r = call i128 @llvm.experimental.constrained.fptosi.i128.f64(double %x, metadata !"fpexcept.strict") #0
  ret i128 %r
}

define i128 @fptoui_f32_i128(float %x) #1 {
  %r = call i128 @llvm.experimental.constrained.fptoui.i128.f32(float %x, metadata !"fpexcept.strict") #0
  ret i128 %r
}

define i128 @fptoui_f64_i128(double %x) #1 {
  %r = call i128 @llvm.experimental.constrained.fptoui.i128.f64(double %x, metadata !"fpexcept.strict") #0
  ret i128 %r
}

define i32 @main() #0 {
  %x = load volatile i128, ptr @i
  %a = call float @sitofp_i128_f32(i128 %x) #0
  store volatile float %a, ptr @of
  %b = call double @sitofp_i128_f64(i128 %x) #0
  store volatile double %b, ptr @od
  %c = call float @uitofp_i128_f32(i128 %x) #0
  store volatile float %c, ptr @of
  %e = call double @uitofp_i128_f64(i128 %x) #0
  store volatile double %e, ptr @od
  %y = load volatile float, ptr @f
  %z = load volatile double, ptr @d
  %g = call i128 @fptosi_f32_i128(float %y) #0
  store volatile i128 %g, ptr @oi
  %h = call i128 @fptosi_f64_i128(double %z) #0
  store volatile i128 %h, ptr @oi
  %j = call i128 @fptoui_f32_i128(float %y) #0
  store volatile i128 %j, ptr @oi
  %k = call i128 @fptoui_f64_i128(double %z) #0
  store volatile i128 %k, ptr @oi
  ret i32 0
}

declare float @llvm.experimental.constrained.sitofp.f32.i128(i128, metadata, metadata)
declare double @llvm.experimental.constrained.sitofp.f64.i128(i128, metadata, metadata)
declare float @llvm.experimental.constrained.uitofp.f32.i128(i128, metadata, metadata)
declare double @llvm.experimental.constrained.uitofp.f64.i128(i128, metadata, metadata)
declare i128 @llvm.experimental.constrained.fptosi.i128.f32(float, metadata)
declare i128 @llvm.experimental.constrained.fptosi.i128.f64(double, metadata)
declare i128 @llvm.experimental.constrained.fptoui.i128.f32(float, metadata)
declare i128 @llvm.experimental.constrained.fptoui.i128.f64(double, metadata)

attributes #0 = { strictfp }
attributes #1 = { noinline strictfp }
