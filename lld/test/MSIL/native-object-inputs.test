# RUN: llc -filetype=obj use-lnx.ll -o use-lnx.o
# RUN: llc -filetype=obj main-win.ll -o main-win.o
# RUN: llc -filetype=obj use-win.ll -o use-win.o
# RUN: llvm-as main-lnx.ll -o main-lnx.bc
# RUN: yaml2obj empty-elf.yaml -o empty-elf.o
# RUN: yaml2obj unused-elf.yaml -o unused-elf.o
# RUN: yaml2obj -D NAME=nat_fn unused-elf.yaml -o nat-elf.o
# RUN: yaml2obj empty-coff.yaml -o empty-coff.obj
# RUN: yaml2obj %S/Inputs/native/coff-code.yaml -o unused-coff.obj
# RUN: yaml2obj -D FN1=nat_fn %S/Inputs/native/coff-code.yaml -o nat-coff.obj
# RUN: yaml2obj wasm.yaml -o wasm.o
# RUN: mkdir plain e u lplain le wplain we wu m lib

