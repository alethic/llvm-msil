# RUN:   | %{nobind} -DFILE=nat-elf.o

## An oldnames-style alias object on the command line binds through its
## alias, in bitcode (--lto-emit-asm) and CIL object links. The text has no
## method '_strdup' ('--implicit-check-not' covers only the text before the
## first match of a -DAG-only prefix, so ALIAS-NONE checks the whole file).
# RUN: llvm-lib /machine:x64 /def:%S/Inputs/native/ucrt-string.def /out:lib/ucrt.lib
# RUN: yaml2obj --docnum=1 %S/Inputs/native/oldnames.yaml -o strdup.obj
# RUN: llvm-as strdup-main.ll -o strdup-main.bc
# RUN: llc -filetype=obj strdup-main.ll -o strdup-main.o
# RUN: msil-ld --lto-emit-asm --lto-O0 strdup-main.bc strdup.obj lib/ucrt.lib -o strdup.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=ALIAS --input-file=strdup.il
# RUN: FileCheck %s --check-prefix=ALIAS-NONE --input-file=strdup.il
# ALIAS-DAG: {{^}}.method assembly hidebysig static pinvokeimpl("api-ms-win-crt-string-l1-1-0.dll" as "_strdup" nomangle cdecl) native int 'strdup'(native int) cil managed preservesig {}{{$}}
# ALIAS-DAG: {{^}}.method assembly hidebysig static pinvokeimpl("api-ms-win-crt-string-l1-1-0.dll" nomangle cdecl) native int 'strlen'(native int) cil managed preservesig {}{{$}}
# ALIAS-DAG: call native int 'strdup'(native int)
# ALIAS-NONE-NOT: '_strdup'
# RUN: msil-ld strdup-main.o strdup.obj lib/ucrt.lib --print-imports -o strdup.exe > strdup-imports.txt 2>&1
# RUN: FileCheck %s --check-prefix=ALIAS-OBJ --match-full-lines --input-file=strdup-imports.txt
# ALIAS-OBJ:      strdup -> api-ms-win-crt-string-l1-1-0.dll!_strdup [function, -]
# ALIAS-OBJ-NEXT: strlen -> api-ms-win-crt-string-l1-1-0.dll!strlen [function, -]
# ALIAS-OBJ-NOT:  {{.}}

## A WebAssembly object: the error names the format.
# RUN: not msil-ld main-lnx.o wasm.o -o x.exe 2>&1 | %{fc} --check-prefix=WASM --implicit-check-not=error:
# WASM: {{^}}msil-ld: error: {{.*}}wasm.o{{.*([Ww]asm|WebAssembly).*$}}

#--- main-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  ret i32 0
}

#--- use-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

declare i32 @nat_fn()

define i32 @main() {
  %r = call i32 @nat_fn()
  ret i32 %r
}

#--- main-win.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  ret i32 0
}

#--- use-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

declare i32 @nat_fn()

define i32 @main() {
  %r = call i32 @nat_fn()
  ret i32 %r
}

#--- natlib.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @nat_fn() {
  ret i32 7
}

#--- strdup-main.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@msg = private constant [3 x i8] c"hi\00"

define i32 @main() {
  %p = call ptr @strdup(ptr @msg)
  %n = call i64 @strlen(ptr %p)
  %r = trunc i64 %n to i32
  ret i32 %r
}

declare ptr @strdup(ptr)
declare i64 @strlen(ptr)

#--- nat.def
LIBRARY nat.dll
EXPORTS
  nat_fn

#--- empty-elf.yaml
## An x86_64 ELF object with an empty .text and no symbol (rustc's
## symbols.o).
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]

#--- unused-elf.yaml
## An x86_64 ELF object that defines one function in machine code.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: '[[NAME=unused_nat]]', Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }

#--- empty-coff.yaml
## An AMD64 COFF object with one 'ret' in .text and no symbol.
--- !COFF
header:
  Machine:         IMAGE_FILE_MACHINE_AMD64
  Characteristics: [  ]
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    Alignment:       16
    SectionData:     C3
symbols:         []

#--- wasm.yaml
## A WebAssembly object (a 'linking' section).
--- !WASM
FileHeader:
  Version: 0x00000001
Sections:
  - Type:    CUSTOM
    Name:    linking
    Version: 2
