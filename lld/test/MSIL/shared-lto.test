## A CIL object against the bitcode archives: x_fn and y_fn stay in
## <Module>, and only api is exported.
# RUN: msil-ld -shared api.o libx.a liby.a --exclude-libs=ALL -o exm/ex.dll 2>&1 | count 0
# RUN: llvm-cil-dump exm/ex.dll > exm.txt
# RUN: %{listing} members exm.txt ex | FileCheck %s --check-prefix=EX-ALL
# RUN: %{listing} members exm.txt '<Module>' | FileCheck %s --check-prefix=EXM-MODULE
# EXM-MODULE:      {{^}}.class '<Module>' flags=0x00000000{{$}}
# EXM-MODULE-NEXT: {{^}}  .method 'x_fn' int32() flags=0x0016 impl=0x0000{{$}}
# EXM-MODULE-NEXT: {{^}}  .method 'y_fn' int32() flags=0x0016 impl=0x0000{{$}}
# EXM-MODULE-NOT:  {{.}}

## A bitcode program against the library.
# RUN: msil-ld prog.bc lib.dll -o prog.exe 2>&1 | count 0
# RUN: llvm-cil-dump prog.exe | FileCheck %s --check-prefix=PROG
# PROG: {{^}}assemblyref 'lib' ver 0.0.0.0 flags=0x00000000 key=- culture=''{{$}}
# PROG: {{^}}    L{{[0-9]+}}: call int32(int32) [lib]lib::'api'{{$}}

## --lto-emit-asm.
# RUN: not msil-ld -shared --lto-emit-asm lib.bc -o x.il 2>&1 | %{fc} --check-prefix=EMIT-SHARED \
# RUN:   --implicit-check-not=error: --implicit-check-not=warning:
# EMIT-SHARED: {{^}}msil-ld: error: --lto-emit-asm cannot write a -shared library; link without --lto-emit-asm{{$}}
# RUN: not msil-ld --lto-emit-asm prog.bc lib.dll -o x.il 2>&1 | %{fc} --check-prefix=EMIT-IMPORT \
# RUN:   --implicit-check-not=error: --implicit-check-not=warning:
# EMIT-IMPORT: {{^}}msil-ld: error: lib.dll: --lto-emit-asm cannot import from a .NET library; link without --lto-emit-asm{{$}}

#--- lib.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@gv = global i32 3, align 4

define hidden i32 @hid(i32 %x) noinline {
  %r = mul i32 %x, 3
  ret i32 %r
}

define i32 @api(i32 %x) {
  %h = call i32 @hid(i32 %x)
  %v = load i32, ptr @gv, align 4
  %r = add i32 %h, %v
  ret i32 %r
}

define i32 @unused_api() {
  ret i32 11
}

#--- win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@sink = internal global i32 0

define i32 @plain() noinline {
  store volatile i32 1, ptr @sink
  ret i32 2
}

define dllexport i32 @exp() {
  %p = call i32 @plain()
  ret i32 %p
}

#--- prog.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

declare i32 @api(i32)

define i32 @main() {
  %r = call i32 @api(i32 4)
  ret i32 %r
}

#--- comdat.ll
; What clang -fms-compatibility writes for a string literal, a
; __declspec(selectany) variable and a header inline function, all used by
; plain; w is weak but in no COMDAT group.
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

$"??_C@_05CJBACGMB@hello?$AA@" = comdat any
$sel = comdat any
$inl = comdat any

@"??_C@_05CJBACGMB@hello?$AA@" = linkonce_odr dso_local unnamed_addr constant [6 x i8] c"hello\00", comdat, align 1
@sel = weak_odr dso_local global i32 0, comdat, align 4
@w = weak global i32 1, align 4

define linkonce_odr dso_local i32 @inl() comdat {
  ret i32 4
}

define i32 @plain() {
  %c = load i8, ptr @"??_C@_05CJBACGMB@hello?$AA@", align 1
  %ci = zext i8 %c to i32
  %s = load i32, ptr @sel, align 4
  %i = call i32 @inl()
  %a = add i32 %ci, %s
  %b = add i32 %a, %i
  ret i32 %b
}

#--- xm.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @x_fn() {
  ret i32 1
}

#--- ym.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @y_fn() {
  ret i32 2
}

#--- api.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

declare i32 @x_fn()
declare i32 @y_fn()

define i32 @api() {
  %x = call i32 @x_fn()
  %y = call i32 @y_fn()
  %r = add i32 %x, %y
  ret i32 %r
}
