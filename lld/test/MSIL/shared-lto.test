# DEFINE: %{listing} = %python %S/Inputs/shared/listing.py

## Default-visibility bitcode definitions are exported, unused ones too.
# RUN: msil-ld -shared lib.bc -o lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump lib.dll > lib.txt
# RUN: %{listing} members lib.txt lib | FileCheck %s --check-prefix=LIB
# LIB:      {{^}}.class 'lib' flags=0x00000181 extends [mscorlib]System.Object{{$}}
# LIB-NEXT: {{^}}  .property 'gv' native int() flags=0x0000{{$}}
# LIB-NEXT: {{^}}    .get native int() 'lib'::'<msil>addr_gv'{{$}}
# LIB-NEXT: {{^}}  .method '<msil>addr_api' native int() flags=0x0096 impl=0x0000{{$}}
# LIB-NEXT: {{^}}  .method '<msil>addr_gv' native int() flags=0x0896 impl=0x0000{{$}}
# LIB-NEXT: {{^}}  .method '<msil>addr_unused_api' native int() flags=0x0096 impl=0x0000{{$}}
# LIB-NEXT: {{^}}  .method 'api' int32(int32) flags=0x0016 impl=0x0000{{$}}
# LIB-NEXT: {{^}}    .param 1 'A_0' flags=0x0000{{$}}
# LIB-NEXT: {{^}}  .method 'unused_api' int32() flags=0x0016 impl=0x0000{{$}}
# LIB-NOT:  {{.}}
# RUN: llvm-cil-dump --link-info lib.dll | FileCheck %s --check-prefix=LIB-TABLE
# LIB-TABLE:      {{^}}SymbolTable v1.0 triple=x86_64-unknown-linux-gnu-msil abi=1 runtime='none' datamodel=8,8,4,8{{$}}
# LIB-TABLE-NEXT: {{^}}ExportClass 'lib'{{$}}
# LIB-TABLE-NEXT: {{^}}Data 'gv' size=4 align=4{{$}}
# LIB-TABLE-NOT:  {{.}}

