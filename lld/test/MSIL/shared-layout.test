## The export-class limit: 8 methods against --msil-type-member-limit=7
## (the other classes hold at most 7 members); 8 links. The failing link
## writes x.dll, so its export class is 'x'.
# RUN: not msil-ld -shared lib.o --msil-type-member-limit=7 -o x.dll 2>&1 | %{fc} --check-prefix=LIMIT
# LIMIT: {{^}}msil-ld: error: export class 'x' would hold 8 methods; the CLR allows 65,524{{$}}
# RUN: mkdir limit
# RUN: msil-ld -shared lib.o --msil-type-member-limit=8 -o limit/lib.dll 2>&1 | count 0

#--- long.py
# An --export-class value of <n> bytes: 'Ns.' and n - 3 letters A.
import sys
n = int(sys.argv[1])
print("--export-class=Ns." + "A" * (n - 3))

#--- lib.ll
target triple = "x86_64-pc-windows-msvc-msil"

@counter = global i32 5, align 4
@table = constant [2 x i32] [i32 1, i32 2], align 4
@calls = internal global i32 0, align 4

define hidden i32 @helper(i32 %x) {
  %r = mul i32 %x, 10
  ret i32 %r
}

define internal i32 @local_fn(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

define i32 @twice(i32 %x) {
  %c = load i32, ptr @calls
  %c1 = add i32 %c, 1
  store i32 %c1, ptr @calls
  %h = call i32 @helper(i32 %x)
  %l = call i32 @local_fn(i32 %h)
  ret i32 %l
}

define i32 @add(i32 %a, i32 %b) {
  %r = add i32 %a, %b
  ret i32 %r
}

define i32 @main() {
  ret i32 0
}

define internal void @init() {
  store i32 100, ptr @counter
  ret void
}

@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init, ptr null }]

#--- main.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  ret i32 0
}
