## A name the references do not have is a warning, and the link goes on.
# RUN: msil-ld prog.o v8/lib.dll --reference=packnt -o out/nt.exe 2>&1 | %{fc} --check-prefix=ABSENT \
# RUN:   --implicit-check-not=error: --implicit-check-not=warning:
# ABSENT: {{^}}msil-ld: warning: v8{{[/\\]}}lib.dll references FakeThreading, which is not among the references{{$}}

## Without references: the built-in table has mscorlib 4.0.0.0 only.
# RUN: msil-ld prog.o v8/lib.dll -o out/builtin.exe > builtin.txt 2>&1
# RUN: %{fc} --check-prefix=BUILTIN --implicit-check-not=error: --input-file=builtin.txt
# BUILTIN-DAG: {{^}}msil-ld: warning: v8{{[/\\]}}lib.dll references FakeCore, which is not among the references{{$}}
# BUILTIN-DAG: {{^}}msil-ld: warning: v8{{[/\\]}}lib.dll references FakeInterop, which is not among the references{{$}}
# BUILTIN-DAG: {{^}}msil-ld: warning: v8{{[/\\]}}lib.dll references FakeThreading, which is not among the references{{$}}
# RUN: msil-ld prog.o none/lib.dll -o out/none.exe 2>&1 | count 0
# RUN: msil-ld prog.o none/lib.dll --reference=mscorlib -o out/mscorlib.exe 2>&1 | count 0
# RUN: msil-ld prog.o none/lib.dll --reference=pack -o out/none-pack.exe 2>&1 | %{fc} --check-prefix=NO-MSCORLIB \
# RUN:   --implicit-check-not=error: --implicit-check-not=warning:
# NO-MSCORLIB: {{^}}msil-ld: warning: none{{[/\\]}}lib.dll references mscorlib, which is not among the references{{$}}

## libb.dll references lib: silent when lib.dll is a library of the link,
## else lib is just a name the references do not have.
# RUN: msil-ld -shared libb.o v8/lib.dll --reference=pack -o b/libb.dll 2>&1 | count 0
# RUN: llvm-cil-dump b/libb.dll | FileCheck %s --check-prefix=B-REFS
# B-REFS: {{^}}assemblyref 'lib' ver 0.0.0.0 flags=0x00000000 key=- culture=''{{$}}
# RUN: msil-ld progb.o b/libb.dll v8/lib.dll --reference=pack -o out/pb.exe 2>&1 | count 0
# RUN: msil-ld progb.o b/libb.dll --reference=pack -o out/pb2.exe 2>&1 | %{fc} --check-prefix=B-ABSENT \
# RUN:   --implicit-check-not=error: --implicit-check-not=warning:
# B-ABSENT: {{^}}msil-ld: warning: b{{[/\\]}}libb.dll references lib, which is not among the references{{$}}

#--- lib.ll
target triple = "x86_64-pc-windows-msvc-msil"

@counter = global i32 5, align 4

define i32 @bump() {
  %c = load i32, ptr @counter, align 4
  %c1 = add i32 %c, 1
  store i32 %c1, ptr @counter, align 4
  fence seq_cst
  ret i32 %c1
}

#--- libb.ll
target triple = "x86_64-pc-windows-msvc-msil"

declare i32 @bump()

define i32 @bump2() {
  %a = call i32 @bump()
  %b = call i32 @bump()
  %r = add i32 %a, %b
  ret i32 %r
}

#--- prog.ll
target triple = "x86_64-pc-windows-msvc-msil"

declare i32 @bump()

define i32 @main() {
  %r = call i32 @bump()
  ret i32 %r
}

#--- progb.ll
target triple = "x86_64-pc-windows-msvc-msil"

declare i32 @bump2()

define i32 @main() {
  %r = call i32 @bump2()
  ret i32 %r
}
