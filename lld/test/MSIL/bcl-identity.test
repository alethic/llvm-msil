# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=CONTENTS --implicit-check-not=error: --implicit-check-not=warning:
# CONTENTS: {{^}}msil-ld: error: references one/FakeInterop.dll and plus/FakeInterop.dll have the same identity (FakeInterop 8.0.0.0 [b03f5f7f11d50a3a]) but different contents{{$}}

## The same name with another version or another key.
# RUN: not msil-ld p1.o --reference=base --reference=one/FakeInterop.dll --reference=v9/FakeInterop.dll \
# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=NAME-V9 --implicit-check-not=error:
# RUN: not msil-ld p1.o --reference=base --reference=v9/FakeInterop.dll --reference=one/FakeInterop.dll \
# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=NAME-V9 --implicit-check-not=error:
# RUN: not msil-ld p1.o --reference=base --reference=one/FakeInterop.dll --reference=k2/FakeInterop.dll \
# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=NAME-K2 --implicit-check-not=error:
# NAME-V9: {{^}}msil-ld: error: references {{(one|v9)}}/FakeInterop.dll ({{.*}}FakeInterop{{.*}}) and {{(one|v9)}}/FakeInterop.dll ({{.*}}FakeInterop{{.*}}) have the same name but different versions or keys{{$}}
# NAME-K2: {{^}}msil-ld: error: references {{(one|k2)}}/FakeInterop.dll ({{.*}}FakeInterop{{.*}}) and {{(one|k2)}}/FakeInterop.dll ({{.*}}FakeInterop{{.*}}) have the same name but different versions or keys{{$}}

## The error names both files, whatever the order.
# RUN: not msil-ld p1.o --reference=base --reference=one/FakeInterop.dll --reference=v9/FakeInterop.dll \
# RUN:   -o x.exe 2>&1 | FileCheck %s --check-prefix=BOTH
# BOTH: {{(one.*v9|v9.*one)}}

## The identities differ, so the version and key show in the AssemblyRef of
## each binding.
# RUN: msil-ld p1.o --reference=base --reference=v9/FakeInterop.dll -o v9.exe 2>&1 | count 0
# RUN: llvm-cil-dump v9.exe | FileCheck %s --check-prefix=V9
# V9: {{^}}assemblyref 'FakeInterop' ver 9.0.0.0 flags=0x00000000 key=B0 3F 5F 7F 11 D5 0A 3A culture=''{{$}}
# RUN: msil-ld p1.o --reference=base --reference=k2/FakeInterop.dll -o k2.exe 2>&1 | count 0
# RUN: llvm-cil-dump k2.exe | FileCheck %s --check-prefix=K2
# K2: {{^}}assemblyref 'FakeInterop' ver 8.0.0.0 flags=0x00000000 key=31 BF 38 56 AD 36 4E 35 culture=''{{$}}

## A binding in System.Private.FakeLib, an implementation assembly: a
## warning, and the binding. From FakeThreading, a reference assembly: none.
# RUN: msil-ld fence.o --reference=priv -o priv.exe 2>&1 \
# RUN:   | %{fc} --check-prefix=PRIVATE --implicit-check-not=error: --implicit-check-not=warning:
# PRIVATE: {{^}}msil-ld: warning: priv/System.Private.FakeLib.dll is not a reference assembly; binding 'System.Threading.Interlocked' to {{.*}}System.Private.FakeLib{{.*}} ties the output to one runtime build{{$}}
# RUN: llvm-cil-dump priv.exe | FileCheck %s --check-prefix=PRIVATE-BOUND
# PRIVATE-BOUND: {{^}}    L{{[0-9]+}}: call void() [System.Private.FakeLib]System.Threading.Interlocked::'MemoryBarrier'{{$}}
# RUN: msil-ld fence.o --reference=base -o ref.exe 2>&1 | count 0

## The warning needs both conditions: without [ReferenceAssembly] but not
## named System.Private.*, and named System.Private.* with
## [ReferenceAssembly], each binds with no diagnostic.
# RUN: msil-ld fence.o --reference=impl -o impl.exe 2>&1 | count 0
# RUN: llvm-cil-dump impl.exe | FileCheck %s --check-prefix=IMPL-BOUND
# IMPL-BOUND: {{^}}    L{{[0-9]+}}: call void() [FakeThreading]System.Threading.Interlocked::'MemoryBarrier'{{$}}
# RUN: msil-ld fence.o --reference=privref -o privref.exe 2>&1 | count 0
# RUN: llvm-cil-dump privref.exe | FileCheck %s --check-prefix=PRIVATE-BOUND

#--- p1.ll
target triple = "x86_64-pc-windows-msvc-msil"

@buf = global [16 x i8] c"0123456789abcdef", align 1
@ptr = global ptr @buf, align 8

declare void @llvm.memmove.p0.p0.i64(ptr, ptr, i64, i1)

define void @shift(i64 %n) {
  %p = load ptr, ptr @ptr
  %q = getelementptr i8, ptr %p, i64 1
  call void @llvm.memmove.p0.p0.i64(ptr %q, ptr %p, i64 %n, i1 false)
  fence seq_cst
  ret void
}

define i32 @main(i32 %argc, ptr %argv) {
  %a = sext i32 %argc to i64
  call void @shift(i64 %a)
  %p = load ptr, ptr @ptr
  %c = load i8, ptr %p
  %r = zext i8 %c to i32
  ret i32 %r
}

#--- fence.ll
target triple = "x86_64-pc-windows-msvc-msil"

define void @barrier() {
  fence seq_cst
  ret void
}

define i32 @main() {
  call void @barrier()
  ret i32 0
}
