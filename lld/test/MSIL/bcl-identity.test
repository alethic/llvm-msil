## The same identity with other contents: an error, the same in either
## order.
# RUN: not msil-ld p1.o --reference=base --reference=one/FakeInterop.dll --reference=plus/FakeInterop.dll \
# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=CONTENTS --implicit-check-not=error: --implicit-check-not=warning:
