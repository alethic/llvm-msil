# RUN:   --implicit-check-not=__msil_ref --implicit-check-not="{{(GLOBAL|WEAK) .*__msil_mc}}"
# RUN: FileCheck %s --check-prefix=SYMTAB --input-file=lnx.sym
# RUN: msil-ld lnx.o --reference=refs -o lnx.exe 2>&1 | count 0
# RUN: llvm-cil-dump lnx.exe > lnx.txt
# RUN: FileCheck %s --check-prefix=BIND --input-file=lnx.txt
# RUN: FileCheck %s --check-prefixes=CASTS,STUBS --input-file=lnx.txt
