#--- rename.py
"""Copy the CIL object argv[1] to argv[2], renaming every '__msil_REF.'
name (the method names in the #Strings heap and the link-info record's
symbol names) '__msil_ref.'. The lengths are equal, so no offset changes."""
import sys

with open(sys.argv[1], "rb") as f:
    data = f.read()
if b"__msil_REF." not in data:
    sys.exit("rename.py: no '__msil_REF.' name in " + sys.argv[1])
with open(sys.argv[2], "wb") as f:
    f.write(data.replace(b"__msil_REF.", b"__msil_ref."))
