# TWO-LABEL:   {{^  }}.method '__msil_mc.<castclass>.__uniq.43270141957106652608784572690135763868' object(object) {{.+$}}
# TWO-NEXT:    {{^    }}.maxstack 1{{$}}
# TWO-NEXT:    {{^    L0: }}ldarg.0{{$}}
# TWO-NEXT:    {{^    L1: }}castclass [FakeWidgets]Contoso.Widget{{$}}
# TWO-NEXT:    {{^    L2: }}ret{{$}}
# TWO-LABEL:   {{^  }}.method '__msil_mc.<castclass>.__uniq.43270141957106652608784572690135763868<msil>1' object(object) {{.+$}}
# TWO-NEXT:    {{^    }}.maxstack 1{{$}}
# TWO-NEXT:    {{^    L0: }}ldarg.0{{$}}
# TWO-NEXT:    {{^    L1: }}castclass [FakeWidgets]Contoso.Widget{{$}}
# TWO-NEXT:    {{^    L2: }}ret{{$}}
# TWO-LABEL:   {{^  }}.method 'one' int32() {{.+$}}
# TWO:         {{^    L[0-9]+: }}call object(object) '<Module>'::'__msil_mc.<castclass>.__uniq.43270141957106652608784572690135763868'{{$}}
# TWO-LABEL:   {{^  }}.method 'two' int32() {{.+$}}
# TWO:         {{^    L[0-9]+: }}call object(object) '<Module>'::'__msil_mc.<castclass>.__uniq.43270141957106652608784572690135763868<msil>1'{{$}}
# ONE-LABEL:   {{^  }}.method '__msil_mc.<castclass>.__uniq.43270141957106652608784572690135763868' object(object) {{.+$}}
# ONE-NEXT:    {{^    }}.maxstack 1{{$}}
# ONE-NEXT:    {{^    L0: }}ldarg.0{{$}}
# ONE-NEXT:    {{^    L1: }}castclass [FakeWidgets]Contoso.Widget{{$}}
# ONE-NEXT:    {{^    L2: }}ret{{$}}
# LIB-SYMTAB:  {{^}}SymbolTable v1.0 triple=x86_64-pc-windows-msvc-msil {{.+$}}
# LIB-EXPORTS: {{^}}.class 'lib' flags={{.+$}}
# LIB-EXPORTS: {{^  }}.method 'one' int32() {{.+$}}

#--- win.head
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"
#--- lnx.head
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"
#--- net.head
target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n8:16:32:64-S128"
target triple = "msil64-unknown-dotnet"
#--- calls.ll
;; The C includes <cli/cli.h>, <stddef.h> and <stdint.h> and declares
;;   typedef struct CLI_TYPE("System.Object") Object Object;
;;   typedef struct CLI_TYPE("System.String") String String;
;;   typedef struct CLI_TYPE("Contoso.Widget") Widget Widget;
;;   typedef struct CLI_TYPE("Contoso.IWidget") IWidget IWidget;
;;   typedef struct CLI_TYPE("Contoso.Outer/Inner") Inner Inner;
;;   typedef struct CLI_TYPE("int32[]") Ints Ints;
;;   typedef struct CLI_TYPE("string[]") Strings Strings;
;;   typedef struct CLI_TYPE("uint8[]") Bytes Bytes;
;;   typedef struct CLI_TYPE("class Contoso.Widget[]") Widgets Widgets;
;; and these managed calls, whose msil_method arguments are the attributes.

;; String ^describe(Object ^, String ^, Widget ^, Ints ^, Strings ^);
;; 'ref' for object, string, a class and two arrays, and a 'ref' result
declare target("msil.ref") @__msil_mc.describe(target("msil.ref"), target("msil.ref"), target("msil.ref"), target("msil.ref"), target("msil.ref")) #0

;; The same member with msil_catch("Contoso.WidgetException", 5):
;; String ^describe_or_null(Object ^, String ^, Widget ^, Ints ^, Strings ^, int *);
declare target("msil.ref") @__msil_mc.describe_or_null(target("msil.ref"), target("msil.ref"), target("msil.ref"), target("msil.ref"), target("msil.ref"), ptr noundef) #1

;; Widget ^widget_new(String ^, int); a constructor
declare target("msil.ref") @__msil_mc.widget_new(target("msil.ref"), i32 noundef) #2

;; int widget_size(Widget ^); 'this-ref' of a virtual property getter
declare i32 @__msil_mc.widget_size(target("msil.ref")) #3

;; void widget_resize(Widget ^, int); 'this-ref' of a method that is not virtual
declare void @__msil_mc.widget_resize(target("msil.ref"), i32 noundef) #4

;; long long widget_serial(Widget ^); 'this-ref' of an instance field
declare i64 @__msil_mc.widget_serial(target("msil.ref")) #5

;; Inner ^widget_part(Widget ^); 'this-ref' of an instance field whose type
;; is another class, with a 'ref' result
declare target("msil.ref") @__msil_mc.widget_part(target("msil.ref")) #25

;; Widget ^widget_last(void); a static field of a class type, with a 'ref'
;; result
declare target("msil.ref") @__msil_mc.widget_last() #26

;; int object_hash(Object ^); 'this-ref' of System.Object
declare i32 @__msil_mc.object_hash(target("msil.ref")) #6

;; int widget_score(IWidget ^); 'this-ref' of an interface
declare i32 @__msil_mc.widget_score(target("msil.ref")) #7

;; Bytes ^new_bytes(int); Widgets ^new_widgets(int); arrays
declare target("msil.ref") @__msil_mc.new_bytes(i32 noundef) #8
declare target("msil.ref") @__msil_mc.new_widgets(i32 noundef) #9

;; Inner ^inner_new(void); int inner_depth(Inner ^); a nested class
declare target("msil.ref") @__msil_mc.inner_new() #10
declare i32 @__msil_mc.inner_depth(target("msil.ref")) #11

;; intptr_t ticket_new(Object ^); Object ^ticket_target(intptr_t);
;; GCHandle's Alloc and get_Target: a ticket in and out
declare i64 @__msil_mc.ticket_new(target("msil.ref")) #12
declare target("msil.ref") @__msil_mc.ticket_target(i64 noundef) #13

;; The cast stubs of (Widget ^), (String ^), (Ints ^), (Strings ^),
