# RUN:   --implicit-check-not=native.dll --input-file=ad2.map
# DEFINED:         {{^}}  DefinedFunction {{[A-Za-z]+}} [[IN]] __msil_compiler_barrier{{$}}
# DEFINED:         {{^}}  0x{{[0-9A-F]+}} <Module> [[IN]] __msil_compiler_barrier{{$}}
# DEFINED-IL:      {{^}}  .method '__msil_compiler_barrier' void() flags=0x0016 impl=0x0000{{$}}
# DEFINED-IL:      {{^}}    L{{[0-9]+}}: ldsfld native int '<Module>'::'count'{{$}}
# DEFINED-IL:      {{^}}    L0: call void() '<Module>'::'__msil_compiler_barrier'{{$}}
#      WHY-ARCHIVE:reference	extracted	symbol
# WHY-ARCHIVE-NEXT:fence.o	libdef.a(def.o)	__msil_compiler_barrier
#  WHY-ARCHIVE-NOT:{{.}}

