# RUN: llvm-ar rcs libdef.a def.o
# RUN: llc -filetype=obj lib.ll -o lib.o
# RUN: llc -filetype=obj prog.ll -o prog.o
# RUN: llc -filetype=obj plain.ll -o plain.o
# RUN: llvm-as lto.ll -o lto.bc
# RUN: llvm-as plain.ll -o plain.bc
# RUN: llvm-lib /machine:x64 /def:native.def /out:native.lib
# RUN: yaml2obj native.yaml -o native.o
# RUN: ld.lld -shared -soname libnative.so.1 native.o -o libnative.so.1

# DEFINE: %{crash} = --implicit-check-not="PLEASE submit" --implicit-check-not="Stack dump" \
# DEFINE:   --implicit-check-not="LLVM ERROR"
# DEFINE: %{barrier} = FileCheck %s --check-prefix=BARRIER "--implicit-check-not=.method '__msil_compiler_barrier'" \
# DEFINE:   "--implicit-check-not=<msil>Symbols" --implicit-check-not=pinvokeimpl --implicit-check-not=moduleref

## The barrier method and main's two calls of it; one method, no MemberRef
## left, no P/Invoke.
# BARRIER:      {{^}}.class '<Module>' flags=0x00000000{{$}}
# BARRIER:      {{^}}  .method '__msil_compiler_barrier' void() flags=0x0013 impl=0x0008{{$}}
# BARRIER-NEXT: {{^}}    .maxstack 0{{$}}
# BARRIER-NEXT: {{^}}    L0: ret{{$}}
# BARRIER-NEXT: {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# BARRIER:      {{^}}    L0: call void() '<Module>'::'__msil_compiler_barrier'{{$}}
# BARRIER:      {{^}}    L{{[0-9]+}}: call void() '<Module>'::'__msil_compiler_barrier'{{$}}

