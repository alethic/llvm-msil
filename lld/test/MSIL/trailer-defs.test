## --lto-emit-asm: the text defines the method and calls it.
# RUN: msil-ld --lto-emit-asm lto.bc -o lto.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=TEXT --implicit-check-not=pinvokeimpl \
# RUN:   "--implicit-check-not=.method assembly static void '__msil_compiler_barrier'" --input-file=lto.il
