# MAP:              {{^}}msil-ld map of [[OUT]] ([[TRIPLE]]){{$}}
# MAP-NEXT:         {{^}}Inputs:{{$}}
# MAP-NEXT:         {{^}}  [[OBJ]]{{$}}
# MAP-NEXT:         {{^}}  <trailer>{{$}}
