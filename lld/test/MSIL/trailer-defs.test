# MAP-TRAILER:      {{^}}  DefinedFunction {{[A-Za-z]+}} <trailer> __msil_compiler_barrier{{$}}
# MAP-TRAILER:      {{^}}Methods:{{$}}
# MAP-TRAILER:      {{^}}  0x{{[0-9A-F]+}} <Module> <trailer> __msil_compiler_barrier{{$}}
