# TEXT:      {{^}}  call void '__msil_compiler_barrier'(){{$}}
# TEXT:      {{^}}.method assembly static void '__msil_compiler_barrier'() cil managed noinlining{{$}}
# TEXT-NEXT: {{^}}{{[{]}}{{$}}
# TEXT-NEXT: {{^}}  .maxstack 0{{$}}
# TEXT-NEXT: {{^}}  ret{{$}}
# TEXT-NEXT: {{^}}} // end of method '__msil_compiler_barrier'{{$}}

## No barrier, no method and no '<trailer>' input.
# RUN: msil-ld plain.o -o plain.exe -Map=plain.map 2>&1 | count 0
# RUN: llvm-cil-dump plain.exe | FileCheck %s --check-prefix=PLAIN --implicit-check-not=__msil_compiler_barrier
# PLAIN: {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# RUN: FileCheck %s --check-prefix=PLAIN-MAP --implicit-check-not="<trailer>" \
# RUN:   --implicit-check-not=__msil_compiler_barrier --input-file=plain.map
# PLAIN-MAP:      {{^}}Inputs:{{$}}
# PLAIN-MAP-NEXT: {{^}}  plain.o{{$}}
# PLAIN-MAP-NEXT: {{^}}Symbols:{{$}}
# RUN: msil-ld --lto-emit-asm plain.bc -o plain.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=PLAIN-TEXT --implicit-check-not=__msil_compiler_barrier --input-file=plain.il
# PLAIN-TEXT: {{^}}.method public static int32 'main'() cil managed{{$}}

#--- fence.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@flag = global i32 0

define i32 @main() {
  fence syncscope("singlethread") seq_cst
  %v = load i32, ptr @flag
  fence syncscope("singlethread") acquire
  ret i32 %v
}

#--- asm.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; __asm__ volatile("" ::: "memory") and atomic_signal_fence(memory_order_acquire).
@flag = global i32 0

define i32 @main() {
  call void asm sideeffect "", "~{memory}"()
  %v = load i32, ptr @flag
  fence syncscope("singlethread") acquire
  ret i32 %v
}

#--- def.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; A C definition of the name, which wins over the trailer's.
@count = global i32 0

define void @__msil_compiler_barrier() {
  %c = load i32, ptr @count
  %n = add i32 %c, 1
  store i32 %n, ptr @count
  ret void
}

#--- lib.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@flag = global i32 0

define i32 @spin() {
  fence syncscope("singlethread") seq_cst
  %v = load i32, ptr @flag
  ret i32 %v
}

#--- prog.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

declare i32 @spin()

define i32 @main() {
  fence syncscope("singlethread") seq_cst
  %v = call i32 @spin()
  ret i32 %v
}

#--- lto.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@flag = global i32 0

define i32 @main() {
  fence syncscope("singlethread") seq_cst
  %v = load volatile i32, ptr @flag
  fence syncscope("singlethread") release
  ret i32 %v
}

#--- plain.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@flag = global i32 0

define i32 @main() {
  %v = load volatile i32, ptr @flag
  ret i32 %v
}

#--- native.def
LIBRARY native.dll
EXPORTS
  __msil_compiler_barrier
  puts

#--- native.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: __msil_compiler_barrier, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: puts,                    Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x8, Size: 8 }
