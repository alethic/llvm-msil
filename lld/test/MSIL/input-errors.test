#--- main.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %r = call i32 @helper()
  ret i32 %r
}

declare i32 @helper()

#--- helper.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @helper() {
  ret i32 1
}

#--- netmodule.il
// A module of its own (no '.assembly'): a netmodule without the link-info
// record of a CIL object.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.module 'plain.o'
.method public static int32 'helper'() cil managed
{
  .maxstack 1
  ldc.i4.1
  ret
}

#--- notes.txt
Not an input file.

#--- prog.il
// MSIL module generated by LLVM
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'prog' { .ver 0:0:0:0 }

#--- modasm.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

module asm ".globl foo"

define i32 @main() {
  ret i32 0
}

#--- modasm-helper.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

module asm ".globl helper_asm"

define i32 @helper() {
  ret i32 1
}

#--- lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  %r = call i32 @foo(i32 1)
  ret i32 %r
}

declare i32 @foo(i32)

#--- callfn1.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %r = call i32 @fn1()
  ret i32 %r
}

declare i32 @fn1()

#--- patch-exports.py
"""Patch one count of a PE DLL's export directory.

Usage: patch-exports.py <in> <out> names|addresses <value>

'names' sets NumberOfNamePointers (export directory + 24), 'addresses'
AddressTableEntries (+ 20). The directory's file offset is found through
e_lfanew, data directory 0 of the optional header and the section table.
"""

import struct
import sys

src, dst, field, value = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4], 0)
with open(src, "rb") as f:
    data = bytearray(f.read())
pe = struct.unpack_from("<I", data, 0x3C)[0]
nsec = struct.unpack_from("<H", data, pe + 6)[0]
optsize = struct.unpack_from("<H", data, pe + 20)[0]
opt = pe + 24
magic = struct.unpack_from("<H", data, opt)[0]
erva = struct.unpack_from("<I", data, opt + (112 if magic == 0x20B else 96))[0]
for i in range(nsec):
    vsize, va, rawsize, rawptr = struct.unpack_from("<IIII", data, opt + optsize + 40 * i + 8)
    if va <= erva < va + max(vsize, rawsize):
        off = erva - va + rawptr
        break
else:
    sys.exit("patch-exports.py: no section holds the export directory")
struct.pack_into("<I", data, off + {"names": 24, "addresses": 20}[field], value)
with open(dst, "wb") as f:
    f.write(data)
