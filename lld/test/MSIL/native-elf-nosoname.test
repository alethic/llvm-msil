## The module string of an ELF library without DT_SONAME (ImplementationPlan.md
## 5.10.8 and 5.10.11; recon p2 native-imports 3.3): its file name as found,
## which is what a native ld records in DT_NEEDED for such a library - never
## its directory, never a name msil-ld makes up. The same library found three
## ways gets three modules: positional dir/libbar.so and -lbar give
## 'libbar.so', -l:libbar.so.2 gives 'libbar.so.2'. A library with a
## DT_SONAME keeps it under any file name (renamed.so is libfoo.so.1).

# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: mkdir -p dir
# RUN: yaml2obj bar.yaml -o bar.o
# RUN: ld.lld -shared bar.o -o dir/libbar.so
# RUN: ld.lld -shared bar.o -o dir/libbar.so.2
# RUN: ld.lld -shared bar.o -o libz.so.1.3.1
# RUN: llvm-readobj --dynamic-table dir/libbar.so | FileCheck %s --check-prefix=NOSONAME
# NOSONAME-NOT: SONAME
# RUN: yaml2obj %S/Inputs/native/libfoo.yaml -o renamed.so
# RUN: llvm-as main.ll -o main.o
# RUN: llvm-as foo.ll -o foo.o

# DEFINE: %{il} = FileCheck %s --implicit-check-not=pinvokeimpl

# RUN: msil-ld --lto-emit-asm --lto-O0 main.o dir/libbar.so -o pos.il 2>&1 | count 0
# RUN: %{il} --check-prefix=SO -DMOD=libbar.so --input-file=pos.il
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o -L dir -lbar -o l.il 2>&1 | count 0
# RUN: %{il} --check-prefix=SO -DMOD=libbar.so --input-file=l.il
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o -L dir -l:libbar.so.2 -o exact.il 2>&1 | count 0
# RUN: %{il} --check-prefix=SO -DMOD=libbar.so.2 --input-file=exact.il
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o libz.so.1.3.1 -o z.il 2>&1 | count 0
# RUN: %{il} --check-prefix=SO -DMOD=libz.so.1.3.1 --input-file=z.il
# SO: {{^}}.method assembly hidebysig static pinvokeimpl("[[MOD]]" nomangle cdecl) int32 'bar_fn'(int32) cil managed preservesig {}{{$}}

# RUN: msil-ld --lto-emit-asm --lto-O0 foo.o renamed.so -o renamed.il 2>&1 | count 0
# RUN: %{il} --check-prefix=RENAMED --implicit-check-not=renamed.so --input-file=renamed.il
# RENAMED: {{^}}.method assembly hidebysig static pinvokeimpl("libfoo.so.1" nomangle cdecl) int32 'foo'(int32) cil managed preservesig {}{{$}}

#--- bar.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: bar_fn, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }

#--- main.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  %r = call i32 @bar_fn(i32 2)
  ret i32 %r
}

declare i32 @bar_fn(i32)

#--- foo.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  %r = call i32 @foo(i32 2)
  ret i32 %r
}

declare i32 @foo(i32)
