## The msil-ld stub of M13 (ImplementationPlan.md 5.9.1, M13.b; M14 replaces
## it with the bitcode linker). Every text it prints, as lld/test/ELF and
## lld/test/wasm check theirs:
## - --version prints the lld version and skips input processing, so a
##   missing input does not matter (lld/test/ELF/version.test); -v without
##   inputs prints it too;
## - --help prints the option table and exits 0;
## - without inputs: 'msil-ld: error: no input files';
## - with any input, existing or not read: 'msil-ld: error: linking is not
##   implemented yet', once however many inputs there are, exit code 1;
## - an unknown option is lld's error, exit code 1.
## Every diagnostic starts with 'msil-ld: ' (5.9.14). No run may crash, and
## none prints an error or warning other than the one expected.
##
## LLD_IN_TEST=2 runs the driver twice in one process and fails if the two
## exit codes differ (lld/tools/lld/lld.cpp): the stub's state is reset for
## each call (5.9.1, as lld/wasm/Driver.cpp's link() does), so the second run
## behaves as the first.

# DEFINE: %{fc} = FileCheck %s --implicit-check-not="PLEASE submit" \
# DEFINE:   --implicit-check-not="Stack dump" --implicit-check-not="LLVM ERROR"
# DEFINE: %{one} = --implicit-check-not=error: --implicit-check-not=warning:

# RUN: msil-ld --version 2>&1 | %{fc} %{one} --check-prefix=VERSION
# RUN: msil-ld --version %t.not-exist 2>&1 | %{fc} %{one} --check-prefix=VERSION
# RUN: msil-ld -v 2>&1 | %{fc} %{one} --check-prefix=VERSION
# RUN: msil-ld --help 2>&1 | %{fc} %{one} --check-prefix=HELP

# RUN: not msil-ld 2>&1 | %{fc} %{one} --check-prefix=NOINPUT
# RUN: not msil-ld %s 2>&1 | %{fc} %{one} --check-prefix=LINK
# RUN: not msil-ld %s %S/lit.local.cfg 2>&1 | %{fc} %{one} --check-prefix=LINK
# RUN: not msil-ld -v %s 2>&1 | %{fc} %{one} --check-prefix=LINK
# RUN: not msil-ld --no-such-option %s 2>&1 | %{fc} --check-prefix=UNKNOWN

# RUN: env LLD_IN_TEST=2 msil-ld --version 2>&1 | %{fc} %{one} --check-prefix=VERSION
# RUN: env LLD_IN_TEST=2 not msil-ld 2>&1 | %{fc} %{one} --check-prefix=NOINPUT
# RUN: env LLD_IN_TEST=2 not msil-ld %s 2>&1 | %{fc} %{one} --check-prefix=LINK

# VERSION:      {{^}}LLD {{.+}}

# HELP:         OVERVIEW:
# HELP:         USAGE: {{.*}}msil-ld
# HELP:         OPTIONS:
# HELP-DAG:     --help
# HELP-DAG:     --version

# NOINPUT:      {{^}}msil-ld: error: no input files{{$}}

# LINK:         {{^}}msil-ld: error: linking is not implemented yet{{$}}

# UNKNOWN:      {{^}}msil-ld: error: unknown argument{{.*}}--no-such-option
