# RUN: FileCheck %s --check-prefix=PI-OPEN --match-full-lines %{crash} --input-file=open-il.txt
# RUN: FileCheck %s --check-prefix=OPEN-TXT --implicit-check-not=vopen --input-file=open.il
# PI-OPEN:      open -> libc.so.6!open [function, GLIBC_2.2.5]
# PI-OPEN-NEXT: libc.so.6: version floor GLIBC_2.2.5
# PI-OPEN-NOT:  {{.+}}
# OPEN-DAG: {{^}}    L{{[0-9]+}}: call int32(native int, int32) '<Module>'::'open'{{$}}
# OPEN-DAG: {{^}}    L{{[0-9]+}}: call int32(native int, int32, int32) '<Module>'::'open'{{$}}
# OPEN-DAG: {{^}}  .method 'open' int32(native int, int32) flags=0x2093 impl=0x0080{{$}}
# OPEN-DAG: {{^}}  .method 'open' int32(native int, int32, int32) flags=0x2093 impl=0x0080{{$}}
# OPEN-DAG: {{^}}    .pinvokeimpl 'libc.so.6' entry 'open' flags=0x0201{{$}}
# OPEN-TXT-DAG: call int32 'open'(native int, int32)
# OPEN-TXT-DAG: call int32 'open'(native int, int32, int32)
# OPEN-TXT-DAG: {{^}}.method assembly hidebysig static pinvokeimpl("libc.so.6" nomangle cdecl) int32 'open'(native int, int32) cil managed preservesig {}{{$}}
# OPEN-TXT-DAG: {{^}}.method assembly hidebysig static pinvokeimpl("libc.so.6" nomangle cdecl) int32 'open'(native int, int32, int32) cil managed preservesig {}{{$}}

## msvcrt.dll's scanf has no variant and is on Msvcrt's fixed-arity list.
# RUN: msil-ld scanf-gnu.o msvcrt.lib --print-imports -o scanf.exe > scanf.txt 2>&1
# RUN: FileCheck %s --check-prefix=PI-SCANF --match-full-lines %{crash} --input-file=scanf.txt
