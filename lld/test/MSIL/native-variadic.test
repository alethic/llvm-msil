target triple = "x86_64-pc-windows-gnu-msil"

@buf = global [16 x i8] zeroinitializer, align 1
@fmt = private constant [3 x i8] c"%d\00"

define i32 @main() {
  %r = call i32 (ptr, i64, ptr, ...) @_snprintf(ptr @buf, i64 16, ptr @fmt, i32 7)
  ret i32 %r
