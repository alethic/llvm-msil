# DEFINE: %{crash} = --implicit-check-not="PLEASE submit" --implicit-check-not="Stack dump" \
# DEFINE:   --implicit-check-not="LLVM ERROR" --implicit-check-not="not supported yet" \
# DEFINE:   --implicit-check-not="(phase 3)"
# DEFINE: %{err} = FileCheck %s %{crash} --implicit-check-not=error: --implicit-check-not=warning:

## The objects record what msil-ld decides on: printf's MemberRef is VARARG
## with one fixed parameter, a record v1.0 item; open's two call sites are
## FIXED_ARITY with two named parameters, so that object is v1.1 (5.14.7 V3).
# RUN: llvm-cil-dump --link-info call-lnx.o | FileCheck %s --check-prefix=REC-VA
# REC-VA:     {{^}}LinkInfo v1.0 triple=x86_64-unknown-linux-gnu-msil {{.*}}{{$}}
# REC-VA:     {{^}}Signature 0x0A{{[0-9A-F]+}} 'printf' VARARG fixed=1{{$}}
# RUN: llvm-cil-dump --link-info open-lnx.o | FileCheck %s --check-prefix=REC-FA
# REC-FA:       {{^}}LinkInfo v1.1 triple=x86_64-unknown-linux-gnu-msil {{.*}}{{$}}
# REC-FA-COUNT-2: {{^}}Signature 0x0A{{[0-9A-F]+}} 'open' FIXED_ARITY fixed=2{{$}}
# REC-FA-NOT:   VARARG

## glibc: printf binds as vprintf, through a CIL object, an LTO image and
## --lto-emit-asm text; --print-imports names the variant.
# RUN: msil-ld call-lnx.o libc.so.6 --print-imports -o lnx.exe > lnx.txt 2>&1
# RUN: FileCheck %s --check-prefix=PI-LNX --match-full-lines %{crash} --input-file=lnx.txt
# RUN: llvm-cil-dump lnx.exe | FileCheck %s --check-prefix=IMG -DMOD=libc.so.6 --implicit-check-not=pinvokeimpl
# RUN: msil-ld --lto-O0 call-lnx.bc libc.so.6 --print-imports -o lnx-lto.exe > lnx-lto.txt 2>&1
# RUN: FileCheck %s --check-prefix=PI-LNX --match-full-lines %{crash} --input-file=lnx-lto.txt
# RUN: llvm-cil-dump lnx-lto.exe | FileCheck %s --check-prefix=IMG -DMOD=libc.so.6 --implicit-check-not=pinvokeimpl
# RUN: msil-ld --lto-emit-asm --lto-O0 call-lnx.bc libc.so.6 --print-imports -o lnx.il > lnx-il.txt 2>&1
# RUN: FileCheck %s --check-prefix=PI-LNX --match-full-lines %{crash} --input-file=lnx-il.txt
# RUN: FileCheck %s --check-prefix=TXT -DMOD=libc.so.6 --input-file=lnx.il
# RUN: FileCheck %s --check-prefix=ONE --input-file=lnx.il
# PI-LNX:      printf -> libc.so.6!vprintf [function, GLIBC_2.2.5]
# PI-LNX-NEXT: libc.so.6: version floor GLIBC_2.2.5
# PI-LNX-NOT:  {{.+}}
# IMG:      {{^}}moduleref '[[MOD]]'{{$}}
# IMG:      {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# IMG:      {{^}}    L{{[0-9]+}}: call int32(native int, native int) '<Module>'::'printf'{{$}}
# IMG:      {{^}}  .method 'printf' int32(native int, native int) flags=0x2093 impl=0x0080{{$}}
# IMG-NEXT: {{^}}    .pinvokeimpl '[[MOD]]' entry 'vprintf' flags=0x0201{{$}}
# TXT-DAG:  call int32 'printf'(native int, native int)
# TXT-DAG:  {{^}}.method assembly hidebysig static pinvokeimpl("[[MOD]]" as "vprintf" nomangle cdecl) int32 'printf'(native int, native int) cil managed preservesig {}{{$}}
# ONE-COUNT-1: pinvokeimpl
# ONE-NOT:     pinvokeimpl

## windows-gnu: msvcrt.dll's printf binds as vprintf (Msvcrt's table).
# RUN: msil-ld call-gnu.o msvcrt.lib --print-imports -o gnu.exe > gnu.txt 2>&1
# RUN: FileCheck %s --check-prefix=PI-GNU --match-full-lines %{crash} --input-file=gnu.txt
# RUN: llvm-cil-dump gnu.exe | FileCheck %s --check-prefix=IMG -DMOD=msvcrt.dll --implicit-check-not=pinvokeimpl
# RUN: msil-ld --lto-emit-asm --lto-O0 call-gnu.bc msvcrt.lib -o gnu.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=TXT -DMOD=msvcrt.dll --input-file=gnu.il
# RUN: FileCheck %s --check-prefix=ONE --input-file=gnu.il
# PI-GNU:      printf -> msvcrt.dll!vprintf [function, -]
# PI-GNU-NOT:  {{.+}}

## windows-msvc: the C runtime is UCRT, which has no va_list variants, so
## msvcrt.dll's printf (which also exports vprintf) is the 'neither' error;
## so is windows-gnu's when the C runtime identity is ucrt (rule 5).
# RUN: not msil-ld call-msvc.o msvcrt.lib -o x.exe 2>&1 | %{err} --check-prefix=NEITHER -DF=printf -DMOD=msvcrt.dll
# RUN: not msil-ld --lto-O0 call-msvc.bc msvcrt.lib -o x.exe 2>&1 \
# RUN:   | %{err} --check-prefix=NEITHER -DF=printf -DMOD=msvcrt.dll
# RUN: not msil-ld --lto-emit-asm --lto-O0 call-msvc.bc msvcrt.lib -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=NEITHER -DF=printf -DMOD=msvcrt.dll
# RUN: not msil-ld call-gnu.o -L wlib -lucrt -o x.exe 2>&1 | %{err} --check-prefix=NEITHER -DF=printf -DMOD=ucrtbase.dll
# RUN: not msil-ld --lto-emit-asm --lto-O0 call-gnu.bc -L wlib -lucrt -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=NEITHER -DF=printf -DMOD=ucrtbase.dll
# RUN: not ls x.exe
# RUN: not ls x.il
# NEITHER: {{^}}msil-ld: error: native function '[[F]]' ([[MOD]]) is variadic and has neither a va_list variant nor an entry in the fixed-arity list{{$}}

## A native library's own variadic function, and glibc's clone, which is on
## no list: the 'neither' error, never a fixed-arity P/Invoke.
# RUN: not msil-ld vlog-lnx.o libv.so.1 -o x.exe 2>&1 | %{err} --check-prefix=NEITHER -DF=vlog -DMOD=libv.so.1
# RUN: not msil-ld --lto-emit-asm --lto-O0 vlog-lnx.bc libv.so.1 -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=NEITHER -DF=vlog -DMOD=libv.so.1
# RUN: not msil-ld clone-lnx.o libc.so.6 -o x.exe 2>&1 | %{err} --check-prefix=NEITHER -DF=clone -DMOD=libc.so.6

## A variant that the native libraries do not define: libc.so.6 has sprintf
## but no vsprintf, msvcrt.dll _snprintf but no _vsnprintf. The program's
## own vsprintf (an MSIL definition) does not capture the binding.
# RUN: not msil-ld sprintf-lnx.o libc.so.6 -o x.exe 2>&1 \
# RUN:   | %{err} --check-prefix=NOVARIANT -DF=sprintf -DMOD=libc.so.6 -DVF=vsprintf
