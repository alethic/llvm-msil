#--- ext-import.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; int ext_setopt(void *h, int opt, ...) __attribute__((import_module("libext.so.1")));
@name = private constant [2 x i8] c"n\00"

define i32 @main() {
  %a = call i32 (ptr, i32, ...) @ext_setopt(ptr null, i32 1, i32 5)
  %b = call i32 (ptr, i32, ...) @ext_setopt(ptr null, i32 2, ptr @name)
  %s = add i32 %a, %b
  ret i32 %s
}

declare i32 @ext_setopt(ptr, i32, ...) #0

attributes #0 = { "msil-import-module"="libext.so.1" }

#--- noproto.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; int foo(); with only its address taken: clang marks a K&R declaration
;; "no-prototype".
@keep = global ptr @foo

define i32 @main() {
  %f = load ptr, ptr @keep
  %c = icmp eq ptr %f, null
  %r = zext i1 %c to i32
  ret i32 %r
}

declare i32 @foo(...) #0

attributes #0 = { "no-prototype" }

#--- noproto-def.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @foo(i32 %x) noinline {
  ret i32 %x
}
