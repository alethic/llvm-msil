#--- sprintf-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@buf = global [16 x i8] zeroinitializer, align 1
@fmt = private constant [3 x i8] c"%d\00"

define i32 @main() {
  %r = call i32 (ptr, ptr, ...) @sprintf(ptr @buf, ptr @fmt, i32 7)
  ret i32 %r
}

declare i32 @sprintf(ptr, ptr, ...)

#--- own-vsprintf.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; The program's own vsprintf, kept alive by a reference.
@keep = global ptr @vsprintf

define i32 @vsprintf(ptr %buf, ptr %fmt, ptr %ap) {
  ret i32 0
}

#--- own-vprintf.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@fmt = private constant [4 x i8] c"%d\0A\00"

define i32 @vprintf(ptr %fmt, ptr %ap) noinline {
  ret i32 3
}

define i32 @main() {
  %a = call i32 (ptr, ...) @printf(ptr @fmt, i32 42)
  %b = call i32 @vprintf(ptr @fmt, ptr null)
  ret i32 %b
}

declare i32 @printf(ptr, ...)

#--- scanf-gnu.ll
