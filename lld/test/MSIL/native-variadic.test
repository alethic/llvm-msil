# PI-SCANF:     scanf -> msvcrt.dll!scanf [function, -]
# PI-SCANF-NOT: {{.+}}
# SCANF:      {{^}}  .method 'scanf' int32(native int, native int) flags=0x2093 impl=0x0080{{$}}
# SCANF-NEXT: {{^}}    .pinvokeimpl 'msvcrt.dll' entry 'scanf' flags=0x0201{{$}}

## An explicit import of a variadic function: FIXED_ARITY stubs, one per
## call-site signature, bound unchecked (no native library defines
## ext_setopt).
# RUN: llvm-cil-dump --link-info ext-import.o | FileCheck %s --check-prefix=REC-EXT
# REC-EXT:         {{^}}LinkInfo v1.1 triple=x86_64-unknown-linux-gnu-msil {{.*}}{{$}}
# REC-EXT-COUNT-2: {{^}}Signature 0x06{{[0-9A-F]+}} 'ext_setopt' FIXED_ARITY fixed=2{{$}}
# RUN: msil-ld ext-import.o -o ext.exe 2>&1 | count 0
# RUN: llvm-cil-dump ext.exe | FileCheck %s --check-prefix=EXT
# RUN: msil-ld --lto-O0 ext-import.bc -o ext-lto.exe 2>&1 | count 0
# RUN: llvm-cil-dump ext-lto.exe | FileCheck %s --check-prefix=EXT
# RUN: msil-ld --lto-emit-asm --lto-O0 ext-import.bc -o ext.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=EXT-TXT --input-file=ext.il
# EXT-DAG: {{^}}moduleref 'libext.so.1'{{$}}
# EXT-DAG: {{^}}  .method 'ext_setopt' int32(native int, int32, int32) flags=0x2093 impl=0x0080{{$}}
# EXT-DAG: {{^}}  .method 'ext_setopt' int32(native int, int32, native int) flags=0x2093 impl=0x0080{{$}}
# EXT-DAG: {{^}}    .pinvokeimpl 'libext.so.1' entry 'ext_setopt' flags=0x0201{{$}}
# EXT-TXT-DAG: {{^}}.method {{.*}}pinvokeimpl("libext.so.1" nomangle cdecl) int32 'ext_setopt'(native int, int32, int32) cil managed preservesig {}{{$}}
# EXT-TXT-DAG: {{^}}.method {{.*}}pinvokeimpl("libext.so.1" nomangle cdecl) int32 'ext_setopt'(native int, int32, native int) cil managed preservesig {}{{$}}

## The address of a natively bound variadic function, until M28.
# RUN: not msil-ld addr-lnx.o libc.so.6 -o x.exe 2>&1 | %{err} --check-prefix=ADDR -DF=printf -DMOD=libc.so.6
# RUN: not msil-ld --lto-O0 addr-lnx.bc libc.so.6 -o x.exe 2>&1 | %{err} --check-prefix=ADDR -DF=printf -DMOD=libc.so.6
# RUN: not msil-ld --lto-emit-asm --lto-O0 addr-lnx.bc libc.so.6 -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=ADDR -DF=printf -DMOD=libc.so.6
# RUN: not msil-ld addr-gnu.o msvcrt.lib -o x.exe 2>&1 | %{err} --check-prefix=ADDR -DF=printf -DMOD=msvcrt.dll
# RUN: not msil-ld --lto-emit-asm --lto-O0 addr-gnu.bc msvcrt.lib -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=ADDR -DF=printf -DMOD=msvcrt.dll
# RUN: not ls x.exe
# RUN: not ls x.il
# ADDR: {{^}}msil-ld: error: the address of native variadic function '[[F]]' ([[MOD]]) is not supported for MSIL yet{{$}}

## A prototype-less function whose address is used but which is never called
## directly (5.10.13: in linked mode the Phase-1 check becomes a link-time
## check after native resolution, with native-imports 6's text, which names
## the module the function bound to): its IL signature cannot be derived,
## so the link fails although libfoo.so.1 defines foo. Another bitcode input
## that defines foo with a prototype gives the signature, and the link
## succeeds without a P/Invoke. A prototype-less declaration stays variadic
## in IR (ExpandVariadics ignores it, 5.15.2), so this is unchanged by M26.
# RUN: yaml2obj %S/Inputs/native/libfoo.yaml -o libfoo.so.1
# RUN: llvm-as noproto.ll -o noproto.o
# RUN: llvm-as noproto-def.ll -o noproto-def.o
# RUN: not msil-ld --lto-emit-asm --lto-O0 noproto.o libfoo.so.1 -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=NOPROTO
# NOPROTO: {{^}}msil-ld: error: the signature of prototype-less function 'foo' (libfoo.so.1) cannot be derived: its address is used, but it is never called directly; declare it with a prototype{{$}}
# RUN: msil-ld --lto-emit-asm --lto-O0 noproto.o noproto-def.o libfoo.so.1 -o noproto-def.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=NOPROTO-DEF --implicit-check-not=pinvokeimpl --input-file=noproto-def.il
# NOPROTO-DEF: {{^}}.method {{.*}}static int32 'foo'(int32) cil managed{{$}}

#--- libs.yaml
## 1: a glibc-like libc.so.6: printf with its variant vprintf, sprintf
## without vsprintf, open (fixed-arity list) and clone (on no list).
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x40
Symbols:
  - { Name: printf,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x00, Size: 8 }
  - { Name: vprintf, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x08, Size: 8 }
  - { Name: sprintf, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x10, Size: 8 }
  - { Name: open,    Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x18, Size: 8 }
  - { Name: clone,   Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x20, Size: 8 }
## 2: libv.so.1, a library with its own variadic function vlog.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: vlog,    Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x00, Size: 8 }

#--- c.map
GLIBC_2.2.5 { global: *; };

#--- msvcrt.def
LIBRARY msvcrt.dll
EXPORTS
  printf
  vprintf
  scanf
  _snprintf

#--- ucrt.def
LIBRARY ucrtbase.dll
EXPORTS
  printf
  vprintf

#--- call-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@fmt = private constant [4 x i8] c"%d\0A\00"

define i32 @main() {
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 42)
  ret i32 0
}

declare i32 @printf(ptr, ...)

#--- call-gnu.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-gnu-msil"

@fmt = private constant [4 x i8] c"%d\0A\00"

define i32 @main() {
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 42)
  ret i32 0
}

declare i32 @printf(ptr, ...)

#--- call-msvc.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@fmt = private constant [4 x i8] c"%d\0A\00"

define i32 @main() {
  %r = call i32 (ptr, ...) @printf(ptr @fmt, i32 42)
  ret i32 0
}

declare i32 @printf(ptr, ...)

#--- open-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; open(path, O_RDONLY) and open(path, O_WRONLY | O_CREAT, 0644).
@path = private constant [6 x i8] c"a.txt\00"

define i32 @main() {
  %a = call i32 (ptr, i32, ...) @open(ptr @path, i32 0)
  %b = call i32 (ptr, i32, ...) @open(ptr @path, i32 65, i32 420)
  %s = add i32 %a, %b
  ret i32 %s
}

declare i32 @open(ptr, i32, ...)

#--- clone-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  %r = call i32 (ptr, ptr, i32, ptr, ...) @clone(ptr null, ptr null, i32 17, ptr null)
  ret i32 %r
}

declare i32 @clone(ptr, ptr, i32, ptr, ...)

