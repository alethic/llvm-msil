# RUN:   | %{err} --check-prefix=NOVARIANT -DF=sprintf -DMOD=libc.so.6 -DVF=vsprintf
# RUN: not msil-ld sprintf-lnx.o own-vsprintf.o libc.so.6 -o x.exe 2>&1 \
# RUN:   | %{err} --check-prefix=NOVARIANT -DF=sprintf -DMOD=libc.so.6 -DVF=vsprintf
# RUN: not msil-ld snprintf-gnu.o msvcrt.lib -o x.exe 2>&1 \
# RUN:   | %{err} --check-prefix=NOVARIANT -DF=_snprintf -DMOD=msvcrt.dll -DVF=_vsnprintf
# RUN: not ls x.exe
# RUN: not ls x.il
# NOVARIANT: {{^}}msil-ld: error: native function '[[F]]' ([[MOD]]) is variadic, and its va_list variant '[[VF]]' is not defined by the native libraries{{$}}

## A program that defines its own vprintf and calls it and printf: its
## vprintf is its own method, printf still binds to libc.so.6's vprintf.
# RUN: msil-ld own-vprintf.o libc.so.6 --print-imports -o own.exe > own.txt 2>&1
# RUN: FileCheck %s --check-prefix=PI-LNX --match-full-lines %{crash} --input-file=own.txt
# RUN: llvm-cil-dump own.exe | FileCheck %s --check-prefix=OWN
# OWN:      {{^}}    L{{[0-9]+}}: call int32(native int, native int) '<Module>'::'printf'{{$}}
# OWN:      {{^}}    L{{[0-9]+}}: call int32(native int, native int) '<Module>'::'vprintf'{{$}}
# OWN:      {{^}}  .method 'printf' int32(native int, native int) flags=0x2093 impl=0x0080{{$}}
# OWN-NEXT: {{^}}    .pinvokeimpl 'libc.so.6' entry 'vprintf' flags=0x0201{{$}}
# OWN-NEXT: {{^}}  .method 'vprintf' int32(native int, native int) flags=0x0016 impl=0x0000{{$}}

## The fixed-arity list: open's two call signatures are two P/Invokes of
## open, entry 'open', in the image and in linked text; --print-imports has
## one line for the symbol.
# RUN: msil-ld open-lnx.o libc.so.6 --print-imports -o open.exe > open.txt 2>&1
# RUN: FileCheck %s --check-prefix=PI-OPEN --match-full-lines %{crash} --input-file=open.txt
