# EDGE10: {{^}}count <msil>Data methods=1 fields=10{{$}}
# EDGE10: {{^}}count <msil>Spill1 methods=1 fields=1{{$}}
# EDGE10: {{^}}limit 10 ok{{$}}
# RUN: %{listing} method edge10.txt '<Module>' .cctor | FileCheck %s --check-prefix=TOUCH

## The same IR for x86_64-unknown-linux-gnu-msil: the same touch.
# RUN: llc -filetype=obj -mtriple=x86_64-unknown-linux-gnu-msil spill.ll -o linux/spill.o
# RUN: msil-ld -shared --msil-type-member-limit=4 linux/spill.o -o linux/spill.dll 2>&1 | count 0
