# IMPORT-MODULE-NEXT: {{^}}    .pinvokeimpl 'libc.so.6' entry 'dlopen' flags=0x0201{{$}}
# IMPORT-MODULE-NEXT: {{^}}  .method 'dlsym' native int(native int, native int) flags=0x{{[0-9A-F]+}} impl=0x0080{{$}}
# IMPORT-MODULE-NEXT: {{^}}    .pinvokeimpl 'libc.so.6' entry 'dlsym' flags=0x0201{{$}}
# IMPORT-MODULE-NOT:  {{.}}

## A spilling library whose phase 1 holds only data imports, the one shape
## that only the data-import term of msil-ld's phase-1 condition covers:
## imports.ll defines no data and exports nothing (no image and no function
## address), and its constructor reads four data imports of libc.so.6. At 3
## their fields spill, and '<msil>data' is made in '<msil>Data' for the
## touch alone, which leaves room for two of them (environ and optind go to
## '<msil>Spill1'); '<msil>Data'::.cctor is phase 1's call of
## '<msil>init_dataimports' alone, and <Module>::.cctor starts with the
## touch, before the constructor's call. Without the limit nothing spills:
## no spill class, no '<msil>data' (the check names '<msil>data flags',
## since '<msil>dataimport' contains '<msil>data') and no touch.
# RUN: llc -filetype=obj imports.ll -o imports.o
# RUN: msil-ld -shared --msil-type-member-limit=3 imports.o libc.so.6 -o imports.dll 2>&1 | count 0
# RUN: llvm-cil-dump imports.dll > imports.txt
# RUN: %python %S/Inputs/members.py --limit 3 imports.txt | FileCheck %s --check-prefix=IMPORTS3
# IMPORTS3: {{^}}field <msil>Data::<msil>data flags=0x0033{{$}}
# IMPORTS3: {{^}}field <msil>Spill1::environ flags=0x0013{{$}}
# IMPORTS3: {{^}}field <msil>Spill1::optind flags=0x0013{{$}}
# IMPORTS3: {{^}}count <msil>Data methods=3 fields=3{{$}}
# IMPORTS3: {{^}}limit 3 ok{{$}}
# RUN: %{listing} method imports.txt '<msil>Data' .cctor | FileCheck %s --check-prefix=IMPORTS3-PHASE1
# IMPORTS3-PHASE1:      {{^}}  .method '.cctor' void() flags=0x1891 impl=0x0000{{$}}
# IMPORTS3-PHASE1-NEXT: {{^}}    .maxstack 0{{$}}
# IMPORTS3-PHASE1-NEXT: {{^}}    L0: call void() '<msil>Data'::'<msil>init_dataimports'{{$}}
# IMPORTS3-PHASE1-NEXT: {{^}}    L1: ret{{$}}
# IMPORTS3-PHASE1-NOT:  {{.}}
# RUN: %{listing} method imports.txt '<Module>' .cctor | FileCheck %s --check-prefix=IMPORTS3-TOUCH
# IMPORTS3-TOUCH:      {{^}}  .method '.cctor' void() flags=0x1891 impl=0x0000{{$}}
# IMPORTS3-TOUCH-NEXT: {{^}}    .maxstack 1{{$}}
# IMPORTS3-TOUCH-NEXT: {{^}}    L0: ldsfld native int '<msil>Data'::'<msil>data'{{$}}
# IMPORTS3-TOUCH-NEXT: {{^}}    L1: pop{{$}}
# IMPORTS3-TOUCH-NEXT: {{^}}    L2: call void() '<Module>'::'probe'{{$}}
# IMPORTS3-TOUCH-NEXT: {{^}}    L3: ret{{$}}
# IMPORTS3-TOUCH-NOT:  {{.}}
# RUN: msil-ld -shared imports.o libc.so.6 -o nolimit/imports.dll 2>&1 | count 0
# RUN: llvm-cil-dump nolimit/imports.dll > imports-nolimit.txt
# RUN: %python %S/Inputs/members.py imports-nolimit.txt | FileCheck %s --check-prefix=IMPORTS-NOLIMIT \
# RUN:   --implicit-check-not='<msil>Spill' --implicit-check-not='<msil>data flags'
# IMPORTS-NOLIMIT: {{^}}count <msil>Data methods=3 fields=4{{$}}
# RUN: %{listing} method imports-nolimit.txt '<Module>' .cctor | FileCheck %s --check-prefix=IMPORTS-PLAIN
# IMPORTS-PLAIN:      {{^}}  .method '.cctor' void() flags=0x1891 impl=0x0000{{$}}
# IMPORTS-PLAIN-NEXT: {{^}}    .maxstack 0{{$}}
# IMPORTS-PLAIN-NEXT: {{^}}    L0: call void() '<Module>'::'probe'{{$}}
# IMPORTS-PLAIN-NEXT: {{^}}    L1: ret{{$}}
# IMPORTS-PLAIN-NOT:  {{.}}

#--- spill.ll
target triple = "x86_64-pc-windows-msvc-msil"

@g0 = internal global i32 10, align 4
@g1 = internal global i32 11, align 4
@g2 = internal global i32 12, align 4
@g3 = internal global i32 13, align 4
@g4 = internal global i32 14, align 4
@g5 = internal global i32 15, align 4
@g6 = internal global i32 16, align 4
@g7 = internal global i32 17, align 4

define i32 @sum() {
  %a0 = load volatile i32, ptr @g0
  %a1 = load volatile i32, ptr @g1
  %a2 = load volatile i32, ptr @g2
  %a3 = load volatile i32, ptr @g3
  %a4 = load volatile i32, ptr @g4
  %a5 = load volatile i32, ptr @g5
  %a6 = load volatile i32, ptr @g6
  %a7 = load volatile i32, ptr @g7
  %s1 = add i32 %a0, %a1
  %s2 = add i32 %s1, %a2
  %s3 = add i32 %s2, %a3
  %s4 = add i32 %s3, %a4
  %s5 = add i32 %s4, %a5
  %s6 = add i32 %s5, %a6
  %s7 = add i32 %s6, %a7
  ret i32 %s7
}

define i32 @last() {
  %a7 = load volatile i32, ptr @g7
  ret i32 %a7
}

#--- envlib.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@environ = external global ptr

define ptr @get_env() {
  %e = load ptr, ptr @environ, align 8
  ret ptr %e
}

#--- peer.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @peer() {
  ret i32 3
}

#--- fnaddr.ll
target triple = "x86_64-pc-windows-msvc-msil"

define internal i32 @f0() {
  ret i32 10
}

define internal i32 @f1() {
  ret i32 11
}

define internal i32 @f2() {
  ret i32 12
}

define ptr @pick(i32 %i) {
entry:
  switch i32 %i, label %l2 [
    i32 0, label %l0
    i32 1, label %l1
  ]
l0:
  ret ptr @f0
l1:
  ret ptr @f1
l2:
  ret ptr @f2
}

#--- weak.ll
target triple = "x86_64-pc-windows-msvc-msil"

@w0 = extern_weak global i32
@w1 = extern_weak global i32
@w2 = extern_weak global i32

define internal void @probe() {
  %slot = alloca ptr, align 8
  store volatile ptr @w0, ptr %slot, align 8
  store volatile ptr @w1, ptr %slot, align 8
  store volatile ptr @w2, ptr %slot, align 8
  ret void
}

@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @probe, ptr null }]

#--- methods.ll
target triple = "x86_64-pc-windows-msvc-msil"

@g = internal global i32 5, align 4

define internal i32 @h0() noinline {
  ret i32 0
}

define internal i32 @h1() noinline {
  ret i32 1
}

define internal i32 @h2() noinline {
  ret i32 2
}

define internal i32 @h3() noinline {
  ret i32 3
}

define internal i32 @h4() noinline {
  ret i32 4
}

define internal i32 @h5() noinline {
  ret i32 5
}

define i32 @use() {
  %a0 = call i32 @h0()
  %a1 = call i32 @h1()
  %a2 = call i32 @h2()
  %a3 = call i32 @h3()
  %a4 = call i32 @h4()
  %a5 = call i32 @h5()
  %v = load volatile i32, ptr @g, align 4
  %s1 = add i32 %a0, %a1
  %s2 = add i32 %s1, %a2
  %s3 = add i32 %s2, %a3
  %s4 = add i32 %s3, %a4
  %s5 = add i32 %s4, %a5
  %s6 = add i32 %s5, %v
  ret i32 %s6
}

#--- imports.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@stdout = external global ptr
@stderr = external global ptr
@environ = external global ptr
@optind = external global i32

define internal void @probe() {
  %slot = alloca i64, align 8
  %a = load ptr, ptr @stdout, align 8
  %b = load ptr, ptr @stderr, align 8
  %c = load ptr, ptr @environ, align 8
  %d = load i32, ptr @optind, align 4
  %ai = ptrtoint ptr %a to i64
  %bi = ptrtoint ptr %b to i64
  %ci = ptrtoint ptr %c to i64
  %di = sext i32 %d to i64
  %s1 = add i64 %ai, %bi
  %s2 = add i64 %s1, %ci
  %s3 = add i64 %s2, %di
  store volatile i64 %s3, ptr %slot, align 8
  ret void
}

@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @probe, ptr null }]
