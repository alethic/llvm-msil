## A forced export wins over --exclude-libs.
# RUN: msil-ld -shared lib.o libx.a --exclude-libs=ALL --export=xfn -o excl/lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump excl/lib.dll > excl.txt
# RUN: %{members} excl.txt lib | FileCheck %s --check-prefix=XFN --implicit-check-not="'xother'"
# RUN: msil-ld -shared lib.o libx.a --exclude-libs=libx.a --export-list=xlist.txt -o excl-named/lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump excl-named/lib.dll > excl-named.txt
# RUN: %{members} excl-named.txt lib | FileCheck %s --check-prefix=XFN --implicit-check-not="'xother'"
# RUN: msil-ld -shared lib.o libh.a --exclude-libs=ALL --export=xhid -o hidden/lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump hidden/lib.dll > hidden.txt
# RUN: %{members} hidden.txt lib | FileCheck %s --check-prefix=XHID --implicit-check-not="'xhother'"
# XHID: {{^}}  .method 'xhid' int32() flags=0x{{[0-9A-F]+}} impl=0x0000{{$}}

## The same options on a host triple.
# RUN: msil-ld -shared lnx.o --export=hid -o lnx/lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump lnx/lib.dll > lnx.txt
# RUN: %{members} lnx.txt lib | FileCheck %s --check-prefix=HID --implicit-check-not="'stay'"
# RUN: msil-ld -shared lnx.o libxl.a --exclude-libs=ALL --export=xfn -o lnx-arch/lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump lnx-arch/lib.dll > lnx-arch.txt
# RUN: %{members} lnx-arch.txt lib | FileCheck %s --check-prefix=XFN --implicit-check-not="'xother'"
# RUN: not msil-ld -shared lnx.o --export=missing -o x.dll 2>&1 | %{fc} --check-prefix=MISSING -DSYM=missing

#--- list.txt
# Hidden definitions forced into the export class.
hid3
# One name per line.
hid4

#--- missing.txt
hid3
missing2

#--- xlist.txt
xfn

#--- lib.ll
target triple = "msil64-unknown-dotnet"

$inl = comdat any
$sel = comdat any

@sel = weak_odr global i32 3, comdat, align 4

define linkonce_odr i32 @inl() comdat {
  ret i32 1
}

define i32 @pub() {
  %r = call i32 @inl()
  ret i32 %r
}

define protected i32 @prot() {
  ret i32 2
}

define weak i32 @wk() {
  ret i32 3
}

define hidden i32 @stay() {
  ret i32 4
}

define hidden i32 @hid() {
  ret i32 5
}

define hidden i32 @hid2() {
  ret i32 6
}

define hidden i32 @hid3() {
  ret i32 7
}

define hidden i32 @hid4() {
  ret i32 8
}

#--- xm.ll
define i32 @xfn() {
  ret i32 10
}

define i32 @xother() {
  ret i32 11
}

#--- xh.ll
target triple = "msil64-unknown-dotnet"

define hidden i32 @xhid() {
  ret i32 12
}

define i32 @xhother() {
  ret i32 13
}

#--- lnx.ll
define i32 @pub() {
  ret i32 1
}

define hidden i32 @stay() {
  ret i32 4
}

define hidden i32 @hid() {
  ret i32 5
}
