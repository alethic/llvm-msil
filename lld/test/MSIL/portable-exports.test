## Names that no input defines.
# RUN: not msil-ld -shared lib.o --export=missing -o x.dll 2>&1 | %{fc} --check-prefix=MISSING -DSYM=missing
# RUN: not msil-ld -shared lib.o --export-list=missing.txt -o x.dll 2>&1 | %{fc} --check-prefix=MISSING -DSYM=missing2
# MISSING: {{^}}msil-ld: error: symbol exported via --export not found: [[SYM]]{{$}}

