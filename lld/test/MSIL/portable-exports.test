## Exports of a -shared library on msil64-unknown-dotnet, and the forced
## export options on every triple (ImplementationPlan.md 5.18.6 PL7;
## portable-linkrules D7):
## - the selection is every name forced by --export=<sym>,
##   --export-if-defined=<sym> or --export-list=<file> (one name per line,
##   '#' comment lines), hidden or not, plus every default- or
##   protected-visibility GLOBAL or WEAK definition; hidden definitions that
##   no option names stay in <Module>;
## - WEAK COMDAT copies stay exported on dotnet (a linkonce_odr function and
##   a weak_odr variable in COMDAT groups), as on ELF triples;
## - a name that --export or --export-list forces and no input defines is
##     symbol exported via --export not found: <sym>
##   while --export-if-defined of such a name is silent;
## - --export and --export-list names are resolved like -u: a forced name
##   defined only by an archive member extracts it (the member's other
##   default-visibility definitions are then exported by the usual rule), and
##   --export-if-defined extracts nothing (it names only what is already
##   defined);
## - a forced export wins over --exclude-libs: under --exclude-libs=ALL (and
##   naming the archive) the forced name is exported, a hidden one included
##   (the shape of c.dll's __llvm_libc_errno), and the member's other
##   definitions are not;
## - the options are generic: on x86_64-unknown-linux-gnu-msil they export a
##   hidden definition and an archive-only one the same way.
## Inputs/shared/listing.py prints the export class's members; the class is
## named after the output ('lib').

# REQUIRES: llvm-cil-dump
# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: mkdir sel force force2 ifdef list arch arch-list arch-ifdef excl excl-named hidden lnx lnx-arch
# RUN: llc -filetype=obj lib.ll -o lib.o
# RUN: llc -filetype=obj -mtriple=msil64-unknown-dotnet xm.ll -o xm.o
# RUN: llc -filetype=obj xh.ll -o xh.o
# RUN: llc -filetype=obj -mtriple=x86_64-unknown-linux-gnu-msil lnx.ll -o lnx.o
# RUN: llc -filetype=obj -mtriple=x86_64-unknown-linux-gnu-msil xm.ll -o xm-lnx.o
# RUN: llvm-ar rc libx.a xm.o
# RUN: llvm-ar rc libh.a xh.o
# RUN: llvm-ar rc libxl.a xm-lnx.o

# DEFINE: %{fc} = FileCheck %s --implicit-check-not="PLEASE submit" --implicit-check-not="Stack dump" \
# DEFINE:   --implicit-check-not="LLVM ERROR"
# DEFINE: %{members} = %python %S/Inputs/shared/listing.py members

## The default selection: visibility, WEAK, COMDAT copies; hidden stays.
# RUN: msil-ld -shared lib.o -o sel/lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump sel/lib.dll > sel.txt
# RUN: %{members} sel.txt lib | FileCheck %s --check-prefix=DEFAULT \
# RUN:   --implicit-check-not="'stay'" --implicit-check-not="'hid'" --implicit-check-not="'hid2'" \
# RUN:   --implicit-check-not="'hid3'" --implicit-check-not="'hid4'"
# DEFAULT-DAG: {{^}}  .method 'pub' int32() flags=0x{{[0-9A-F]+}} impl=0x0000{{$}}
# DEFAULT-DAG: {{^}}  .method 'prot' int32() flags=0x{{[0-9A-F]+}} impl=0x0000{{$}}
# DEFAULT-DAG: {{^}}  .method 'wk' int32() flags=0x{{[0-9A-F]+}} impl=0x0000{{$}}
# DEFAULT-DAG: {{^}}  .method 'inl' int32() flags=0x{{[0-9A-F]+}} impl=0x0000{{$}}
# DEFAULT-DAG: {{^}}  .property 'sel' native int() flags=0x0000{{$}}

## --export of a hidden definition, in both positions.
# RUN: msil-ld -shared --export=hid lib.o -o force/lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump force/lib.dll > force.txt
# RUN: %{members} force.txt lib | FileCheck %s --check-prefixes=DEFAULT,HID \
# RUN:   --implicit-check-not="'stay'" --implicit-check-not="'hid2'"
# HID-DAG: {{^}}  .method 'hid' int32() flags=0x{{[0-9A-F]+}} impl=0x0000{{$}}
# RUN: msil-ld -shared lib.o --export=hid -o force2/lib.dll 2>&1 | count 0
# RUN: cmp force/lib.dll force2/lib.dll

## --export-if-defined: a defined hidden name is exported, a missing one is
## silent.
# RUN: msil-ld -shared lib.o --export-if-defined=hid2 --export-if-defined=absent -o ifdef/lib.dll 2>&1 | count 0
# RUN: llvm-cil-dump ifdef/lib.dll > ifdef.txt
# RUN: %{members} ifdef.txt lib | FileCheck %s --check-prefixes=DEFAULT,HID2 \
