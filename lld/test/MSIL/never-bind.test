# RUN: FileCheck %s --check-prefix=N4-NONE --input-file=sj.txt
# RUN: FileCheck %s --check-prefix=N4-NONE --input-file=sj-nolib.txt
# N4-DAG:    {{^}}msil-ld: error: [[FILE]]: '_setjmp' cannot be bound to a native library: setjmp and longjmp are lowered by the compiler{{$}}
# N4-DAG:    {{^}}msil-ld: error: [[FILE]]: 'setjmp' cannot be bound to a native library: setjmp and longjmp are lowered by the compiler{{$}}
# N4-DAG:    {{^}}msil-ld: error: [[FILE]]: '__sigsetjmp' cannot be bound to a native library: setjmp and longjmp are lowered by the compiler{{$}}
# N4-DAG:    {{^}}msil-ld: error: [[FILE]]: 'sigsetjmp' cannot be bound to a native library: setjmp and longjmp are lowered by the compiler{{$}}
# N4-DAG:    {{^}}msil-ld: error: [[FILE]]: 'longjmp' cannot be bound to a native library: setjmp and longjmp are lowered by the compiler{{$}}
# N4-DAG:    {{^}}msil-ld: error: [[FILE]]: '_longjmp' cannot be bound to a native library: setjmp and longjmp are lowered by the compiler{{$}}
# N4-DAG:    {{^}}msil-ld: error: [[FILE]]: 'siglongjmp' cannot be bound to a native library: setjmp and longjmp are lowered by the compiler{{$}}
