# SJDEF: {{^}}  .method '_setjmp' int32(native int) flags=0x0016 impl=0x0000{{$}}
# SJDEF: {{^}}  .method 'longjmp' void(native int, int32) flags=0x0016 impl=0x0000{{$}}
