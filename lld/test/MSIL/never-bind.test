#--- sj.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; Every Linux name of the family. glibc's headers spell setjmp as _setjmp
;; and sigsetjmp as __sigsetjmp, and longjmp, _longjmp and siglongjmp under
;; _FORTIFY_SOURCE as __longjmp_chk; musl's spell each name as itself. Every
;; call is live.
@buf = global [200 x i8] zeroinitializer

declare i32 @_setjmp(ptr) returns_twice
declare i32 @setjmp(ptr) returns_twice
declare i32 @__sigsetjmp(ptr, i32) returns_twice
declare i32 @sigsetjmp(ptr, i32) returns_twice
declare void @longjmp(ptr, i32) noreturn
declare void @_longjmp(ptr, i32) noreturn
declare void @siglongjmp(ptr, i32) noreturn
declare void @__longjmp_chk(ptr, i32) noreturn

define i32 @main() {
  %a = call i32 @_setjmp(ptr @buf)
  %b = call i32 @setjmp(ptr @buf)
  %c = call i32 @__sigsetjmp(ptr @buf, i32 0)
  %d = call i32 @sigsetjmp(ptr @buf, i32 1)
  %ab = add i32 %a, %b
  %cd = add i32 %c, %d
  %s = add i32 %ab, %cd
  switch i32 %s, label %done [
    i32 0, label %jump
    i32 1, label %jump2
    i32 2, label %jumpsig
    i32 3, label %jumpchk
  ]
jump:
  call void @longjmp(ptr @buf, i32 1)
  unreachable
jump2:
  call void @_longjmp(ptr @buf, i32 2)
  unreachable
jumpsig:
  call void @siglongjmp(ptr @buf, i32 3)
  unreachable
jumpchk:
  call void @__longjmp_chk(ptr @buf, i32 4)
  unreachable
done:
  ret i32 0
}

#--- sj2.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; A second file that references longjmp: an error of its own.
@buf2 = global [200 x i8] zeroinitializer

declare void @longjmp(ptr, i32) noreturn

define void @leave() {
  call void @longjmp(ptr @buf2, i32 3)
  unreachable
}

#--- sjdef.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; Object definitions of sj.ll's eight names.
define i32 @_setjmp(ptr %b) {
  ret i32 1
}

define i32 @setjmp(ptr %b) {
  ret i32 1
}

define i32 @__sigsetjmp(ptr %b, i32 %m) {
  ret i32 1
}

define i32 @sigsetjmp(ptr %b, i32 %m) {
  ret i32 1
}

define void @longjmp(ptr %b, i32 %v) {
  ret void
}

define void @_longjmp(ptr %b, i32 %v) {
  ret void
}

define void @siglongjmp(ptr %b, i32 %v) {
  ret void
}

define void @__longjmp_chk(ptr %b, i32 %v) {
  ret void
}

#--- sj-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; The UCRT's setjmp is _setjmpex (or _setjmp) with a frame argument; the
;; 32-bit x86 CRT's, _setjmp3, takes the count of the arguments that follow
;; (here none).
@buf = global [256 x i8] zeroinitializer

declare i32 @_setjmpex(ptr, ptr) returns_twice
declare i32 @_setjmp(ptr, ptr) returns_twice
declare i32 @_setjmp3(ptr, i32) returns_twice
declare void @longjmp(ptr, i32) noreturn

define i32 @main() {
  %a = call i32 @_setjmpex(ptr @buf, ptr null)
  %b = call i32 @_setjmp(ptr @buf, ptr null)
  %e = call i32 @_setjmp3(ptr @buf, i32 0)
  %ab = add i32 %a, %b
  %s = add i32 %ab, %e
  %c = icmp eq i32 %s, 0
  br i1 %c, label %jump, label %done
jump:
  call void @longjmp(ptr @buf, i32 1)
  unreachable
done:
  ret i32 0
}

#--- imp.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; Ordinary symbols whose import names are an N1, an N4 and an N3 name, as C's
;; __attribute__((import_name("..."))) gives them; libgcc_s.so.1 exports
;; __extendhfsf2 and libc.so.6 exports _setjmp and __msil_foo.
@buf = global [200 x i8] zeroinitializer

declare float @my_ext(i32) "msil-import-name"="__extendhfsf2"
declare i32 @my_setjmp(ptr) returns_twice "msil-import-name"="_setjmp"
declare i32 @my_foo(i32) "msil-import-name"="__msil_foo"

define i32 @main() {
  %f = call float @my_ext(i32 15872)
  %i = fptosi float %f to i32
  %s = call i32 @my_setjmp(ptr @buf)
  %r = call i32 @my_foo(i32 %i)
  %t = add i32 %r, %s
  ret i32 %t
}

#--- impweak.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; imp.ll's references, weak.
@buf = global [200 x i8] zeroinitializer

declare extern_weak float @my_ext(i32) "msil-import-name"="__extendhfsf2"
declare extern_weak i32 @my_setjmp(ptr) returns_twice "msil-import-name"="_setjmp"
declare extern_weak i32 @my_foo(i32) "msil-import-name"="__msil_foo"

define i32 @main() {
  %c = icmp eq ptr @my_ext, null
  br i1 %c, label %none, label %call
call:
  %f = call float @my_ext(i32 15872)
  %i = fptosi float %f to i32
  %s = call i32 @my_setjmp(ptr @buf)
  %r = call i32 @my_foo(i32 %i)
  %t = add i32 %r, %s
  ret i32 %t
none:
  ret i32 0
}
