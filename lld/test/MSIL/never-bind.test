## Import names: my_ext, my_setjmp and my_foo, imported as __extendhfsf2,
## _setjmp and __msil_foo, bind to neither libgcc_s.so.1 nor libc.so.6, which
## export those names: each is an undefined symbol under its own name, and
## no image or text is written; objects, LTO with an image and
## --lto-emit-asm.
# RUN: not msil-ld imp.o libc.so.6 libgcc_s.so.1 -o imp.exe 2>&1 | %{err} --check-prefix=IMPORT -DREF=imp.o
# RUN: not ls imp.exe
# RUN: not msil-ld imp.bc libc.so.6 libgcc_s.so.1 -o imp-lto.exe 2>&1 | %{err} --check-prefix=IMPORT -DREF=imp.bc
# RUN: not ls imp-lto.exe
# RUN: not msil-ld --lto-emit-asm imp.bc libc.so.6 libgcc_s.so.1 -o imp.il 2>&1 \
# RUN:   | %{err} --check-prefix=IMPORT -DREF=imp.bc
# RUN: not ls imp.il
# IMPORT:      {{^}}msil-ld: error: undefined symbol: my_ext{{$}}
# IMPORT-NEXT: {{^}}>>> referenced by [[REF]]:(main){{$}}
# IMPORT-EMPTY:
# IMPORT-NEXT: {{^}}msil-ld: error: undefined symbol: my_setjmp{{$}}
# IMPORT-NEXT: {{^}}>>> referenced by [[REF]]:(main){{$}}
# IMPORT-EMPTY:
# IMPORT-NEXT: {{^}}msil-ld: error: undefined symbol: my_foo{{$}}
# IMPORT-NEXT: {{^}}>>> referenced by [[REF]]:(main){{$}}

## Weak references to the same imports keep their trap stubs: no P/Invoke,
## no ImplMap or ModuleRef row (llvm-cil-dump's .pinvokeimpl and moduleref
## lines).
# RUN: msil-ld impweak.o libc.so.6 libgcc_s.so.1 -o impweak.exe 2>&1 | count 0
# RUN: llvm-cil-dump impweak.exe | FileCheck %s --check-prefix=IMPORT-STUB --implicit-check-not=pinvokeimpl \
# RUN:   --implicit-check-not=moduleref
# RUN: msil-ld impweak.bc libc.so.6 libgcc_s.so.1 -o impweak-lto.exe 2>&1 | count 0
# RUN: llvm-cil-dump impweak-lto.exe | FileCheck %s --check-prefix=IMPORT-STUB --implicit-check-not=pinvokeimpl \
# RUN:   --implicit-check-not=moduleref
# IMPORT-STUB: {{^}}  .method '<msil>undef_my_ext' float32(int32) flags=0x0013 impl=0x0000{{$}}
# IMPORT-STUB: {{^}}  .method '<msil>undef_my_foo' int32(int32) flags=0x0013 impl=0x0000{{$}}
# IMPORT-STUB: {{^}}  .method '<msil>undef_my_setjmp' int32(native int) flags=0x0013 impl=0x0000{{$}}
# IMPORT-STUB: {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# IMPORT-STUB: {{^}}    L{{[0-9]+}}: call float32(int32) '<Module>'::'<msil>undef_my_ext'{{$}}
# IMPORT-STUB: {{^}}    L{{[0-9]+}}: call int32(native int) '<Module>'::'<msil>undef_my_setjmp'{{$}}
# IMPORT-STUB: {{^}}    L{{[0-9]+}}: call int32(int32) '<Module>'::'<msil>undef_my_foo'{{$}}
# RUN: msil-ld --lto-emit-asm impweak.bc libc.so.6 libgcc_s.so.1 -o impweak.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=IMPORT-STUB-TEXT --implicit-check-not=pinvokeimpl --input-file=impweak.il
# IMPORT-STUB-TEXT: {{^}}  call float32 '<msil>undef_my_ext'(int32){{$}}
# IMPORT-STUB-TEXT: {{^}}  call int32 '<msil>undef_my_setjmp'(native int){{$}}
# IMPORT-STUB-TEXT: {{^}}  call int32 '<msil>undef_my_foo'(int32){{$}}
# IMPORT-STUB-TEXT: {{^}}.method assembly static float32 '<msil>undef_my_ext'(int32) cil managed{{$}}
# IMPORT-STUB-TEXT: {{^}}.method assembly static int32 '<msil>undef_my_setjmp'(native int) cil managed{{$}}
# IMPORT-STUB-TEXT: {{^}}.method assembly static int32 '<msil>undef_my_foo'(int32) cil managed{{$}}

#--- libgcc.yaml
## A libgcc_s.so.1 stand-in that exports compiler-rt names.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x18
Symbols:
  - { Name: __extendhfsf2, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: __truncsfhf2,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x8, Size: 8 }
  - { Name: __floattidf,   Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x10, Size: 8 }

#--- libc.yaml
## A libc.so.6 stand-in: the checked entry points and the stack protector's
## guard (data), dlopen and dlsym (for the guard's data import), every Linux
## name of the setjmp family and an '__msil_' name.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x80
  - Name:  .data
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    Size:  0x8
Symbols:
  - { Name: puts,              Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: dlopen,            Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x8, Size: 8 }
  - { Name: dlsym,             Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x10, Size: 8 }
  - { Name: __memcpy_chk,      Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x18, Size: 8 }
  - { Name: __memmove_chk,     Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x20, Size: 8 }
  - { Name: __memset_chk,      Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x28, Size: 8 }
  - { Name: __stack_chk_fail,  Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x30, Size: 8 }
  - { Name: __stack_chk_guard, Type: STT_OBJECT, Section: .data, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: _setjmp,           Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x38, Size: 8 }
  - { Name: setjmp,            Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x40, Size: 8 }
  - { Name: __sigsetjmp,       Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x48, Size: 8 }
  - { Name: sigsetjmp,         Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x50, Size: 8 }
  - { Name: longjmp,           Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x58, Size: 8 }
  - { Name: _longjmp,          Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x60, Size: 8 }
  - { Name: siglongjmp,        Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x68, Size: 8 }
  - { Name: __longjmp_chk,     Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x70, Size: 8 }
  - { Name: __msil_foo,        Type: STT_FUNC,   Section: .text, Binding: STB_GLOBAL, Value: 0x78, Size: 8 }

#--- libm.yaml
## A libm.so.6 stand-in: two of glibc's _finite entry points.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: __exp_finite,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: __powf_finite, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x8, Size: 8 }

#--- atomic.yaml
## A libatomic.so.1 stand-in.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: __atomic_load_4,  Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: __atomic_store_4, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x8, Size: 8 }

#--- helpers.def
LIBRARY helpers.dll
EXPORTS
  __extendhfsf2
  __msil_foo

#--- atomic.def
LIBRARY libatomic-1.dll
EXPORTS
  __atomic_load_4
  __atomic_store_4

#--- vcruntime.def
LIBRARY VCRUNTIME140.dll
EXPORTS
  _setjmp
  _setjmp3
  _setjmpex
  longjmp
  __chkstk
  __security_check_cookie
  __security_cookie DATA

#--- half.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; The legalizer calls __extendhfsf2 for the fpext.
@g = global half 0xH3E00

define i32 @main() {
  %h = load volatile half, ptr @g
  %f = fpext half %h to float
  %i = fptosi float %f to i32
  ret i32 %i
}

#--- direct.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

declare float @__extendhfsf2(i32)

define i32 @main() {
  %f = call float @__extendhfsf2(i32 15872)
  %i = fptosi float %f to i32
  ret i32 %i
}

#--- ref2.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

declare float @__extendhfsf2(i32)

define float @ext2(i32 %h) {
  %f = call float @__extendhfsf2(i32 %h)
  ret float %f
}

#--- ext.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; A stand-in for the helper archive's member.
define float @__extendhfsf2(i32 %h) {
  %f = sitofp i32 %h to float
  ret float %f
}

#--- weak.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

declare extern_weak float @__extendhfsf2(i32)

define i32 @main() {
  %c = icmp eq ptr @__extendhfsf2, null
  br i1 %c, label %none, label %call
call:
  %f = call float @__extendhfsf2(i32 15872)
  %i = fptosi float %f to i32
  ret i32 %i
none:
  ret i32 0
}

#--- chk.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@dst = global [16 x i8] zeroinitializer
@src = global [16 x i8] zeroinitializer
@n = global i64 4
@os = global i64 16

declare ptr @__memcpy_chk(ptr, ptr, i64, i64)
declare ptr @__memmove_chk(ptr, ptr, i64, i64)
declare ptr @__memset_chk(ptr, i32, i64, i64)
declare void @__stack_chk_fail()

define i32 @main() {
  %n = load volatile i64, ptr @n
  %os = load volatile i64, ptr @os
  %a = call ptr @__memcpy_chk(ptr @dst, ptr @src, i64 %n, i64 %os)
  %b = call ptr @__memmove_chk(ptr %a, ptr @src, i64 %n, i64 %os)
  %c = call ptr @__memset_chk(ptr %b, i32 0, i64 %n, i64 %os)
  %z = icmp eq ptr %c, null
  br i1 %z, label %fail, label %ok
fail:
  call void @__stack_chk_fail()
  unreachable
ok:
  ret i32 0
}

#--- clib.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; The stack protector's guard and two of libm's _finite entry points; the
;; arguments are volatile loads, so nothing folds the calls.
@__stack_chk_guard = external global i64
@d = global double 1.0
@f = global float 2.0

declare double @__exp_finite(double)
declare float @__powf_finite(float, float)

define i32 @main() {
  %g = load volatile i64, ptr @__stack_chk_guard
  %x = load volatile double, ptr @d
  %e = call double @__exp_finite(double %x)
  %y = load volatile float, ptr @f
  %p = call float @__powf_finite(float %y, float %y)
  %pe = fpext float %p to double
  %s = fadd double %e, %pe
  %i = fptosi double %s to i64
  %r = add i64 %i, %g
  %t = trunc i64 %r to i32
  ret i32 %t
}

#--- crt-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; The MSVC C runtime's stack probe and security cookie.
@__security_cookie = external global i64

declare void @__chkstk()
declare void @__security_check_cookie(i64)

define i32 @main() {
  call void @__chkstk()
  %c = load volatile i64, ptr @__security_cookie
  call void @__security_check_cookie(i64 %c)
  %t = trunc i64 %c to i32
  ret i32 %t
}

#--- atom.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@v = global i32 7

declare i32 @__atomic_load_4(ptr, i32)

define i32 @main() {
  %r = call i32 @__atomic_load_4(ptr @v, i32 5)
  ret i32 %r
}

#--- atom-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@v = global i32 7

declare i32 @__atomic_load_4(ptr, i32)

define i32 @main() {
  %r = call i32 @__atomic_load_4(ptr @v, i32 5)
  ret i32 %r
}

#--- help-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

declare float @__extendhfsf2(i32)
declare i32 @__msil_foo(i32)

define i32 @main() {
  %f = call float @__extendhfsf2(i32 15872)
  %i = fptosi float %f to i32
  %r = call i32 @__msil_foo(i32 %i)
  ret i32 %r
}

#--- foo.ll
