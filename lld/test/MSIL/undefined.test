## With native libraries: the UCRT's API sets on windows-msvc, glibc's
## libc.so.6 and libm.so.6 on linux-gnu; 'assembly', never D14's spelling.
# RUN: msil-ld --lto-emit-asm --lto-O0 imports-win.o ucrt.lib -o win.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=WIN --implicit-check-not='"ucrtbase"' \
# RUN:   --implicit-check-not="public hidebysig static pinvokeimpl" --input-file=win.il
# RUN: FileCheck %s --check-prefix=WIN-NONE --input-file=win.il
# RUN: msil-ld --lto-emit-asm --lto-O0 imports-lnx.o libc.so.6 libm.so.6 -o lnx.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=LNX --implicit-check-not='"libc"' \
# RUN:   --implicit-check-not="public hidebysig static pinvokeimpl" --input-file=lnx.il
# RUN: FileCheck %s --check-prefix=LNX-NONE --input-file=lnx.il

# WIN-DAG:   {{^}}.method assembly hidebysig static pinvokeimpl("api-ms-win-crt-stdio-l1-1-0.dll" cdecl) int32 'puts'(native int) cil managed preservesig {}{{$}}
# WIN-DAG:   {{^}}.method assembly hidebysig static pinvokeimpl("api-ms-win-crt-math-l1-1-0.dll" cdecl) float64 'sqrt'(float64) cil managed preservesig {}{{$}}
# LNX-DAG:   {{^}}.method assembly hidebysig static pinvokeimpl("libc.so.6" cdecl) int32 'puts'(native int) cil managed preservesig {}{{$}}
# LNX-DAG:   {{^}}.method assembly hidebysig static pinvokeimpl("libm.so.6" cdecl) float64 'sqrt'(float64) cil managed preservesig {}{{$}}
## The implicit patterns nowhere in the file: for a prefix made only of -DAG
## lines, --implicit-check-not checks only the text before the first match.
# WIN-NONE-NOT: "ucrtbase"
# WIN-NONE-NOT: public hidebysig static pinvokeimpl
# LNX-NONE-NOT: "libc"
# LNX-NONE-NOT: public hidebysig static pinvokeimpl

## A name that LTO's optimizer introduces: printf("hi\n") becomes puts("hi")
## at -O2, and the report names the merged module; with a library that
## binds puts the program links.
# RUN: llvm-as printf.ll -o printf.o
# RUN: not msil-ld --lto-emit-asm printf.o -o x.il 2>&1 | %{err} --check-prefix=LTO-NAME --implicit-check-not=printf
# LTO-NAME:      {{^}}msil-ld: error: undefined symbol: puts{{$}}
# LTO-NAME-NEXT: {{^}}>>> referenced by ld-temp.o
# RUN: msil-ld --lto-emit-asm printf.o ucrt.lib -o puts.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=WIN-PUTS --implicit-check-not=printf --input-file=puts.il
# WIN-PUTS: {{^}}.method assembly hidebysig static pinvokeimpl("api-ms-win-crt-stdio-l1-1-0.dll" cdecl) int32 'puts'(native int) cil managed preservesig {}{{$}}

## __start_myreg and __stop_myreg with a bitcode definition in section
## "myreg" (ss.ll): on linux-gnu, with libss.so (which defines both names) or
## without it, msil-ld neither reports them nor binds them, so --trace-symbol
## shows no shared definition. Until M20 the backend's M12 texts for the
## section global and the external globals still fail the link. For section
## "other" (ns.ll) they are native data with libss.so and undefined without
## it; on windows-msvc they are undefined although ss-win.ll names "myreg".
# RUN: yaml2obj ss.yaml -o ss-lib.o
# RUN: ld.lld -shared -soname libss.so.1 ss-lib.o -o libss.so
# RUN: llvm-as ss.ll -o ss.o
# RUN: llvm-as ns.ll -o ns.o
# RUN: llvm-as ss-win.ll -o ss-win.o
# DEFINE: %{ss} = %{err} --implicit-check-not='undefined symbol' --implicit-check-not='shared definition' \
# DEFINE:   --implicit-check-not='importing native data'
# RUN: not msil-ld --lto-emit-asm ss.o libss.so --trace-symbol=__start_myreg --trace-symbol=__stop_myreg \
# RUN:   -o x.il > ss-lib.txt 2>&1
# RUN: not msil-ld --lto-emit-asm ss.o -o x.il > ss-nolib.txt 2>&1
# RUN: %{ss} --check-prefixes=SS-TRACE,SS-M12 --input-file=ss-lib.txt
# RUN: %{ss} --check-prefix=SS-M12 --input-file=ss-nolib.txt
# RUN: FileCheck %s --check-prefix=SS-ABSENT --input-file=ss-lib.txt
# RUN: FileCheck %s --check-prefix=SS-ABSENT --input-file=ss-nolib.txt
# SS-TRACE-DAG: {{^}}ss.o: reference to __start_myreg{{$}}
# SS-TRACE-DAG: {{^}}ss.o: reference to __stop_myreg{{$}}
# SS-M12-DAG:   {{^}}msil-ld: error: global variable @entry in section "myreg" is not supported for MSIL yet (phase 2 CIL objects){{$}}
# SS-M12-DAG:   {{^}}msil-ld: error: external global variable '__start_myreg' is not supported (phase 2 linker){{$}}
# SS-M12-DAG:   {{^}}msil-ld: error: external global variable '__stop_myreg' is not supported (phase 2 linker){{$}}
## Nowhere in the output (the implicit checks above guard only the text
## before the first CHECK-DAG match).
# SS-ABSENT-NOT: undefined symbol
# SS-ABSENT-NOT: shared definition
# SS-ABSENT-NOT: importing native data
# SS-ABSENT-NOT: PLEASE submit
# SS-ABSENT-NOT: Stack dump
# SS-ABSENT-NOT: LLVM ERROR
# RUN: not msil-ld --lto-emit-asm ns.o libss.so --trace-symbol=__start_myreg -o x.il 2>&1 \
# RUN:   | %{err} --check-prefix=NS-LIB --implicit-check-not='undefined symbol'
# NS-LIB:      {{^}}libss.so: shared definition of __start_myreg{{$}}
# NS-LIB:      {{^}}msil-ld: error: importing native data symbol '__start_myreg' (libss.so.1) is not supported yet{{$}}
# NS-LIB-NEXT: {{^}}>>> referenced by ns.o:(main){{$}}
# NS-LIB:      {{^}}msil-ld: error: importing native data symbol '__stop_myreg' (libss.so.1) is not supported yet{{$}}
# NS-LIB-NEXT: {{^}}>>> referenced by ns.o:(main){{$}}
# RUN: not msil-ld --lto-emit-asm ns.o -o x.il 2>&1 | %{err} --check-prefix=SS-UNDEF -DFILE=ns.o
# RUN: not msil-ld --lto-emit-asm ss-win.o -o x.il 2>&1 | %{err} --check-prefix=SS-UNDEF -DFILE=ss-win.o
# SS-UNDEF:      {{^}}msil-ld: error: undefined symbol: __start_myreg{{$}}
# SS-UNDEF-NEXT: {{^}}>>> referenced by [[FILE]]:(main){{$}}
# SS-UNDEF:      {{^}}msil-ld: error: undefined symbol: __stop_myreg{{$}}
# SS-UNDEF-NEXT: {{^}}>>> referenced by [[FILE]]:(main){{$}}

#--- ss.yaml
## libss.so defines __start_myreg and __stop_myreg as data.
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .data
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_WRITE ]
    Size:  0x2
Symbols:
  - { Name: __start_myreg, Type: STT_OBJECT, Section: .data, Binding: STB_GLOBAL, Value: 0x0, Size: 1 }
  - { Name: __stop_myreg,  Type: STT_OBJECT, Section: .data, Binding: STB_GLOBAL, Value: 0x1, Size: 1 }

#--- ss.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@__start_myreg = external global i8
@__stop_myreg = external global i8
@entry = global i32 7, section "myreg"
@llvm.used = appending global [1 x ptr] [ptr @entry], section "llvm.metadata"

define i32 @main() {
  %a = ptrtoint ptr @__start_myreg to i64
  %b = ptrtoint ptr @__stop_myreg to i64
  %d = sub i64 %b, %a
  %r = trunc i64 %d to i32
  ret i32 %r
}

#--- ns.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@__start_myreg = external global i8
@__stop_myreg = external global i8
@entry = global i32 7, section "other"
@llvm.used = appending global [1 x ptr] [ptr @entry], section "llvm.metadata"

define i32 @main() {
  %a = ptrtoint ptr @__start_myreg to i64
  %b = ptrtoint ptr @__stop_myreg to i64
  %d = sub i64 %b, %a
  %r = trunc i64 %d to i32
  ret i32 %r
}

#--- ss-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@__start_myreg = external global i8
@__stop_myreg = external global i8
@entry = global i32 7, section "myreg"
@llvm.used = appending global [1 x ptr] [ptr @entry], section "llvm.metadata"

define i32 @main() {
  %a = ptrtoint ptr @__start_myreg to i64
  %b = ptrtoint ptr @__stop_myreg to i64
  %d = sub i64 %b, %a
  %r = trunc i64 %d to i32
  ret i32 %r
}

#--- data.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@ext_data = external global i32

define i32 @main() {
  %v = load i32, ptr @ext_data
  ret i32 %v
}

#--- many.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@ext_data = external global i32
@ptr = global ptr @ext_data

define i32 @main() {
  %v = load i32, ptr @ext_data
  %a = call i32 @f1()
  %b = call i32 @f2()
  %c = call i32 @f3()
  %p = load ptr, ptr @ptr
  %w = load i32, ptr %p
  %s1 = add i32 %v, %a
  %s2 = add i32 %s1, %b
  %s3 = add i32 %s2, %c
  %s4 = add i32 %s3, %w
  ret i32 %s4
}

define i32 @f1() {
  %v = load i32, ptr @ext_data
  ret i32 %v
}

define i32 @f2() {
  %v = load i32, ptr @ext_data
  ret i32 %v
}

define i32 @f3() {
  %v = load i32, ptr @ext_data
  ret i32 %v
}

#--- data-def.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@ext_data = global i32 3, align 4

#--- hidden-fn.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %r = call i32 @hidden_fn()
  ret i32 %r
}

declare hidden i32 @hidden_fn()

#--- hidden-data.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@hidden_data = external hidden global i32

define i32 @main() {
  %v = load i32, ptr @hidden_data
  ret i32 %v
}

#--- hidden-def.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @hidden_fn() {
  ret i32 6
}

#--- hidden.def
LIBRARY hidden.dll
EXPORTS
  hidden_fn
  hidden_data DATA

#--- fn.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %r = call i32 @ext_fn(i32 1)
  ret i32 %r
}

declare i32 @ext_fn(i32)

#--- fn-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  %r = call i32 @ext_fn(i32 1)
  ret i32 %r
}

declare i32 @ext_fn(i32)

#--- imports-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@msg = private constant [3 x i8] c"hi\00"

define i32 @main() {
  %r = call i32 @puts(ptr @msg)
  %s = call double @sqrt(double 4.0)
  %i = fptosi double %s to i32
  %t = add i32 %r, %i
