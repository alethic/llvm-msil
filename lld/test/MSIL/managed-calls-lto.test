#--- lto.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; int widget_count(void); a static field: ldsfld
declare i32 @__msil_mc.widget_count() #0

;; dn_handle widget_new(const char *, int); a constructor, a UTF-8 string
declare ptr @__msil_mc.widget_new(ptr, i32) #1

;; int point_sum(dn_handle); an instance method of a value type
declare i32 @__msil_mc.point_sum(ptr) #2

;; void set_wide(long long); an enum over int64
declare void @__msil_mc.set_wide(i64) #3

;; int guarded(int, int *); msil_catch: a derived type before its base, and a
;; BCL exception
declare i32 @__msil_mc.guarded(i32, ptr) #4

;; long long measure(void); ASSEMBLY names the scope of standalone text only
declare i64 @__msil_mc.measure() #5

define i32 @main() {
  %r0 = call i32 @__msil_mc.widget_count()
  %r1 = call ptr @__msil_mc.widget_new(ptr null, i32 3)
  %r2 = call i32 @__msil_mc.point_sum(ptr null)
  call void @__msil_mc.set_wide(i64 4294967296)
  %r3 = call i32 @__msil_mc.guarded(i32 9, ptr null)
  %r4 = call i64 @__msil_mc.measure()
  %c = call i32 @widget_count()
  ret i32 %c
}

declare i32 @widget_count()

