# IMAGE-DAG: {{^}}assemblyref 'FakeWidgets' ver 1.0.0.0 flags=0x00000000 key=- culture=''{{$}}
# IMAGE-DAG: {{^  }}.method '__msil_mc.widget_count' int32() {{.+$}}
# IMAGE-DAG: {{^    L[0-9]+: }}ldsfld int32 [FakeWidgets]Contoso.Widget::'Count'{{$}}
# IMAGE-DAG: {{^    L[0-9]+: }}newobj instance void(string, int32) [FakeWidgets]Contoso.Widget::'.ctor'{{$}}
# IMAGE-DAG: {{^    L[0-9]+: }}newobj instance void(bool, bool) [FakeRuntime]System.Text.UTF8Encoding::'.ctor'{{$}}
# IMAGE-DAG: {{^    L[0-9]+: }}call instance int32() [FakeWidgets]Contoso.Point::'Sum'{{$}}
# IMAGE-DAG: {{^    L[0-9]+: }}unbox [FakeWidgets]Contoso.Point{{$}}
# IMAGE-DAG: {{^    L[0-9]+: }}call void(valuetype [FakeWidgets]Contoso.WideMode) [FakeWidgets]Contoso.Widget::'SetWide'{{$}}
# IMAGE-DAG: {{^    L[0-9]+: }}call int32(int32) [FakeWidgets]Contoso.Widget::'Guarded'{{$}}
# IMAGE-DAG: {{^    L[0-9]+: }}isinst [FakeWidgets]Contoso.BrokenWidgetException{{$}}
# IMAGE-DAG: {{^    }}.try L{{[0-9]+}} to L{{[0-9]+}} filter L{{[0-9]+}} handler L{{[0-9]+}} to L{{[0-9]+}}{{$}}
# IMAGE-DAG: {{^    L[0-9]+: }}call int64() [FakeWidgets]Contoso.Widget::'Measure'{{$}}

# CNAME-DAG: {{^  }}.method 'widget_count' int32() {{.+$}}
# CNAME-DAG: {{^  }}.method '__msil_mc.widget_count' int32() {{.+$}}
# CNAME-DAG: {{^    L[0-9]+: }}call int32() '<Module>'::'__msil_mc.widget_count'{{$}}
# CNAME-DAG: {{^    L[0-9]+: }}call int32() '<Module>'::'widget_count'{{$}}

## MW3: --lto-emit-asm, without and with references; cname.bc defines the
## C name that main calls.
# RUN: mkdir none withrefs
