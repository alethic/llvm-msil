## A 64-bit C value is native int in a stub's own signature (D2); the stub
## converts it for the member's int64.
# TEXT-DAG: {{^}}.method assembly static int32 '__msil_mc.widget_count'() cil managed{{$}}
# TEXT-DAG: {{^ +}}ldsfld int32 [mscorlib]Contoso.Widget::Count{{$}}
# TEXT-DAG: {{^}}.method assembly static native int '__msil_mc.widget_new'(native int, int32) cil managed{{$}}
# TEXT-DAG: {{^ +}}newobj instance void [mscorlib]Contoso.Widget::.ctor(string, int32){{$}}
# TEXT-DAG: {{^ +}}newobj instance void [mscorlib]System.Text.UTF8Encoding::.ctor(bool, bool){{$}}
# TEXT-DAG: {{^ +}}callvirt instance string [mscorlib]System.Text.Encoding::GetString(uint8*, int32){{$}}
# TEXT-DAG: {{^}}.method assembly static int32 '__msil_mc.point_sum'(native int) cil managed{{$}}
# TEXT-DAG: {{^ +}}call instance int32 [mscorlib]Contoso.Point::Sum(){{$}}
# TEXT-DAG: {{^}}.method assembly static void '__msil_mc.set_wide'(native int) cil managed{{$}}
# TEXT-DAG: {{^ +}}call void [mscorlib]Contoso.Widget::SetWide(valuetype [mscorlib]Contoso.WideMode){{$}}
# TEXT-DAG: {{^}}.method assembly static int32 '__msil_mc.guarded'(int32, native int) cil managed{{$}}
# TEXT-DAG: {{^ +}}call int32 [mscorlib]Contoso.Widget::Guarded(int32){{$}}
# TEXT-DAG: {{^ +}}isinst [mscorlib]Contoso.BrokenWidgetException{{$}}
# TEXT-DAG: {{^ +}}isinst [mscorlib]Contoso.WidgetException{{$}}
# TEXT-DAG: {{^ +}}isinst [mscorlib]System.Text.DecoderFallbackException{{$}}
# TEXT-DAG: {{^ +}}endfilter{{$}}
# TEXT-DAG: {{^}}.method assembly static native int '__msil_mc.measure'() cil managed{{$}}
# TEXT-DAG: {{^ +}}call int64 [ContosoText]Contoso.Widget::Measure(){{$}}

