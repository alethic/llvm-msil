# CANON-NEXT: {{^}}    L0: ldsfld native int '<Module>'::'scratch'{{$}}
# CANON-NEXT: {{^}}    L1: ldarg.0{{$}}
# CANON-NEXT: {{^}}    L2: call int32(int32) '<Module>'::'helper'{{$}}
# CANON:      {{^}}  .method 'helper' int32(int32) flags=0x0013 impl=0x0000{{$}}
# CANON-NEXT: {{^}}    .maxstack 2{{$}}
# CANON:      {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# CANON-NEXT: {{^}}    .maxstack 3{{$}}
# CANON-NEXT: {{^}}    L0: ldsfld native int '<Module>'::'msg'{{$}}
# CANON-NEXT: {{^}}    L1: call int32(native int) '<Module>'::'puts'{{$}}
# CANON-NEXT: {{^}}    L2: pop{{$}}
# CANON-NEXT: {{^}}    L3: ldc.i4.1{{$}}
# CANON-NEXT: {{^}}    L4: ldsfld native int '<Module>'::'table'{{$}}
# CANON-NEXT: {{^}}    L5: ldind.i{{$}}
# CANON-NEXT: {{^}}    L6: calli int32(int32){{$}}
# CANON-NEXT: {{^}}    L7: ldsfld native int '<Module>'::'counter'{{$}}
# CANON-NEXT: {{^}}    L8: ldind.i4{{$}}
# CANON-NEXT: {{^}}    L9: add{{$}}
# CANON-NEXT: {{^}}    L10: ret{{$}}
# CANON-NEXT: {{^}}  .method 'puts' int32(native int) flags=0x2093 impl=0x0080{{$}}
# CANON-NEXT: {{^}}    .pinvokeimpl 'api-ms-win-crt-stdio-l1-1-0.dll' entry 'puts' flags=0x0201{{$}}
# CANON-EMPTY:
# CANON-NEXT: {{^}}.class '<msil>image_t' flags=0x00000110 extends [mscorlib]System.ValueType{{$}}
# CANON-NEXT: {{^}}  .layout pack 1 size 20{{$}}
# CANON-NOT:  {{.}}

# HEADERS:      {{^}}Format: PE32+ machine=0x8664 exe{{$}}
# HEADERS-NEXT: {{^}}COFF: sections={{[0-9]+}} timestamp=0x{{[0-9A-F]+}} characteristics=0x{{[0-9A-F]+}} symbols=0{{$}}
# HEADERS:      {{^}}CLI: flags=0x00000001 entrypoint=0x0600{{[0-9A-F][0-9A-F][0-9A-F][0-9A-F]}} metadata=

# TABLES:      {{^}}Table: Module rows=1 rowsize={{[0-9]+}}{{$}}
# TABLES-NEXT: {{^}}  Module[1]: Generation=0x0000 Name='prog.exe' Mvid=
# TABLES:      {{^}}Table: TypeDef rows=2 rowsize={{[0-9]+}}{{$}}
# TABLES-NEXT: {{^}}  TypeDef[1]: Flags=0x00000000 TypeName='<Module>' TypeNamespace='' Extends=0 FieldList=0x04000001 MethodList=0x06000001{{$}}
# TABLES-NEXT: {{^}}  TypeDef[2]: Flags=0x00000110 TypeName='<msil>image_t' TypeNamespace=''
# TABLES:      {{^}}Table: Field rows=7 rowsize={{[0-9]+}}{{$}}
# TABLES-NEXT: {{^}}  Field[1]: Flags=0x0033 Name='msg' Signature=06 18{{$}}
# TABLES-NEXT: {{^}}  Field[2]: Flags=0x0036 Name='table' Signature=06 18{{$}}
# TABLES-NEXT: {{^}}  Field[3]: Flags=0x0036 Name='counter' Signature=06 18{{$}}
# TABLES-NEXT: {{^}}  Field[4]: Flags=0x0036 Name='scratch' Signature=06 18{{$}}
# TABLES:      {{^}}Table: MethodDef rows=6 rowsize={{[0-9]+}}{{$}}
# TABLES-NEXT: {{^}}  MethodDef[1]: RVA=0x{{[0-9A-F]+}} ImplFlags=0x0000 Flags=0x0016 Name='main' Signature=00 00 08 ParamList=
# TABLES-NEXT: {{^}}  MethodDef[2]: RVA=0x{{[0-9A-F]+}} ImplFlags=0x0000 Flags=0x0013 Name='helper' Signature=00 01 08 08 ParamList=
# TABLES-NEXT: {{^}}  MethodDef[3]: RVA=0x{{[0-9A-F]+}} ImplFlags=0x0000 Flags=0x0016 Name='add3' Signature=00 01 08 08 ParamList=
# TABLES-NEXT: {{^}}  MethodDef[4]: RVA=0x00000000 ImplFlags=0x0080 Flags=0x2093 Name='puts' Signature=00 01 08 18 ParamList=
# TABLES-NEXT: {{^}}  MethodDef[5]: RVA=0x{{[0-9A-F]+}} ImplFlags=0x0000 Flags=0x{{1891|0091}} Name='{{\.cctor|<msil>Main}}'
# TABLES-NEXT: {{^}}  MethodDef[6]: RVA=0x{{[0-9A-F]+}} ImplFlags=0x0000 Flags=0x{{1891|0091}} Name='{{\.cctor|<msil>Main}}'
# TABLES:      {{^}}Table: ImplMap rows=1 rowsize={{[0-9]+}}{{$}}
# TABLES-NEXT: {{^}}  ImplMap[1]: MappingFlags=0x0201 MemberForwarded=0x06000004 ImportName='puts' ImportScope=0x1A000001{{$}}
# TABLES:      {{^}}Table: Assembly rows=1 rowsize={{[0-9]+}}{{$}}
# TABLES-NEXT: {{^}}  Assembly[1]: HashAlgId=0x00008004 MajorVersion=0x0000 MinorVersion=0x0000 BuildNumber=0x0000 RevisionNumber=0x0000 Flags=0x00000000 PublicKey=- Name='prog' Culture=''{{$}}
# TABLES-NEXT: {{^}}Table: AssemblyRef rows=1 rowsize={{[0-9]+}}{{$}}
# TABLES-NEXT: {{^}}  AssemblyRef[1]: MajorVersion=0x0004 MinorVersion=0x0000 BuildNumber=0x0000 RevisionNumber=0x0000 Flags=0x00000000 PublicKeyOrToken=B7 7A 5C 56 19 34 E0 89 Name='mscorlib' Culture='' HashValue=-{{$}}

## The assembly is named by --assembly-name (both spellings) or -soname, else
## after the stem of -o (only the last extension goes); the Module row
## always names the output file.
# RUN: mkdir out
# RUN: msil-ld a.o b.o ucrt.lib --assembly-name=Named -o out/n1.exe 2>&1 | count 0
# RUN: llvm-cil-dump out/n1.exe | FileCheck %s --check-prefix=NAMED -DFILE=n1.exe
# RUN: msil-ld a.o b.o ucrt.lib --assembly-name Named -o out/n2.exe 2>&1 | count 0
# RUN: llvm-cil-dump out/n2.exe | FileCheck %s --check-prefix=NAMED -DFILE=n2.exe
# RUN: msil-ld a.o b.o ucrt.lib -soname Named -o out/n3.exe 2>&1 | count 0
# RUN: llvm-cil-dump out/n3.exe | FileCheck %s --check-prefix=NAMED -DFILE=n3.exe
# RUN: msil-ld a.o b.o ucrt.lib -o out/My.App.exe 2>&1 | count 0
# RUN: llvm-cil-dump out/My.App.exe | FileCheck %s --check-prefix=DOTS
# NAMED:     {{^}}assembly 'Named' ver 0.0.0.0 flags=0x00000000 hash=0x00008004 culture='' key=-{{$}}
# NAMED-NEXT: {{^}}module '[[FILE]]'{{$}}
# DOTS:      {{^}}assembly 'My.App' ver 0.0.0.0 flags=0x00000000 hash=0x00008004 culture='' key=-{{$}}
# DOTS-NEXT: {{^}}module 'My.App.exe'{{$}}

## An output name that ends in neither .exe nor .dll is still an EXE, with a
## warning (5.10.5).
# RUN: msil-ld a.o b.o ucrt.lib -o out/prog.bin 2>&1 | FileCheck %s --check-prefix=EXT \
# RUN:   --implicit-check-not=error: --implicit-check-not="PLEASE submit"
# RUN: llvm-cil-dump --headers out/prog.bin | FileCheck %s --check-prefix=HEADERS
# EXT: {{^}}msil-ld: warning: {{.*}}prog.bin

## The machine comes from the triple: aarch64 Linux.
# RUN: llc -filetype=obj a64.ll -o a64.o
# RUN: msil-ld a64.o -o a64.exe 2>&1 | count 0
# RUN: llvm-cil-dump --headers a64.exe | FileCheck %s --check-prefix=A64-HEADERS
# RUN: llvm-cil-dump a64.exe | FileCheck %s --check-prefix=A64 %{none}
# A64-HEADERS: {{^}}Format: PE32+ machine=0xAA64 exe{{$}}
# A64:         {{^}}pe PE32+ machine=0xAA64 exe subsystem=3{{$}}
# A64-NEXT:    {{^}}cor flags=0x00000001 runtime=2.5 metadata-version=v4.0.30319{{$}}
# A64-NEXT:    {{^}}entrypoint int32(string[]) '<Module>'::'<msil>Main'{{$}}
# A64-NEXT:    {{^}}assembly 'a64' ver 0.0.0.0 flags=0x00000000 hash=0x00008004 culture='' key=-{{$}}
# A64-NEXT:    {{^}}module 'a64.exe'{{$}}
# A64-NEXT:    {{^}}assemblyref 'mscorlib' ver 4.0.0.0 flags=0x00000000 key=B7 7A 5C 56 19 34 E0 89 culture=''{{$}}
# A64-EMPTY:
# A64-NEXT:    {{^}}.class '<Module>' flags=0x00000000{{$}}
# A64-NEXT:    {{^}}  .method '<msil>Main' int32(string[]) flags=0x0091 impl=0x0000{{$}}
# A64-NEXT:    {{^}}    .maxstack 1{{$}}
# A64-NEXT:    {{^}}    L0: call int32() '<Module>'::'main'{{$}}
# A64-NEXT:    {{^}}    L1: ret{{$}}
# A64-NEXT:    {{^}}  .method 'main' int32() flags=0x0016 impl=0x0000{{$}}
# A64-NEXT:    {{^}}    .maxstack 1{{$}}
# A64-NEXT:    {{^}}    L0: ldc.i4.s 42{{$}}
# A64-NEXT:    {{^}}    L1: ret{{$}}
# A64-NOT:     {{.}}

#--- a.ll
target triple = "x86_64-pc-windows-msvc-msil"

@msg = private unnamed_addr constant [6 x i8] c"hello\00", align 1
@table = global [1 x ptr] [ptr @add3], align 8
@counter = external global i32

declare i32 @add3(i32)
declare i32 @puts(ptr)

define i32 @main() {
  %p = call i32 @puts(ptr @msg)
  %f = load ptr, ptr @table
  %r = call i32 %f(i32 1)
  %c = load i32, ptr @counter
  %s = add i32 %r, %c
  ret i32 %s
}

#--- b.ll
target triple = "x86_64-pc-windows-msvc-msil"

@counter = global i32 5, align 4
@scratch = global [3 x i32] zeroinitializer, align 4

define internal i32 @helper(i32 %x) {
  %r = add i32 %x, 3
  ret i32 %r
}

define i32 @add3(i32 %x) {
  %h = call i32 @helper(i32 %x)
  store i32 %h, ptr @scratch
  ret i32 %h
}

#--- a64.ll
target triple = "aarch64-unknown-linux-gnu-msil"

define i32 @main() {
  ret i32 42
}
