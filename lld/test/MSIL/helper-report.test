  %f = call float @__extendhfsf2(i32 %h)
  %d = fpext float %f to double
  call void @__muldc3(ptr sret({ double, double }) align 8 %tmp, double %d, double 0.0, double 2.0, double 0.0)
  %re = load double, ptr %tmp, align 8
  %i = fptosi double %re to i32
  ret i32 %i
}

#--- hlprog.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

