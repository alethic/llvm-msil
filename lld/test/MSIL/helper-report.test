# RUN: llc -filetype=obj hl-win.ll -o hl-win.o
# RUN: llvm-as hl-win.ll -o hl-win.bc
# RUN: msil-ld -shared hl-lnx.o dll-lnx/libclang_rt.builtins.a -o hll.dll 2>&1 | count 0
# RUN: msil-ld -shared hl-win.o dll-win/clang_rt.builtins.lib -o hlw.dll 2>&1 | count 0
# RUN: msil-ld -shared hl-win.bc dll-win/clang_rt.builtins.lib -o hlw-lto.dll 2>&1 | count 0
# RUN: llvm-cil-dump hll.dll > hll.txt
# RUN: llvm-cil-dump hlw.dll > hlw.txt
# RUN: llvm-cil-dump hlw-lto.dll > hlw-lto.txt
# RUN: %python %S/Inputs/shared/listing.py members hll.txt hll | FileCheck %s --check-prefix=PRIV-EXPORTS \
# RUN:   -DCLASS=hll --implicit-check-not=__extendhfsf2 --implicit-check-not=__muldc3
# RUN: %python %S/Inputs/shared/listing.py members hlw.txt hlw | FileCheck %s --check-prefix=PRIV-EXPORTS \
# RUN:   -DCLASS=hlw --implicit-check-not=__extendhfsf2 --implicit-check-not=__muldc3
# RUN: %python %S/Inputs/shared/listing.py members hlw-lto.txt hlw-lto | FileCheck %s --check-prefix=PRIV-EXPORTS \
# RUN:   -DCLASS=hlw-lto --implicit-check-not=__extendhfsf2 --implicit-check-not=__muldc3
# PRIV-EXPORTS: {{^}}.class '[[CLASS]]' flags=
# PRIV-EXPORTS: {{^}}  .method 'use_helpers' int32(int32) flags=0x0016 impl=0x0000{{$}}
# RUN: %python %S/Inputs/shared/listing.py members hll.txt '<Module>' | FileCheck %s --check-prefix=PRIV-MODULE
# RUN: %python %S/Inputs/shared/listing.py members hlw.txt '<Module>' | FileCheck %s --check-prefix=PRIV-MODULE
# RUN: %python %S/Inputs/shared/listing.py members hlw-lto.txt '<Module>' | FileCheck %s --check-prefix=PRIV-MODULE
# PRIV-MODULE: {{^}}.class '<Module>' flags=0x00000000{{$}}
# PRIV-MODULE: {{^}}  .method '__extendhfsf2' float32(int32) flags=
# PRIV-MODULE: {{^}}  .method '__muldc3' void(native int, float64, float64, float64, float64) flags=

## A program linked against hlw.dll: without the archive its own call of
## __extendhfsf2 is undefined (N1's first form), with it the program has its
## own copy.
# RUN: llc -filetype=obj hlprog.ll -o hlprog.o
# RUN: not msil-ld hlprog.o hlw.dll -o x.exe 2>&1 | FileCheck %s --check-prefix=PRIV-UNDEF
# PRIV-UNDEF-NOT:  {{.}}
# PRIV-UNDEF:      {{^}}msil-ld: error: undefined symbol: __extendhfsf2{{$}}
# PRIV-UNDEF-NEXT: {{^}}>>> a compiler runtime helper: link the toolchain's helper archive clang_rt.builtins{{$}}
# PRIV-UNDEF-NEXT: {{^}}>>> referenced by hlprog.o:(main){{$}}
# PRIV-UNDEF-NOT:  {{.}}
# RUN: msil-ld hlprog.o hlw.dll dll-win/clang_rt.builtins.lib -o hlprog.exe 2>&1 | count 0
# RUN: llvm-cil-dump hlprog.exe | FileCheck %s --check-prefix=PRIV-PROG "--implicit-check-not=[hlw]hlw::'__"
# PRIV-PROG: {{^}}assemblyref 'hlw' ver
# PRIV-PROG: {{^}}  .method '__extendhfsf2' float32(int32) flags=
# PRIV-PROG: {{^}}    L{{[0-9]+}}: call int32(int32) [hlw]hlw::'use_helpers'{{$}}
# PRIV-PROG: {{^}}    L{{[0-9]+}}: call float32(int32) '<Module>'::'__extendhfsf2'{{$}}

#--- lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; Calls of an f16 conversion, the double complex multiply as clang emits it
;; for x86_64 Linux, an atomic load, an '__msil_' name and another '__' name.
@v = global i32 7

declare float @__extendhfsf2(i32)
declare { double, double } @__muldc3(double, double, double, double)
declare i32 @__atomic_load_4(ptr, i32)
declare i32 @__msil_example(i32)
declare i32 @__start_x()

define i32 @main() {
  %f = call float @__extendhfsf2(i32 15872)
  %i = fptosi float %f to i32
  %c = call { double, double } @__muldc3(double 1.0, double 2.0, double 3.0, double 4.0)
  %re = extractvalue { double, double } %c, 0
  %j = fptosi double %re to i32
  %a = call i32 @__atomic_load_4(ptr @v, i32 5)
  %e = call i32 @__msil_example(i32 %a)
  %s = call i32 @__start_x()
  %r1 = add i32 %i, %j
  %r2 = add i32 %r1, %e
  %r3 = add i32 %r2, %s
  ret i32 %r3
}

#--- win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; The same calls; Win64 returns the complex result through an sret pointer.
@v = global i32 7

declare float @__extendhfsf2(i32)
declare void @__muldc3(ptr, double, double, double, double)
declare i32 @__atomic_load_4(ptr, i32)
declare i32 @__msil_example(i32)
declare i32 @__start_x()

define i32 @main() {
  %tmp = alloca { double, double }, align 8
  %f = call float @__extendhfsf2(i32 15872)
  %i = fptosi float %f to i32
  call void @__muldc3(ptr sret({ double, double }) align 8 %tmp, double 1.0, double 2.0, double 3.0, double 4.0)
  %re = load double, ptr %tmp, align 8
  %j = fptosi double %re to i32
  %a = call i32 @__atomic_load_4(ptr @v, i32 5)
  %e = call i32 @__msil_example(i32 %a)
  %s = call i32 @__start_x()
  %r1 = add i32 %i, %j
  %r2 = add i32 %r1, %e
  %r3 = add i32 %r2, %s
  ret i32 %r3
}

#--- ext-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; A stand-in for the archive's __extendhfsf2 member.
define hidden float @__extendhfsf2(i32 %h) {
  %f = sitofp i32 %h to float
  ret float %f
}

#--- ext-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; A stand-in for the archive's __extendhfsf2 member.
define hidden float @__extendhfsf2(i32 %h) {
  %f = sitofp i32 %h to float
  ret float %f
}

#--- div-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; A stand-in member that defines a helper which lnx.ll does not call and
;; divcall-lnx.ll does.
define hidden { double, double } @__divdc3(double %a, double %b, double %c, double %d) {
  %re = fdiv double %a, %c
  %im = fdiv double %b, %d
  %r0 = insertvalue { double, double } poison, double %re, 0
  %r1 = insertvalue { double, double } %r0, double %im, 1
  ret { double, double } %r1
}

#--- div-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; A stand-in member that defines a helper which win.ll does not call and
;; divcall-win.ll does.
define hidden void @__divdc3(ptr sret({ double, double }) align 8 %r, double %a, double %b, double %c, double %d) {
  %re = fdiv double %a, %c
  %im = fdiv double %b, %d
  store double %re, ptr %r, align 8
  %p = getelementptr inbounds i8, ptr %r, i64 8
  store double %im, ptr %p, align 8
  ret void
}

#--- div-gnu.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-w64-windows-gnu-msil"

;; A stand-in member that defines a helper which nothing here calls.
define hidden void @__divdc3(ptr sret({ double, double }) align 8 %r, double %a, double %b, double %c, double %d) {
  %re = fdiv double %a, %c
  %im = fdiv double %b, %d
  store double %re, ptr %r, align 8
  %p = getelementptr inbounds i8, ptr %r, i64 8
  store double %im, ptr %p, align 8
  ret void
}

#--- gnu.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-w64-windows-gnu-msil"

declare void @__muldc3(ptr, double, double, double, double)

define i32 @main() {
  %tmp = alloca { double, double }, align 8
  call void @__muldc3(ptr sret({ double, double }) align 8 %tmp, double 1.0, double 2.0, double 3.0, double 4.0)
  %re = load double, ptr %tmp, align 8
  %i = fptosi double %re to i32
  ret i32 %i
}

#--- rmw-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; Code generation calls __atomic_fetch_add_4 for the atomicrmw and
;; __extendhfsf2 for the fpext.
@v = global i32 7
@g = global half 0xH3E00

define i32 @main() {
  %old = atomicrmw add ptr @v, i32 1 seq_cst
  %h = load volatile half, ptr @g
  %f = fpext half %h to float
  %i = fptosi float %f to i32
  %r = add i32 %old, %i
  ret i32 %r
}

#--- rmw-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; Code generation calls __atomic_fetch_add_4 for the atomicrmw and
;; __extendhfsf2 for the fpext.
@v = global i32 7
@g = global half 0xH3E00

define i32 @main() {
  %old = atomicrmw add ptr @v, i32 1 seq_cst
  %h = load volatile half, ptr @g
  %f = fpext half %h to float
  %i = fptosi float %f to i32
  %r = add i32 %old, %i
  ret i32 %r
}

#--- divcall-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; A call of the helper that div-lnx.o defines.
declare { double, double } @__divdc3(double, double, double, double)

define i32 @main() {
  %c = call { double, double } @__divdc3(double 1.0, double 2.0, double 3.0, double 4.0)
  %re = extractvalue { double, double } %c, 0
  %i = fptosi double %re to i32
  ret i32 %i
}

#--- divcall-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; A call of the helper that div-win.o defines.
declare void @__divdc3(ptr, double, double, double, double)

define i32 @main() {
  %tmp = alloca { double, double }, align 8
  call void @__divdc3(ptr sret({ double, double }) align 8 %tmp, double 1.0, double 2.0, double 3.0, double 4.0)
  %re = load double, ptr %tmp, align 8
  %i = fptosi double %re to i32
  ret i32 %i
}

#--- gcc.yaml
## A libgcc_s.so.1 stand-in that exports the ten complex helpers (the real
## one exports __mulhc3 and __divhc3 from GCC_12.0.0).
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x50
Symbols:
  - { Name: __mulhc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x00, Size: 8 }
  - { Name: __mulsc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x08, Size: 8 }
  - { Name: __muldc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x10, Size: 8 }
  - { Name: __mulxc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x18, Size: 8 }
  - { Name: __multc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x20, Size: 8 }
  - { Name: __divhc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x28, Size: 8 }
  - { Name: __divsc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x30, Size: 8 }
  - { Name: __divdc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x38, Size: 8 }
  - { Name: __divxc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x40, Size: 8 }
  - { Name: __divtc3, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x48, Size: 8 }

#--- gccw.def
LIBRARY libgcc_s_seh-1.dll
EXPORTS
  __mulhc3
  __mulsc3
  __muldc3
  __mulxc3
  __multc3
  __divhc3
  __divsc3
  __divdc3
  __divxc3
  __divtc3

#--- cxl.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; The ten complex helpers as clang calls them for x86_64 Linux (float
;; complex as <2 x float>; long double and __float128 are double on MSIL
;; triples, so __mulxc3, __multc3, __divxc3 and __divtc3 take doubles here).
;; __mulhc3 and __divhc3 have clang's half form, which it emits when it does
;; not promote half arithmetic to float (as with -fexcess-precision=16):
;; half operands and a <2 x half> result, which main reads as an i32 so that
;; code generation adds no f16 conversion.
declare <2 x half> @__mulhc3(half, half, half, half)
declare <2 x float> @__mulsc3(float, float, float, float)
declare { double, double } @__muldc3(double, double, double, double)
declare { double, double } @__mulxc3(double, double, double, double)
declare { double, double } @__multc3(double, double, double, double)
declare <2 x half> @__divhc3(half, half, half, half)
declare <2 x float> @__divsc3(float, float, float, float)
declare { double, double } @__divdc3(double, double, double, double)
declare { double, double } @__divxc3(double, double, double, double)
declare { double, double } @__divtc3(double, double, double, double)

define i32 @main() {
  %m = call <2 x half> @__mulhc3(half 1.0, half 2.0, half 3.0, half 4.0)
  %a = call <2 x float> @__mulsc3(float 1.0, float 2.0, float 3.0, float 4.0)
  %b = call { double, double } @__muldc3(double 1.0, double 2.0, double 3.0, double 4.0)
  %c = call { double, double } @__mulxc3(double 1.0, double 2.0, double 3.0, double 4.0)
  %d = call { double, double } @__multc3(double 1.0, double 2.0, double 3.0, double 4.0)
  %n = call <2 x half> @__divhc3(half 1.0, half 2.0, half 3.0, half 4.0)
  %e = call <2 x float> @__divsc3(float 1.0, float 2.0, float 3.0, float 4.0)
  %f = call { double, double } @__divdc3(double 1.0, double 2.0, double 3.0, double 4.0)
  %g = call { double, double } @__divxc3(double 1.0, double 2.0, double 3.0, double 4.0)
  %h = call { double, double } @__divtc3(double 1.0, double 2.0, double 3.0, double 4.0)
  %mi = bitcast <2 x half> %m to i32
  %ni = bitcast <2 x half> %n to i32
  %a0 = extractelement <2 x float> %a, i32 0
  %e0 = extractelement <2 x float> %e, i32 0
  %b0 = extractvalue { double, double } %b, 0
  %c0 = extractvalue { double, double } %c, 0
  %d0 = extractvalue { double, double } %d, 0
  %f0 = extractvalue { double, double } %f, 0
  %g0 = extractvalue { double, double } %g, 0
  %h0 = extractvalue { double, double } %h, 0
  %ae = fadd float %a0, %e0
  %aed = fpext float %ae to double
  %s1 = fadd double %b0, %c0
  %s2 = fadd double %d0, %f0
  %s3 = fadd double %g0, %h0
  %s4 = fadd double %s1, %s2
  %s5 = fadd double %s3, %s4
  %s6 = fadd double %s5, %aed
  %fi = fptosi double %s6 to i32
  %mn = add i32 %mi, %ni
  %r = add i32 %fi, %mn
  ret i32 %r
}

#--- cxw.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; The ten complex helpers as clang calls them for Win64: float complex in
;; an i64, _Float16 complex in an i32 (clang's half form of __mulhc3 and
;; __divhc3, with half operands, as with -fexcess-precision=16), the others
;; through an sret pointer.
declare i32 @__mulhc3(half, half, half, half)
declare i64 @__mulsc3(float, float, float, float)
declare void @__muldc3(ptr, double, double, double, double)
declare void @__mulxc3(ptr, double, double, double, double)
declare void @__multc3(ptr, double, double, double, double)
declare i32 @__divhc3(half, half, half, half)
declare i64 @__divsc3(float, float, float, float)
declare void @__divdc3(ptr, double, double, double, double)
declare void @__divxc3(ptr, double, double, double, double)
declare void @__divtc3(ptr, double, double, double, double)

define i32 @main() {
  %t = alloca { double, double }, align 8
  %m = call i32 @__mulhc3(half 1.0, half 2.0, half 3.0, half 4.0)
  %a = call i64 @__mulsc3(float 1.0, float 2.0, float 3.0, float 4.0)
  call void @__muldc3(ptr sret({ double, double }) align 8 %t, double 1.0, double 2.0, double 3.0, double 4.0)
  call void @__mulxc3(ptr sret({ double, double }) align 8 %t, double 1.0, double 2.0, double 3.0, double 4.0)
  call void @__multc3(ptr sret({ double, double }) align 8 %t, double 1.0, double 2.0, double 3.0, double 4.0)
  %n = call i32 @__divhc3(half 1.0, half 2.0, half 3.0, half 4.0)
  %e = call i64 @__divsc3(float 1.0, float 2.0, float 3.0, float 4.0)
  call void @__divdc3(ptr sret({ double, double }) align 8 %t, double 1.0, double 2.0, double 3.0, double 4.0)
  call void @__divxc3(ptr sret({ double, double }) align 8 %t, double 1.0, double 2.0, double 3.0, double 4.0)
  call void @__divtc3(ptr sret({ double, double }) align 8 %t, double 1.0, double 2.0, double 3.0, double 4.0)
  %re = load double, ptr %t, align 8
  %ae = add i64 %a, %e
  %i = trunc i64 %ae to i32
  %j = fptosi double %re to i32
  %mn = add i32 %m, %n
  %ij = add i32 %i, %j
  %r = add i32 %ij, %mn
  ret i32 %r
}

#--- cxdef.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; Stand-ins for the Win64 __muldc3 and __divsc3; noinline keeps the calls.
define hidden void @__muldc3(ptr sret({ double, double }) align 8 %r, double %a, double %b, double %c, double %d) noinline {
  %re = fmul double %a, %c
  store double %re, ptr %r, align 8
  ret void
}

define hidden i64 @__divsc3(float %a, float %b, float %c, float %d) noinline {
  %q = fdiv float %a, %c
  %i = bitcast float %q to i32
  %z = zext i32 %i to i64
  ret i64 %z
}

#--- cxmis.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; The imaginary parts are missing.
declare void @__muldc3(ptr, double, double)
declare i64 @__divsc3(float, float)

define i32 @main() {
  %t = alloca { double, double }, align 8
  call void @__muldc3(ptr sret({ double, double }) align 8 %t, double 1.0, double 3.0)
  %q = call i64 @__divsc3(float 6.0, float 3.0)
  %re = load double, ptr %t, align 8
  %i = fptosi double %re to i32
  %j = trunc i64 %q to i32
  %r = add i32 %i, %j
  ret i32 %r
}

#--- mul-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; A stand-in for the archive's __muldc3 member.
define hidden { double, double } @__muldc3(double %a, double %b, double %c, double %d) {
  %re = fmul double %a, %c
  %im = fmul double %b, %d
  %r0 = insertvalue { double, double } poison, double %re, 0
  %r1 = insertvalue { double, double } %r0, double %im, 1
  ret { double, double } %r1
}

#--- mul-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

;; A stand-in for the archive's __muldc3 member.
define hidden void @__muldc3(ptr sret({ double, double }) align 8 %r, double %a, double %b, double %c, double %d) {
  %re = fmul double %a, %c
  %im = fmul double %b, %d
  store double %re, ptr %r, align 8
  %p = getelementptr inbounds i8, ptr %r, i64 8
  store double %im, ptr %p, align 8
  ret void
}

#--- hl-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

declare float @__extendhfsf2(i32)
declare { double, double } @__muldc3(double, double, double, double)

define i32 @use_helpers(i32 %h) {
  %f = call float @__extendhfsf2(i32 %h)
  %d = fpext float %f to double
  %c = call { double, double } @__muldc3(double %d, double 0.0, double 2.0, double 0.0)
  %re = extractvalue { double, double } %c, 0
  %i = fptosi double %re to i32
  ret i32 %i
}

#--- hl-win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

