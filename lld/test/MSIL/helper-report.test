declare float @__extendhfsf2(i32)

define i32 @main() {
  %a = call i32 @use_helpers(i32 15872)
  %f = call float @__extendhfsf2(i32 15360)
  %b = fptosi float %f to i32
  %r = add i32 %a, %b
  ret i32 %r
}
