;; LTO internalizes @sorter; the volatile load keeps GlobalOpt from folding
;; it to @qsort, so its initializer's reference to qsort stays live at -O2.
@sorter = global ptr @qsort

define i32 @main() {
  %f = load volatile ptr, ptr @sorter
  %c = icmp eq ptr %f, null
  %r = zext i1 %c to i32
  ret i32 %r
}

