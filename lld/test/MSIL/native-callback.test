# DEAD-NOT: qsort
# DEAD:     {{^}}.method public static int32 'main'() cil managed
# DEAD-NOT: qsort

#--- cb.yaml
## Every name of the callback list as a function (ld.lld links libcb.so.1).
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x170
Symbols:
  - { Name: CreateThread,       Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }
  - { Name: __sysv_signal,      Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x8, Size: 8 }
  - { Name: _beginthread,       Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x10, Size: 8 }
  - { Name: _beginthreadex,     Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x18, Size: 8 }
  - { Name: _lfind,             Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x20, Size: 8 }
  - { Name: _lfind_s,           Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x28, Size: 8 }
  - { Name: _lsearch,           Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x30, Size: 8 }
  - { Name: _lsearch_s,         Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x38, Size: 8 }
  - { Name: _onexit,            Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x40, Size: 8 }
  - { Name: at_quick_exit,      Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x48, Size: 8 }
