#--- cb.def
LIBRARY cb.dll
EXPORTS
  CreateThread
  __sysv_signal
  _beginthread
  _beginthreadex
  _lfind
  _lfind_s
  _lsearch
  _lsearch_s
  _onexit
  at_quick_exit
  atexit
  bsd_signal
  bsearch
  bsearch_s
  call_once
  ftw
  ftw64
  lfind
  lsearch
  nftw
  nftw64
  on_exit
  pthread_atfork
  pthread_create
  pthread_key_create
  pthread_once
  qsort
  qsort_r
  qsort_s
  scandir
  scandir64
  scandirat
  scandirat64
  sigaction
  signal
  sigset
  ssignal
  sysv_signal
  tdelete
  tdestroy
  tfind
  thrd_create
  tsearch
  tss_create
  twalk
  twalk_r

#--- table.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

;; One call of each name of the callback list.
define i32 @main() {
  call void @CreateThread()
  call void @__sysv_signal()
  call void @_beginthread()
  call void @_beginthreadex()
  call void @_lfind()
