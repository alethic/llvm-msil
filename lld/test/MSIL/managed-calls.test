# BIND-DAG: {{^    L[0-9]+: }}callvirt instance void(valuetype [FakeWidgets]Contoso.SmallMode) [FakeWidgets]Contoso.Widget::'Tune'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}call void(valuetype [FakeRuntime]System.Runtime.InteropServices.GCHandle) [FakeWidgets]Contoso.Widget::'Pin'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}call valuetype [FakeRuntime]System.Runtime.InteropServices.GCHandle(object) [FakeWidgets]Contoso.Widget::'Keep'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}callvirt instance int32() [FakeWidgets]Contoso.Widget::'get_Size'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}callvirt instance void(int32) [FakeWidgets]Contoso.Widget::'Resize'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}newobj instance void(int32, int32) [FakeWidgets]Contoso.Point::'.ctor'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}call instance int32() [FakeWidgets]Contoso.Point::'Sum'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}ldsfld int32 [FakeWidgets]Contoso.Widget::'Count'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}ldfld int64 [FakeWidgets]Contoso.Widget::'Serial'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}ldfld int32 [FakeWidgets]Contoso.Point::'X'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}newarr {{(uint8|\[FakeRuntime\]System\.Byte)}}{{$}}
# BIND-DAG: {{^    L[0-9]+: }}newarr [FakeWidgets]Contoso.Widget{{$}}
# BIND-DAG: {{^    L[0-9]+: }}newobj instance void() [FakeWidgets]Contoso.Outer/Inner::'.ctor'{{$}}
