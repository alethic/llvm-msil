# SYMTAB-DAG: {{^}}Symbol {{[0-9]+}} FUNCTION LOCAL DEFAULT '__msil_mc.widget_size' method=0x{{[0-9A-F]+}}{{$}}
# SYMTAB-DAG: {{^}}Symbol {{[0-9]+}} FUNCTION LOCAL DEFAULT '__msil_mc.widget_resize' method=0x{{[0-9A-F]+}}{{$}}
# SYMTAB-DAG: {{^}}Symbol {{[0-9]+}} FUNCTION LOCAL DEFAULT '__msil_mc.point_new' method=0x{{[0-9A-F]+}}{{$}}
