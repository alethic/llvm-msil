#--- calls.ll
;; void prims(int, char16_t, int8_t, uint8_t, int16_t, uint16_t, int32_t, uint32_t,
;;            int64_t, uint64_t, float, double, intptr_t, uintptr_t);
;; every listing primitive (bool from an int)
declare void @__msil_mc.prims(i32, i16, i8, i8, i16, i16, i32, i32, i64, i64, float, double, i64, i64) #0

;; double mix(float, double);
declare double @__msil_mc.mix(float, double) #1

;; void *ptrs(unsigned char *, void *, int *); unmanaged pointers
declare ptr @__msil_mc.ptrs(ptr, ptr, ptr) #2

;; dn_handle describe(dn_handle, dn_handle, dn_handle, dn_handle, dn_handle);
;; object, string, class, arrays: handles in and out
declare ptr @__msil_mc.describe(ptr, ptr, ptr, ptr, ptr) #3

;; dn_handle widget_new(const char *, int); a constructor, a UTF-8 string
declare ptr @__msil_mc.widget_new(ptr, i32) #4

;; int length16(const char16_t *); a UTF-16 string
declare i32 @__msil_mc.length16(ptr) #5

;; int length32(const char32_t *); a UTF-32 string
declare i32 @__msil_mc.length32(ptr) #6

;; int check(int); bool in and out
declare i32 @__msil_mc.check(i32) #7

;; char16_t letter(char16_t);
declare i16 @__msil_mc.letter(i16) #8

;; dn_handle wrap(dn_handle); a value type in by a boxed handle
declare ptr @__msil_mc.wrap(ptr) #9

;; dn_handle origin(void); a value-type result, boxed
declare ptr @__msil_mc.origin() #10

;; void set_mode(int); an enum over int32
declare void @__msil_mc.set_mode(i32) #11

;; void set_wide(long long); an enum over int64
declare void @__msil_mc.set_wide(i64) #12

;; void set_small(signed char); an enum over uint8 (signedness is not checked)
declare void @__msil_mc.set_small(i8) #13

;; void set_modes(int, int, long long); the second and third CIL parameters are enums
declare void @__msil_mc.set_modes(i32, i32, i64) #14

;; void tune(dn_handle, unsigned char); an enum after the 'this' handle
declare void @__msil_mc.tune(ptr, i8) #15

;; void pin(dn_handle); a GCHandle is the handle itself
declare void @__msil_mc.pin(ptr) #16

;; dn_handle keep(dn_handle); a GCHandle result
declare ptr @__msil_mc.keep(ptr) #17

;; int widget_size(dn_handle); a virtual property getter: callvirt
declare i32 @__msil_mc.widget_size(ptr) #18

;; void widget_resize(dn_handle, int); an instance method
declare void @__msil_mc.widget_resize(ptr, i32) #19

;; dn_handle point_new(int, int); a value-type constructor: newobj, then box
declare ptr @__msil_mc.point_new(i32, i32) #20

;; int point_sum(dn_handle); an instance method of a value type
declare i32 @__msil_mc.point_sum(ptr) #21

;; int widget_count(void); a static field: ldsfld
declare i32 @__msil_mc.widget_count() #22

;; long long widget_serial(dn_handle); an instance field: ldfld
declare i64 @__msil_mc.widget_serial(ptr) #23

;; int point_x(dn_handle); an instance field of a value type
declare i32 @__msil_mc.point_x(ptr) #24

;; dn_handle new_bytes(int); an array of a primitive: newarr
declare ptr @__msil_mc.new_bytes(i32) #25

;; dn_handle new_widgets(int); an array of a class: newarr
declare ptr @__msil_mc.new_widgets(i32) #26

;; dn_handle inner_new(void); a nested type's constructor
declare ptr @__msil_mc.inner_new() #27

;; int inner_depth(dn_handle); a nested type in a signature
declare i32 @__msil_mc.inner_depth(ptr) #28

;; int guarded(int, int *); msil_catch: a derived type before its base, and a
;; BCL exception
declare i32 @__msil_mc.guarded(i32, ptr) #29

;; long long measure(void); ASSEMBLY names the scope of standalone text only
declare i64 @__msil_mc.measure() #30

;; int point_hash(dn_handle); Contoso.Point inherits GetHashCode() from
;; System.ValueType
declare i32 @__msil_mc.point_hash(ptr) #31

;; dn_handle point_type(dn_handle); Contoso.Point inherits the non-virtual
;; GetType() from System.Object
declare ptr @__msil_mc.point_type(ptr) #32

define i32 @main() {
  call void @__msil_mc.prims(i32 1, i16 65, i8 -1, i8 255, i16 -2, i16 2, i32 3, i32 4, i64 5, i64 6, float 1.5, double 2.5, i64 7, i64 8)
  %r0 = call double @__msil_mc.mix(float 1.0, double 2.0)
  %r1 = call ptr @__msil_mc.ptrs(ptr null, ptr null, ptr null)
  %r2 = call ptr @__msil_mc.describe(ptr null, ptr null, ptr null, ptr null, ptr null)
  %r3 = call ptr @__msil_mc.widget_new(ptr null, i32 3)
  %r4 = call i32 @__msil_mc.length16(ptr null)
  %r5 = call i32 @__msil_mc.length32(ptr null)
  %r6 = call i32 @__msil_mc.check(i32 2)
  %r7 = call i16 @__msil_mc.letter(i16 66)
  %r8 = call ptr @__msil_mc.wrap(ptr null)
  %r9 = call ptr @__msil_mc.origin()
  call void @__msil_mc.set_mode(i32 1)
  call void @__msil_mc.set_wide(i64 4294967296)
  call void @__msil_mc.set_small(i8 1)
  call void @__msil_mc.set_modes(i32 0, i32 1, i64 2)
  call void @__msil_mc.tune(ptr null, i8 1)
  call void @__msil_mc.pin(ptr null)
  %r10 = call ptr @__msil_mc.keep(ptr null)
  %r11 = call i32 @__msil_mc.widget_size(ptr null)
  call void @__msil_mc.widget_resize(ptr null, i32 4)
  %r12 = call ptr @__msil_mc.point_new(i32 1, i32 2)
  %r13 = call i32 @__msil_mc.point_sum(ptr null)
  %r14 = call i32 @__msil_mc.widget_count()
  %r15 = call i64 @__msil_mc.widget_serial(ptr null)
  %r16 = call i32 @__msil_mc.point_x(ptr null)
  %r17 = call ptr @__msil_mc.new_bytes(i32 16)
  %r18 = call ptr @__msil_mc.new_widgets(i32 2)
  %r19 = call ptr @__msil_mc.inner_new()
  %r20 = call i32 @__msil_mc.inner_depth(ptr null)
  %r21 = call i32 @__msil_mc.guarded(i32 9, ptr null)
  %r22 = call i64 @__msil_mc.measure()
  %r23 = call i32 @__msil_mc.point_hash(ptr null)
  %r24 = call ptr @__msil_mc.point_type(ptr null)
