# BIND-DAG: {{^    L[0-9]+: }}call bool(bool) [FakeWidgets]Contoso.Widget::'Check'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}call char(char) [FakeWidgets]Contoso.Widget::'Letter'{{$}}
