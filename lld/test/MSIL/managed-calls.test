# STUBS-DAG: {{^  }}.method '__msil_mc.length32' {{.+$}}
# STUBS-DAG: {{^  }}.method '__msil_mc.check' {{.+$}}
# STUBS-DAG: {{^  }}.method '__msil_mc.letter' {{.+$}}
