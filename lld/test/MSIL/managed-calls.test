# BIND-DAG: {{^    L[0-9]+: }}call void(bool, char, int8, uint8, int16, uint16, int32, uint32, int64, uint64, float32, float64, native int, native uint) [FakeWidgets]Contoso.Widget::'Prims'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}call float64(float32, float64) [FakeWidgets]Contoso.Widget::'Mix'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}call void*(uint8*, void*, int32*) [FakeWidgets]Contoso.Widget::'Ptrs'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}call string(object, string, class [FakeWidgets]Contoso.Widget, int32[], string[]) [FakeWidgets]Contoso.Widget::'Describe'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}newobj instance void(string, int32) [FakeWidgets]Contoso.Widget::'.ctor'{{$}}
