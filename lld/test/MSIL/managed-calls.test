## MR2 (reason 4): a plain declaration of the same name in another unit.
# RUN: llc -filetype=obj -mtriple=x86_64-pc-windows-msvc-msil mr2a.ll -o mr2a.o
# RUN: llc -filetype=obj -mtriple=x86_64-pc-windows-msvc-msil mr2b.ll -o mr2b.o
# RUN: not msil-ld mr2a.o mr2b.o --reference=refs -o x.exe 2>&1 | %{err} --check-prefix=MR2R4
# RUN: llc -filetype=obj -mtriple=msil64-unknown-dotnet mr2a.ll -o mr2a.o
# RUN: llc -filetype=obj -mtriple=msil64-unknown-dotnet mr2b.ll -o mr2b.o
# RUN: not msil-ld mr2a.o mr2b.o --reference=refs -o x.exe 2>&1 | %{err} --check-prefix=MR2R4
