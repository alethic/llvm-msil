# BIND-DAG: {{^    L[0-9]+: }}newobj instance void(bool, bool, bool) [FakeRuntime]System.Text.UTF32Encoding::'.ctor'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}callvirt instance string(uint8*, int32) [FakeRuntime]System.Text.Encoding::'GetString'{{$}}
# BIND-DAG: {{^    L[0-9]+: }}newobj instance void(char*) [FakeRuntime]System.String::'.ctor'{{$}}

# STUBS-DAG: {{^  }}.method '__msil_mc.prims' {{.+$}}
# STUBS-DAG: {{^  }}.method '__msil_mc.mix' {{.+$}}
# STUBS-DAG: {{^  }}.method '__msil_mc.ptrs' {{.+$}}
