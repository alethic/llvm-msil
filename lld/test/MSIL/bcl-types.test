# RUN: cp ab/FakeTypesA.dll ab/FakeTypesB.dll abc
# RUN: yaml2obj %S/Inputs/fakepack/FakeTypesC.yaml -o abc/FakeTypesC.dll
# RUN: msil-ld ret42.o --reference=FakeCore.dll --reference=abc --print-bcl-binding=type:Fake.Dup -o out.exe \
# RUN:   > dup-abc.txt 2>&1
