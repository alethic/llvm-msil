## A link that binds Interlocked, defined by FakeThreading and by
## System.Private.FakeLib, in either order.
# RUN: llc -filetype=obj fence.ll -o fence.o
# RUN: mkdir t1 t2
# RUN: yaml2obj %S/Inputs/fakepack/FakeThreading.yaml -o t1/FakeThreading.dll
# RUN: yaml2obj %S/Inputs/fakepack/System.Private.FakeLib.yaml -o t2/System.Private.FakeLib.dll
# RUN: not msil-ld fence.o --reference=FakeCore.dll --reference=t1 --reference=t2 -o x.exe > two-12.txt 2>&1
# RUN: not msil-ld fence.o --reference=t2 --reference=t1 --reference=FakeCore.dll -o x.exe > two-21.txt 2>&1
# RUN: %{fc} --check-prefix=TWO-LINK --input-file=two-12.txt
# RUN: diff two-12.txt two-21.txt
# TWO-LINK: {{^}}msil-ld: error: type 'System.Threading.Interlocked' is defined in two references: {{(.*FakeThreading.* \(.*\) and .*System.Private.FakeLib.* \(.*\)|.*System.Private.FakeLib.* \(.*\) and .*FakeThreading.* \(.*\))$}}

#--- ret42.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  ret i32 42
}

#--- fence.ll
target triple = "x86_64-pc-windows-msvc-msil"

define void @barrier() {
  fence seq_cst
  ret void
}

define i32 @main() {
  call void @barrier()
  ret i32 0
}
