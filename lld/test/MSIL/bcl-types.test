# RUN:   --reference=FakeCore.dll --print-bcl-binding=type:Fake.Dup -o out.exe > dup-cba.txt 2>&1
# RUN: %{fc} --check-prefix=DUP3 --input-file=dup-abc.txt
# RUN: diff dup-abc.txt dup-cba.txt
# DUP3: {{^}}type:Fake.Dup -> type 'Fake.Dup' is defined in 3 references: FakeTypesA 1.2.3.4 [b03f5f7f11d50a3a] (abc/FakeTypesA.dll), FakeTypesB 1.0.0.0 [null] (abc/FakeTypesB.dll) and FakeTypesC 1.0.0.0 [null] (abc/FakeTypesC.dll){{$}}

