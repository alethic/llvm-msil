# TEXT-LABEL: {{^}}.method assembly static int32 '__msil_mc.widget_same'(native int, native int) cil managed{{$}}
# TEXT:       {{^ +}}call bool [mscorlib]Contoso.Widget::ReferenceEquals(object, object){{$}}

## --lto-emit-asm without references binds nothing: 'call V::M'.
# NONE-LABEL: {{^}}.method assembly static native int '__msil_mc.color_names'(native int) cil managed{{$}}
# NONE:       {{^ +}}call string[] [mscorlib]Contoso.Color::GetNames(class [mscorlib]System.Type){{$}}
# NONE-LABEL: {{^}}.method assembly static native int '__msil_mc.color_names_plain'(native int) cil managed{{$}}
# NONE:       {{^ +}}call string[] [mscorlib]Contoso.Color::GetNames(class [mscorlib]System.Type){{$}}
# NONE-LABEL: {{^}}.method assembly static int32 '__msil_mc.color_same'(native int, native int) cil managed{{$}}
# NONE:       {{^ +}}call bool [mscorlib]Contoso.Color::ReferenceEquals(object, object){{$}}
# NONE-LABEL: {{^}}.method assembly static int32 '__msil_mc.extent_same'(native int, native int) cil managed{{$}}
# NONE:       {{^ +}}call bool [mscorlib]Contoso.Extent::ReferenceEquals(object, object){{$}}
# NONE-LABEL: {{^}}.method assembly static int32 '__msil_mc.extent_same_plain'(native int, native int) cil managed{{$}}
# NONE:       {{^ +}}call bool [mscorlib]Contoso.Extent::ReferenceEquals(object, object){{$}}

#--- win.head
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"
#--- net.head
target datalayout = "e-m:e-p:64:64-i64:64-i128:128-n8:16:32:64-S128"
target triple = "msil64-unknown-dotnet"
#--- st.ll

;; typedef struct dn_object *dn_handle;
;; dn_handle color_names(dn_handle) __attribute__((msil_method(
;; "valuetype Contoso.Color", "GetNames", "string[](class System.Type)")));
;; Contoso.Color inherits System.Enum's static GetNames
declare ptr @__msil_mc.color_names(ptr) #0

;; dn_handle color_names_plain(dn_handle); the same with the TYPE
;; "Contoso.Color"
declare ptr @__msil_mc.color_names_plain(ptr) #1

;; int color_same(dn_handle, dn_handle) __attribute__((msil_method(
;; "valuetype Contoso.Color", "ReferenceEquals", "bool(object, object)")));
;; System.Object's static ReferenceEquals through the enum
declare i32 @__msil_mc.color_same(ptr, ptr) #2

;; int extent_same(dn_handle, dn_handle) __attribute__((msil_method(
;; "valuetype Contoso.Extent", "ReferenceEquals", "bool(object, object)")));
;; Contoso.Extent inherits System.Object's static ReferenceEquals
declare i32 @__msil_mc.extent_same(ptr, ptr) #3

;; int extent_same_plain(dn_handle, dn_handle); the same with the TYPE
;; "Contoso.Extent"
declare i32 @__msil_mc.extent_same_plain(ptr, ptr) #4

;; int point_twice(int) __attribute__((msil_method("valuetype Contoso.Point",
;; "Twice", "int32(int32)"))); a static method that Contoso.Point declares
declare i32 @__msil_mc.point_twice(i32) #5

;; int widget_same(dn_handle, dn_handle) __attribute__((msil_method(
;; "Contoso.Widget", "ReferenceEquals", "bool(object, object)"))); the class
;; Contoso.Widget inherits ReferenceEquals
declare i32 @__msil_mc.widget_same(ptr, ptr) #6

define i32 @main() {
  %n0 = call ptr @__msil_mc.color_names(ptr null)
  %n1 = call ptr @__msil_mc.color_names_plain(ptr %n0)
  %s0 = call i32 @__msil_mc.color_same(ptr %n0, ptr %n1)
  %s1 = call i32 @__msil_mc.extent_same(ptr %n0, ptr %n1)
  %s2 = call i32 @__msil_mc.extent_same_plain(ptr %n0, ptr %n1)
  %s3 = call i32 @__msil_mc.point_twice(i32 %s0)
  %s4 = call i32 @__msil_mc.widget_same(ptr %n0, ptr %n1)
  %a0 = add i32 %s1, %s2
  %a1 = add i32 %a0, %s3
  %a2 = add i32 %a1, %s4
  ret i32 %a2
}

attributes #0 = { "msil-managed-type"="valuetype Contoso.Color" "msil-managed-member"="GetNames" "msil-managed-sig"="string[](class System.Type)" "msil-managed-conv"="obj;obj" }
attributes #1 = { "msil-managed-type"="Contoso.Color" "msil-managed-member"="GetNames" "msil-managed-sig"="string[](class System.Type)" "msil-managed-conv"="obj;obj" }
attributes #2 = { "msil-managed-type"="valuetype Contoso.Color" "msil-managed-member"="ReferenceEquals" "msil-managed-sig"="bool(object, object)" "msil-managed-conv"="obj,obj;bool" }
attributes #3 = { "msil-managed-type"="valuetype Contoso.Extent" "msil-managed-member"="ReferenceEquals" "msil-managed-sig"="bool(object, object)" "msil-managed-conv"="obj,obj;bool" }
attributes #4 = { "msil-managed-type"="Contoso.Extent" "msil-managed-member"="ReferenceEquals" "msil-managed-sig"="bool(object, object)" "msil-managed-conv"="obj,obj;bool" }
attributes #5 = { "msil-managed-type"="valuetype Contoso.Point" "msil-managed-member"="Twice" "msil-managed-sig"="int32(int32)" "msil-managed-conv"="val;val" }
attributes #6 = { "msil-managed-type"="Contoso.Widget" "msil-managed-member"="ReferenceEquals" "msil-managed-sig"="bool(object, object)" "msil-managed-conv"="obj,obj;bool" }

!msil.managed.calls = !{!0, !1, !2, !3, !4, !5, !6}
!0 = !{!"__msil_mc.color_names", !"valuetype Contoso.Color", !"GetNames", !"string[](class System.Type)", !"", !"obj;obj", !""}
!1 = !{!"__msil_mc.color_names_plain", !"Contoso.Color", !"GetNames", !"string[](class System.Type)", !"", !"obj;obj", !""}
!2 = !{!"__msil_mc.color_same", !"valuetype Contoso.Color", !"ReferenceEquals", !"bool(object, object)", !"", !"obj,obj;bool", !""}
!3 = !{!"__msil_mc.extent_same", !"valuetype Contoso.Extent", !"ReferenceEquals", !"bool(object, object)", !"", !"obj,obj;bool", !""}
!4 = !{!"__msil_mc.extent_same_plain", !"Contoso.Extent", !"ReferenceEquals", !"bool(object, object)", !"", !"obj,obj;bool", !""}
!5 = !{!"__msil_mc.point_twice", !"valuetype Contoso.Point", !"Twice", !"int32(int32)", !"", !"val;val", !""}
!6 = !{!"__msil_mc.widget_same", !"Contoso.Widget", !"ReferenceEquals", !"bool(object, object)", !"", !"obj,obj;bool", !""}
