#--- weak-slot.ll
target triple = "msil64-unknown-dotnet"

declare extern_weak void @maybe_init()

@slot = internal global ptr @maybe_init, section ".init_array", align 8
@llvm.used = appending global [1 x ptr] [ptr @slot], section "llvm.metadata"

define i32 @main() {
  ret i32 0
}

#--- xnul.ll
target triple = "msil64-unknown-dotnet"

@log = global i32 0, align 4
@nul = internal global ptr null, section ".xnit_array", align 8
@llvm.used = appending global [1 x ptr] [ptr @nul], section "llvm.metadata"

define i32 @main() {
  %v = load i32, ptr @log, align 4
  ret i32 %v
}

#--- xnul-array.ll
target triple = "msil64-unknown-dotnet"

@log = global i32 0, align 4
@slots = internal global [2 x ptr] [ptr @init, ptr null], section ".xnit_array", align 8
