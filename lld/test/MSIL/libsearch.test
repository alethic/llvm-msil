# RUN: cp libm.so.txt lsys/usr/lib/x86_64-linux-gnu/libm.so

# DEFINE: %{why} = FileCheck %s --match-full-lines --strict-whitespace

## The first directory with a candidate wins.
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o -L d1 -L d2 -lfoo -o d12.il --why-extract=d12.why 2>&1 | count 0
# RUN: %{why} --check-prefix=WHY1 --input-file=d12.why
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o -Ld2 -Ld1 -lfoo -o d21.il --why-extract=d21.why 2>&1 | count 0
# RUN: %{why} --check-prefix=WHY2 --input-file=d21.why

#      WHY1:reference	extracted	symbol
# WHY1-NEXT:main.o	d1{{[/\\]}}libfoo.a(foo1.o)	foo_fn
#      WHY2:reference	extracted	symbol
# WHY2-NEXT:main.o	d2{{[/\\]}}libfoo.a(foo2.o)	foo_fn

## In one directory the static library wins over the import library.
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o -L both -lfoo -o both.il --why-extract=both.why 2>&1 | count 0
# RUN: %{why} --check-prefix=WHY-BOTH --input-file=both.why

#      WHY-BOTH:reference	extracted	symbol
# WHY-BOTH-NEXT:main.o	both{{[/\\]}}libfoo.a(foo1.o)	foo_fn

## Across directories the first one wins even with a native candidate only:
## the import library of nat binds foo_fn (in M14 it was accepted unread and
## foo_fn stayed undefined).
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o -L nat -L stat -lfoo -o natfirst.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=NATIVE-FIRST --input-file=natfirst.il
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o -L stat -L nat -lfoo -o stat.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=STAT-FIRST --implicit-check-not=pinvokeimpl --input-file=stat.il

# NATIVE-FIRST: {{^}}.method assembly hidebysig static pinvokeimpl("foo.dll" nomangle cdecl) int32 'foo_fn'() cil managed preservesig {}{{$}}
# STAT-FIRST:   {{^}}  ldc.i4.2{{$}}

## A native-only archive and a .NET assembly are skipped; the search goes on.
