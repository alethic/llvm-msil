# MACHINE:   {{^}}msil-ld: error: armlib{{[/\\]}}foo.lib{{.*}} machine {{.+}} does not match target x86_64-pc-windows-msvc-msil{{$}}
# MALFORMED: {{^}}msil-ld: error: {{.*}}badlib{{[/\\]}}foo.lib

## -l: takes the exact name.
# RUN: msil-ld --lto-emit-asm --lto-O0 main.o -L d1 -l:custom.name -o exact.il --why-extract=exact.why 2>&1 \
# RUN:   | count 0
# RUN: %{why} --check-prefix=WHY-EXACT --input-file=exact.why
# RUN: not msil-ld --lto-emit-asm main.o -L d1 -l:libfoo -o x.il 2>&1 | FileCheck %s --check-prefix=NO-EXACT --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not="LLVM ERROR" --implicit-check-not="Stack dump"

#      WHY-EXACT:reference	extracted	symbol
# WHY-EXACT-NEXT:main.o	d1{{[/\\]}}custom.name(foo1.o)	foo_fn
# NO-EXACT: {{^}}msil-ld: error: unable to find library -l:libfoo{{$}}

## -L=<dir> is sysroot-relative (5.10.9, lld's rule): with --sysroot=sysroot,
## -L=/lib and -L=lib both name sysroot/lib. Without --sysroot the '=' names
## the empty sysroot, so -L=/lib is the root's lib directory, and a plain -L
## is never sysroot-relative.
# RUN: mkdir -p sysroot/lib
# RUN: llvm-ar rcs sysroot/lib/libsysfoo.a foo1.o
# RUN: msil-ld --lto-emit-asm --lto-O0 --sysroot=sysroot main.o -L=/lib -lsysfoo -o sys1.il \
# RUN:   --why-extract=sys1.why 2>&1 | count 0
# RUN: %{why} --check-prefix=WHY-SYS --input-file=sys1.why
# RUN: msil-ld --lto-emit-asm --lto-O0 --sysroot sysroot main.o -L=lib -lsysfoo -o sys2.il \
# RUN:   --why-extract=sys2.why 2>&1 | count 0
# RUN: %{why} --check-prefix=WHY-SYS --input-file=sys2.why
# RUN: not msil-ld --lto-emit-asm main.o -L=/lib -lsysfoo -o x.il 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOLIB-SYS --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not="LLVM ERROR" --implicit-check-not="Stack dump"
# RUN: not msil-ld --lto-emit-asm --sysroot=sysroot main.o -L lib -lsysfoo -o x.il 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOLIB-SYS --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not="LLVM ERROR" --implicit-check-not="Stack dump"

#      WHY-SYS:reference	extracted	symbol
# WHY-SYS-NEXT:main.o	sysroot{{[/\\]}}lib{{[/\\]}}libsysfoo.a(foo1.o)	foo_fn
# NOLIB-SYS: {{^}}msil-ld: error: unable to find library -lsysfoo{{$}}

# RUN: not msil-ld --lto-emit-asm main.o -L d1 -lnosuch -o x.il 2>&1 | FileCheck %s --check-prefix=NOLIB --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not="LLVM ERROR" --implicit-check-not="Stack dump"
# RUN: not msil-ld --lto-emit-asm main.o -lfoo -o x.il 2>&1 | FileCheck %s --check-prefix=NOLIB-FOO --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not="LLVM ERROR" --implicit-check-not="Stack dump"
# NOLIB:     {{^}}msil-ld: error: unable to find library -lnosuch{{$}}
# NOLIB-FOO: {{^}}msil-ld: error: unable to find library -lfoo{{$}}

## windows-msvc: the driver's default libraries are import libraries, and a
## DLL is a candidate (winonly.dll exports nothing); puts binds to the UCRT.
# RUN: msil-ld --lto-emit-asm hello.o -L winlib -lucrt -lkernel32 -loldnames -lwinonly -o win.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=WIN --input-file=win.il
# RUN: not msil-ld --lto-emit-asm hello.o -lucrt -o x.il 2>&1 | FileCheck %s --check-prefix=NOUCRT --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not="LLVM ERROR" --implicit-check-not="Stack dump"

# WIN: {{^}}.method assembly hidebysig static pinvokeimpl("api-ms-win-crt-stdio-l1-1-0.dll" nomangle cdecl) int32 'puts'(native int) cil managed preservesig {}{{$}}
# NOUCRT: {{^}}msil-ld: error: unable to find library -lucrt{{$}}

## ELF triples: lib<n>.so (here glibc's linker scripts); .lib is not a
## candidate, and <n>.dll only as a .NET assembly. A bitcode lib<n>.a is
## found beside the native foo.dll of lnxlib.
# RUN: msil-ld --lto-emit-asm --sysroot=lsys hello-lnx.o -L=/usr/lib/x86_64-linux-gnu -lc -lm -o lnx.il 2>&1 \
# RUN:   | count 0
# RUN: FileCheck %s --check-prefix=LNX --input-file=lnx.il
# RUN: not msil-ld --lto-emit-asm hello-lnx.o -L winlib -lkernel32 -o x.il 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOLIB-LNX --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not="LLVM ERROR" --implicit-check-not="Stack dump"
# RUN: msil-ld --lto-emit-asm --lto-O0 main-lnx.o -L lnxlib -lfoo -o lnxfoo.il --why-extract=lnxfoo.why 2>&1 \
# RUN:   | count 0
# RUN: %{why} --check-prefix=WHY-LNX --input-file=lnxfoo.why

# LNX: {{^}}.method assembly hidebysig static pinvokeimpl("libc.so.6" nomangle cdecl) int32 'puts'(native int) cil managed preservesig {}{{$}}
# NOLIB-LNX: {{^}}msil-ld: error: unable to find library -lkernel32{{$}}
#      WHY-LNX:reference	extracted	symbol
# WHY-LNX-NEXT:main-lnx.o	lnxlib{{[/\\]}}libfoo.a(foo-lnx.o)	foo_fn

## windows-gnu: MinGW import archives lib<n>.a and lib<n>.dll.a.
# RUN: msil-ld --lto-emit-asm hello-gnu.o -L gnulib -lmsvcrt -lkernel32 -o gnu.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=GNU --input-file=gnu.il
# RUN: not msil-ld --lto-emit-asm hello.o -L gnulib -lkernel32 -o x.il 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOLIB-MSVC --implicit-check-not="PLEASE submit" \
# RUN:     --implicit-check-not="LLVM ERROR" --implicit-check-not="Stack dump"

# GNU: {{^}}.method assembly hidebysig static pinvokeimpl("msvcrt.dll" nomangle cdecl) int32 'puts'(native int) cil managed preservesig {}{{$}}
# NOLIB-MSVC: {{^}}msil-ld: error: unable to find library -lkernel32{{$}}

#--- main.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  %r = call i32 @foo_fn()
  ret i32 %r
}

declare i32 @foo_fn()

#--- main-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  %r = call i32 @foo_fn()
  ret i32 %r
}

declare i32 @foo_fn()

#--- hello.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@msg = private constant [3 x i8] c"hi\00"

define i32 @main() {
  %r = call i32 @puts(ptr @msg)
  ret i32 0
}

declare i32 @puts(ptr)

#--- hello-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@msg = private constant [3 x i8] c"hi\00"

define i32 @main() {
  %r = call i32 @puts(ptr @msg)
  ret i32 0
}

declare i32 @puts(ptr)

#--- hello-gnu.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-w64-windows-gnu-msil"

@msg = private constant [3 x i8] c"hi\00"

define i32 @main() {
  %r = call i32 @puts(ptr @msg)
  ret i32 0
}

declare i32 @puts(ptr)

#--- foo1.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @foo_fn() {
  ret i32 1
}

#--- foo2.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @foo_fn() {
  ret i32 2
}

#--- foo-lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @foo_fn() {
  ret i32 3
}

#--- foo.def
LIBRARY foo.dll
EXPORTS
  foo_fn

#--- ucrt.def
LIBRARY api-ms-win-crt-stdio-l1-1-0.dll
EXPORTS
  puts

#--- kernel32.def
LIBRARY kernel32.dll
EXPORTS
  GetTickCount

#--- oldnames.def
LIBRARY oldnames.dll
EXPORTS
  strdup

#--- msvcrt.def
LIBRARY msvcrt.dll
EXPORTS
  puts

#--- libc.so.txt
/* GNU ld script, as glibc installs it */
OUTPUT_FORMAT(elf64-x86-64)
GROUP ( /lib/x86_64-linux-gnu/libc.so.6 /usr/lib/x86_64-linux-gnu/libc_nonshared.a  AS_NEEDED ( /lib64/ld-linux-x86-64.so.2 ) )

#--- libm.so.txt
/* GNU ld script, as glibc installs it */
OUTPUT_FORMAT(elf64-x86-64)
GROUP ( /lib/x86_64-linux-gnu/libm.so.6  AS_NEEDED ( /lib/x86_64-linux-gnu/libmvec.so.1 ) )
