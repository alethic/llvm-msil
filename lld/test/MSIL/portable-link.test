## A refused --target outranks every input: a native archive given by path,
## before or after the object, still gets the target's diagnostic (T-P1 or
## PT5's reason, the texts the cases above pin), never T-P4, and an empty
## archive alone gets PT5's reason, not 'no input files'.
# DEFINE: %{refused} = %{fc} %{one} --implicit-check-not="is a native library" \
# DEFINE:   --implicit-check-not="binds no native code"
# RUN: not msil-ld --target=msil32-unknown-dotnet libnat.a p.o -o x.exe 2>&1 | %{refused} --check-prefix=MSIL32
# RUN: not msil-ld --target=msil32-unknown-dotnet p.o libnat.a -o x.exe 2>&1 | %{refused} --check-prefix=MSIL32
# RUN: not msil-ld --target=x86_64-unknown-dotnet libnat.a p.o -o x.exe 2>&1 | %{refused} --check-prefix=PT5-ARCH
# RUN: not msil-ld --target=x86_64-unknown-dotnet p.o libnat.a -o x.exe 2>&1 | %{refused} --check-prefix=PT5-ARCH
# RUN: not msil-ld --target=msil64-unknown-dotnet-gnu libnat.a p.o -o x.exe 2>&1 | %{refused} --check-prefix=PT5-ENV
# RUN: not msil-ld --target=msil64-unknown-dotnet-gnu p.o libnat.a -o x.exe 2>&1 | %{refused} --check-prefix=PT5-ENV
# RUN: not msil-ld --target=msil64-unknown-dotnet-gnu libempty.a -o x.exe 2>&1 \
# RUN:   | %{refused} --check-prefix=PT5-ENV --implicit-check-not="no input files"
# PT5-ENV: {{^}}msil-ld: error: unable to get target for 'msil64-unknown-dotnet-gnu': the architecture 'msil64' with the OS 'dotnet' takes no environment, not 'gnu' (msil64-unknown-dotnet){{$}}

## N6. crt/c.dll stands in for the C library: a --shared output named c
## that defines strlen and neither malloc nor pthread_create.
# RUN: msil-ld -shared cstub.o -o crt/c.dll 2>&1 | count 0
# RUN: not msil-ld malloc.o -o x.exe 2>&1 | %{fc} %{one} --check-prefixes=UNDEF,LINK-C -DSYM=malloc -DREF=malloc.o
# RUN: not msil-ld pthread.o -o x.exe 2>&1 | %{fc} %{one} --check-prefixes=UNDEF,LINK-C -DSYM=pthread_create -DREF=pthread.o
# RUN: not msil-ld malloc.o crt/c.dll -o x.exe 2>&1 | %{fc} %{one} --check-prefixes=UNDEF,NOT-IN-C -DSYM=malloc -DREF=malloc.o
# RUN: not msil-ld pthread.o crt/c.dll -o x.exe 2>&1 | %{fc} %{one} --check-prefixes=UNDEF,NOT-IN-C -DSYM=pthread_create -DREF=pthread.o
# RUN: not msil-ld malloc.o -L crt -lc -o x.exe 2>&1 | %{fc} %{one} --check-prefixes=UNDEF,NOT-IN-C -DSYM=malloc -DREF=malloc.o
# RUN: not msil-ld pthread.o -L crt -lc -o x.exe 2>&1 | %{fc} %{one} --check-prefixes=UNDEF,NOT-IN-C -DSYM=pthread_create -DREF=pthread.o
# UNDEF:         {{^}}msil-ld: error: undefined symbol: [[SYM]]{{$}}
# LINK-C-NEXT:   {{^}}>>> a C library function; link the managed C library c.dll (-lc){{$}}
# NOT-IN-C-NEXT: {{^}}>>> a C library function that the C library c.dll (msil64-unknown-dotnet) does not provide{{$}}
# UNDEF-NEXT:    {{^}}>>> referenced by [[REF]]:(main){{$}}

