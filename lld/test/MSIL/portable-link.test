# RUN: msil-ld opts.o -L opts -o opts/p.exe 2>&1 | count 0
# RUN: %if llvm-cil-dump %{ llvm-cil-dump opts/p.exe | FileCheck %s --check-prefix=OPTS-LINKED %}
# OPTS-LINKED: {{^}}  .method 'my_fn' int32() flags=0x{{[0-9A-F]+}} impl=0x0000{{$}}
# RUN: not msil-ld opts.o -L no-my -o x.exe 2>&1 | %{fc} %{one} --check-prefix=NO-LIB "-DLIB=my lib"
# RUN: not msil-ld opts.o -L no-m -o x.exe 2>&1 | %{fc} %{one} --check-prefix=NO-LIB -DLIB=m
# NO-LIB:      {{^}}msil-ld: error: unable to find library from dependent library specifier: [[LIB]]{{$}}
# NO-LIB-NEXT: {{^}}>>> requested by opts.o{{$}}

#--- p.ll
target triple = "msil64-unknown-dotnet"

define i32 @main() {
  ret i32 42
}

#--- host.ll
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @hostfn() {
  ret i32 7
}

#--- cstub.ll
target triple = "msil64-unknown-dotnet"

define i64 @strlen(ptr %s) {
  ret i64 0
}

#--- malloc.ll
target triple = "msil64-unknown-dotnet"

declare ptr @malloc(i64)

define i32 @main() {
  %p = call ptr @malloc(i64 16)
  %b = icmp eq ptr %p, null
  %r = zext i1 %b to i32
  ret i32 %r
}

#--- pthread.ll
target triple = "msil64-unknown-dotnet"

declare i32 @pthread_create(ptr, ptr, ptr, ptr)

define i32 @main() {
  %r = call i32 @pthread_create(ptr null, ptr null, ptr null, ptr null)
  ret i32 %r
}

#--- zork.ll
target triple = "msil64-unknown-dotnet"

declare i32 @zork_frobnicate(i32)

define i32 @main() {
  %r = call i32 @zork_frobnicate(i32 1)
  ret i32 %r
}

#--- helpers.ll
target triple = "msil64-unknown-dotnet"

declare float @__extendhfsf2(i16)
declare i32 @__atomic_load_4(ptr, i32)
declare i32 @__msil_example()

@cell = global i32 0

define i32 @main() {
  %f = call float @__extendhfsf2(i16 15360)
  %i = fptosi float %f to i32
  %a = call i32 @__atomic_load_4(ptr @cell, i32 5)
  %m = call i32 @__msil_example()
  %s1 = add i32 %i, %a
  %s2 = add i32 %s1, %m
  ret i32 %s2
}

#--- weak.ll
target triple = "msil64-unknown-dotnet"

declare extern_weak void @maybe()

define i32 @main() {
  %b = icmp eq ptr @maybe, null
  br i1 %b, label %none, label %call

call:
  call void @maybe()
  ret i32 1

none:
  ret i32 0
}

#--- nat.yaml
--- !ELF
FileHeader:
  Class:   ELFCLASS64
  Data:    ELFDATA2LSB
  Type:    ET_REL
  Machine: EM_X86_64
Sections:
  - Name:  .text
    Type:  SHT_PROGBITS
    Flags: [ SHF_ALLOC, SHF_EXECINSTR ]
    Size:  0x10
Symbols:
  - { Name: nat_fn, Type: STT_FUNC, Section: .text, Binding: STB_GLOBAL, Value: 0x0, Size: 8 }

#--- data.ll
target triple = "msil64-unknown-dotnet"

@stdout = external global ptr, align 8
@environ = external global ptr, align 8

define i32 @main() {
  %f = load ptr, ptr @stdout, align 8
  %e = load ptr, ptr @environ, align 8
  %a = icmp eq ptr %f, null
  %b = icmp eq ptr %e, null
  %c = and i1 %a, %b
  %r = zext i1 %c to i32
  ret i32 %r
}

#--- data-def.ll
target triple = "msil64-unknown-dotnet"

@stdout = global ptr null, align 8
@environ = global ptr null, align 8

#--- use-nat.ll
target triple = "msil64-unknown-dotnet"

declare i32 @nat_fn()

define i32 @main() {
  %r = call i32 @nat_fn()
  ret i32 %r
}

#--- mix-fn.ll
target triple = "msil64-unknown-dotnet"

define i32 @mix_fn() {
  ret i32 6
}

#--- use-mix.ll
target triple = "msil64-unknown-dotnet"

declare i32 @mix_fn()

define i32 @main() {
  %r = call i32 @mix_fn()
  ret i32 %r
}

#--- opts.ll
target triple = "msil64-unknown-dotnet"

!llvm.linker.options = !{!0, !1}
!0 = !{!"-lm"}
!1 = !{!"-lmy lib"}

declare i32 @my_fn()

define i32 @main() {
  %r = call i32 @my_fn()
  ret i32 %r
}

#--- my-fn.ll
target triple = "msil64-unknown-dotnet"

define i32 @my_fn() {
  ret i32 7
}
