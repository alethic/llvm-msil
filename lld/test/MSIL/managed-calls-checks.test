# RUN: not msil-ld struct.o --reference=refs -o x.exe 2>&1 | %{err} --check-prefix=TM7 \
# RUN:   -DF=place -DI=1 -DN=32 -DE=Contoso.Point
# RUN: llc -filetype=obj -mtriple=x86_64-pc-windows-msvc-msil third.ll -o third.o
# RUN: not msil-ld third.o --reference=refs -o x.exe 2>&1 | %{err} --check-prefix=TM7 \
# RUN:   -DF=set_modes -DI=3 -DN=32 -DE=Contoso.WideMode
# RUN: llc -filetype=obj -mtriple=x86_64-pc-windows-msvc-msil tune.ll -o tune.o
# RUN: not msil-ld tune.o --reference=refs -o x.exe 2>&1 | %{err} --check-prefix=TM7 \
