#--- patch-access.py
"""Copy the object argv[1] to argv[2], changing the 'constrained.' token of
its one managed-call stub, a 'this-val' method access, to the token of the
GCHandle that the stub's conversion boxes and unboxes. The stub's IL is
  ldarg.0; call GCHandle::FromIntPtr; box GCHandle; unbox GCHandle;
  call GCHandle::get_Target; unbox V; constrained. V; callvirt V::M; ...
(5.20.3 MS5 and 5.20.5 ML2 (2) as amended in section 12, 2026-11-04), so the
access becomes 'constrained. GCHandle' then 'callvirt V::M'. Offsets do not
change."""
import re
import sys

with open(sys.argv[1], "rb") as f:
    data = bytearray(f.read())
# box G; unbox G; call get_Target; unbox V; constrained. V; callvirt V::M
site = re.compile(rb"\x8c(.{4})\x79(.{4})\x28.{4}\x79.{4}\xfe\x16(.{4})\x6f.{4}", re.S)
found = list(site.finditer(data))
if len(found) != 1:
    sys.exit("patch-access.py: %d 'constrained.' access sites, expected 1" % len(found))
m = found[0]
if m.group(1) != m.group(2) or m.group(1) == m.group(3):
    sys.exit("patch-access.py: unexpected stub body")
data[m.start(3):m.end(3)] = m.group(1)
with open(sys.argv[2], "wb") as f:
    f.write(data)
