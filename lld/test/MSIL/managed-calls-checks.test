# RUN:   -DF=set_wide -DI=1 -DN=32 -DE=Contoso.WideMode
# RUN: llc -filetype=obj -mtriple=msil64-unknown-dotnet third.ll -o third-net.o
# RUN: not msil-ld third-net.o --reference=refs -o x.exe 2>&1 | %{err} --check-prefix=TM7 \
# RUN:   -DF=set_modes -DI=3 -DN=32 -DE=Contoso.WideMode
