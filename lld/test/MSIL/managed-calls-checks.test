# PT-OBJ-DAG:    {{^    L[0-9]+: }}call int32(int32) valuetype [msil.bcl]Contoso.Point::'Twice'{{$}}
# PT-OBJ-DAG:    {{^    L[0-9]+: }}ldsfld int32 valuetype [msil.bcl]Contoso.Point::'Total'{{$}}
# PLAIN-OBJ-DAG: {{^    L[0-9]+: }}call int32(int32) [msil.bcl]Contoso.Point::'Twice'{{$}}
# PLAIN-OBJ-DAG: {{^    L[0-9]+: }}ldsfld int32 [msil.bcl]Contoso.Point::'Total'{{$}}
# PT-IMAGE-DAG:  {{^    L[0-9]+: }}call int32(int32) [FakeWidgets]Contoso.Point::'Twice'{{$}}
# PT-IMAGE-DAG:  {{^    L[0-9]+: }}ldsfld int32 [FakeWidgets]Contoso.Point::'Total'{{$}}

