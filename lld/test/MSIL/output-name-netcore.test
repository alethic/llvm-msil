## Executables bound to .NET and their names (section 12 rows of 2026-10-26
## 'M23.d extended (executable naming, msil-ld)' and 'M23.c extended
## (executable naming, tests)', corrected for netstandard by the row of
## 2026-10-27 'M23.d extended (executable naming, netstandard 2.1)';
## ImplementationPlan.md 5.10.5, 5.9.12, 5.11.3).
## msil-ld always writes an EXE image for a program, whatever its name, and
## the default name stays a.exe; but a program whose bound core library
## (M21's ReferenceSet::coreLibrary()) is .NET Core's, System.Runtime (a
## .NET reference pack) or System.Private.CoreLib (a runtime directory), or
## netstandard 2.1 or later, runs only on .NET, through 'dotnet', and cannot
## start on .NET Framework (which ships netstandard 2.0.0.0 and nothing
## later), where <name>.exe would be expected to run. So a non -shared link
## whose output name ends in .exe, in any case, warns
##   '<path>: this executable is bound to <core library> <version>, so it
##   runs only on .NET through 'dotnet' and cannot start on .NET Framework;
##   .NET executables are named .dll (for example -o <stem>.dll)'
## and still writes the EXE image (llvm-cil-dump --headers). There is no
## warning for the same link named .dll, for a link without references (the
## built-in [mscorlib] table), for the .NET Framework reference assemblies
## (mscorlib) or netstandard 2.0 (both run on .NET Framework), or for
## -shared.
## The references are small assemblies in the style of M21's fake pack
## (Inputs/fakepack): rt/System.Runtime.dll is FakeCore.il renamed
## System.Runtime (version 8.0.0.0, the .NET packs' key), whose attribute
## types a -shared link needs; spc/System.Private.CoreLib.dll (10.0.0.0),
## ns/netstandard.dll (2.0.0.0) and ns21/netstandard.dll (2.1.0.0) are
## minimal core libraries (System.Object and System.ValueType, as
## Inputs/fakepack/MiniCore.il); fw/mscorlib.dll is the pack's FakeMscorlib.
## The IL source of each image is the split-file part <name>.il, and the
## part <name>.yaml after it is 'ilasm -dll <name>.il' (the .NET Framework's
## ilasm, gen.py's default) converted by Inputs/fakepack/gen.py's pe_to_yaml,
## with the two comment lines it starts with as the header; no gen.py
## target builds these images, and regenerating changes only their MVIDs.
## The links run in the test's directory, so <path> is the -o value and
## <stem> its name without .exe.

# REQUIRES: llvm-cil-dump
# RUN: rm -rf %t && split-file %s %t && cd %t
# RUN: llc -filetype=obj ret.ll -o ret.o
# RUN: llc -filetype=obj lib.ll -o lib.o
# RUN: mkdir rt spc ns ns21 fw
# RUN: yaml2obj System.Runtime.yaml -o rt/System.Runtime.dll
# RUN: yaml2obj System.Private.CoreLib.yaml -o spc/System.Private.CoreLib.dll
# RUN: yaml2obj netstandard-2.0.yaml -o ns/netstandard.dll
# RUN: yaml2obj netstandard-2.1.yaml -o ns21/netstandard.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeMscorlib.yaml -o fw/mscorlib.dll

# DEFINE: %{fc} = FileCheck %s --implicit-check-not="PLEASE submit" --implicit-check-not="Stack dump" \
# DEFINE:   --implicit-check-not="LLVM ERROR" --implicit-check-not=error: --implicit-check-not=warning:

## Bound to System.Runtime and named .exe: the warning, and an EXE image.
# RUN: msil-ld ret.o --reference=rt -o x.exe 2>&1 | %{fc} --check-prefix=WARN-RT
# WARN-RT: {{^}}msil-ld: warning: x.exe: this executable is bound to System.Runtime 8.0.0.0, so it runs only on .NET through 'dotnet' and cannot start on .NET Framework; .NET executables are named .dll (for example -o x.dll){{$}}
# RUN: llvm-cil-dump --headers x.exe | FileCheck %s --check-prefix=EXE-IMAGE
# EXE-IMAGE: {{^}}Format: PE32+ machine=0x8664 exe{{$}}

## Bound to System.Private.CoreLib, an upper-case extension: the same.
# RUN: msil-ld ret.o --reference=spc -o Prog.EXE 2>&1 | %{fc} --check-prefix=WARN-SPC
# WARN-SPC: {{^}}msil-ld: warning: Prog.EXE: this executable is bound to System.Private.CoreLib 10.0.0.0, so it runs only on .NET through 'dotnet' and cannot start on .NET Framework; .NET executables are named .dll (for example -o Prog.dll){{$}}
# RUN: llvm-cil-dump --headers Prog.EXE | FileCheck %s --check-prefix=EXE-IMAGE

## The same link named .dll: no warning, the same EXE image.
# RUN: msil-ld ret.o --reference=rt -o x.dll 2>&1 | count 0
# RUN: llvm-cil-dump --headers x.dll | FileCheck %s --check-prefix=EXE-IMAGE

## No references, the Framework's mscorlib, netstandard 2.0: no warning.
# RUN: msil-ld ret.o -o none.exe 2>&1 | count 0
# RUN: msil-ld ret.o --reference=fw -o framework.exe 2>&1 | count 0
# RUN: msil-ld ret.o --reference=ns -o standard.exe 2>&1 | count 0

## Bound to netstandard 2.1, which the .NET Framework does not ship: the
## warning named .exe, with the EXE image; nothing named .dll.
# RUN: msil-ld ret.o --reference=ns21 -o x.exe 2>&1 | %{fc} --check-prefix=WARN-NS21
# WARN-NS21: {{^}}msil-ld: warning: x.exe: this executable is bound to netstandard 2.1.0.0, so it runs only on .NET through 'dotnet' and cannot start on .NET Framework; .NET executables are named .dll (for example -o x.dll){{$}}
# RUN: llvm-cil-dump --headers x.exe | FileCheck %s --check-prefix=EXE-IMAGE
# RUN: msil-ld ret.o --reference=ns21 -o x.dll 2>&1 | count 0

## -shared: no warning, whatever the name.
# RUN: msil-ld -shared lib.o --reference=rt -o lib.dll 2>&1 | count 0
# RUN: msil-ld -shared lib.o --reference=rt -o shlib.exe 2>&1 | count 0

#--- ret.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  ret i32 42
}

#--- lib.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @lib_fn(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

#--- System.Runtime.il
// System.Runtime 8.0.0.0: Inputs/fakepack/FakeCore.il as gen.py's FakeCore
// target assembles it (no '#define'), without its comments, with the
// assembly and the module renamed System.Runtime: the same types and the
// .NET packs' public key.
.mscorlib
.assembly System.Runtime
{
  .custom instance void System.Runtime.CompilerServices.ReferenceAssemblyAttribute::.ctor() = ( 01 00 00 00 )
  .publickey = ( 00 24 00 00 04 80 00 00 94 00 00 00 06 02 00 00
                 00 24 00 00 52 53 41 31 00 04 00 00 01 00 01 00
                 07 D1 FA 57 C4 AE D9 F0 A3 2E 84 AA 0F AE FD 0D
                 E9 E8 FD 6A EC 8F 87 FB 03 76 6C 83 4C 99 92 1E
                 B2 3B E7 9A D9 D5 DC C1 DD 9A D2 36 13 21 02 90
                 0B 72 3C F9 80 95 7F C4 E1 77 10 8F C6 07 77 4F
                 29 E8 32 0E 92 EA 05 EC E4 E8 21 C0 A5 EF E8 F1
                 64 5C 4C 0C 93 C1 AB 99 28 5D 62 2C AA 65 2C 1D
                 FA D6 3D 74 5D 6F 2D E5 F1 7E 5E AF 0F C4 96 3D
                 26 1C 8A 12 43 65 18 20 6D C0 93 34 4D 5A D2 93 )
  .ver 8:0:0:0
}
