# FOO-IMPORTS-NEXT: dlsym -> libfoo.so!dlsym [function, GLIBC_2.34]
# FOO-IMPORTS-NEXT: environ -> libfoo.so!environ [data, GLIBC_2.2.5]
# FOO-IMPORTS-NEXT: libfoo.so: version floor GLIBC_2.34
# FOO-IMPORTS-NOT:  {{.}}
# RUN: llvm-cil-dump alias-foo.exe | FileCheck %s --check-prefix=FOO --implicit-check-not=libc.so.6
# RUN: msil-ld --lto-O0 --lto-emit-asm alias.bc libfoo.so --print-imports -o alias-foo.il > alias-foo-text.txt 2>&1
