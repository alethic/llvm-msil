# RUN: llvm-cil-dump args1.exe > args1.txt
# RUN: %{listing} method args1.txt '<Module>' .cctor | FileCheck %s --check-prefix=CALL1
# RUN: %{noargv} --check-prefix=NOARGV --input-file=args1.txt
# CALL1: {{^}}    L{{[0-9]+}}: call void(int32) '<Module>'::'init1'{{$}}
# RUN: msil-ld args2.o libc.so.6 -o args2.exe 2>&1 | count 0
# RUN: llvm-cil-dump args2.exe > args2.txt
# RUN: %{listing} method args2.txt '<Module>' .cctor | FileCheck %s --check-prefix=CALL2
# RUN: %{noargv} --check-prefix=NOARGV --input-file=args2.txt
# CALL2: {{^}}    L{{[0-9]+}}: call void(int32, native int) '<Module>'::'init2'{{$}}
# NOARGV: {{^}}.class '<Module>' flags=
# NOARGV: {{^}}  .method '<msil>Main' int32(string[]) flags={{.*}}
# NOARGV: {{^}}    L{{[0-9]+}}: call int32() '<Module>'::'main'{{$}}

