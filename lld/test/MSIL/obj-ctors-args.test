## -Map: the import under Imports:, with the field's name as the symbol.
# RUN: msil-ld args3.o libc.so.6 -Map args3.map -o args3-map.exe 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=MAP --input-file=args3.map
# RUN: msil-ld args3.bc libc.so.6 -Map args3-lto.map -o args3-map-lto.exe 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=MAP --input-file=args3-lto.map
# MAP:      {{^}}Imports:{{$}}
# MAP-NEXT: {{^ *Token +Module!Entry +Symbol$}}
# MAP-DAG:  {{^ +0x04[0-9A-F]+ +libc\.so\.6!environ +<msil>environ$}}
# MAP-DAG:  {{^ +0x06[0-9A-F]+ +libc\.so\.6!dlopen +dlopen$}}
# MAP-DAG:  {{^ +0x06[0-9A-F]+ +libc\.so\.6!dlsym +dlsym$}}

## Another soname: libfoo.so defines environ, and nothing names libc.so.6.
# RUN: ld.lld -shared -soname libfoo.so --version-script %S/Inputs/native/glibc-libc.map libc.o -o libfoo.so
# RUN: msil-ld args3.o libfoo.so -o foo.exe 2>&1 | count 0
# RUN: llvm-cil-dump foo.exe | FileCheck %s --check-prefix=FOO --implicit-check-not=libc.so.6
# FOO:     {{^}}moduleref 'libfoo.so'{{$}}
# FOO-DAG: {{^}}    L{{[0-9]+}}: ldstr "libfoo.so"{{[[:space:]]+}}L{{[0-9]+}}: ldstr "environ"{{$}}
# FOO-DAG: {{^}}    .pinvokeimpl 'libfoo.so' entry 'dlopen' flags=0x0201{{$}}
# FOO-DAG: {{^}}    .pinvokeimpl 'libfoo.so' entry 'dlsym' flags=0x0201{{$}}
# RUN: msil-ld --lto-emit-asm args3.bc libfoo.so -o foo.il 2>&1 | count 0
# RUN: FileCheck %s --check-prefix=FOO-TEXT --implicit-check-not=libc.so.6 --input-file=foo.il
# FOO-TEXT-DAG: {{^}}.method {{.*}}pinvokeimpl("libfoo.so" nomangle cdecl) native int 'dlopen'(native int, int32) {{.*}}
# FOO-TEXT-DAG: {{^}}.method {{.*}}pinvokeimpl("libfoo.so" nomangle cdecl) native int 'dlsym'(native int, native int) {{.*}}
# FOO-TEXT-DAG: {{^}}.field public static native int '<msil>environ'{{$}}
# FOO-TEXT-DAG: {{^}}  ldstr "libfoo.so"{{[[:space:]]+}}ldstr "environ"{{$}}

## An alias constructor under --lto-O0: the PE link and --lto-emit-asm
## agree, with and without libfoo.so.
# RUN: llvm-as alias.ll -o alias.bc
# RUN: not msil-ld --lto-O0 alias.bc -o noenv-alias.exe 2>&1 | %{fc} --check-prefix=NO-ENVIRON-ALIAS
# RUN: not msil-ld --lto-O0 --lto-emit-asm alias.bc -o noenv-alias.il 2>&1 | %{fc} --check-prefix=NO-ENVIRON-ALIAS
# NO-ENVIRON-ALIAS: {{^}}msil-ld: error: global constructor '{{init3|init_alias}}' takes envp, but no native library of the link defines 'environ'{{$}}
