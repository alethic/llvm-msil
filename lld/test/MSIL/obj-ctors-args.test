# RUN: FileCheck %s --check-prefix=FOO-TEXT --implicit-check-not=libc.so.6 --input-file=alias-foo.il

## No native definition of environ: the error, in every link.
# RUN: not msil-ld args3.o -o noenv.exe 2>&1 | %{fc} --check-prefix=NO-ENVIRON -DCTOR=init3
# RUN: not msil-ld args3.bc -o noenv-lto.exe 2>&1 | %{fc} --check-prefix=NO-ENVIRON -DCTOR=init3
# RUN: not msil-ld -shared args3.o -o noenv.dll 2>&1 | %{fc} --check-prefix=NO-ENVIRON -DCTOR=init3
# RUN: not msil-ld -shared args3.bc -o noenv-lto.dll 2>&1 | %{fc} --check-prefix=NO-ENVIRON -DCTOR=init3
# RUN: not msil-ld --lto-emit-asm args3.bc -o noenv.il 2>&1 | %{fc} --check-prefix=NO-ENVIRON -DCTOR=init3
# RUN: not msil-ld slot.o -o noenv-slot.exe 2>&1 | %{fc} --check-prefix=NO-ENVIRON -DCTOR=init_slot
# NO-ENVIRON: {{^}}msil-ld: error: global constructor '[[CTOR]]' takes envp, but no native library of the link defines 'environ'{{$}}

## Other parameter lists, and windows-msvc.
# RUN: not msil-ld other.bc libc.so.6 -o x.exe 2>&1 | %{fc} --check-prefix=ARGS -DCTOR=init_other
# RUN: not msil-ld --lto-emit-asm other.bc libc.so.6 -o x.il 2>&1 | %{fc} --check-prefix=ARGS -DCTOR=init_other
# RUN: not msil-ld four.bc libc.so.6 -o x.exe 2>&1 | %{fc} --check-prefix=ARGS -DCTOR=init4
# RUN: not msil-ld win.bc -o x.exe 2>&1 | %{fc} --check-prefix=ARGS -DCTOR=init3
# RUN: not msil-ld --lto-emit-asm win.bc -o x.il 2>&1 | %{fc} --check-prefix=ARGS -DCTOR=init3
# RUN: not msil-ld winslot.o -o x.exe 2>&1 | %{fc} --check-prefix=ARGS -DCTOR=init_slot
# ARGS: {{^}}msil-ld: error: {{.*}}global constructor '[[CTOR]]' takes arguments, which MSIL does not pass{{$}}
# RUN: not llc -filetype=obj other.ll -o x.o 2>&1 | %{fc} --check-prefix=LLC-ARGS -DCTOR=init_other
# RUN: not llc -filetype=obj win.ll -o x.o 2>&1 | %{fc} --check-prefix=LLC-ARGS -DCTOR=init3
# LLC-ARGS: {{^}}error: {{.*}}global constructor '[[CTOR]]' takes arguments, which MSIL does not pass{{$}}

#--- args3.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@seen = global i32 0, align 4
@saved_argv = global ptr null, align 8
@saved_envp = global ptr null, align 8
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init3, ptr null }]

define internal void @init3(i32 %argc, ptr %argv, ptr %envp) {
  store i32 %argc, ptr @seen, align 4
  store ptr %argv, ptr @saved_argv, align 8
  store ptr %envp, ptr @saved_envp, align 8
  ret void
}

define i32 @main() {
  %v = load i32, ptr @seen, align 4
  %a = load ptr, ptr @saved_argv, align 8
  %e = load ptr, ptr @saved_envp, align 8
  %ai = ptrtoint ptr %a to i32
  %ei = ptrtoint ptr %e to i32
  %s1 = add i32 %v, %ai
  %s2 = add i32 %s1, %ei
  ret i32 %s2
}

#--- env.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@environ = external global ptr

define i32 @main() {
  %e = load ptr, ptr @environ, align 8
  %i = ptrtoint ptr %e to i32
  ret i32 %i
}

#--- args1.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@seen = global i32 0, align 4
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init1, ptr null }]

define internal void @init1(i32 %argc) {
  store i32 %argc, ptr @seen, align 4
  ret void
}

define i32 @main() {
  %v = load i32, ptr @seen, align 4
  ret i32 %v
}

#--- args2.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@seen = global i32 0, align 4
@saved_argv = global ptr null, align 8
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init2, ptr null }]

define internal void @init2(i32 %argc, ptr %argv) {
  store i32 %argc, ptr @seen, align 4
  store ptr %argv, ptr @saved_argv, align 8
  ret void
}

define i32 @main() {
  %v = load i32, ptr @seen, align 4
  ret i32 %v
}

#--- slot.ll
target triple = "x86_64-unknown-linux-gnu-msil"

@seen = global i32 0, align 4
@slot = internal global ptr @init_slot, section ".init_array", align 8
@llvm.used = appending global [1 x ptr] [ptr @slot], section "llvm.metadata"

define internal void @init_slot(i32 %argc, ptr %argv, ptr %envp) {
  store i32 %argc, ptr @seen, align 4
  ret void
}

define i32 @main() {
  %v = load i32, ptr @seen, align 4
  ret i32 %v
}

#--- other.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@saved = global ptr null, align 8
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init_other, ptr null }]

define internal void @init_other(ptr %p) {
  store ptr %p, ptr @saved, align 8
  ret void
}

define i32 @main() {
  %p = load ptr, ptr @saved, align 8
  %r = ptrtoint ptr %p to i32
  ret i32 %r
}

#--- four.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@seen = global i32 0, align 4
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init4, ptr null }]

define internal void @init4(i32 %argc, ptr %argv, ptr %envp, i32 %extra) {
  store i32 %extra, ptr @seen, align 4
  ret void
}

define i32 @main() {
  %v = load i32, ptr @seen, align 4
  ret i32 %v
}

#--- win.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@seen = global i32 0, align 4
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init3, ptr null }]

define internal void @init3(i32 %argc, ptr %argv, ptr %envp) {
  store i32 %argc, ptr @seen, align 4
  ret void
}

define i32 @main() {
  %v = load i32, ptr @seen, align 4
  ret i32 %v
}

#--- winslot.ll
target triple = "x86_64-pc-windows-msvc-msil"

@seen = global i32 0, align 4
@slot = internal global ptr @init_slot, section ".CRT$XCU", align 8
@llvm.used = appending global [1 x ptr] [ptr @slot], section "llvm.metadata"

define internal void @init_slot(i32 %argc, ptr %argv, ptr %envp) {
  store i32 %argc, ptr @seen, align 4
  ret void
}

define i32 @main() {
  %v = load i32, ptr @seen, align 4
  ret i32 %v
}

#--- alias.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

@seen = global i32 0, align 4
@saved_envp = global ptr null, align 8
@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @init_alias, ptr null }]

@init_alias = internal alias void (i32, ptr, ptr), ptr @init3

define internal void @init3(i32 %argc, ptr %argv, ptr %envp) {
  store i32 %argc, ptr @seen, align 4
  store ptr %envp, ptr @saved_envp, align 8
  ret void
}

define i32 @main() {
  %v = load i32, ptr @seen, align 4
  ret i32 %v
}
