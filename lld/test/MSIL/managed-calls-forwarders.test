#--- damage.py
## damage.py <in> <out>: writes the bitcode file <in> to <out> with the 8
## bytes before its first '__msil_mc.wguard' set to 0xff. They end the
## lengths (VBR6 fields) that the module's METADATA_STRINGS record keeps
## right before the strings' characters, so the module's metadata no longer
## reads ('Unterminated VBR') while the symbol table still does.
import sys

data = bytearray(open(sys.argv[1], "rb").read())
at = data.find(b"__msil_mc.wguard")
if at < 8:
    sys.exit("damage.py: no '__msil_mc.wguard' in " + sys.argv[1])
data[at - 8 : at] = b"\xff" * 8
open(sys.argv[2], "wb").write(data)
