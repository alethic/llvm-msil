## Two units with the forwarder: <A> is the first of them in load order, and
## the name gets one line.
# RUN: not msil-ld -shared exp2.o cweak.o exp1.o --reference=refs -o x.dll 2>&1 \
# RUN:   | %{err} --check-prefix=TM21 -DA=exp2.o -DB=cweak.o
# RUN: not msil-ld -shared cweak.bc exp1.bc exp2.bc --reference=refs -o x.dll 2>&1 \
# RUN:   | %{err} --check-prefix=TM21 -DA=exp1.bc -DB=cweak.bc
## An archive member, extracted only for an undefined name: before exp1,
## pmain's call extracts it (T-M21); after exp1 nothing is extracted, and
## the export calls the stub.
# RUN: llvm-ar rc libb.a cweak.o
# RUN: llvm-ar rc libb-bc.a cweak.bc
# RUN: not msil-ld pmain.o libb.a exp1.o --reference=refs -o x.exe 2>&1 \
# RUN:   | %{err} --check-prefix=TM21 -DA=exp1.o -DB="libb.a(cweak.o)"
# RUN: not msil-ld pmain.bc libb-bc.a exp1.bc --reference=refs -o x.exe 2>&1 \
# RUN:   | %{err} --check-prefix=TM21 -DA=exp1.bc -DB="libb-bc.a(cweak.bc)"
# RUN: not ls x.dll
# RUN: not ls x.exe
# RUN: msil-ld pmain.o exp1.o libb.a --reference=refs -o o/arch.exe 2>&1 | count 0
# RUN: llvm-cil-dump o/arch.exe > arch-o.txt
# RUN: %{listing} method arch-o.txt '<Module>' wguard | FileCheck %s --check-prefix=EXPORT-BODY
# RUN: FileCheck %s --check-prefix=EXPORT-STUB --implicit-check-not="ldc.i4 1000" --input-file=arch-o.txt
# RUN: msil-ld pmain.bc exp1.bc libb-bc.a --reference=refs -o lto/arch.exe 2>&1 | count 0
# RUN: llvm-cil-dump lto/arch.exe > arch-lto.txt
# RUN: %{listing} method arch-lto.txt '<Module>' main | FileCheck %s --check-prefix=PMAIN-LTO
# RUN: FileCheck %s --check-prefix=EXPORT-STUB --implicit-check-not="ldc.i4 1000" --input-file=arch-lto.txt
# TM21: {{^}}msil-ld: error: managed call 'wguard' is exported from [[A]], but [[B]] also defines 'wguard'{{$}}

## destructor: the error names the C function.
# DEFINE: %{dtor} = cat %{tri}.head dtor.ll > dtor-%{tri}.ll && llvm-as dtor-%{tri}.ll -o dtor-%{tri}.bc && \
# DEFINE:   not llc -filetype=obj dtor-%{tri}.ll -o dtor-%{tri}.o 2>&1 | %{err} --check-prefix=DTOR-LLC && \
# DEFINE:   not msil-ld dtor-%{tri}.bc --reference=refs -o x.exe 2>&1 | %{err} --check-prefix=DTOR && \
# DEFINE:   not msil-ld --lto-emit-asm dtor-%{tri}.bc -o x.il 2>&1 | %{err} --check-prefix=DTOR
# REDEFINE: %{tri} = win
# RUN: %{dtor}
# REDEFINE: %{tri} = lnx
# RUN: %{dtor}
# REDEFINE: %{tri} = net
# RUN: %{dtor}
# RUN: not ls x.exe
# RUN: not ls x.il
# DTOR-LLC: {{^}}error: global destructor @wfini is not supported for MSIL yet{{$}}
# DTOR:     {{^}}msil-ld: error: global destructor @wfini is not supported for MSIL yet{{$}}

## T-M23's forwarder form: a GLOBAL definition of a constructor (gctor.ll)
## or destructor (gdtor.ll) forwarder's name beside ctor1.ll's constructor
## managed call wreset: CIL objects, bitcode, and mixed, in both orders.
# DEFINE: %{tm23-unit} =
# DEFINE: %{tm23-name} =
# DEFINE: %{tm23} = cat %{tri}.head %{tm23-unit}.ll > %{tm23-unit}-%{tri}.ll && \
# DEFINE:   llc -filetype=obj %{tm23-unit}-%{tri}.ll -o %{tm23-unit}-%{tri}.o && \
# DEFINE:   llvm-as %{tm23-unit}-%{tri}.ll -o %{tm23-unit}-%{tri}.bc && \
# DEFINE:   not msil-ld ctor1-%{tri}.o %{tm23-unit}-%{tri}.o --reference=refs -o x.exe 2>&1 \
# DEFINE:     | %{err} --check-prefix=TM23F -DO=%{tm23-unit}-%{tri}.o -DN=%{tm23-name} && \
# DEFINE:   not msil-ld %{tm23-unit}-%{tri}.o ctor1-%{tri}.o --reference=refs -o x.exe 2>&1 \
# DEFINE:     | %{err} --check-prefix=TM23F -DO=%{tm23-unit}-%{tri}.o -DN=%{tm23-name} && \
# DEFINE:   not msil-ld ctor1-%{tri}.bc %{tm23-unit}-%{tri}.bc --reference=refs -o x.exe 2>&1 \
# DEFINE:     | %{err} --check-prefix=TM23F -DO=%{tm23-unit}-%{tri}.bc -DN=%{tm23-name} && \
# DEFINE:   not msil-ld %{tm23-unit}-%{tri}.bc ctor1-%{tri}.bc --reference=refs -o x.exe 2>&1 \
# DEFINE:     | %{err} --check-prefix=TM23F -DO=%{tm23-unit}-%{tri}.bc -DN=%{tm23-name} && \
# DEFINE:   not msil-ld ctor1-%{tri}.o %{tm23-unit}-%{tri}.bc --reference=refs -o x.exe 2>&1 \
# DEFINE:     | %{err} --check-prefix=TM23F -DO=%{tm23-unit}-%{tri}.bc -DN=%{tm23-name} && \
# DEFINE:   not msil-ld %{tm23-unit}-%{tri}.bc ctor1-%{tri}.o --reference=refs -o x.exe 2>&1 \
# DEFINE:     | %{err} --check-prefix=TM23F -DO=%{tm23-unit}-%{tri}.bc -DN=%{tm23-name} && \
# DEFINE:   not msil-ld ctor1-%{tri}.bc %{tm23-unit}-%{tri}.o --reference=refs -o x.exe 2>&1 \
# DEFINE:     | %{err} --check-prefix=TM23F -DO=%{tm23-unit}-%{tri}.o -DN=%{tm23-name} && \
# DEFINE:   not msil-ld %{tm23-unit}-%{tri}.o ctor1-%{tri}.bc --reference=refs -o x.exe 2>&1 \
