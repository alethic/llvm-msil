# RUN: msil-ld --reference=empty --print-bcl-binding=member:NativeLibrary_Load 2>&1 \
# RUN:   | %{fc} --check-prefix=NO-REFS-BINDING --implicit-check-not="pass --reference"
# NO-REFS-BINDING: {{^}}member:NativeLibrary_Load -> the references contain no core library (an assembly that defines System.Object and references no other assembly); given: no references{{$}}

#--- ret42.ll
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  ret i32 42
}

#--- fence.ll
target triple = "x86_64-pc-windows-msvc-msil"

define void @barrier() {
  fence seq_cst
  ret void
}

define i32 @main() {
  call void @barrier()
  ret i32 0
}
