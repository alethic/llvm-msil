# RUN: yaml2obj %S/Inputs/fakepack/FakeCore.yaml -o pack/FakeCore.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeThreading.yaml -o pack/FakeThreading.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeFacade.yaml -o FakeFacade.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeInterop.yaml -o FakeInterop.dll
# RUN: yaml2obj %S/Inputs/fakepack/IlasmCore.yaml -o IlasmCore.dll
# RUN: yaml2obj %S/Inputs/fakepack/FakeMscorlib.yaml -o mscorlib.dll
# RUN: yaml2obj %S/Inputs/fakepack/BaseCore.yaml -o BaseCore.dll
# RUN: mkdir three
# RUN: yaml2obj %S/Inputs/fakepack/CoreA.yaml -o three/CoreA.dll
# RUN: yaml2obj %S/Inputs/fakepack/CoreB.yaml -o three/CoreB.dll
# RUN: yaml2obj %S/Inputs/fakepack/CoreC.yaml -o three/CoreC.dll

# DEFINE: %{fc} = FileCheck %s --implicit-check-not="PLEASE submit" --implicit-check-not="Stack dump" \
# DEFINE:   --implicit-check-not="LLVM ERROR" --implicit-check-not=error:

## No core library.
# RUN: not msil-ld ret42.o --reference=FakeFacade.dll -o x.exe 2>&1 | %{fc} --check-prefix=FACADE
# RUN: not msil-ld fence.o --reference=FakeFacade.dll -o x.exe 2>&1 | %{fc} --check-prefix=FACADE
# FACADE: {{^}}msil-ld: error: the references contain no core library (an assembly that defines System.Object and references no other assembly); given: {{.*}}FakeFacade{{.*}}(facade, forwards System.Object to FakeCore){{.*$}}
# RUN: not msil-ld ret42.o --reference=FakeInterop.dll -o x.exe 2>&1 | %{fc} --check-prefix=NONE -DNAME=FakeInterop
# RUN: not msil-ld ret42.o --reference=IlasmCore.dll -o x.exe 2>&1 | %{fc} --check-prefix=NONE -DNAME=IlasmCore
# RUN: not msil-ld ret42.o IlasmCore.dll -o x.exe 2>&1 | %{fc} --check-prefix=NONE -DNAME=IlasmCore
# NONE: {{^}}msil-ld: error: the references contain no core library (an assembly that defines System.Object and references no other assembly); given: {{.*}}[[NAME]]{{.*$}}

## The list (section 12 row 2026-10-26, '5.11.9 clarified') names only the
## references that define or forward System.Object, each with its note:
## FakeFacade and IlasmCore, but not FakeInterop, which does neither. The
## list is in identity order whatever the command-line order (section 12 row
## 2026-10-26, 'Row 5.11.9 clarified ... corrected'), so the reversed
## command line gives the same line.
# RUN: not msil-ld ret42.o --reference=FakeFacade.dll --reference=FakeInterop.dll --reference=IlasmCore.dll \
# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=LIST
# LIST:      {{^}}msil-ld: error: the references contain no core library {{.*}}; given:
# LIST-SAME: FakeFacade
# LIST-SAME: (facade, forwards System.Object to FakeCore)
# RUN: not msil-ld ret42.o --reference=FakeFacade.dll --reference=FakeInterop.dll --reference=IlasmCore.dll \
# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=LIST-ALL
# RUN: not msil-ld ret42.o --reference=IlasmCore.dll --reference=FakeInterop.dll --reference=FakeFacade.dll \
# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=LIST-ALL
# LIST-ALL: {{^}}msil-ld: error: the references contain no core library (an assembly that defines System.Object and references no other assembly); given: FakeFacade 4.0.0.0 [b77a5c561934e089] (facade, forwards System.Object to FakeCore), IlasmCore 8.0.0.0 [b77a5c561934e089] (defines System.Object but references mscorlib){{$}}
# RUN: not msil-ld ret42.o --reference=FakeFacade.dll --reference=FakeInterop.dll --reference=IlasmCore.dll \
# RUN:   -o x.exe 2>&1 | FileCheck %s --check-prefix=LIST-ILASM
# LIST-ILASM: {{^}}msil-ld: error: the references contain no core library {{.*}}IlasmCore{{.*$}}

## When no reference defines or forwards System.Object, the list names every
## reference, without a note (FakeInterop and FakeThreading have neither a
## System.Object TypeDef nor an ExportedType), again in identity order in
## either command-line order.
# RUN: not msil-ld ret42.o --reference=FakeInterop.dll --reference=pack/FakeThreading.dll -o x.exe 2>&1 \
# RUN:   | %{fc} --check-prefix=LIST-NONE
# RUN: not msil-ld ret42.o --reference=pack/FakeThreading.dll --reference=FakeInterop.dll -o x.exe 2>&1 \
# RUN:   | %{fc} --check-prefix=LIST-NONE
# LIST-NONE: {{^}}msil-ld: error: the references contain no core library (an assembly that defines System.Object and references no other assembly); given: FakeInterop 8.0.0.0 [b03f5f7f11d50a3a], FakeThreading 8.1.2.3 [31bf3856ad364e35]{{$}}

## Two core libraries, in either command-line order; the error names them in
## identity order ('fakecore' before 'mscorlib'). A file that a directory
## contributes is named '<dir>/<file>' with '/' on every host (M21 review-r1
## finding 5), as bcl-identity.test checks too.
# RUN: not msil-ld ret42.o --reference=pack --reference=mscorlib.dll -o x.exe 2>&1 | %{fc} --check-prefix=TWO
# RUN: not msil-ld ret42.o --reference=mscorlib.dll --reference=pack -o x.exe 2>&1 | %{fc} --check-prefix=TWO
# TWO: {{^}}msil-ld: error: the references mix two core libraries: FakeCore 8.0.0.0 [b03f5f7f11d50a3a] (pack/FakeCore.dll) and mscorlib 4.0.0.0 [b77a5c561934e089] (mscorlib.dll){{$}}

## Three core libraries: counted, and listed in identity order, through a
## directory and through files in the reverse order.
# RUN: not msil-ld ret42.o --reference=three -o x.exe 2>&1 | %{fc} --check-prefix=THREE
# RUN: not msil-ld ret42.o --reference=three/CoreC.dll --reference=three/CoreB.dll --reference=three/CoreA.dll \
# RUN:   -o x.exe 2>&1 | %{fc} --check-prefix=THREE
# THREE: {{^}}msil-ld: error: the references mix 3 core libraries: CoreA 1.0.0.0 [null] (three/CoreA.dll), CoreB 1.0.0.0 [null] (three/CoreB.dll) and CoreC 1.0.0.0 [null] (three/CoreC.dll){{$}}

## A candidate with an AssemblyRef is no core library, so FakeCore is the
## only one.
# RUN: msil-ld ret42.o --reference=pack --reference=IlasmCore.dll -o ok1.exe 2>&1 | count 0
# RUN: msil-ld fence.o --reference=pack --reference=IlasmCore.dll -o ok2.exe 2>&1 | count 0

## Nor is a System.Object with a base type: alone it is named with its note;
## next to FakeCore it is no second core library.
# RUN: not msil-ld ret42.o --reference=BaseCore.dll -o x.exe 2>&1 | %{fc} --check-prefix=BASETYPE
# BASETYPE: {{^}}msil-ld: error: the references contain no core library (an assembly that defines System.Object and references no other assembly); given: BaseCore 1.0.0.0 [null] (defines System.Object with a base type){{$}}
# RUN: msil-ld ret42.o --reference=pack/FakeCore.dll --reference=BaseCore.dll -o ok5.exe 2>&1 | count 0
# RUN: msil-ld ret42.o --reference=BaseCore.dll --reference=pack/FakeCore.dll -o ok6.exe 2>&1 | count 0

## With the core library alone a program without BCL members links, and so
## does one whose references hold a facade besides.
# RUN: msil-ld ret42.o --reference=pack/FakeCore.dll -o ok3.exe 2>&1 | count 0
# RUN: msil-ld fence.o --reference=pack --reference=FakeFacade.dll -o ok4.exe 2>&1 | count 0

