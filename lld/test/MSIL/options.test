#--- main.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

define i32 @main() {
  ret i32 42
}

#--- reloc.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-pc-windows-msvc-msil"

@a = global i32 1, align 4
@b = global i32 2, align 4
@c = global i32 3, align 4
@tab = global [3 x ptr] [ptr @a, ptr @b, ptr @c], align 8

define i32 @main(i32 %argc, ptr %argv) {
  %i = sext i32 %argc to i64
  %p = getelementptr [3 x ptr], ptr @tab, i64 0, i64 %i
  %q = load ptr, ptr %p, align 8
  %v = load i32, ptr %q, align 4
  ret i32 %v
}

#--- gnu.ll
target datalayout = "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-w64-windows-gnu-msil"

define i32 @main() {
  ret i32 42
}

#--- lnx.ll
target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
target triple = "x86_64-unknown-linux-gnu-msil"

define i32 @main() {
  ret i32 42
}
