//===----------------------------------------------------------------------===//
//
// The C library names that TargetLibraryInfo lacks (llvm/docs/MSIL/
// ImplementationPlan.md 5.18.6 PL3): llvm-libc's public function names, the
// 'name' of every 'functions:' entry of libc/include/**/*.yaml, less the
// names of llvm/include/llvm/Analysis/TargetLibraryInfo.td. On the portable
// triples an undefined symbol with one of these names, or one that
// TargetLibraryInfo::getLibFunc knows, gets N6's class line (plan 5.14.2).
// The line is a hint: a name missing from both sources still fails as an
// undefined symbol, only without N6.
//
// One C_LIBRARY_NAME(name) per line, sorted by byte value (the reader
// binary-searches the list and asserts the order). Generated from the
// llvm-libc headers' YAML and TargetLibraryInfo.td by
// `python msil/utils/gen-clibrary-names.py`, which rewrites only the
// C_LIBRARY_NAME entries below and keeps this header; run it when either
// source changes. Its `--check` mode reports whether the entries are
// current without writing the file.
//
//===----------------------------------------------------------------------===//

#ifndef C_LIBRARY_NAME
#error "define C_LIBRARY_NAME(name) before including CLibraryNames.def"
#endif

