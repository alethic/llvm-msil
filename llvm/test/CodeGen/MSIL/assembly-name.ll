; The assembly is named by -msil-assembly-name; by default it is the stem of the
; module's source_filename, or 'module' when that is empty (decision D28,
; ImplementationPlan.md M2.d). The name is quoted with the identifier escapes of
; decision D11 (a quote becomes \', a backslash \134), and the result assembles.
; Names are written as raw UTF-8, and a module in which a global value or the
; assembly has a non-ASCII name starts with a UTF-8 byte-order mark (D11):
; without it ilasm reads the bytes in the ANSI code page and silently
; double-encodes the name. An all-ASCII module has no BOM (empty-module.ll).

; RUN: split-file %s %t

; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/path.ll \
; RUN:   | FileCheck %s --check-prefix=DEFAULT
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/path.ll \
; RUN:   | FileCheck %s --check-prefix=DEFAULT
; DEFAULT: // source_filename = "lib/src/prog-1.c"
; DEFAULT: {{^}}.assembly 'prog-1' { .ver 0:0:0:0 }{{$}}

; Only the last extension is dropped.
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/dots.ll \
; RUN:   | FileCheck %s --check-prefix=DOTS
; DOTS: {{^}}.assembly 'zlib.inflate' { .ver 0:0:0:0 }{{$}}

; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/no-source.ll \
; RUN:   | FileCheck %s --check-prefix=NOSOURCE
; NOSOURCE: {{^}}.assembly 'module' { .ver 0:0:0:0 }{{$}}

; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/quote.ll \
; RUN:   | FileCheck %s --check-prefix=QUOTE-DEFAULT
; QUOTE-DEFAULT: {{^}}.assembly 'o\'brien' { .ver 0:0:0:0 }{{$}}

; The option wins over the source file name.
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -msil-assembly-name=foo -verify-machineinstrs < %t/path.ll \
; RUN:   | FileCheck %s --check-prefix=FOO
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -msil-assembly-name=foo -verify-machineinstrs < %t/no-source.ll \
; RUN:   | FileCheck %s --check-prefix=FOO
; FOO-NOT: .assembly 'prog-1'
; FOO-NOT: .assembly 'module'
; FOO: {{^}}.assembly 'foo' { .ver 0:0:0:0 }{{$}}
; FOO-NOT: .assembly '

; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil "-msil-assembly-name=it's" -verify-machineinstrs < %t/path.ll \
; RUN:   | FileCheck %s --check-prefix=QUOTE
; QUOTE: {{^}}.assembly 'it\'s' { .ver 0:0:0:0 }{{$}}

; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil "-msil-assembly-name=a\\b" -verify-machineinstrs < %t/path.ll \
; RUN:   | FileCheck %s --check-prefix=BACKSLASH
; BACKSLASH: {{^}}.assembly 'a\134b' { .ver 0:0:0:0 }{{$}}

; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil "-msil-assembly-name=my lib" -verify-machineinstrs < %t/path.ll \
; RUN:   | FileCheck %s --check-prefix=SPACE
; SPACE: {{^}}.assembly 'my lib' { .ver 0:0:0:0 }{{$}}

; Every form assembles.
; RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil < %t/quote.ll -o %t/quote.il \
; RUN:   && %ilasm-verify -output=%t/quote.dll %t/quote.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil "-msil-assembly-name=a\\b" < %t/path.ll -o %t/backslash.il \
; RUN:   && %ilasm-verify -output=%t/backslash.dll %t/backslash.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-pc-windows-msvc-msil "-msil-assembly-name=my lib" < %t/path.ll -o %t/space.il \
; RUN:   && %ilasm-verify -output=%t/space.dll %t/space.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-pc-windows-msvc-msil < %t/no-source.ll -o %t/no-source.il \
; RUN:   && %ilasm-verify -output=%t/no-source.dll %t/no-source.il %}

; A non-ASCII function name in an otherwise ASCII module, and a non-ASCII
; source file name, which becomes the default assembly name. The input spells
; the names with IR escapes: "caf\C3\A9" is 'cafe' with an acute accent.
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/bom-decl.ll \
; RUN:   | FileCheck %s --check-prefixes=BOM,BOM-DECL
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/bom-decl.ll \
; RUN:   | FileCheck %s --check-prefixes=BOM,BOM-DECL
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/bom-source.ll \
; RUN:   | FileCheck %s --check-prefixes=BOM,BOM-SOURCE
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/bom-source.ll \
; RUN:   | FileCheck %s --check-prefixes=BOM,BOM-SOURCE
; BOM-NOT: {{.}}
; BOM: {{^}}{{\xEF\xBB\xBF}}// MSIL module generated by LLVM{{$}}
; BOM-DECL: {{^}}.assembly 'bom-ascii' { .ver 0:0:0:0 }{{$}}
; BOM-SOURCE: {{^}}.assembly 'caf{{\xC3\xA9}}' { .ver 0:0:0:0 }{{$}}

; RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil < %t/bom-decl.ll -o %t/bom-decl.il \
; RUN:   && %ilasm-verify -output=%t/bom-decl.dll %t/bom-decl.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-pc-windows-msvc-msil < %t/bom-source.ll -o %t/bom-source.il \
; RUN:   && %ilasm-verify -output=%t/bom-source.dll %t/bom-source.il %}

;--- path.ll
source_filename = "lib/src/prog-1.c"

;--- dots.ll
source_filename = "zlib.inflate.c"

;--- no-source.ll
source_filename = ""

;--- quote.ll
source_filename = "o'brien.c"

;--- bom-decl.ll
source_filename = "bom-ascii.c"

declare void @"caf\C3\A9"()

;--- bom-source.ll
source_filename = "caf\C3\A9.c"
