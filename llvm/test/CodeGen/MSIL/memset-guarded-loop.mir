# The custom inserter of INITBLK_LONG (ImplementationPlan.md FX-2, FX-2.a's
# emitLongInitBlk; decision D15 as section 12's row 'D15 amended (FX-2)'
# amends it; plan 5.4's memory row as row 'Contract rows (FX-2)' extends it).
# Instruction selection gives a memset whose length may reach 2^N the pseudo
#   INITBLK_LONG <memflags>, <destination i64>, <value i32>, <length i64>, <N>
# and FinalizeISel (-run-pass=finalize-isel) expands it into three blocks:
#   BB:   (the instructions before the pseudo)
#         %lim = CONST_I64 2^N - 1
#         %big = CGT_UN_I64 %len, %lim
#         BR_UNLESS Tail, %big
#   Loop: %p   = PHI %dst, BB, %p2, Loop
#         %n   = PHI %len, BB, %n2, Loop
#         INITBLK <flags>, %p, %val, (CONST_I32 2^(N-1) as an int32)
#         %p2  = ADD_I64 %p, (CONST_I64 2^(N-1))
#         %n2  = SUB_I64 %n, (CONST_I64 2^(N-1))
#         BR_IF Loop, (CGT_UN_I64 %n2, %lim)
#   Tail: %pt  = PHI %dst, BB, %p2, Loop
#         %nt  = PHI %len, BB, %n2, Loop
#         INITBLK <flags>, %pt, %val, (CONV_I4_I64 %nt)
#         (the rest of BB, with BB's successors and the PHIs that named BB)
# BB and Loop each have Loop and Tail as successors (in either order); Tail
# takes over BB's successors, and a PHI in one of them that named BB names
# Tail. Both INITBLKs carry the pseudo's flags immediate as it is
# (MSILSetMemFlags has filled it before FinalizeISel runs) and a memory
# operand like the pseudo's: the same pointer, flags and unknown size, aligned
# to the common alignment of the pseudo's alignment and 2^(N-1) (align 16
# becomes align 8 at N = 4). A frame-index destination is copied into a
# register with COPY_I64 first, and so is a frame-index length, because a PHI
# takes only registers. The function loses its NoPHIs property (the inputs
# without a PHI get it when they are read). -verify-machineinstrs checks every
# PHI against the predecessor lists and every successor list against the
# branches that end the block, so together with the PHIs below it pins the
# successor lists as sets. The constants: N = 32 gives 4294967295 and
# 2147483648 (-2147483648 as the int32 length), N = 31 gives 2147483647 and
# 1073741824, N = 4 gives 15 and 8. A second pseudo in the same block is
# expanded in the first one's tail (two). No INITBLK_LONG survives.
#
# The implicit ARGUMENTS def of each new instruction is accepted with or
# without the dead flag. memset-guarded-loop.ll checks the CIL of these shapes.

# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=finalize-isel -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --implicit-check-not=INITBLK_LONG
# RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -run-pass=finalize-isel -verify-machineinstrs %s -o - \
# RUN:   | FileCheck %s --implicit-check-not=INITBLK_LONG

# ---- guard32: N = 32, 1-aligned and volatile (flags 9) ----
# CHECK-LABEL: name: guard32{{$}}
# CHECK:       noPhis: false
# CHECK:       body:
# CHECK-NEXT:  {{^ +}}bb.0:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NEXT:  liveins: $arguments
# CHECK:       [[DST:%[0-9]+]]:i64 = ARGUMENT_I64 0, implicit $arguments
# CHECK-NEXT:  [[VAL:%[0-9]+]]:i32 = ARGUMENT_I32 1, implicit $arguments
# CHECK-NEXT:  [[LEN:%[0-9]+]]:i64 = ARGUMENT_I64 2, implicit $arguments
# CHECK-NEXT:  [[LIM:%[0-9]+]]:i64 = CONST_I64 4294967295, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[BIG:%[0-9]+]]:i32 = CGT_UN_I64 [[LEN]], [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_UNLESS %bb.[[TAIL:[0-9]+]], [[BIG]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[LOOP:[0-9]+]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[P:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[N:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[BLK:%[0-9]+]]:i32 = CONST_I32 -2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 9, [[P]], [[VAL]], [[BLK]], implicit-def {{(dead )?}}$arguments :: (volatile store unknown-size into %ir.p, align 1){{$}}
# CHECK-NEXT:  [[S1:%[0-9]+]]:i64 = CONST_I64 2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[P2]]:i64 = ADD_I64 [[P]], [[S1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[S2:%[0-9]+]]:i64 = CONST_I64 2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[N2]]:i64 = SUB_I64 [[N]], [[S2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[MORE:%[0-9]+]]:i32 = CGT_UN_I64 [[N2]], [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_IF %bb.[[LOOP]], [[MORE]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[TAIL]]:{{$}}
# CHECK-NOT:   successors:
# CHECK:       [[PT:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[NT:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[REST:%[0-9]+]]:i32 = CONV_I4_I64 [[NT]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 9, [[PT]], [[VAL]], [[REST]], implicit-def {{(dead )?}}$arguments :: (volatile store unknown-size into %ir.p, align 1){{$}}
# CHECK-NEXT:  RETURN implicit-def dead $arguments
# CHECK-NEXT:  {{^\.\.\.$}}

# ---- guard4: N = 4, 16-aligned (flags 0): the blocks are 8-aligned ----
# CHECK-LABEL: name: guard4{{$}}
# CHECK:       noPhis: false
# CHECK:       body:
# CHECK-NEXT:  {{^ +}}bb.0:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NEXT:  liveins: $arguments
# CHECK:       [[DST:%[0-9]+]]:i64 = ARGUMENT_I64 0, implicit $arguments
# CHECK-NEXT:  [[VAL:%[0-9]+]]:i32 = ARGUMENT_I32 1, implicit $arguments
# CHECK-NEXT:  [[LEN:%[0-9]+]]:i64 = ARGUMENT_I64 2, implicit $arguments
# CHECK-NEXT:  [[LIM:%[0-9]+]]:i64 = CONST_I64 15, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[BIG:%[0-9]+]]:i32 = CGT_UN_I64 [[LEN]], [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_UNLESS %bb.[[TAIL:[0-9]+]], [[BIG]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[LOOP:[0-9]+]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[P:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[N:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[BLK:%[0-9]+]]:i32 = CONST_I32 8, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 0, [[P]], [[VAL]], [[BLK]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.p, align 8){{$}}
# CHECK-NEXT:  [[S1:%[0-9]+]]:i64 = CONST_I64 8, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[P2]]:i64 = ADD_I64 [[P]], [[S1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[S2:%[0-9]+]]:i64 = CONST_I64 8, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[N2]]:i64 = SUB_I64 [[N]], [[S2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[MORE:%[0-9]+]]:i32 = CGT_UN_I64 [[N2]], [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_IF %bb.[[LOOP]], [[MORE]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[TAIL]]:{{$}}
# CHECK-NOT:   successors:
# CHECK:       [[PT:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[NT:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[REST:%[0-9]+]]:i32 = CONV_I4_I64 [[NT]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 0, [[PT]], [[VAL]], [[REST]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.p, align 8){{$}}
# CHECK-NEXT:  RETURN implicit-def dead $arguments
# CHECK-NEXT:  {{^\.\.\.$}}

# ---- frame_dest: a stack array (a frame index) as the destination ----
# The PHIs take a register copy of the frame index; the load after the memset
# still reads the frame index itself.
# CHECK-LABEL: name: frame_dest{{$}}
# CHECK:       noPhis: false
# CHECK:       body:
# CHECK-NEXT:  {{^ +}}bb.0:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NEXT:  liveins: $arguments
# CHECK:       [[VAL:%[0-9]+]]:i32 = ARGUMENT_I32 0, implicit $arguments
# CHECK-NEXT:  [[LEN:%[0-9]+]]:i64 = ARGUMENT_I64 1, implicit $arguments
# CHECK-DAG:   [[DST:%[0-9]+]]:i64 = COPY_I64 %stack.0.buf, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-DAG:   [[LIM:%[0-9]+]]:i64 = CONST_I64 4294967295, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK:       [[BIG:%[0-9]+]]:i32 = CGT_UN_I64 [[LEN]], [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_UNLESS %bb.[[TAIL:[0-9]+]], [[BIG]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[LOOP:[0-9]+]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[P:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[N:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[BLK:%[0-9]+]]:i32 = CONST_I32 -2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 0, [[P]], [[VAL]], [[BLK]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.buf, align 16){{$}}
# CHECK-NEXT:  [[S1:%[0-9]+]]:i64 = CONST_I64 2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[P2]]:i64 = ADD_I64 [[P]], [[S1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[S2:%[0-9]+]]:i64 = CONST_I64 2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[N2]]:i64 = SUB_I64 [[N]], [[S2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[MORE:%[0-9]+]]:i32 = CGT_UN_I64 [[N2]], [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_IF %bb.[[LOOP]], [[MORE]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[TAIL]]:{{$}}
# CHECK-NOT:   successors:
# CHECK:       [[PT:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[NT:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[REST:%[0-9]+]]:i32 = CONV_I4_I64 [[NT]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 0, [[PT]], [[VAL]], [[REST]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.buf, align 16){{$}}
# CHECK-NEXT:  [[V:%[0-9]+]]:i32 = LDIND_U1 0, %stack.0.buf, implicit-def dead $arguments :: (load (s8) from %ir.buf, align 16){{$}}
# CHECK-NEXT:  RETURN [[V]], implicit-def dead $arguments
# CHECK-NEXT:  {{^\.\.\.$}}

# ---- frame_len: the address of a stack object (a frame index) as the length ----
# The PHIs of the length take a register copy of the frame index; the guard
# may compare either.
# CHECK-LABEL: name: frame_len{{$}}
# CHECK:       noPhis: false
# CHECK:       body:
# CHECK-NEXT:  {{^ +}}bb.0:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NEXT:  liveins: $arguments
# CHECK:       [[DST:%[0-9]+]]:i64 = ARGUMENT_I64 0, implicit $arguments
# CHECK-NEXT:  [[VAL:%[0-9]+]]:i32 = ARGUMENT_I32 1, implicit $arguments
# CHECK-DAG:   [[LEN:%[0-9]+]]:i64 = COPY_I64 %stack.0.obj, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-DAG:   [[LIM:%[0-9]+]]:i64 = CONST_I64 4294967295, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK:       [[BIG:%[0-9]+]]:i32 = CGT_UN_I64 {{%[0-9]+|%stack\.0\.obj}}, [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_UNLESS %bb.[[TAIL:[0-9]+]], [[BIG]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[LOOP:[0-9]+]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[P:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[N:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[BLK:%[0-9]+]]:i32 = CONST_I32 -2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 1, [[P]], [[VAL]], [[BLK]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.p, align 1){{$}}
# CHECK:       BR_IF %bb.[[LOOP]], {{%[0-9]+}}, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[TAIL]]:{{$}}
# CHECK-NOT:   successors:
# CHECK:       [[PT:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[NT:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[REST:%[0-9]+]]:i32 = CONV_I4_I64 [[NT]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 1, [[PT]], [[VAL]], [[REST]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.p, align 1){{$}}
# CHECK-NEXT:  RETURN implicit-def dead $arguments
# CHECK-NEXT:  {{^\.\.\.$}}

# ---- rest: instructions after the pseudo, two successors and a PHI ----
# The constant before the pseudo stays in BB, before the guard; the add and
# the branch after it move to the tail, which takes over BB's successors
# (bb.1 and bb.2, in either order), and bb.2's PHI names the tail where it
# named BB. bb.1 and bb.2 keep their numbers and follow the tail.
# CHECK-LABEL: name: rest{{$}}
# CHECK:       body:
# CHECK-NEXT:  {{^ +}}bb.0:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NEXT:  liveins: $arguments
# CHECK:       [[DST:%[0-9]+]]:i64 = ARGUMENT_I64 0, implicit $arguments
# CHECK-NEXT:  [[VAL:%[0-9]+]]:i32 = ARGUMENT_I32 1, implicit $arguments
# CHECK-NEXT:  [[LEN:%[0-9]+]]:i64 = ARGUMENT_I64 2, implicit $arguments
# CHECK-NEXT:  [[C:%[0-9]+]]:i32 = ARGUMENT_I32 3, implicit $arguments
# CHECK-NEXT:  [[K:%[0-9]+]]:i32 = CONST_I32 11, implicit-def dead $arguments
# CHECK-NEXT:  [[LIM:%[0-9]+]]:i64 = CONST_I64 4294967295, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[BIG:%[0-9]+]]:i32 = CGT_UN_I64 [[LEN]], [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_UNLESS %bb.[[TAIL:[0-9]+]], [[BIG]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[LOOP:[0-9]+]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[P:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[N:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2:%[0-9]+]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[BLK:%[0-9]+]]:i32 = CONST_I32 -2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 4, [[P]], [[VAL]], [[BLK]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.p, align 4){{$}}
# CHECK-NEXT:  [[S1:%[0-9]+]]:i64 = CONST_I64 2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[P2]]:i64 = ADD_I64 [[P]], [[S1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[S2:%[0-9]+]]:i64 = CONST_I64 2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[N2]]:i64 = SUB_I64 [[N]], [[S2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[MORE:%[0-9]+]]:i32 = CGT_UN_I64 [[N2]], [[LIM]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_IF %bb.[[LOOP]], [[MORE]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[TAIL]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[12]}}{{.*}}, %bb.{{[12]}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[PT:%[0-9]+]]:i64 = PHI [[DST]], %bb.0, [[P2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[NT:%[0-9]+]]:i64 = PHI [[LEN]], %bb.0, [[N2]], %bb.[[LOOP]]{{$}}
# CHECK-NEXT:  [[REST:%[0-9]+]]:i32 = CONV_I4_I64 [[NT]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 4, [[PT]], [[VAL]], [[REST]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.p, align 4){{$}}
# CHECK-NEXT:  [[SUM:%[0-9]+]]:i32 = ADD_I32 [[K]], [[C]], implicit-def dead $arguments
# CHECK-NEXT:  BR_IF %bb.2, [[C]], implicit-def dead $arguments
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.1:{{$}}
# CHECK-NEXT:  successors: %bb.2{{(\(0x[0-9a-f]+\))?$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[SEVEN:%[0-9]+]]:i32 = CONST_I32 7, implicit-def dead $arguments
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.2:{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[R:%[0-9]+]]:i32 = PHI [[SUM]], %bb.[[TAIL]], [[SEVEN]], %bb.1{{$}}
# CHECK-NEXT:  RETURN [[R]], implicit-def dead $arguments
# CHECK-NEXT:  {{^\.\.\.$}}

# ---- two: two pseudos in one block ----
# The second (N = 31, 2-aligned and volatile, flags 10) is expanded in the
# first one's tail, whose successors are the second loop and tail; the second
# guard's PHIs name that tail.
# CHECK-LABEL: name: two{{$}}
# CHECK:       noPhis: false
# CHECK:       body:
# CHECK-NEXT:  {{^ +}}bb.0:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NEXT:  liveins: $arguments
# CHECK:       [[DST1:%[0-9]+]]:i64 = ARGUMENT_I64 0, implicit $arguments
# CHECK-NEXT:  [[DST2:%[0-9]+]]:i64 = ARGUMENT_I64 1, implicit $arguments
# CHECK-NEXT:  [[VAL:%[0-9]+]]:i32 = ARGUMENT_I32 2, implicit $arguments
# CHECK-NEXT:  [[LEN1:%[0-9]+]]:i64 = ARGUMENT_I64 3, implicit $arguments
# CHECK-NEXT:  [[LEN2:%[0-9]+]]:i64 = ARGUMENT_I64 4, implicit $arguments
# CHECK-NEXT:  [[LIM1:%[0-9]+]]:i64 = CONST_I64 4294967295, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[BIG1:%[0-9]+]]:i32 = CGT_UN_I64 [[LEN1]], [[LIM1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_UNLESS %bb.[[TAIL1:[0-9]+]], [[BIG1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[LOOP1:[0-9]+]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[P:%[0-9]+]]:i64 = PHI [[DST1]], %bb.0, [[P2:%[0-9]+]], %bb.[[LOOP1]]{{$}}
# CHECK-NEXT:  [[N:%[0-9]+]]:i64 = PHI [[LEN1]], %bb.0, [[N2:%[0-9]+]], %bb.[[LOOP1]]{{$}}
# CHECK-NEXT:  [[BLK:%[0-9]+]]:i32 = CONST_I32 -2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 1, [[P]], [[VAL]], [[BLK]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.p, align 1){{$}}
# CHECK-NEXT:  [[S1:%[0-9]+]]:i64 = CONST_I64 2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[P2]]:i64 = ADD_I64 [[P]], [[S1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[S2:%[0-9]+]]:i64 = CONST_I64 2147483648, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[N2]]:i64 = SUB_I64 [[N]], [[S2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[MORE:%[0-9]+]]:i32 = CGT_UN_I64 [[N2]], [[LIM1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_IF %bb.[[LOOP1]], [[MORE]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[TAIL1]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[PT:%[0-9]+]]:i64 = PHI [[DST1]], %bb.0, [[P2]], %bb.[[LOOP1]]{{$}}
# CHECK-NEXT:  [[NT:%[0-9]+]]:i64 = PHI [[LEN1]], %bb.0, [[N2]], %bb.[[LOOP1]]{{$}}
# CHECK-NEXT:  [[REST:%[0-9]+]]:i32 = CONV_I4_I64 [[NT]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 1, [[PT]], [[VAL]], [[REST]], implicit-def {{(dead )?}}$arguments :: (store unknown-size into %ir.p, align 1){{$}}
# CHECK-NEXT:  [[LIM2:%[0-9]+]]:i64 = CONST_I64 2147483647, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[BIG2:%[0-9]+]]:i32 = CGT_UN_I64 [[LEN2]], [[LIM2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_UNLESS %bb.[[TAIL2:[0-9]+]], [[BIG2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[LOOP2:[0-9]+]]:{{$}}
# CHECK-NEXT:  successors: %bb.{{[0-9]+}}{{.*}}, %bb.{{[0-9]+}}{{[^,]*$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       [[Q:%[0-9]+]]:i64 = PHI [[DST2]], %bb.[[TAIL1]], [[Q2:%[0-9]+]], %bb.[[LOOP2]]{{$}}
# CHECK-NEXT:  [[M:%[0-9]+]]:i64 = PHI [[LEN2]], %bb.[[TAIL1]], [[M2:%[0-9]+]], %bb.[[LOOP2]]{{$}}
# CHECK-NEXT:  [[BLK2:%[0-9]+]]:i32 = CONST_I32 1073741824, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 10, [[Q]], [[VAL]], [[BLK2]], implicit-def {{(dead )?}}$arguments :: (volatile store unknown-size into %ir.q, align 2){{$}}
# CHECK-NEXT:  [[T1:%[0-9]+]]:i64 = CONST_I64 1073741824, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[Q2]]:i64 = ADD_I64 [[Q]], [[T1]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[T2:%[0-9]+]]:i64 = CONST_I64 1073741824, implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[M2]]:i64 = SUB_I64 [[M]], [[T2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  [[MORE2:%[0-9]+]]:i32 = CGT_UN_I64 [[M2]], [[LIM2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  BR_IF %bb.[[LOOP2]], [[MORE2]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NOT:   {{^ *[%A-Z]}}
# CHECK:       {{^ +}}bb.[[TAIL2]]:{{$}}
# CHECK-NOT:   successors:
# CHECK:       [[QT:%[0-9]+]]:i64 = PHI [[DST2]], %bb.[[TAIL1]], [[Q2]], %bb.[[LOOP2]]{{$}}
# CHECK-NEXT:  [[MT:%[0-9]+]]:i64 = PHI [[LEN2]], %bb.[[TAIL1]], [[M2]], %bb.[[LOOP2]]{{$}}
# CHECK-NEXT:  [[REST2:%[0-9]+]]:i32 = CONV_I4_I64 [[MT]], implicit-def {{(dead )?}}$arguments{{$}}
# CHECK-NEXT:  INITBLK 10, [[QT]], [[VAL]], [[REST2]], implicit-def {{(dead )?}}$arguments :: (volatile store unknown-size into %ir.q, align 2){{$}}
# CHECK-NEXT:  RETURN implicit-def dead $arguments
# CHECK-NEXT:  {{^\.\.\.$}}

--- |
  source_filename = "memset-guarded-loop.c"

  define void @guard32(ptr %p, i8 %v, i64 %n) {
    ret void
  }

  define void @guard4(ptr %p, i8 %v, i64 %n) {
    ret void
  }

  define i8 @frame_dest(i8 %v, i64 %n) {
    %buf = alloca [64 x i8], align 16
    ret i8 0
  }

  define void @frame_len(ptr %p, i8 %v) {
    %obj = alloca [64 x i8], align 8
    ret void
  }

  define i32 @rest(ptr %p, i8 %v, i64 %n, i32 %c) {
    ret i32 0
  }

  define void @two(ptr %p, ptr %q, i8 %v, i64 %n, i64 %m) {
    ret void
  }
...
---
name:            guard32
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i64, i32, i64 ]
  results: [ ]
body: |
  bb.0:
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 0, implicit $arguments
    %1:i32 = ARGUMENT_I32 1, implicit $arguments
    %2:i64 = ARGUMENT_I64 2, implicit $arguments
    INITBLK_LONG 9, %0, %1, %2, 32, implicit-def dead $arguments :: (volatile store unknown-size into %ir.p, align 1)
    RETURN implicit-def dead $arguments
...
---
name:            guard4
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i64, i32, i64 ]
  results: [ ]
body: |
  bb.0:
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 0, implicit $arguments
    %1:i32 = ARGUMENT_I32 1, implicit $arguments
    %2:i64 = ARGUMENT_I64 2, implicit $arguments
    INITBLK_LONG 0, %0, %1, %2, 4, implicit-def dead $arguments :: (store unknown-size into %ir.p, align 16)
    RETURN implicit-def dead $arguments
...
---
name:            frame_dest
tracksRegLiveness: true
stack:
  - { id: 0, name: buf, size: 64, alignment: 16 }
machineFunctionInfo:
  params:  [ i32, i64 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i64 = ARGUMENT_I64 1, implicit $arguments
    INITBLK_LONG 0, %stack.0.buf, %0, %1, 32, implicit-def dead $arguments :: (store unknown-size into %ir.buf, align 16)
    %2:i32 = LDIND_U1 0, %stack.0.buf, implicit-def dead $arguments :: (load (s8) from %ir.buf, align 16)
    RETURN %2, implicit-def dead $arguments
...
---
name:            frame_len
tracksRegLiveness: true
stack:
  - { id: 0, name: obj, size: 64, alignment: 8 }
machineFunctionInfo:
  params:  [ i64, i32 ]
  results: [ ]
body: |
  bb.0:
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 0, implicit $arguments
    %1:i32 = ARGUMENT_I32 1, implicit $arguments
    INITBLK_LONG 1, %0, %1, %stack.0.obj, 32, implicit-def dead $arguments :: (store unknown-size into %ir.p, align 1)
    RETURN implicit-def dead $arguments
...
---
name:            rest
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i64, i32, i64, i32 ]
  results: [ i32 ]
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 0, implicit $arguments
    %1:i32 = ARGUMENT_I32 1, implicit $arguments
    %2:i64 = ARGUMENT_I64 2, implicit $arguments
    %3:i32 = ARGUMENT_I32 3, implicit $arguments
    %4:i32 = CONST_I32 11, implicit-def dead $arguments
    INITBLK_LONG 4, %0, %1, %2, 32, implicit-def dead $arguments :: (store unknown-size into %ir.p, align 4)
    %5:i32 = ADD_I32 %4, %3, implicit-def dead $arguments
    BR_IF %bb.2, %3, implicit-def dead $arguments

  bb.1:
    successors: %bb.2
    %6:i32 = CONST_I32 7, implicit-def dead $arguments

  bb.2:
    %7:i32 = PHI %5, %bb.0, %6, %bb.1
    RETURN %7, implicit-def dead $arguments
...
---
name:            two
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i64, i64, i32, i64, i64 ]
  results: [ ]
body: |
  bb.0:
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 0, implicit $arguments
    %1:i64 = ARGUMENT_I64 1, implicit $arguments
    %2:i32 = ARGUMENT_I32 2, implicit $arguments
    %3:i64 = ARGUMENT_I64 3, implicit $arguments
    %4:i64 = ARGUMENT_I64 4, implicit $arguments
    INITBLK_LONG 1, %0, %2, %3, 32, implicit-def dead $arguments :: (store unknown-size into %ir.p, align 1)
    INITBLK_LONG 10, %1, %2, %4, 31, implicit-def dead $arguments :: (volatile store unknown-size into %ir.q, align 2)
    RETURN implicit-def dead $arguments
...
