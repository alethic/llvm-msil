---
name:            tee_il
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i32 = COPY_I32 %0, implicit-def dead $arguments
    DROP_I32 %1, implicit-def dead $arguments
    RETURN %1, implicit-def dead $arguments
...
---
name:            tee_local_il
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i32 = COPY_I32 %0, implicit-def dead $arguments
    DROP_I32 %1, implicit-def dead $arguments
    DROP_I32 %0, implicit-def dead $arguments
    RETURN %1, implicit-def dead $arguments
...
---
name:            move_il
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ ]
  results: [ i32 ]
body: |
  bb.0:
    %0:i32 = CONST_I32 42, implicit-def dead $arguments
    dead %1:i64 = CONST_I64 1, implicit-def dead $arguments
    RETURN %0, implicit-def dead $arguments
...
---
name:            tee_classes_il
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i64, f32, f64, f64, f64 ]
  results: [ f64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 0, implicit $arguments
    %1:f32 = ARGUMENT_F32 1, implicit $arguments
    %2:f64 = ARGUMENT_F64 4, implicit $arguments
    %3:i64 = COPY_I64 %0, implicit-def dead $arguments
    DROP_I64 %3, implicit-def dead $arguments
    %4:f32 = COPY_F32 %1, implicit-def dead $arguments
    DROP_F32 %4, implicit-def dead $arguments
    %5:i64 = COPY_I64 %0, implicit-def dead $arguments
    DROP_I64 %5, implicit-def dead $arguments
    %6:f32 = COPY_F32 %1, implicit-def dead $arguments
    DROP_F32 %6, implicit-def dead $arguments
    %7:f64 = COPY_F64 %2, implicit-def dead $arguments
    DROP_F64 %7, implicit-def dead $arguments
    DROP_I64 %3, implicit-def dead $arguments
    DROP_F32 %4, implicit-def dead $arguments
    DROP_I64 %5, implicit-def dead $arguments
    DROP_F32 %6, implicit-def dead $arguments
    RETURN %7, implicit-def dead $arguments
...

#--- tee-wide.py
# Prints the machine function of tee_wide_il (IR and checks in il.mir), which
# the RUN lines append to il.mir: argument 256 is copied 258 times, and each
# copy %1 to %258 is used right after its def and again at the end (%258 by
# the RETURN).
import sys

n = 257
dead = ", implicit-def dead $arguments"
lines = [
    "---",
    "name:            tee_wide_il",
    "tracksRegLiveness: true",
    "machineFunctionInfo:",
    "  params:  [ " + ", ".join(["f64"] * n) + " ]",
    "  results: [ f64 ]",
    "body: |",
    "  bb.0:",
    "    liveins: $arguments",
    "    %0:f64 = ARGUMENT_F64 256, implicit $arguments",
]
for v in range(1, n + 2):
    lines.append("    %%%d:f64 = COPY_F64 %%0%s" % (v, dead))
    lines.append("    DROP_F64 %%%d%s" % (v, dead))
for v in range(1, n + 1):
    lines.append("    DROP_F64 %%%d%s" % (v, dead))
lines.append("    RETURN %%%d%s" % (n + 1, dead))
lines.append("...")
sys.stdout.reconfigure(newline="\n")
print("\n".join(lines))
