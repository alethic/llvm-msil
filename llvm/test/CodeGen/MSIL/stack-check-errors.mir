# RUN:   | FileCheck %s --check-prefix=END
# END: LLVM ERROR: MSIL stack check failed in 'block_end': evaluation stack not empty at end of {{.+}}

# The well-formed control, and the inputs themselves: the machine verifier
# accepts every input, so the failures above come from MSILStackCheck and not
# from malformed MIR.
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=msil-explicit-locals,msil-stack-check \
# RUN:   -verify-machineinstrs %t/balanced.mir -o - | FileCheck %s --check-prefix=OK
# RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -run-pass=msil-explicit-locals,msil-stack-check \
# RUN:   -verify-machineinstrs %t/balanced.mir -o - | FileCheck %s --check-prefix=OK
# OK-LABEL: name: balanced{{$}}
# OK:       maxStack: 1{{$}}
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/multi-push.mir -o /dev/null
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/underflow.mir -o /dev/null
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/order.mir -o /dev/null
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/ret-extra.mir -o /dev/null
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/ret-missing.mir -o /dev/null
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/ret-two.mir -o /dev/null
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/ret-ops.mir -o /dev/null
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/localloc-depth.mir -o /dev/null
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/block-end.mir -o /dev/null

#--- multi-push.mir
# A call with two results: both are stored to locals, but the call itself
# pushes two values.
---
name:            multi_push
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ ]
  results: [ ]
body: |
  bb.0:
    %0:i32, %1:i32 = CALL &msil_pair, implicit-def dead $arguments
    DROP_I32 %0, implicit-def dead $arguments
    DROP_I32 %1, implicit-def dead $arguments
    RETURN implicit-def dead $arguments
...

#--- underflow.mir
# The value of a KILL that defines a register is stored to a local after the
# KILL, but the KILL pushes nothing: the store pops an empty stack.
---
name:            underflow
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ ]
  results: [ i32 ]
body: |
  bb.0:
    %0:i32 = KILL
    RETURN %0, implicit-def dead $arguments
...

#--- order.mir
# The argument is read for the KILL and stays on the stack; the KILL's result
# is stored to a local after it, so the store finds the argument, not the
# KILL's result, on top of the stack.
---
name:            order
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i32 = KILL %0
    RETURN %1, implicit-def dead $arguments
...

#--- ret-extra.mir
# A void function returns a value.
---
name:            ret_extra
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    RETURN %0, implicit-def dead $arguments
...

#--- ret-missing.mir
# A function with an int32 result returns without a value.
---
name:            ret_missing
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ ]
  results: [ i32 ]
body: |
  bb.0:
    RETURN implicit-def dead $arguments
...

#--- ret-two.mir
# A function with one result returns two values.
---
name:            ret_two
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32, i32 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i32 = ARGUMENT_I32 1, implicit $arguments
    RETURN %0, %1, implicit-def dead $arguments
...

#--- ret-ops.mir
# The argument read for the KILL stays on the stack, so the depth at the
# RETURN equals the number of results, but the RETURN names no value.
---
name:            ret_ops
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    KILL %0
    RETURN implicit-def dead $arguments
...

#--- localloc-depth.mir
# The argument read for the KILL stays on the stack, under the size of the
# localloc.
---
name:            localloc_depth
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ i64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    KILL %0
    %1:i64 = LOCALLOC %0, implicit-def dead $arguments
    RETURN %1, implicit-def dead $arguments
...

#--- block-end.mir
# The argument read for the KILL is still on the stack when the first block
# branches to the second.
---
name:            block_end
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ ]
body: |
  bb.0:
    successors: %bb.1
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    KILL %0
    BR %bb.1, implicit-def dead $arguments

  bb.1:
    RETURN implicit-def dead $arguments
...

#--- balanced.mir
---
name:            balanced
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ i64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i64 = LOCALLOC %0, implicit-def dead $arguments
    RETURN %1, implicit-def dead $arguments
...
