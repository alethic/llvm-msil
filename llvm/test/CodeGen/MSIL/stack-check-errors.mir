# RUN:   | FileCheck %s --check-prefix=LOCALLOC
# LOCALLOC: LLVM ERROR: MSIL stack check failed in 'localloc_depth': 'localloc' with a non-empty evaluation stack: {{.*}}LOCALLOC

# RUN: not --crash llc -mtriple=x86_64-unknown-linux-gnu-msil %{check} %t/block-end.mir 2>&1 \
