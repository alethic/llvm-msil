; The module flags msil-ld sets on the merged LTO module (ImplementationPlan.md
; 5.9.13, M14; the section 12 row of 2026-10-21 amending D28):
; - msil-assembly-name (an MDString, behaviour Override) names the assembly
;   when -msil-assembly-name is not given, and the source_filename stem names
;   it only without both (msil-ld's merged module is named 'ld-temp.o'); the
;   name gets D11's identifier escapes, and a non-ASCII name the byte-order
;   mark, as an option's name does (assembly-name.ll);
; - msil-lto (i32 1, Override) changes only the text of an undefined
;   function that is no Phase-1 import: 'undefined symbol: <name>', the first
;   line of msil-ld's own report (5.9.6, 5.9.14), instead of Phase 1's
;   'undefined function ... Phase 1 has no linker'. D14 imports and weak
;   references are unaffected, and so is all other IL; an msil-lto flag
;   whose value is no integer counts as absent.
; Without the flags the IL is unchanged; on both triples.

; RUN: split-file %s %t

; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/name.ll \
; RUN:   | FileCheck %s --check-prefix=FLAG
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/name.ll \
; RUN:   | FileCheck %s --check-prefix=FLAG
; FLAG: // source_filename = "ld-temp.o"
; FLAG-NOT: .assembly 'ld-temp'
; FLAG: {{^}}.assembly 'prog' { .ver 0:0:0:0 }{{$}}
; FLAG-NOT: .assembly '

; The option wins over the flag. (Its name is no lit tool name: lit would
; replace a tool name after '=' with the tool's path.)
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -msil-assembly-name=fromcli -verify-machineinstrs < %t/name.ll \
; RUN:   | FileCheck %s --check-prefix=OPT
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -msil-assembly-name=fromcli -verify-machineinstrs < %t/name.ll \
; RUN:   | FileCheck %s --check-prefix=OPT
; OPT-NOT: .assembly 'prog'
; OPT-NOT: .assembly 'ld-temp'
; OPT: {{^}}.assembly 'fromcli' { .ver 0:0:0:0 }{{$}}
; OPT-NOT: .assembly '

; Escapes and the byte-order mark apply to a flag's name.
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/quote.ll \
; RUN:   | FileCheck %s --check-prefix=QUOTE
; QUOTE: {{^}}.assembly 'it\'s a\134b' { .ver 0:0:0:0 }{{$}}
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/utf8.ll \
; RUN:   | FileCheck %s --check-prefix=BOM
; BOM-NOT: {{.}}
; BOM: {{^}}{{\xEF\xBB\xBF}}// MSIL module generated by LLVM{{$}}
; BOM: {{^}}.assembly 'caf{{\xC3\xA9}}' { .ver 0:0:0:0 }{{$}}

; Every form assembles.
; RUN: %if ilasm %{ llc -mtriple=x86_64-pc-windows-msvc-msil < %t/name.ll -o %t/name.il \
; RUN:   && %ilasm-verify -output=%t/name.dll %t/name.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil < %t/quote.ll -o %t/quote.il \
; RUN:   && %ilasm-verify -output=%t/quote.dll %t/quote.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-pc-windows-msvc-msil < %t/utf8.ll -o %t/utf8.il \
; RUN:   && %ilasm-verify -output=%t/utf8.dll %t/utf8.il %}

; msil-lto: the undefined function's text, at -O0 and -O2, on both triples.
; DEFINE: %{err} = FileCheck %s --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/lto-undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=LTO-UNDEF
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/lto-undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=LTO-UNDEF
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -O0 -verify-machineinstrs < %t/lto-undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=LTO-UNDEF
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -O0 -verify-machineinstrs < %t/lto-undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=LTO-UNDEF
; LTO-UNDEF: {{^}}error: {{.*}}undefined symbol: ext{{$}}
; LTO-UNDEF-NOT: Phase 1 has no linker
; LTO-UNDEF-NOT: undefined symbol: puts
; LTO-UNDEF-NOT: undefined symbol: maybe

; The same module without the flag keeps Phase 1's text.
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=UNDEF
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=UNDEF
; UNDEF: {{^}}error: {{.*}}undefined function 'ext' is not defined in this module and is not a Phase-1 import (puts, putchar, the C math library, msil-import-module); Phase 1 has no linker{{$}}
; UNDEF-NOT: undefined symbol

; Everything else is the same IL with and without msil-lto: D14 imports, the
; weak reference's trap stub, data, the entry point.
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/lto-ok.ll -o %t/lto-ok.lnx.il 2>&1 \
; RUN:   | count 0
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/ok.ll -o %t/ok.lnx.il 2>&1 | count 0
; RUN: diff %t/ok.lnx.il %t/lto-ok.lnx.il
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -O0 -verify-machineinstrs < %t/lto-ok.ll -o %t/lto-ok.win.il 2>&1 \
; RUN:   | count 0
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -O0 -verify-machineinstrs < %t/ok.ll -o %t/ok.win.il 2>&1 | count 0
; RUN: diff %t/ok.win.il %t/lto-ok.win.il
; RUN: FileCheck %s --check-prefixes=OK,OK-LNX --input-file=%t/lto-ok.lnx.il
; RUN: FileCheck %s --check-prefixes=OK,OK-WIN --input-file=%t/lto-ok.win.il
; OK: {{^}}.assembly 'ok' { .ver 0:0:0:0 }{{$}}
; OK: {{^}}.method {{.*}}'<msil>undef_maybe'(){{.*}}
; OK-LNX: pinvokeimpl("libc" cdecl) int32 'puts'(native int)
; OK-WIN: pinvokeimpl("ucrtbase" cdecl) int32 'puts'(native int)
; OK: .entrypoint

; A malformed msil-lto flag counts as absent: an MDString ("yes") or a value
; that is no integer (float 1.0) gives no crash, the same IL as the module
; without the flag, and Phase 1's undefined-function text.
