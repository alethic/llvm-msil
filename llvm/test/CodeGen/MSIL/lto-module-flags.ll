;--- name.ll
source_filename = "ld-temp.o"

define i32 @main() {
  ret i32 0
}

!llvm.module.flags = !{!0, !1}
!0 = !{i32 4, !"msil-assembly-name", !"prog"}
!1 = !{i32 4, !"msil-lto", i32 1}

;--- quote.ll
source_filename = "ld-temp.o"

!llvm.module.flags = !{!0}
!0 = !{i32 4, !"msil-assembly-name", !"it's a\5Cb"}

;--- utf8.ll
source_filename = "ld-temp.o"

!llvm.module.flags = !{!0}
!0 = !{i32 4, !"msil-assembly-name", !"caf\C3\A9"}

;--- lto-undef.ll
source_filename = "ld-temp.o"

@msg = private constant [3 x i8] c"hi\00"

define i32 @main() {
  %p = call i32 @puts(ptr @msg)
  %w = call i32 @maybe()
  %r = call i32 @ext(i32 1)
  ret i32 %r
}

declare i32 @puts(ptr)
declare extern_weak i32 @maybe()
declare i32 @ext(i32)

!llvm.module.flags = !{!0}
!0 = !{i32 4, !"msil-lto", i32 1}

;--- undef.ll
source_filename = "ld-temp.o"

define i32 @main() {
  %r = call i32 @ext(i32 1)
  ret i32 %r
}

declare i32 @ext(i32)

;--- lto-ok.ll
source_filename = "ok.c"

@msg = private constant [3 x i8] c"hi\00"
@counter = global i32 3

define i32 @main() {
  %p = call i32 @puts(ptr @msg)
  %w = call i32 @maybe()
  %c = load i32, ptr @counter
  %r = add i32 %w, %c
  ret i32 %r
}

declare i32 @puts(ptr)
declare extern_weak i32 @maybe()

!llvm.module.flags = !{!0}
!0 = !{i32 4, !"msil-lto", i32 1}

;--- ok.ll
source_filename = "ok.c"

@msg = private constant [3 x i8] c"hi\00"
@counter = global i32 3

define i32 @main() {
  %p = call i32 @puts(ptr @msg)
  %w = call i32 @maybe()
  %c = load i32, ptr @counter
  %r = add i32 %w, %c
  ret i32 %r
}

declare i32 @puts(ptr)
declare extern_weak i32 @maybe()

;--- str-ok.ll
