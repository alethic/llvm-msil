; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -O0 -verify-machineinstrs < %t/str-ok.ll -o %t/str-ok.win.il 2>&1 \
; RUN:   | count 0
; RUN: diff %t/ok.win.il %t/str-ok.win.il
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -O0 -verify-machineinstrs < %t/float-ok.ll -o %t/float-ok.win.il 2>&1 \
; RUN:   | count 0
; RUN: diff %t/ok.win.il %t/float-ok.win.il
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/str-undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=UNDEF
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/str-undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=UNDEF
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/float-undef.ll -o /dev/null 2>&1 \
; RUN:   | %{err} --check-prefix=UNDEF
