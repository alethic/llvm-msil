;--- utf8.ll
; The byte order mark is the first thing in the file, before the header.
; UTF8:      {{^}}﻿// MSIL module generated by LLVM{{$}}
; UTF8:      {{^}}.method public static int32 'café'() cil managed{{$}}
; UTF8:      {{^}}} // end of method 'café'{{$}}
; UTF8:      {{^}}.method public static float64 'π'() cil managed{{$}}
; UTF8:      {{^}}} // end of method 'π'{{$}}
source_filename = "utf8.c"

define i32 @"caf\C3\A9"() {
  ret i32 1
}

define double @"\CF\80"() {
  ret double 0x400921FB54442D18
}
