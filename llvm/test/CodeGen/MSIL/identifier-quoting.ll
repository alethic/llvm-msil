; Identifiers (ImplementationPlan.md decision D11; recon asmprinter.md 4): every
; method name is the IR name, single-quoted by MSIL::printQuotedName, never the
; Mangler's symbol and never left bare. Quoting is what makes ILAsm keywords and
; instruction names (add, ret, value, int32, string, ...), C++ and MSVC names
; ('?foo@@YAHXZ'), dots, '$', spaces and names starting with a digit usable;
; a quote is written \', a backslash \134 (ilasm drops "\\"), control bytes
; as three-digit octal escapes, and a leading \01 (LLVM's 'do not mangle'
; marker) is dropped. The method header and its closing comment spell the
; name the same way. A non-ASCII name is written as raw UTF-8, and the file
; then starts with a UTF-8 byte order mark, without which ilasm reads it in
; the ANSI code page. The main check is that the output assembles.

; RUN: split-file %s %t
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -asm-verbose=false -verify-machineinstrs < %t/names.ll \
; RUN:   | FileCheck %s
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -asm-verbose=false -verify-machineinstrs < %t/names.ll \
; RUN:   | FileCheck %s
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/names.ll \
; RUN:   | FileCheck %s --check-prefix=NOBOM
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/utf8.ll \
; RUN:   | FileCheck %s --check-prefix=UTF8 --strict-whitespace
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/utf8.ll \
; RUN:   | FileCheck %s --check-prefix=UTF8 --strict-whitespace
; RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil < %t/names.ll -o %t/names.il \
; RUN:   && %ilasm-verify -output=%t/names.dll %t/names.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-pc-windows-msvc-msil < %t/utf8.ll -o %t/utf8.il \
; RUN:   && %ilasm-verify -output=%t/utf8.dll %t/utf8.il %}

; An all-ASCII module has no byte order mark.
; NOBOM-NOT: {{.}}
; NOBOM:     {{^}}// MSIL module generated by LLVM{{$}}

;--- names.ll
source_filename = "names.c"

