; A module without functions or globals is a complete ILAsm module made of
; exactly the header of the output contract (ImplementationPlan.md 5.1): two
; comment lines with the source file name and the triple, the mscorlib
; reference (decision D10) and the assembly named after the source-file stem
; (decision D28), with no UTF-8 BOM for an all-ASCII module (decision D11). The
; same holds for copies of the modules clang emits for an empty translation
; unit on the Windows MSVC triple (which clang versions, as
; x86_64-pc-windows-msvc19.33.0-msil), the Linux triple and the MinGW triple,
; whose module flags, llvm.ident and (on Windows) NoDebug compile unit must not
; leak '.ident', CodeView '.section .debug$S' or any other GNU directive.
; clang/test/CodeGen/MSIL/empty-tu.c checks clang's own output, but clang's
; tests have no ilasm, so the copies here are what proves that the output for
; each of these triples assembles (M2 exit criterion). --addrsig asks for an
; address-significance table, which the TargetMachine turns off (decision D8).

; RUN: split-file %s %t

; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/empty.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,LNX,PROG --strict-whitespace
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/empty.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,WIN,PROG --strict-whitespace
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -O0 -verify-machineinstrs < %t/empty.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,WIN,PROG --strict-whitespace
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -O3 -verify-machineinstrs < %t/empty.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,LNX,PROG --strict-whitespace
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil --addrsig -verify-machineinstrs < %t/empty.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,LNX,PROG --strict-whitespace
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil --addrsig -verify-machineinstrs < %t/empty.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,WIN,PROG --strict-whitespace

; RUN: llc -mtriple=x86_64-pc-windows-msvc19.33.0-msil -verify-machineinstrs < %t/clang-msvc.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,WINV,EMPTYTU --strict-whitespace
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/clang-linux.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,LNX,EMPTYTU --strict-whitespace
; RUN: llc -mtriple=x86_64-w64-windows-gnu-msil -verify-machineinstrs < %t/clang-mingw.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,MINGW,EMPTYTU --strict-whitespace

; Nothing precedes the first header line (in particular no BOM), and nothing
; but '//' comments and blank lines follows the assembly declaration.
; CHECK-NOT: {{.}}
; CHECK:        {{^}}// MSIL module generated by LLVM{{$}}
; PROG-NEXT:    {{^}}// source_filename = "prog.c"{{$}}
; EMPTYTU-NEXT: {{^}}// source_filename = "empty.c"{{$}}
; LNX-NEXT:     {{^}}// target triple   = "x86_64-unknown-linux-gnu-msil"{{$}}
; WIN-NEXT:     {{^}}// target triple   = "x86_64-pc-windows-msvc-msil"{{$}}
; WINV-NEXT:    {{^}}// target triple   = "x86_64-pc-windows-msvc19.33.0-msil"{{$}}
; MINGW-NEXT:   {{^}}// target triple   = "x86_64-w64-windows-gnu-msil"{{$}}
; CHECK-NEXT:   {{^}}.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }{{$}}
; PROG-NEXT:    {{^}}.assembly 'prog' { .ver 0:0:0:0 }{{$}}
; EMPTYTU-NEXT: {{^}}.assembly 'empty' { .ver 0:0:0:0 }{{$}}
; CHECK-NOT: {{^[[:space:]]*([^/[:space:]]|/([^/]|$))}}

; RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil < %t/empty.ll -o %t/empty.il \
; RUN:   && %ilasm-verify -output=%t/empty.dll %t/empty.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-pc-windows-msvc19.33.0-msil < %t/clang-msvc.ll -o %t/clang-msvc.il \
; RUN:   && %ilasm-verify -output=%t/clang-msvc.dll %t/clang-msvc.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil < %t/clang-linux.ll -o %t/clang-linux.il \
; RUN:   && %ilasm-verify -output=%t/clang-linux.dll %t/clang-linux.il %}
; RUN: %if ilasm %{ llc -mtriple=x86_64-w64-windows-gnu-msil < %t/clang-mingw.ll -o %t/clang-mingw.il \
; RUN:   && %ilasm-verify -output=%t/clang-mingw.dll %t/clang-mingw.il %}

;--- empty.ll
source_filename = "prog.c"

;--- clang-msvc.ll
; What 'clang --target=x86_64-pc-windows-msvc-msil -S -emit-llvm' produces for
; an empty file, without the datalayout and triple lines.
source_filename = "empty.c"

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2, !3, !4, !5}
!llvm.ident = !{!6}

!0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "clang", isOptimized: false, runtimeVersion: 0, emissionKind: NoDebug, splitDebugInlining: false, nameTableKind: None)
!1 = !DIFile(filename: "empty.c", directory: "/src")
!2 = !{i32 2, !"Debug Info Version", i32 3}
!3 = !{i32 8, !"PIC Level", i32 2}
!4 = !{i32 7, !"uwtable", i32 2}
!5 = !{i32 1, !"MaxTLSAlign", i32 65536}
!6 = !{!"clang"}

;--- clang-linux.ll
; The same for x86_64-unknown-linux-gnu-msil.
source_filename = "empty.c"

!llvm.module.flags = !{!0, !1, !2, !3}
!llvm.ident = !{!4}

!0 = !{i32 8, !"PIC Level", i32 2}
!1 = !{i32 7, !"PIE Level", i32 2}
!2 = !{i32 7, !"uwtable", i32 2}
!3 = !{i32 7, !"frame-pointer", i32 2}
!4 = !{!"clang"}

;--- clang-mingw.ll
; The same for x86_64-w64-windows-gnu-msil (the MinGW driver also passes
; -exception-model=seh, which leaves no trace in the IR of an empty file).
source_filename = "empty.c"

!llvm.dbg.cu = !{!0}
!llvm.module.flags = !{!2, !3, !4, !5}
!llvm.ident = !{!6}

!0 = distinct !DICompileUnit(language: DW_LANG_C11, file: !1, producer: "clang", isOptimized: false, runtimeVersion: 0, emissionKind: NoDebug, splitDebugInlining: false, nameTableKind: None)
!1 = !DIFile(filename: "empty.c", directory: "/src")
!2 = !{i32 2, !"Debug Info Version", i32 3}
!3 = !{i32 8, !"PIC Level", i32 2}
!4 = !{i32 7, !"uwtable", i32 2}
!5 = !{i32 1, !"MaxTLSAlign", i32 65536}
!6 = !{!"clang"}
