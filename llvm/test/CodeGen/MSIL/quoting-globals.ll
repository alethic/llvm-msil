; Names of global variables (ImplementationPlan.md decision D11, M8.c; recon
; asmprinter.md 4 and 10 e2/e6): the address field of a global is named after
; its IR name (a leading \01 dropped, never the Mangler's name), and the same
; single-quoted spelling (MSIL::printQuotedName: \' for a quote, \134 for a
; backslash, three-digit octal for control bytes, raw UTF-8) is used by the
; field declaration, by 'ldsfld' in code, by 'stsfld' in the .cctor and by a
; relocation to the global. Quoting is what makes ILAsm keywords and
; instruction names ('add', 'int32'), MSVC names ('?g@@3HA'), dots, '$',
; spaces and names starting with '.L' usable as field names; an unnamed global
; gets the name the target machine gives its symbol. A non-ASCII name is
; written as raw UTF-8 and the file then starts with a byte order mark; an
; all-ASCII module has none. The main check is that every output assembles.

; RUN: split-file %s %t
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -asm-verbose=false -verify-machineinstrs < %t/names.ll \
; RUN:   -o %t/names.lnx.il 2>&1 | count 0
; RUN: FileCheck %s --implicit-check-not=".field " --input-file=%t/names.lnx.il
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -asm-verbose=false -verify-machineinstrs < %t/names.ll \
; RUN:   -o %t/names.win.il 2>&1 | count 0
; RUN: FileCheck %s --implicit-check-not=".field " --input-file=%t/names.win.il
; RUN: FileCheck %s --check-prefix=NOBOM --input-file=%t/names.win.il
; RUN: %if ilasm %{ %ilasm-verify -output=%t/names.lnx.dll %t/names.lnx.il %}
; RUN: %if ilasm %{ %ilasm-verify -output=%t/names.win.dll %t/names.win.il %}
; RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -asm-verbose=false -verify-machineinstrs < %t/utf8.ll \
; RUN:   -o %t/utf8.lnx.il 2>&1 | count 0
; RUN: FileCheck %s --check-prefix=UTF8 --strict-whitespace --input-file=%t/utf8.lnx.il
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -asm-verbose=false -verify-machineinstrs < %t/utf8.ll \
; RUN:   -o %t/utf8.win.il 2>&1 | count 0
; RUN: FileCheck %s --check-prefix=UTF8 --strict-whitespace --input-file=%t/utf8.win.il
; RUN: %if ilasm %{ %ilasm-verify -output=%t/utf8.lnx.dll %t/utf8.lnx.il %}
; RUN: %if ilasm %{ %ilasm-verify -output=%t/utf8.win.dll %t/utf8.win.il %}

