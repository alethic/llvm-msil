;--- names.ll
; Eleven int32 globals at +0 to +40 (values 1 to 11) and a pointer to 'it''s'
; at +48.
source_filename = "quoting-globals.c"

@add = global i32 1, align 4
@"it's" = global i32 2, align 4
@"back\5Cslash" = global i32 3, align 4
@"two words" = global i32 4, align 4
@"tab\09name" = global i32 5, align 4
@"\01mangled" = global i32 6, align 4
@.L.local = internal global i32 7, align 4
@"a.b$c" = global i32 8, align 4
@"?g@@3HA" = global i32 9, align 4
@int32 = global i32 10, align 4
@0 = global i32 11, align 4
@"ref'q" = global ptr @"it's", align 8

; CHECK-LABEL: {{^}}.method public static int32 'read_all'() cil managed{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'add'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'it\'s'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'back\134slash'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'two words'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'tab\011name'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'mangled'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int '.L.local'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'a.b$c'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int '?g@@3HA'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'int32'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int '{{[^']*}}__unnamed_{{[0-9]+}}'{{$}}
; CHECK-DAG:   {{^}}  ldsfld native int 'ref\'q'{{$}}
; CHECK:       {{^}}} // end of method 'read_all'{{$}}
define i32 @read_all() {
  %v1 = load i32, ptr @add, align 4
  %v2 = load i32, ptr @"it's", align 4
  %v3 = load i32, ptr @"back\5Cslash", align 4
  %v4 = load i32, ptr @"two words", align 4
  %v5 = load i32, ptr @"tab\09name", align 4
  %v6 = load i32, ptr @"\01mangled", align 4
  %v7 = load i32, ptr @.L.local, align 4
  %v8 = load i32, ptr @"a.b$c", align 4
  %v9 = load i32, ptr @"?g@@3HA", align 4
  %v10 = load i32, ptr @int32, align 4
  %v11 = load i32, ptr @0, align 4
  %p = load ptr, ptr @"ref'q", align 8
  %v12 = load i32, ptr %p, align 4
  %s1 = add i32 %v1, %v2
  %s2 = add i32 %s1, %v3
  %s3 = add i32 %s2, %v4
  %s4 = add i32 %s3, %v5
  %s5 = add i32 %s4, %v6
  %s6 = add i32 %s5, %v7
  %s7 = add i32 %s6, %v8
  %s8 = add i32 %s7, %v9
  %s9 = add i32 %s8, %v10
  %s10 = add i32 %s9, %v11
  %s11 = add i32 %s10, %v12
  ret i32 %s11
}

