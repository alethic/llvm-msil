;--- reserved-data.ll
; int msil_data __asm__("<msil>data") = 5;
source_filename = "reserved-data.c"

; RES-DATA: {{^}}error: {{.*}}global variable @"<msil>data" has the reserved IL name '<msil>data'{{$}}

@"<msil>data" = global i32 5, align 4

define i32 @main() {
  %v = load i32, ptr @"<msil>data", align 4
  ret i32 %v
}

;--- reserved-cctor.ll
; void init(void) __asm__(".cctor"), in a module with data.
source_filename = "reserved-cctor.c"

; RES-CCTOR: {{^}}error: {{.*}}function @.cctor has the reserved IL name '.cctor'{{$}}

@g = global i32 5, align 4

define void @".cctor"() {
  store i32 7, ptr @g, align 4
  ret void
}

define i32 @main() {
  call void @".cctor"()
  %v = load i32, ptr @g, align 4
  ret i32 %v
}

;--- reserved-ctor.ll
; int make(int) __asm__(".ctor");
source_filename = "reserved-ctor.c"

; RES-CTOR: {{^}}error: {{.*}}function @.ctor has the reserved IL name '.ctor'{{$}}

define i32 @".ctor"(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

define i32 @main() {
  %r = call i32 @".ctor"(i32 41)
  ret i32 %r
}

;--- reserved-import.ll
; int make(int) __asm__(".ctor"), imported from "mylib" (the same RES-CTOR
; error).
source_filename = "reserved-import.c"

declare i32 @".ctor"(i32) #0

define i32 @main() {
  %r = call i32 @".ctor"(i32 41)
  ret i32 %r
}

attributes #0 = { "msil-import-module"="mylib" }

;--- dup-global.ll
; int foo = 1; int foo2 __asm__("foo") = 2;
source_filename = "dup-global.c"

; DUP-GLOBAL: {{^}}error: {{.*}}global variable @"\01foo" has the same IL name 'foo' as @foo{{$}}

@foo = global i32 1, align 4
@"\01foo" = global i32 2, align 4

define i32 @main() {
  %a = load i32, ptr @foo, align 4
  %b = load i32, ptr @"\01foo", align 4
  %r = add i32 %a, %b
  ret i32 %r
}

;--- dup-unnamed.ll
; The only unnamed global, @0, is '__unnamed_1', the name of the next one.
source_filename = "dup-unnamed.c"

; DUP-UNNAMED: {{^}}error: {{.*}}global variable @__unnamed_1 has the same IL name '__unnamed_1' as @0{{$}}

@0 = global i32 7, align 4
@__unnamed_1 = global i32 8, align 4

define i32 @main() {
  %a = load i32, ptr @0, align 4
  %b = load i32, ptr @__unnamed_1, align 4
  %r = add i32 %a, %b
  ret i32 %r
}

;--- dup-func.ll
; int f(int x) { return x; } int f2(int x) __asm__("f"); int f2(int x) { return x + 1; }
source_filename = "dup-func.c"

; DUP-FUNC: {{^}}error: {{.*}}function @"\01f" has the same IL name 'f' and signature as @f{{$}}

define i32 @f(i32 %x) {
  ret i32 %x
}

define i32 @"\01f"(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

define i32 @main() {
  %a = call i32 @f(i32 1)
  %b = call i32 @"\01f"(i32 2)
  %r = add i32 %a, %b
  ret i32 %r
}

;--- msil-names.ll
; A global '<msil>image' and a function '<msil>Main' with no arguments: valid
; names, since no generated member has the same name and kind (and signature).
source_filename = "msil-names.c"

; MSILNAMES:      {{^}}.method public static int32 '<msil>Main'() cil managed{{$}}
; MSILNAMES:      {{^}}.method public static int32 'main'() cil managed{{$}}
; MSILNAMES-DAG:  {{^}}  call int32 '<msil>Main'(){{$}}
; MSILNAMES-DAG:  {{^}}  ldsfld native int '<msil>image'{{$}}
; MSILNAMES:      {{^}}} // end of method 'main'{{$}}
; MSILNAMES:      {{^}}.field private static valuetype '<msil>image_t' '<msil>image' at '<msil>image_d'{{$}}
; MSILNAMES:      {{^}}.field private static initonly native int '<msil>data'{{$}}
; MSILNAMES:      {{^}}.field public static initonly native int '<msil>image'{{( |$)}}
; MSILNAMES:      {{^}}  ldsflda valuetype '<msil>image_t' '<msil>image'{{( |$)}}
; MSILNAMES:      {{^}}  stsfld native int '<msil>image'{{( |$)}}
; MSILNAMES:      {{^}}.method private hidebysig static int32 '<msil>Main'(string[] args) cil managed{{$}}
; MSILNAMES-NEXT: {{^\{$}}
; MSILNAMES-NEXT: {{^}}  .entrypoint{{$}}
; MSILNAMES-NEXT: {{^}}  .maxstack 1{{$}}
; MSILNAMES-NEXT: {{^}}  call int32 'main'(){{$}}

@"<msil>image" = global i32 3, align 4

define i32 @"<msil>Main"() {
  ret i32 3
}

define i32 @main() {
  %a = call i32 @"<msil>Main"()
  %b = load i32, ptr @"<msil>image", align 4
  %r = add i32 %a, %b
  ret i32 %r
}
