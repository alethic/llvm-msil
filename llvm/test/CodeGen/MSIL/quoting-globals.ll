; The IL identifier limit (D11 and plan 5.1 amended, section 12 row of
; 2026-10-13: field names printed from M8 on keep the limit): a global whose
; name has 1023 bytes is an ordinary global and the module assembles; one of
; 1024 bytes is one clean error that names the global by its IR name and
; states its length and the limit (1023 bytes), with exit code 1 and no crash.
; genglobals.py N prints a global named with N 'g's, a global 'ok' and a
; function that reads 'ok'.
; RUN: %python %t/genglobals.py 1023 > %t/long-ok.ll
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -asm-verbose=false -verify-machineinstrs < %t/long-ok.ll \
; RUN:   -o %t/long-ok.il 2>&1 | count 0
; RUN: FileCheck %s --check-prefix=LONG-OK --input-file=%t/long-ok.il
; RUN: %if ilasm %{ %ilasm-verify -output=%t/long-ok.dll %t/long-ok.il %}
; RUN: %python %t/genglobals.py 1024 > %t/long-bad.ll
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/long-bad.ll -o /dev/null 2>&1 \
; RUN:   | FileCheck %s --check-prefix=LONG-BAD --implicit-check-not="LLVM ERROR" \
; RUN:       --implicit-check-not="PLEASE submit" --implicit-check-not=error:
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/long-bad.ll -o /dev/null 2>&1 \
; RUN:   | FileCheck %s --check-prefix=LONG-BAD --implicit-check-not="LLVM ERROR" \
; RUN:       --implicit-check-not="PLEASE submit" --implicit-check-not=error:

; LONG-OK:   {{^}}.field public static initonly native int '{{g+}}'{{( |$)}}
; LONG-OK:   {{^}}.field public static initonly native int 'ok'{{( |$)}}
; LONG-OK:   {{^}}  stsfld native int '{{g+}}'{{( |$)}}
; LONG-BAD:  {{^}}error: {{.*}}global variable @{{g+}}: identifier of 1024 bytes is longer than the 1023 bytes ilasm accepts{{$}}

; Reserved and duplicate IL names (plan section 12, 'M8.a and M8.c amended (IL
; names of `<Module>` members)' part (3)). A name that a member the module
; generates already has, or that two definitions share, would print IL that
; ilasm rejects (a duplicate field or method) or that the runtime cannot load
; (a second '.cctor', a static '.ctor' in <Module>). llc reports it instead:
; one error, which names the IR value as the IR prints it (printAsOperand:
; @.cctor, @"\01foo", @0) and the IL name, exit code 1, no crash. One part per
; case:
; - reserved-data.ll: a global variable named '<msil>data' (the base field of
;   the data segment);
; - reserved-cctor.ll: a function named '.cctor' in a module with data (the
;   module initializer); reserved-ctor.ll: a function named '.ctor';
;   reserved-import.ll: an import named '.ctor', which would get a P/Invoke
;   declaration of that name;
; - dup-global.ll: @foo and @"\01foo", whose IL names are both 'foo';
;   dup-unnamed.ll: the unnamed @0, whose IL name is '__unnamed_1' (the only
;   unnamed global), and @__unnamed_1; the later definition in module order
;   is named first, the earlier one last;
; - dup-func.ll: @f and @"\01f", both 'f' with the CIL signature
;   int32(int32).
; Only the generated names that collide are reserved: in msil-names.ll a
; global named '<msil>image' (a public address field, as for any global with
; external linkage, next to the image field of another type) and a function
; '<msil>Main' that takes no arguments (a method next to the entry point
; '<msil>Main'(string[])) compile without any message and assemble.
; DEFINE: %{diag} = FileCheck %s --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
; DEFINE:   --implicit-check-not=error: --implicit-check-not=warning:
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/reserved-data.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=RES-DATA
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/reserved-data.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=RES-DATA
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/reserved-cctor.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=RES-CCTOR
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/reserved-cctor.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=RES-CCTOR
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/reserved-ctor.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=RES-CTOR
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/reserved-ctor.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=RES-CTOR
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/reserved-import.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=RES-CTOR
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/reserved-import.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=RES-CTOR
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/dup-global.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=DUP-GLOBAL
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/dup-global.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=DUP-GLOBAL
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/dup-unnamed.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=DUP-UNNAMED
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/dup-unnamed.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=DUP-UNNAMED
; RUN: not llc -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/dup-func.ll -o /dev/null \
; RUN:   2>&1 | %{diag} --check-prefix=DUP-FUNC
; RUN: not llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/dup-func.ll -o /dev/null \
