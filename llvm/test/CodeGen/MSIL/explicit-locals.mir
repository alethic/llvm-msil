name:            numbering_il
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32, i64, f32, f64 ]
  results: [ f64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i64 = ARGUMENT_I64 1, implicit $arguments
    %2:f32 = ARGUMENT_F32 2, implicit $arguments
    %3:f64 = ARGUMENT_F64 3, implicit $arguments
    %4:i64 = CONST_I64 -5, implicit-def dead $arguments
    %5:f32 = CONST_F32 float 2.5, implicit-def dead $arguments
    %6:i32 = CONST_I32 7, implicit-def dead $arguments
    DROP_I32 %6, implicit-def dead $arguments
    DROP_F32 %5, implicit-def dead $arguments
    DROP_I64 %4, implicit-def dead $arguments
    DROP_F32 %2, implicit-def dead $arguments
    DROP_I64 %1, implicit-def dead $arguments
    DROP_I32 %0, implicit-def dead $arguments
    RETURN %3, implicit-def dead $arguments
...
