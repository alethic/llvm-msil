---
name:            set_classes_il
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i64, f32 ]
  results: [ f32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 0, implicit $arguments
    %1:f32 = ARGUMENT_F32 1, implicit $arguments
    DROP_I64 %0, implicit-def dead $arguments
    DROP_F32 %1, implicit-def dead $arguments
    %0:i64 = CONST_I64 7, implicit-def dead $arguments
    %1:f32 = CONST_F32 float 1.5, implicit-def dead $arguments
    DROP_I64 %0, implicit-def dead $arguments
    RETURN %1, implicit-def dead $arguments
...

#--- dbg.mir
# Debug values of arguments, compiled with full debug info. ExplicitLocals
# removes the ARGUMENT_<RC> pseudos and rewrites the DBG_VALUE of each
# argument register into target-index(msil-local) plus the argument's index,
# also for the argument 'p' that is never read. The DBG_VALUE of 'c', whose
# value is in memory at the address in argument slot 1, already uses
# target-index(msil-local-indirect) and passes through unchanged. The output
# must read back in with the same text: 'target-index(<unknown>)' cannot be
# parsed.
# DBG-LABEL: name: dbg_args{{$}}
# DBG:       body:
# DBG-NOT:   ARGUMENT_
# DBG:       DBG_VALUE target-index(msil-local), $noreg, !{{[0-9]+}}, !DIExpression(),
# DBG-NEXT:  DBG_VALUE target-index(msil-local) + 1, $noreg, !{{[0-9]+}}, !DIExpression(),
# DBG-NEXT:  DBG_VALUE target-index(msil-local-indirect) + 1, $noreg, !{{[0-9]+}}, !DIExpression(),
# DBG-NEXT:  [[A:%[0-9]+]]:i32 = ARG_GET_I32 0,
# DBG-NEXT:  RETURN [[A]],
# DBG-NOT:   {{ARGUMENT_|LOCAL_|DROP_|<unknown>}}
--- |
  source_filename = "dbg.c"

  define i32 @dbg_args(i32 %a, ptr %p) !dbg !4 {
    ret i32 %a, !dbg !13
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!2, !3}

  !0 = distinct !DICompileUnit(language: DW_LANG_C99, file: !1, producer: "dbg", isOptimized: false, runtimeVersion: 0, emissionKind: FullDebug)
  !1 = !DIFile(filename: "dbg.c", directory: "/")
  !2 = !{i32 7, !"Dwarf Version", i32 4}
  !3 = !{i32 2, !"Debug Info Version", i32 3}
  !4 = distinct !DISubprogram(name: "dbg_args", scope: !1, file: !1, line: 1, type: !5, scopeLine: 1, spFlags: DISPFlagDefinition, unit: !0, retainedNodes: !9)
  !5 = !DISubroutineType(types: !6)
  !6 = !{!7, !7, !8}
  !7 = !DIBasicType(name: "int", size: 32, encoding: DW_ATE_signed)
  !8 = !DIDerivedType(tag: DW_TAG_pointer_type, baseType: !7, size: 64)
  !9 = !{!10, !11, !12}
  !10 = !DILocalVariable(name: "a", arg: 1, scope: !4, file: !1, line: 1, type: !7)
  !11 = !DILocalVariable(name: "p", arg: 2, scope: !4, file: !1, line: 1, type: !8)
  !12 = !DILocalVariable(name: "c", scope: !4, file: !1, line: 2, type: !7)
  !13 = !DILocation(line: 1, column: 1, scope: !4)
...
---
name:            dbg_args
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32, i64 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i64 = ARGUMENT_I64 1, implicit $arguments
    DBG_VALUE %0, $noreg, !10, !DIExpression(), debug-location !13
    DBG_VALUE %1, $noreg, !11, !DIExpression(), debug-location !13
    DBG_VALUE target-index(msil-local-indirect) + 1, $noreg, !12, !DIExpression(), debug-location !13
    RETURN %0, implicit-def dead $arguments, debug-location !13
...

#--- f64-forms.py
# Prints the machine function of f64_forms_il (IR and checks in il.mir), which
# the RUN lines append to il.mir: arg_forms with float64 parameters, then a
# chain of 257 COPY_F64 as in local_forms, then reads of the written
# parameters and of the last local.
import sys

n = 257
dead = ", implicit-def dead $arguments"
lines = [
    "---",
    "name:            f64_forms_il",
    "tracksRegLiveness: true",
    "machineFunctionInfo:",
    "  params:  [ " + ", ".join(["f64"] * n) + " ]",
    "  results: [ f64 ]",
    "body: |",
    "  bb.0:",
    "    liveins: $arguments",
]
# %0 to %4 are the parameters 0, 3, 4, 255 and 256.
for v, arg in enumerate([0, 3, 4, 255, 256]):
    lines.append("    %%%d:f64 = ARGUMENT_F64 %d, implicit $arguments" % (v, arg))
for v in [1, 2, 3, 4]:
    lines.append("    DROP_F64 %%%d%s" % (v, dead))
for v, value in [(0, "1.0"), (2, "2.0"), (3, "3.0"), (4, "4.0")]:
    lines.append("    %%%d:f64 = CONST_F64 double %s%s" % (v, value, dead))
# %10 to %266 are the locals 0 to 256.
lines.append("    %%10:f64 = CONST_F64 double 0.5%s" % dead)
for v in range(11, 10 + n):
    lines.append("    %%%d:f64 = COPY_F64 %%%d%s" % (v, v - 1, dead))
for v in [0, 2, 3, 9 + n]:
    lines.append("    DROP_F64 %%%d%s" % (v, dead))
lines.append("    RETURN %%4%s" % dead)
lines.append("...")
sys.stdout.reconfigure(newline="\n")
print("\n".join(lines))
