# MSILExplicitLocals (ImplementationPlan.md M3.a; recon passes-frame.md 7) gives
# every virtual register that is not on the evaluation stack a CIL argument or
# local and makes every register operand an evaluation-stack slot. Arguments
# and locals share one index space while the pass runs, parameters first, as
# in WebAssembly, and are then split into CIL's two index spaces: an index
# below the number of parameters (machineFunctionInfo 'params') reads and
# writes an argument (ARG_GET_<RC> / ARG_SET_<RC>, printed ldarg / starg),
# any other index a CIL local counted from 0 (LOCAL_GET_<RC> / LOCAL_SET_<RC>,
# printed ldloc / stloc). ARGUMENT_<RC> pseudos disappear: an argument is read
# where it is used and is never copied into a local. A def without uses is
# followed by DROP_<RC> (pop), and a COPY_<RC> is coalesced away. The inputs
# are written against the operand lists of plan 5.4 and its sample MIR.
#
# mir.mir checks the MIR the pass leaves behind; il.mir runs the rest of the
# pipeline from this pass on (RegNumbering, MSILStackCheck, the AsmPrinter) and
# checks the .locals directive and the printed forms of the argument and local
# opcodes at their boundaries (plan 5.1: ldarg.0-3, ldarg.s N for N < 256,
# ldarg N; the same for ldloc and stloc; starg has no .0-3 forms), for I32 and
# for F64 (f64_forms_il, which f64-forms.py appends to il.mir), plus the
# argument writes and drops of I64 and F32. RegStackify runs before this pass,
# so nothing is stackified in these inputs and every value goes through an
# argument or a local (the tees are in reg-stackify-basic.mir). dbg.mir checks
# that a DBG_VALUE of an argument becomes a DBG_VALUE of its slot,
# target-index(msil-local) plus the index, and that the output reads back in:
# the MIR names of the target indices are msil-local and msil-local-indirect.

# RUN: split-file %s %t
# RUN: %python %t/f64-forms.py >> %t/il.mir
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=msil-explicit-locals -verify-machineinstrs \
# RUN:   %t/mir.mir -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -run-pass=msil-explicit-locals -verify-machineinstrs \
# RUN:   %t/mir.mir -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -start-before=msil-explicit-locals -asm-verbose=false \
# RUN:   -verify-machineinstrs %t/il.mir -o - | FileCheck %s --check-prefix=IL
# RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -start-before=msil-explicit-locals -asm-verbose=false \
# RUN:   -verify-machineinstrs %t/il.mir -o - | FileCheck %s --check-prefix=IL
# RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil -start-before=msil-explicit-locals \
# RUN:   %t/il.mir -o %t/il.il && %ilasm-verify -output=%t/il.dll %t/il.il %}
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=msil-explicit-locals -verify-machineinstrs \
# RUN:   %t/dbg.mir -o %t/dbg.lnx.mir
# RUN: FileCheck %s --check-prefix=DBG --input-file=%t/dbg.lnx.mir
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=none -verify-machineinstrs %t/dbg.lnx.mir -o - \
# RUN:   | FileCheck %s --check-prefix=DBG
# RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -run-pass=msil-explicit-locals -verify-machineinstrs \
# RUN:   %t/dbg.mir -o %t/dbg.win.mir
# RUN: FileCheck %s --check-prefix=DBG --input-file=%t/dbg.win.mir
# RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -run-pass=none -verify-machineinstrs %t/dbg.win.mir -o - \
# RUN:   | FileCheck %s --check-prefix=DBG

#--- mir.mir
# The sample of plan 5.4: the use of the argument becomes ARG_GET_I32 0, the
# unused ARGUMENT_I64 disappears without a DROP, and the dead CONST_I32 is
# followed by DROP_I32 (its def is no longer dead: the DROP reads it).
# CHECK-LABEL: name: sample{{$}}
# CHECK:       machineFunctionInfo:
# CHECK-NEXT:    params: [ i32, i64 ]
# CHECK-NEXT:    results: [ i32 ]
# CHECK:       body:
# CHECK-NOT:   ARGUMENT_
# CHECK:       {{^ +}}[[C:%[0-9]+]]:i32 = CONST_I32 7,
# CHECK-NEXT:  DROP_I32 killed [[C]],
# CHECK-NEXT:  [[A:%[0-9]+]]:i32 = ARG_GET_I32 0,
# CHECK-NEXT:  RETURN [[A]],
# CHECK-NOT:   {{LOCAL_|ARG_SET|ARGUMENT_}}
---
name:            sample
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32, i64 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i64 = ARGUMENT_I64 1, implicit $arguments
    dead %2:i32 = CONST_I32 7, implicit-def dead $arguments
    RETURN %0, implicit-def dead $arguments
...

# Ported from llvm/test/CodeGen/WebAssembly/explicit-locals.mir: when a DROP is
# inserted for a dead def, the def is no longer marked dead (the DROP uses it)
# and the DROP's operand is marked killed.
# CHECK-LABEL: name: drop_test{{$}}
# CHECK:       bb.1:
# CHECK-NOT:   dead %{{[0-9]+}}
# CHECK:       DROP_I32 killed %{{[0-9]+}}
---
name:            drop_test
liveins:
  - { reg: '$arguments' }
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ ]
  results: [ ]
body: |
  bb.0:
    successors: %bb.1
    liveins: $arguments

  bb.1:
    dead %0:i32 = CONST_I32 0, implicit-def dead $arguments
    RETURN implicit-def dead $arguments
...

# Unified numbering with the parameters first (passes-frame.md 7): with four
# parameters the first CIL local is unified index 4, which is LOCAL index 0.
# Locals are numbered in the order their values are first seen, one per value
# and of the value's register class; a value used in another block is read
# from its local again there, and a value read twice is read twice. The
# arguments of every register class are read with ARG_GET_<RC> and their
# parameter index.
# CHECK-LABEL: name: numbering{{$}}
# CHECK:       bb.0:
# CHECK-NOT:   ARGUMENT_
# CHECK:       {{^ +}}[[V4:%[0-9]+]]:i64 = CONST_I64 -5,
# CHECK-NEXT:  LOCAL_SET_I64 0, [[V4]],
# CHECK-NEXT:  {{^ +}}[[V5:%[0-9]+]]:f32 = CONST_F32 float 2.5{{0*}}e+00,
# CHECK-NEXT:  LOCAL_SET_F32 1, [[V5]],
# CHECK-NEXT:  {{^ +}}[[V6:%[0-9]+]]:i32 = CONST_I32 7,
# CHECK-NEXT:  LOCAL_SET_I32 2, [[V6]],
# CHECK-NEXT:  BR %bb.1,
# CHECK:       bb.1:
# CHECK:       [[G:%[0-9]+]]:i32 = LOCAL_GET_I32 2,
# CHECK-NEXT:  DROP_I32 [[G]],
# CHECK-NEXT:  [[G:%[0-9]+]]:f32 = LOCAL_GET_F32 1,
# CHECK-NEXT:  DROP_F32 [[G]],
# CHECK-NEXT:  [[G:%[0-9]+]]:i64 = LOCAL_GET_I64 0,
# CHECK-NEXT:  DROP_I64 [[G]],
# CHECK-NEXT:  [[G:%[0-9]+]]:i64 = LOCAL_GET_I64 0,
# CHECK-NEXT:  DROP_I64 [[G]],
# CHECK-NEXT:  [[G:%[0-9]+]]:f32 = ARG_GET_F32 2,
# CHECK-NEXT:  DROP_F32 [[G]],
# CHECK-NEXT:  [[G:%[0-9]+]]:i64 = ARG_GET_I64 1,
# CHECK-NEXT:  DROP_I64 [[G]],
# CHECK-NEXT:  [[G:%[0-9]+]]:i32 = ARG_GET_I32 0,
# CHECK-NEXT:  DROP_I32 [[G]],
# CHECK-NEXT:  [[G:%[0-9]+]]:f64 = ARG_GET_F64 3,
# CHECK-NEXT:  RETURN [[G]],
# CHECK-NOT:   {{LOCAL_[A-Z]+_[A-Z0-9]+ [3-9]|ARG_SET|ARGUMENT_}}
---
name:            numbering
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32, i64, f32, f64 ]
  results: [ f64 ]
body: |
  bb.0:
    successors: %bb.1
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i64 = ARGUMENT_I64 1, implicit $arguments
    %2:f32 = ARGUMENT_F32 2, implicit $arguments
    %3:f64 = ARGUMENT_F64 3, implicit $arguments
    %4:i64 = CONST_I64 -5, implicit-def dead $arguments
    %5:f32 = CONST_F32 float 2.5, implicit-def dead $arguments
    %6:i32 = CONST_I32 7, implicit-def dead $arguments
    BR %bb.1, implicit-def dead $arguments

  bb.1:
    DROP_I32 %6, implicit-def dead $arguments
    DROP_F32 %5, implicit-def dead $arguments
    DROP_I64 %4, implicit-def dead $arguments
    DROP_I64 %4, implicit-def dead $arguments
    DROP_F32 %2, implicit-def dead $arguments
    DROP_I64 %1, implicit-def dead $arguments
    DROP_I32 %0, implicit-def dead $arguments
    RETURN %3, implicit-def dead $arguments
...

# A value written to an argument's register (what RegColoring produces when it
# gives a temporary the color of an argument; written here directly, so this
# MIR is not in SSA form) is stored with ARG_SET_<RC> (starg) into that
# parameter, never into a local; every read of the register before and after
# the write is an ARG_GET_<RC> (ldarg) of the same parameter.
# CHECK-LABEL: name: arg_write{{$}}
# CHECK:       body:
# CHECK:       [[A:%[0-9]+]]:i32 = ARG_GET_I32 0,
# CHECK-NEXT:  DROP_I32 [[A]],
# CHECK-NEXT:  {{^ +}}[[C:%[0-9]+]]:i32 = CONST_I32 9,
# CHECK-NEXT:  ARG_SET_I32 0, [[C]],
# CHECK-NEXT:  [[B:%[0-9]+]]:i32 = ARG_GET_I32 1,
# CHECK-NEXT:  DROP_I32 [[B]],
# CHECK-NEXT:  [[R:%[0-9]+]]:i32 = ARG_GET_I32 0,
# CHECK-NEXT:  RETURN [[R]],
# CHECK-NOT:   {{LOCAL_|ARGUMENT_}}
---
name:            arg_write
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32, i32 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:i32 = ARGUMENT_I32 1, implicit $arguments
    DROP_I32 %0, implicit-def dead $arguments
    %0:i32 = CONST_I32 9, implicit-def dead $arguments
    DROP_I32 %1, implicit-def dead $arguments
    RETURN %0, implicit-def dead $arguments
...

# COPY_<RC> is coalesced away: its source is read where the copy was and stored
# straight into the copy's local.
# CHECK-LABEL: name: copy{{$}}
# CHECK:       body:
# CHECK:       [[A:%[0-9]+]]:i64 = ARG_GET_I64 0,
# CHECK-NEXT:  LOCAL_SET_I64 0, [[A]],
# CHECK-NEXT:  [[L:%[0-9]+]]:i64 = LOCAL_GET_I64 0,
# CHECK-NEXT:  RETURN [[L]],
# CHECK-NOT:   {{COPY|ARGUMENT_}}
---
name:            copy
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i64 ]
  results: [ i64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 0, implicit $arguments
    %1:i64 = COPY_I64 %0, implicit-def dead $arguments
    RETURN %1, implicit-def dead $arguments
...

# Unused arguments leave nothing behind (no ldarg, no pop), and the parameter
# index of a used argument does not depend on the unused ones (the
# WebAssembly unused-argument.ll cases at the MIR level).
# CHECK-LABEL: name: unused_args{{$}}
# CHECK:       body:
# CHECK-NOT:   {{DROP_|ARGUMENT_|LOCAL_}}
# CHECK:       [[A:%[0-9]+]]:i64 = ARG_GET_I64 2,
# CHECK-NEXT:  RETURN [[A]],
# CHECK-NOT:   {{DROP_|ARGUMENT_|LOCAL_|ARG_GET}}
---
name:            unused_args
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32, f64, i64 ]
  results: [ i64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = ARGUMENT_I32 0, implicit $arguments
    %1:f64 = ARGUMENT_F64 1, implicit $arguments
    %2:i64 = ARGUMENT_I64 2, implicit $arguments
    RETURN %2, implicit-def dead $arguments
...

#--- il.mir
# The same numbering through the AsmPrinter: the CIL locals are declared in
# index order with the CIL type of their register class (I64 is native int,
# decision D2), never with 'init' (decision D13), and .maxstack is exact.
# IL-LABEL: .method {{.*}}'numbering_il'(
# IL-SAME:  int32, native int, float32, float64) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  .locals (native int, float32, int32){{$}}
# IL-NEXT:  {{^}}  {{ldc.i4.s -5|ldc.i4 -5}}{{$}}
# IL-NEXT:  {{^}}  conv.i{{$}}
# IL-NEXT:  {{^}}  stloc.0{{$}}
# IL-NEXT:  {{^}}  ldc.r4 float32(0x40200000){{$}}
# IL-NEXT:  {{^}}  stloc.1{{$}}
# IL-NEXT:  {{^}}  ldc.i4.7{{$}}
# IL-NEXT:  {{^}}  stloc.2{{$}}
# IL-NEXT:  {{^}}  ldloc.2{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldloc.1{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldloc.0{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.2{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.1{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.3{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'numbering_il'{{$}}

# Argument forms at the index boundaries 3/4 and 255/256 with 257 parameters:
# ldarg.3, ldarg.s 4, ldarg.s 255, ldarg 256; starg.s for every index below
# 256 (CIL has no starg.0-3) and starg 256. No local is needed.
# IL-LABEL: .method {{.*}}'arg_forms'(
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  ldarg.3{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.s 4{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.s 255{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg 256{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldc.i4.s 10{{$}}
# IL-NEXT:  {{^}}  starg.s 0{{$}}
# IL-NEXT:  {{^}}  ldc.i4.s 11{{$}}
# IL-NEXT:  {{^}}  starg.s 4{{$}}
# IL-NEXT:  {{^}}  ldc.i4.s 12{{$}}
# IL-NEXT:  {{^}}  starg.s 255{{$}}
# IL-NEXT:  {{^}}  ldc.i4.s 13{{$}}
# IL-NEXT:  {{^}}  starg 256{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.s 4{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.s 255{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg 256{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'arg_forms'{{$}}

# Local forms at the same boundaries with 257 locals: a chain of copies stores
# local k and reads it back before storing local k + 1, so every index from 0
# to 256 is written once and read once.
# IL-LABEL: .method {{.*}}'local_forms'(
# IL-SAME:  ) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  .locals ({{(int32, ){255}int32, int32}}){{$}}
# IL-NEXT:  {{^}}  ldc.i4.0{{$}}
# IL-NEXT:  {{^}}  stloc.0{{$}}
# IL-NEXT:  {{^}}  ldloc.0{{$}}
# IL-NEXT:  {{^}}  stloc.1{{$}}
# IL-NEXT:  {{^}}  ldloc.1{{$}}
# IL-NEXT:  {{^}}  stloc.2{{$}}
# IL-NEXT:  {{^}}  ldloc.2{{$}}
# IL-NEXT:  {{^}}  stloc.3{{$}}
# IL-NEXT:  {{^}}  ldloc.3{{$}}
# IL-NEXT:  {{^}}  stloc.s 4{{$}}
# IL-NEXT:  {{^}}  ldloc.s 4{{$}}
# IL-NEXT:  {{^}}  stloc.s 5{{$}}
# IL:       {{^}}  ldloc.s 254{{$}}
# IL-NEXT:  {{^}}  stloc.s 255{{$}}
# IL-NEXT:  {{^}}  ldloc.s 255{{$}}
# IL-NEXT:  {{^}}  stloc 256{{$}}
# IL-NEXT:  {{^}}  ldloc 256{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'local_forms'{{$}}

# The argument writes of the I64 and F32 classes (starg.s; a CONST_I64 is
# ldc.i4 plus conv.i, decision D2) and their drops (pop).
# IL-LABEL: .method {{.*}}'set_classes_il'(
# IL-SAME:  native int, float32) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.1{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  {{ldc.i4.7|ldc.i4 7}}{{$}}
# IL-NEXT:  {{^}}  conv.i{{$}}
# IL-NEXT:  {{^}}  starg.s 0{{$}}
# IL-NEXT:  {{^}}  ldc.r4 float32(0x3FC00000){{$}}
# IL-NEXT:  {{^}}  starg.s 1{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.1{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'set_classes_il'{{$}}

# arg_forms and local_forms for the F64 class, in one function with 257
# float64 parameters and 257 float64 locals (f64_forms_il, which f64-forms.py
# appends to il.mir): ldarg, starg, ldloc and stloc at 0 and at the boundaries
# 3/4 and 255/256, pop for a DROP_F64, and a value written to a parameter is
# read back from it.
# IL-LABEL: .method {{.*}}'f64_forms_il'(
# IL-SAME:  {{(float64, ){255}float64, float64}}) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  .locals ({{(float64, ){255}float64, float64}}){{$}}
# IL-NEXT:  {{^}}  ldarg.3{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.s 4{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.s 255{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg 256{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldc.r8 float64(0x3FF0000000000000){{$}}
# IL-NEXT:  {{^}}  starg.s 0{{$}}
# IL-NEXT:  {{^}}  ldc.r8 float64(0x4000000000000000){{$}}
# IL-NEXT:  {{^}}  starg.s 4{{$}}
# IL-NEXT:  {{^}}  ldc.r8 float64(0x4008000000000000){{$}}
# IL-NEXT:  {{^}}  starg.s 255{{$}}
# IL-NEXT:  {{^}}  ldc.r8 float64(0x4010000000000000){{$}}
# IL-NEXT:  {{^}}  starg 256{{$}}
# IL-NEXT:  {{^}}  ldc.r8 float64(0x3FE0000000000000){{$}}
# IL-NEXT:  {{^}}  stloc.0{{$}}
# IL-NEXT:  {{^}}  ldloc.0{{$}}
# IL-NEXT:  {{^}}  stloc.1{{$}}
# IL-NEXT:  {{^}}  ldloc.1{{$}}
# IL-NEXT:  {{^}}  stloc.2{{$}}
# IL-NEXT:  {{^}}  ldloc.2{{$}}
# IL-NEXT:  {{^}}  stloc.3{{$}}
# IL-NEXT:  {{^}}  ldloc.3{{$}}
# IL-NEXT:  {{^}}  stloc.s 4{{$}}
# IL-NEXT:  {{^}}  ldloc.s 4{{$}}
# IL-NEXT:  {{^}}  stloc.s 5{{$}}
# IL:       {{^}}  ldloc.s 254{{$}}
# IL-NEXT:  {{^}}  stloc.s 255{{$}}
# IL-NEXT:  {{^}}  ldloc.s 255{{$}}
# IL-NEXT:  {{^}}  stloc 256{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.s 4{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg.s 255{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldloc 256{{$}}
# IL-NEXT:  {{^}}  pop{{$}}
# IL-NEXT:  {{^}}  ldarg 256{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'f64_forms_il'{{$}}
--- |
  source_filename = "explicit-locals.c"

  define double @numbering_il(i32 %a, ptr %b, float %c, double %d) {
    ret double %d
  }

