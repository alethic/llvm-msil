; -march=msil selects the MSIL target for a native triple and only switches the
; triple's object format to msil: the architecture, OS and environment, which
; select the C ABI, are kept (decision D4, recon registry-tm.md 1.2). This is
; how bitcode built by a stock clang for the native triple is compiled to MSIL
; (Design.md 3). A triple that is already an MSIL triple is unchanged. Another
; target named with -march cannot compile an MSIL triple.

; RUN: split-file %s %t

; RUN: llc -march=msil -mtriple=x86_64-unknown-linux-gnu -verify-machineinstrs < %t/m.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-LNX
; RUN: llc -march=msil -mtriple=x86_64-pc-windows-msvc -verify-machineinstrs < %t/m.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-WIN
; RUN: llc -march=msil -mtriple=x86_64-w64-windows-gnu -verify-machineinstrs < %t/m.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-MINGW
; RUN: llc -march=msil -mtriple=aarch64-unknown-linux-gnu -verify-machineinstrs < %t/m.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,A64-LNX
; RUN: llc -march=msil -mtriple=x86_64-unknown-linux-gnu-msil -verify-machineinstrs < %t/m.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-LNX

; Without -mtriple the module's own native triple is switched.
; RUN: llc -march=msil -verify-machineinstrs < %t/native-triple.ll \
; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-WIN

; CHECK:     // MSIL module generated by LLVM
; X64-LNX:   // target triple   = "x86_64-unknown-linux-gnu-msil"
; X64-WIN:   // target triple   = "x86_64-pc-windows-msvc-msil"
; X64-MINGW: // target triple   = "x86_64-w64-windows-gnu-msil"
; A64-LNX:   // target triple   = "aarch64-unknown-linux-gnu-msil"
; CHECK:     .assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
; CHECK:     .assembly 'march' { .ver 0:0:0:0 }

; RUN: %if ilasm %{ llc -march=msil -mtriple=x86_64-pc-windows-msvc < %t/m.ll -o %t/m.il \
; RUN:   && %ilasm-verify -output=%t/m.dll %t/m.il %}

; A native target named with -march refuses an MSIL triple, from the command
; line or from the module (the message comes from TargetRegistry::lookupTarget).
; RUN: %if x86-registered-target %{ not llc -march=x86-64 -mtriple=x86_64-unknown-linux-gnu-msil < %t/m.ll 2>&1 \
; RUN:   | FileCheck %s --check-prefix=X86-LNX --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" %}
; RUN: %if x86-registered-target %{ not llc -march=x86-64 < %t/msil-triple.ll 2>&1 \
; RUN:   | FileCheck %s --check-prefix=X86-WIN --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" %}
; X86-LNX: error: target 'x86-64' cannot compile for the MSIL triple 'x86_64-unknown-linux-gnu-msil'; use -march=msil or a non-MSIL triple
; X86-WIN: error: target 'x86-64' cannot compile for the MSIL triple 'x86_64-pc-windows-msvc-msil'; use -march=msil or a non-MSIL triple

;--- m.ll
source_filename = "march.c"

declare i32 @f(i32)

;--- native-triple.ll
; Bitcode from a stock clang names the native triple.
source_filename = "march.c"
target triple = "x86_64-pc-windows-msvc"

declare i32 @f(i32)

;--- msil-triple.ll
source_filename = "march.c"
target triple = "x86_64-pc-windows-msvc-msil"

declare i32 @f(i32)
