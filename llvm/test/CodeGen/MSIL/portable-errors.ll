; The portable target's backend refusals (ImplementationPlan.md 5.18,
; milestone P-1a, texts T-P1 to T-P3), each a clean error: llc exits with 1
; and prints neither 'LLVM ERROR' nor a crash report.
; - T-P1 (5.18.11): msil32-unknown-dotnet parses, selects the MSIL target and
;   gets its own data layout ('e-m:e-p:32:32-...'; opt runs IR passes on it
;   without a diagnostic), but code generation refuses it with "target
;   'msil32-unknown-dotnet' is not supported yet: only msil64-unknown-dotnet
;   is implemented", in text (once; only the module header is written, as
;   for any refused triple, target-selection.ll) and in object mode, at -O0
;   and -O2.
; - T-P2 (5.18.6 PL4): a declaration with "msil-import-module" is refused on
;   msil64 with "'<f>' is declared with import module '<module>', which
;   msil64-unknown-dotnet does not support: the portable target binds no
;   native code", in whole-program text, object-form text and objects; no
;   P/Invoke is written. A global variable declared with the attribute gets
;   the same text (P-1a.e: T-P2 covers every declaration, data included), in
;   text and in objects; whole-program text also gives the existing error
;   for an external global variable, since the data-import helpers of the
;   host triples are off on dotnet (5.18.5 LR2).
; - T-P3 (5.18.6 PL5): standalone text imports nothing, so every function
;   that is called but not defined is "function '<f>' is not defined in this
;   module: standalone text for msil64-unknown-dotnet imports nothing (link
;   with msil-ld)", once per function and never the host triples' Phase-1
;   import text. The same module compiles without a message as an object and
;   as object-form text, where each callee is a symbol of
;   [msil.extern]'<msil>Symbols' for msil-ld to bind.

; RUN: rm -rf %t && split-file %s %t
; DEFINE: %{nocrash} = --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"

; T-P1.
; RUN: opt -mtriple=msil32-unknown-dotnet -S < %t/plain.ll 2>%t/opt32.err | FileCheck %s --check-prefix=DL32
; RUN: count 0 < %t/opt32.err
; DL32:      {{^}}target datalayout = "e-m:e-p:32:32-i64:64-i128:128-n8:16:32:64-S128"{{$}}
; DL32-NEXT: {{^}}target triple = "msil32-unknown-dotnet"{{$}}
; DL32:      {{^}}define i32 @plain(i32 %x)
; RUN: not llc -mtriple=msil32-unknown-dotnet -verify-machineinstrs < %t/plain.ll -o - 2>%t/p1.err \
; RUN:   | FileCheck %s --check-prefix=P1HDR --implicit-check-not="'plain'"
; RUN: FileCheck %s --check-prefix=P1 --input-file=%t/p1.err %{nocrash} --implicit-check-not=error:
; RUN: not llc -mtriple=msil32-unknown-dotnet -O0 -verify-machineinstrs < %t/plain.ll -o /dev/null 2>&1 \
; RUN:   | FileCheck %s --check-prefix=P1 %{nocrash} --implicit-check-not=error:
; RUN: not llc -mtriple=msil32-unknown-dotnet-msil -verify-machineinstrs < %t/plain.ll -o /dev/null 2>&1 \
; RUN:   | FileCheck %s --check-prefix=P1 %{nocrash} --implicit-check-not=error:
; RUN: not llc -mtriple=msil32-unknown-dotnet -filetype=obj -verify-machineinstrs < %t/plain.ll -o %t/p1.o 2>&1 \
; RUN:   | FileCheck %s --check-prefix=P1 %{nocrash}
; RUN: not llc -mtriple=msil32-unknown-dotnet -O0 -filetype=obj -verify-machineinstrs < %t/plain.ll \
; RUN:   -o %t/p1.o0.o 2>&1 | FileCheck %s --check-prefix=P1 %{nocrash}
; P1:        {{^}}{{.*}}error: {{.*}}target 'msil32-unknown-dotnet' is not supported yet: only msil64-unknown-dotnet is implemented{{$}}
; P1HDR:     {{^}}// MSIL module generated by LLVM{{$}}
; P1HDR:     {{^}}.assembly 'plain' { .ver 0:0:0:0 }{{$}}

; T-P2.
; DEFINE: %{p2} = FileCheck %s --check-prefix=P2 %{nocrash}
; RUN: not llc -mtriple=msil64-unknown-dotnet -verify-machineinstrs < %t/import.ll -o - 2>%t/import.err \
; RUN:   > %t/import.il
; RUN: %{p2} --input-file=%t/import.err
; RUN: not llc -mtriple=msil64-unknown-dotnet -O0 -verify-machineinstrs < %t/import.ll -o /dev/null 2>&1 | %{p2}
; RUN: not llc -mtriple=msil64-unknown-dotnet -msil-object-form -verify-machineinstrs < %t/import.ll \
; RUN:   -o - 2>%t/import.of.err > %t/import.of.il
; RUN: %{p2} --input-file=%t/import.of.err
; RUN: not llc -mtriple=msil64-unknown-dotnet -filetype=obj -verify-machineinstrs < %t/import.ll -o %t/import.o 2>&1 \
; RUN:   | %{p2}
; RUN: not llc -mtriple=msil64-unknown-dotnet -O0 -filetype=obj -verify-machineinstrs < %t/import.ll \
; RUN:   -o %t/import.o0.o 2>&1 | %{p2}
; DEFINE: %{noimp} = FileCheck %s --implicit-check-not=pinvokeimpl --implicit-check-not=moduleref
; RUN: %{noimp} --check-prefix=NOIMP --input-file=%t/import.il
; RUN: %{noimp} --check-prefix=NOIMPOF --input-file=%t/import.of.il
; NOIMP: {{^}}// MSIL module generated by LLVM{{$}}
; NOIMPOF: {{^}}// MSIL object generated by LLVM{{$}}
; P2: {{^}}{{.*}}error: {{.*}}'native_fn' is declared with import module 'mylib', which msil64-unknown-dotnet does not support: the portable target binds no native code{{$}}

; T-P2 for a global variable.
; RUN: not llc -mtriple=msil64-unknown-dotnet -verify-machineinstrs < %t/gimport.ll -o - 2>%t/gimport.err \
; RUN:   > %t/gimport.il
; RUN: FileCheck %s --check-prefixes=GP2,GDATA %{nocrash} --input-file=%t/gimport.err
; RUN: not llc -mtriple=msil64-unknown-dotnet -O0 -verify-machineinstrs < %t/gimport.ll -o /dev/null 2>&1 \
; RUN:   | FileCheck %s --check-prefixes=GP2,GDATA %{nocrash}
; RUN: not llc -mtriple=msil64-unknown-dotnet -filetype=obj -verify-machineinstrs < %t/gimport.ll \
; RUN:   -o %t/gimport.o 2>&1 | FileCheck %s --check-prefix=GP2 %{nocrash}
; RUN: not llc -mtriple=msil64-unknown-dotnet -O0 -filetype=obj -verify-machineinstrs < %t/gimport.ll \
; RUN:   -o %t/gimport.o0.o 2>&1 | FileCheck %s --check-prefix=GP2 %{nocrash}
; RUN: %{noimp} --check-prefix=NOIMP --input-file=%t/gimport.il
; GP2-DAG:   {{^}}{{.*}}error: {{.*}}'nat_data' is declared with import module 'mylib', which msil64-unknown-dotnet does not support: the portable target binds no native code{{$}}
; GDATA-DAG: {{^}}{{.*}}error: {{.*}}external global variable 'nat_data' is not supported{{.*}}

; T-P3.
; DEFINE: %{p3} = FileCheck %s --check-prefix=P3 %{nocrash} --implicit-check-not="Phase-1 import" \
; DEFINE:   --implicit-check-not=warning:
; RUN: not llc -mtriple=msil64-unknown-dotnet -verify-machineinstrs < %t/undef.ll -o - 2>%t/undef.err \
; RUN:   > %t/undef.il
; RUN: %{p3} --input-file=%t/undef.err
; RUN: not llc -mtriple=msil64-unknown-dotnet -O0 -verify-machineinstrs < %t/undef.ll -o /dev/null 2>&1 | %{p3}
; RUN: not llc -mtriple=msil64-unknown-dotnet -verify-machineinstrs < %t/undef.ll -o /dev/null 2>&1 \
; RUN:   | grep -c "error: " | FileCheck %s --check-prefix=NERR2
; RUN: %{noimp} --input-file=%t/undef.il
; P3-DAG: {{^}}{{.*}}error: {{.*}}function 'ext_fn' is not defined in this module: standalone text for msil64-unknown-dotnet imports nothing (link with msil-ld){{$}}
; P3-DAG: {{^}}{{.*}}error: {{.*}}function 'ext_void' is not defined in this module: standalone text for msil64-unknown-dotnet imports nothing (link with msil-ld){{$}}
; NERR2: {{^}}2{{$}}

; The same module as object-form text and as objects.
; RUN: llc -mtriple=msil64-unknown-dotnet -msil-object-form -asm-verbose=false -verify-machineinstrs < %t/undef.ll \
; RUN:   -o %t/undef.of.il 2>&1 | count 0
; RUN: FileCheck %s --check-prefix=OF --input-file=%t/undef.of.il --implicit-check-not=pinvokeimpl
; RUN: llc -mtriple=msil64-unknown-dotnet -O0 -msil-object-form -asm-verbose=false -verify-machineinstrs \
; RUN:   < %t/undef.ll -o %t/undef.of.o0.il 2>&1 | count 0
; RUN: FileCheck %s --check-prefix=OF --input-file=%t/undef.of.o0.il --implicit-check-not=pinvokeimpl
; RUN: llc -mtriple=msil64-unknown-dotnet -filetype=obj -verify-machineinstrs < %t/undef.ll -o %t/undef.o 2>&1 \
; RUN:   | count 0
; RUN: llc -mtriple=msil64-unknown-dotnet -O0 -filetype=obj -verify-machineinstrs < %t/undef.ll -o %t/undef.o0.o 2>&1 \
; RUN:   | count 0
; RUN: %if llvm-cil-dump %{ llvm-cil-dump --tables %t/undef.o | FileCheck %s --check-prefix=OBJ \
; RUN:   --implicit-check-not="Table: ImplMap " --implicit-check-not="Table: ModuleRef " %}
; OF-LABEL: {{^}}.method public static int32 'caller'(int32) cil managed{{$}}
; OF:       {{^}}  call void [msil.extern]'<msil>Symbols'::'ext_void'(){{$}}
; OF:       {{^}}  call int32 [msil.extern]'<msil>Symbols'::'ext_fn'(int32){{$}}
; OF:       {{^}}} // end of method 'caller'{{$}}
; OBJ:      {{^}}Table: MemberRef rows={{[0-9]+}} rowsize={{[0-9]+}}{{$}}
; OBJ-DAG:  {{^}}  MemberRef[{{[0-9]+}}]: Class=0x{{[0-9A-F]+}} Name='ext_fn' Signature=00 01 08 08{{$}}
; OBJ-DAG:  {{^}}  MemberRef[{{[0-9]+}}]: Class=0x{{[0-9A-F]+}} Name='ext_void' Signature=00 00 01{{$}}

;--- plain.ll
source_filename = "plain.c"

define i32 @plain(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

;--- import.ll
source_filename = "import.c"

declare i32 @native_fn(i32) #0

define i32 @use_import(i32 %x) {
  %r = call i32 @native_fn(i32 %x)
  ret i32 %r
}

attributes #0 = { "msil-import-module"="mylib" }

;--- gimport.ll
source_filename = "gimport.c"

@nat_data = external global i32 #0

define i32 @use_data() {
  %v = load i32, ptr @nat_data, align 4
  ret i32 %v
}

attributes #0 = { "msil-import-module"="mylib" }

;--- undef.ll
source_filename = "undef.c"

declare i32 @ext_fn(i32)
declare void @ext_void()

define i32 @caller(i32 %x) {
  call void @ext_void()
  %r = call i32 @ext_fn(i32 %x)
  ret i32 %r
}
