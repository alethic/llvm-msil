# CHECK-NEXT:    liveins: $arguments
# CHECK-NEXT:    {{  $}}
# CHECK-NEXT:    %1:f32 = ARGUMENT_F32 0, implicit $arguments
# CHECK-NEXT:    %0:i32 = CONST_I32 0, implicit-def $arguments
# CHECK-NEXT:    RETURN %1, implicit-def dead $arguments
# IL-LABEL: .method {{.*}}'argument_f32'(
# IL-SAME:  float32) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'argument_f32'{{$}}
---
name:            argument_f32
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ f32 ]
  results: [ f32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = CONST_I32 0, implicit-def $arguments
    %1:f32 = ARGUMENT_F32 0, implicit $arguments
    RETURN %1, implicit-def dead $arguments
...

# CHECK-LABEL: name: argument_f64{{$}}
# CHECK:       bb.0:
# CHECK-NEXT:    liveins: $arguments
# CHECK-NEXT:    {{  $}}
# CHECK-NEXT:    %1:f64 = ARGUMENT_F64 0, implicit $arguments
# CHECK-NEXT:    %0:i32 = CONST_I32 0, implicit-def $arguments
# CHECK-NEXT:    RETURN %1, implicit-def dead $arguments
# IL-LABEL: .method {{.*}}'argument_f64'(
# IL-SAME:  float64) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'argument_f64'{{$}}
---
name:            argument_f64
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ f64 ]
  results: [ f64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = CONST_I32 0, implicit-def $arguments
    %1:f64 = ARGUMENT_F64 0, implicit $arguments
    RETURN %1, implicit-def dead $arguments
...

# Several ARGUMENTs interleaved with other instructions. The first one is
# already at the top and stays first. The others follow it in their original
# order, which is not argument-index order. The other instructions keep their
# order after the ARGUMENTs, and the last constant, which comes after every
# ARGUMENT, has plan 5.4's dead $arguments def.
# CHECK-LABEL: name: argument_several{{$}}
# CHECK:       bb.0:
# CHECK-NEXT:    liveins: $arguments
# CHECK-NEXT:    {{  $}}
# CHECK-NEXT:    %0:i64 = ARGUMENT_I64 1, implicit $arguments
# CHECK-NEXT:    %2:f64 = ARGUMENT_F64 3, implicit $arguments
# CHECK-NEXT:    %4:i32 = ARGUMENT_I32 0, implicit $arguments
# CHECK-NEXT:    %5:f32 = ARGUMENT_F32 2, implicit $arguments
# CHECK-NEXT:    %1:i32 = CONST_I32 1, implicit-def $arguments
# CHECK-NEXT:    %3:f32 = CONST_F32 float 2.000000e+00, implicit-def $arguments
# CHECK-NEXT:    %6:i64 = CONST_I64 3, implicit-def $arguments
# CHECK-NEXT:    dead %7:i32 = CONST_I32 4, implicit-def dead $arguments
# CHECK-NEXT:    RETURN %2, implicit-def dead $arguments
# IL-LABEL: .method {{.*}}'argument_several'(
# IL-SAME:  int32, native int, float32, float64) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  ldarg.3{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'argument_several'{{$}}
---
name:            argument_several
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32, i64, f32, f64 ]
  results: [ f64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i64 = ARGUMENT_I64 1, implicit $arguments
    %1:i32 = CONST_I32 1, implicit-def $arguments
    %2:f64 = ARGUMENT_F64 3, implicit $arguments
    %3:f32 = CONST_F32 float 2.000000e+00, implicit-def $arguments
    %4:i32 = ARGUMENT_I32 0, implicit $arguments
    %5:f32 = ARGUMENT_F32 2, implicit $arguments
    %6:i64 = CONST_I64 3, implicit-def $arguments
    dead %7:i32 = CONST_I32 4, implicit-def dead $arguments
    RETURN %2, implicit-def dead $arguments
...
