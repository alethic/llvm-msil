# Ported from llvm/test/CodeGen/WebAssembly/reg-argument.mir.
#
# MSILArgumentMove (msil-argument-move) moves every ARGUMENT_<RC> to the top of
# the entry block. Instruction selection may schedule an ARGUMENT after other
# instructions, but MSILExplicitLocals expects all of them first. ARGUMENTs that
# are already at the top stay where they are, the moved ones keep their
# original order (not argument-index order), and every other instruction keeps
# its relative order after them. The WebAssembly funcref, externref and exnref
# cases have no MSIL register class and are dropped.
#
# The inputs use the operand lists of plan 5.4 and record params and results in
# machineFunctionInfo. Each function returns a value, and its IR signature
# matches params and results, so the -start-before run can print it. The
# AsmPrinter asserts that the method header agrees with params and results.
# An instruction that comes before an ARGUMENT in the input defines $arguments
# without plan 5.4's 'dead' flag. The ARGUMENT after it reads $arguments, and
# with tracksRegLiveness the machine verifier rejects a read after a dead def.
# The WebAssembly original has no dead flags either. bb.0 lists $arguments as
# a live-in, and the MIR printer puts a blank line after the liveins line, so
# the checks match those two lines before the first instruction.
#
# The -start-before runs check that a late ARGUMENT goes all the way to IL.
# Without the move, MSILExplicitLocals would reach an ARGUMENT after a
# non-ARGUMENT instruction. The unused constants are deleted before
# MSILExplicitLocals, so each method is just 'ldarg' and 'ret'.

# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -run-pass=msil-argument-move -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -run-pass=msil-argument-move -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=x86_64-unknown-linux-gnu-msil -start-before=msil-argument-move -asm-verbose=false \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=IL
# RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -start-before=msil-argument-move -asm-verbose=false \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s --check-prefix=IL
# RUN: %if ilasm %{ llc -mtriple=x86_64-unknown-linux-gnu-msil -start-before=msil-argument-move %s -o %t.il \
# RUN:   && %ilasm-verify -output=%t.dll %t.il %}

--- |
  define i32 @argument_i32(i32 %a) {
    ret i32 %a
  }
  define i64 @argument_i64(i64 %a) {
    ret i64 %a
  }
  define float @argument_f32(float %a) {
    ret float %a
  }
  define double @argument_f64(double %a) {
    ret double %a
  }
  define double @argument_several(i32 %a, i64 %b, float %c, double %d) {
    ret double %d
  }
...

# CHECK-LABEL: name: argument_i32{{$}}
# CHECK:       bb.0:
# CHECK-NEXT:    liveins: $arguments
# CHECK-NEXT:    {{  $}}
# CHECK-NEXT:    %1:i32 = ARGUMENT_I32 0, implicit $arguments
# CHECK-NEXT:    %0:i32 = CONST_I32 0, implicit-def $arguments
# CHECK-NEXT:    RETURN %1, implicit-def dead $arguments
# IL-LABEL: .method {{.*}}'argument_i32'(
# IL-SAME:  int32) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'argument_i32'{{$}}
---
name:            argument_i32
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i32 ]
  results: [ i32 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = CONST_I32 0, implicit-def $arguments
    %1:i32 = ARGUMENT_I32 0, implicit $arguments
    RETURN %1, implicit-def dead $arguments
...

# CHECK-LABEL: name: argument_i64{{$}}
# CHECK:       bb.0:
# CHECK-NEXT:    liveins: $arguments
# CHECK-NEXT:    {{  $}}
# CHECK-NEXT:    %1:i64 = ARGUMENT_I64 0, implicit $arguments
# CHECK-NEXT:    %0:i32 = CONST_I32 0, implicit-def $arguments
# CHECK-NEXT:    RETURN %1, implicit-def dead $arguments
# IL-LABEL: .method {{.*}}'argument_i64'(
# IL-SAME:  native int) cil managed{{$}}
# IL-NEXT:  {{^\{$}}
# IL-NEXT:  {{^}}  .maxstack 1{{$}}
# IL-NEXT:  {{^}}  ldarg.0{{$}}
# IL-NEXT:  {{^}}  ret{{$}}
# IL-NEXT:  {{^}}} // end of method 'argument_i64'{{$}}
---
name:            argument_i64
tracksRegLiveness: true
machineFunctionInfo:
  params:  [ i64 ]
  results: [ i64 ]
body: |
  bb.0:
    liveins: $arguments
    %0:i32 = CONST_I32 0, implicit-def $arguments
    %1:i64 = ARGUMENT_I64 0, implicit $arguments
    RETURN %1, implicit-def dead $arguments
...

# CHECK-LABEL: name: argument_f32{{$}}
