;--- attrs.ll
; Declarations with the attributes clang emits for x86_64 and aarch64.
source_filename = "selection.c"

declare i32 @puts_like(ptr) #0
declare void @abort_like() #1
declare double @sqrt_like(double) #2

attributes #0 = { nounwind "target-cpu"="x86-64" "target-features"="+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87" "tune-cpu"="generic" }
attributes #1 = { noreturn nounwind "target-cpu"="skylake" "target-features"="+avx,+avx2,+bmi,+bmi2,+crc32,+cx16,+f16c,+fma,+popcnt,+sse4.2" "tune-cpu"="generic" }
attributes #2 = { nounwind "target-cpu"="generic" "target-features"="+fp-armv8,+neon,+outline-atomics,+v8a,-fmv" }

;--- badtriple.ll
; A definition and a global variable, which MSILPrepareIR must remove before
; they reach the M2 stubs.
source_filename = "badtriple.c"

@msil_bad_global = global i32 1

define i32 @msil_bad_fn() {
  %v = load i32, ptr @msil_bad_global
  ret i32 %v
}

;--- wineh.ll
source_filename = "ehflag.c"

declare void @external_fn()

!llvm.module.flags = !{!0}
!0 = !{i32 1, !"exception-model", !"wineh"}

;--- ehmodel.ll
; A definition without nounwind, so a DWARF model would give it an unwind
; table entry.
source_filename = "ehmodel.c"

define i32 @may_unwind(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

;--- ehdwarf.ll
source_filename = "ehmodel.c"

define i32 @may_unwind(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

!llvm.module.flags = !{!0}
!0 = !{i32 1, !"exception-model", !"dwarf"}

;--- ehsjlj.ll
source_filename = "ehmodel.c"

define i32 @may_unwind(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

!llvm.module.flags = !{!0}
!0 = !{i32 1, !"exception-model", !"sjlj"}

;--- eharm.ll
source_filename = "ehmodel.c"

define i32 @may_unwind(i32 %x) {
  %r = add i32 %x, 1
  ret i32 %r
}

!llvm.module.flags = !{!0}
!0 = !{i32 1, !"exception-model", !"arm"}
