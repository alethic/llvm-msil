; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-MINGW --implicit-check-not="not a recognized"
; RUN: llc -mtriple=aarch64-unknown-linux-gnu-msil -verify-machineinstrs < %t/attrs.ll 2>&1 \
; RUN:   | FileCheck %s --check-prefixes=CHECK,A64-LNX --implicit-check-not="not a recognized"
; RUN: llc -mtriple=aarch64-pc-windows-msvc-msil -verify-machineinstrs < %t/attrs.ll 2>&1 \
; RUN:   | FileCheck %s --check-prefixes=CHECK,A64-WIN --implicit-check-not="not a recognized"

