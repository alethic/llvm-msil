; RUN:   | FileCheck %s --check-prefix=BADHDR --implicit-check-not=msil_bad
; RUN: FileCheck %s --check-prefix=BADTRIPLE --input-file=%t/bad-i686.err -DTRIPLE=i686-pc-windows-msvc-msil \
; RUN:   --implicit-check-not=error: --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit"
