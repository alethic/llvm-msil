; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-LNX --implicit-check-not="not a recognized"
; RUN: llc -mtriple=x86_64-unknown-linux-musl-msil -verify-machineinstrs < %t/attrs.ll 2>&1 \
; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-MUSL --implicit-check-not="not a recognized"
; RUN: llc -mtriple=x86_64-pc-windows-msvc-msil -verify-machineinstrs < %t/attrs.ll 2>&1 \
; RUN:   | FileCheck %s --check-prefixes=CHECK,X64-WIN --implicit-check-not="not a recognized"
