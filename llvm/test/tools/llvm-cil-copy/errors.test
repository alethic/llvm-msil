#--- us.il
// An ldstr whose #US entry is not well-formed UTF-16: the bytes 00 D8 41 00
// are the lone high surrogate U+D800 and 'A'. ilasm keeps them.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'us' { }
.module 'us.exe'

.method public static int32 'main'() cil managed
{
  .entrypoint
  .maxstack 8
  ldstr bytearray (00 D8 41 00)
  callvirt instance int32 [mscorlib]System.String::get_Length()
  ret
}
