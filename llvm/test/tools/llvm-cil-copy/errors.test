## llvm-cil-copy errors (plan 5.7.10, 5.7.12): a missing input, an input that
## is not a CLI image, FieldRVA data whose size the rule of the listing's
## '.data' line cannot give (a native int field) and an ldstr string that
## addUserString cannot represent are errors with exit status 1, never a
## crash (section 2: the guards against 'LLVM ERROR' and 'PLEASE submit'
## catch an abort(), which plain 'not' accepts on Windows). The inputs are
## yaml2obj copies of the ilasm (.NET Framework 4.8, -exe -pe64 -x64) images
## of rvasize.il and us.il. The copier's other refusals (section 12, '5.7.10
## amended (`llvm-cil-copy`'s other refusals)') follow, on fwd.il and on
## patched copies of patch.il's YAML.

# RUN: rm -rf %t && split-file %s %t
# RUN: yaml2obj %t/rvasize.yaml -o %t/rvasize.exe
# RUN: yaml2obj %t/us.yaml -o %t/us.exe

# RUN: not llvm-cil-copy %t/missing.exe -o %t/missing.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=MISSING -DFILE=%t/missing.exe -DMSG=%errc_ENOENT \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# MISSING: {{.*}}error: {{.*}}'[[FILE]]': [[MSG]]

# RUN: not llvm-cil-copy %t/rvasize.il -o %t/text.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOTPE \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# NOTPE: {{.*}}error: {{.*}}invalid CLI image: {{.+}}

## The field 'ptr' is a native int with FieldRVA data: its size is unknown.
# RUN: llvm-cil-dump --canonical %t/rvasize.exe | FileCheck %s --check-prefix=DATA
# DATA:      .field 'ptr' native int flags=0x0116
# DATA-NEXT:   .data (unknown size)
# RUN: not llvm-cil-copy %t/rvasize.exe -o %t/rvasize.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=SIZE -DFILE=%t/rvasize.exe \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# SIZE: llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': the FieldRVA data of field 'ptr' has no known size

## A #US entry with a lone UTF-16 surrogate is valid metadata (ECMA-335
## II.24.2.4 stores UTF-16 code units, and the runtime runs the image), so
## the listing shows it, but MetadataBuilder::addUserString takes UTF-8 and
## cannot hold it: llvm-cil-copy refuses it (section 12, '5.7.10 amended
## (`llvm-cil-copy` and lone surrogates)'). The entry is the first of the
## heap, at #US offset 1.
# RUN: llvm-cil-dump --canonical %t/us.exe \
# RUN:   | FileCheck %s --check-prefix=US-LISTING --match-full-lines --strict-whitespace
# US-LISTING:    L0: ldstr "\uD800A"
# RUN: not llvm-cil-copy %t/us.exe -o %t/us.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=US -DFILE=%t/us.exe --match-full-lines \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# US:llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': unsupported user string at #US offset 0x00000001: it holds a lone UTF-16 surrogate

## The copier's other refusals (section 12, '5.7.10 amended
## (`llvm-cil-copy`'s other refusals)'): each is an error with exit status 1
## that leaves no output file. Names print raw and row numbers in decimal.
## patch.il's own image copies (the control), so each patched input below
## differs from a good one only where its sed command patches the YAML.
# RUN: yaml2obj %t/patch.yaml -o %t/patch.exe
# RUN: llvm-cil-copy %t/patch.exe -o %t/patch.copy.exe
# RUN: llvm-cil-dump --canonical %t/patch.exe > %t/patch.txt
# RUN: llvm-cil-dump --canonical %t/patch.copy.exe > %t/patch.copy.txt
# RUN: diff %t/patch.txt %t/patch.copy.txt

## (1) A forward Extends: 'Derived' (TypeDef row 2) precedes its base 'Base'
## (row 3). The image is valid and lists, but MetadataBuilder::addTypeDef
## takes only an Extends row that already exists.
# RUN: yaml2obj %t/fwd.yaml -o %t/fwd.exe
# RUN: llvm-cil-dump --canonical %t/fwd.exe \
# RUN:   | FileCheck %s --check-prefix=FWD-LISTING --match-full-lines --strict-whitespace
# FWD-LISTING:.class 'Derived' flags=0x00000001 extends 'Base'
# RUN: not llvm-cil-copy %t/fwd.exe -o %t/fwd.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=FWD -DFILE=%t/fwd.exe --match-full-lines \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# RUN: not ls %t/fwd.copy.exe
# FWD:llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': type 'Derived' (TypeDef row 2) extends a later TypeDef, row 3

## (2) A TypeDef nested in a later TypeDef: the NestedClass row (NestedClass
## 3, EnclosingClass 2) is patched to name row 4, 'Last', as the enclosing
## class.
# RUN: sed -e "s/03000200/03000400/" %t/patch.yaml > %t/nested.yaml
# RUN: yaml2obj %t/nested.yaml -o %t/nested.exe
# RUN: not llvm-cil-copy %t/nested.exe -o %t/nested.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NESTED -DFILE=%t/nested.exe --match-full-lines \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# RUN: not ls %t/nested.copy.exe
# NESTED:llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': type 'Inner' (TypeDef row 3) is nested in a later TypeDef, row 4

## (3) TypeDef row 1 is not the plain '<Module>': its Flags (the first four
## bytes of the row) are patched from 0 to 1.
# RUN: sed -e "s/0000000001000000000001000100/0100000001000000000001000100/" %t/patch.yaml > %t/module.yaml
# RUN: yaml2obj %t/module.yaml -o %t/module.exe
# RUN: not llvm-cil-copy %t/module.exe -o %t/module.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=MODULE -DFILE=%t/module.exe --match-full-lines \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# RUN: not ls %t/module.copy.exe
# MODULE:llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': TypeDef row 1 is not the '<Module>' type that MetadataBuilder writes (flags 0, no base type)

## (4) A body that is not IL: the ImplFlags of 'main' (MethodDef row 1, RVA
## 0x2060) are patched from 0 (IL) to 1 (Native), its CodeTypeMask bits.
# RUN: sed -e "s/602000000000160049000F000100/602000000100160049000F000100/" %t/patch.yaml > %t/native.yaml
# RUN: yaml2obj %t/native.yaml -o %t/native.exe
# RUN: not llvm-cil-copy %t/native.exe -o %t/native.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NATIVE -DFILE=%t/native.exe --match-full-lines \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# RUN: not ls %t/native.copy.exe
# NATIVE:llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': method 'main' (MethodDef row 1) has a body that is not IL

## (5)-(7) patch the CLI header (cb 0x48, runtime 2.5, the metadata
## directory, Flags 0x00000001 and EntryPointToken 0x06000001). (5) CorFlags
## without COMIMAGE_FLAGS_ILONLY.
# RUN: sed -e "s/48000000020005006C200000B80100000100000001000006/48000000020005006C200000B80100000000000001000006/" %t/patch.yaml > %t/notilonly.yaml
# RUN: yaml2obj %t/notilonly.yaml -o %t/notilonly.exe
# RUN: not llvm-cil-copy %t/notilonly.exe -o %t/notilonly.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NOTILONLY -DFILE=%t/notilonly.exe --match-full-lines \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# RUN: not ls %t/notilonly.copy.exe
# NOTILONLY:llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': not an IL-only image (CorFlags 0x00000000)

## (6) CorFlags with COMIMAGE_FLAGS_NATIVE_ENTRYPOINT (0x10).
# RUN: sed -e "s/48000000020005006C200000B80100000100000001000006/48000000020005006C200000B80100001100000001000006/" %t/patch.yaml > %t/natep.yaml
# RUN: yaml2obj %t/natep.yaml -o %t/natep.exe
# RUN: not llvm-cil-copy %t/natep.exe -o %t/natep.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NATEP -DFILE=%t/natep.exe --match-full-lines \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# RUN: not ls %t/natep.copy.exe
# NATEP:llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': the entry point is native code (CorFlags 0x00000011)

## (7) An entry point token that is not a MethodDef: MemberRef row 1
## (GC::KeepAlive).
# RUN: sed -e "s/48000000020005006C200000B80100000100000001000006/48000000020005006C200000B8010000010000000100000A/" %t/patch.yaml > %t/eptok.yaml
# RUN: yaml2obj %t/eptok.yaml -o %t/eptok.exe
# RUN: not llvm-cil-copy %t/eptok.exe -o %t/eptok.copy.exe 2>&1 \
# RUN:   | FileCheck %s --check-prefix=EPTOK -DFILE=%t/eptok.exe --match-full-lines \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# RUN: not ls %t/eptok.copy.exe
# EPTOK:llvm-cil-copy{{(\.exe)?}}: error: '[[FILE]]': the entry point token 0x0A000001 is not a MethodDef

#--- rvasize.il
// FieldRVA data on a native int field: the size rule of plan 5.7.10's
// '.data' line gives no size, so llvm-cil-copy cannot copy it.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'rvasize' { }
.module 'rvasize.dll'

.field public static native int 'ptr' at D_1
.data D_1 = int64(0)

.method public static int32 'main'() cil managed
{
  .entrypoint
  .maxstack 8
  ldc.i4.0
  ret
}
