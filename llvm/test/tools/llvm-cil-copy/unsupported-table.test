## llvm-cil-copy refuses a row of a table outside the writer set of plan
## 5.7.6 (Constant, InterfaceImpl and GenericParam among them; they are read
## but not written until a later milestone): 'unsupported table <Name> (<n>
## rows)' (5.7.10) and exit status 1, never a crash (section 2: the guards
## against 'LLVM ERROR' and 'PLEASE submit' catch an abort(), which plain
## 'not' accepts on Windows). The inputs are yaml2obj copies of the ilasm
## (.NET Framework 4.8, -dll -pe64 -x64) images of constant.il, interface.il
## and generic.il, each with rows in exactly one table outside the writer
## set.

# RUN: rm -rf %t && split-file %s %t
# RUN: yaml2obj %t/constant.yaml -o %t/constant.dll
# RUN: yaml2obj %t/interface.yaml -o %t/interface.dll
# RUN: yaml2obj %t/generic.yaml -o %t/generic.dll

# RUN: not llvm-cil-copy %t/constant.dll -o %t/constant.copy.dll 2>&1 \
# RUN:   | FileCheck %s --check-prefix=CONSTANT \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# CONSTANT: {{.*}}error: {{.*}}unsupported table Constant (2 rows)

# RUN: not llvm-cil-copy %t/interface.dll -o %t/interface.copy.dll 2>&1 \
# RUN:   | FileCheck %s --check-prefix=INTERFACE \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# INTERFACE: {{.*}}error: {{.*}}unsupported table InterfaceImpl (1 rows)

# RUN: not llvm-cil-copy %t/generic.dll -o %t/generic.copy.dll 2>&1 \
# RUN:   | FileCheck %s --check-prefix=GENERIC \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# GENERIC: {{.*}}error: {{.*}}unsupported table GenericParam (1 rows)

#--- constant.il
// Two Constant rows (a literal field and a parameter default): the Constant
// table is outside the writer set of plan 5.7.6.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'constant' { }
.module 'constant.dll'

.class public auto ansi NS.K extends [mscorlib]System.Object
{
  .field public static literal int32 'Answer' = int32(42)
}

.method public static int32 'f'([opt] int32 'b') cil managed
{
  .param [1] = int32(5)
  .maxstack 8
  ldarg.0
  ret
}
#--- constant.yaml
--- !COFF
OptionalHeader:
  AddressOfEntryPoint: 8798
  ImageBase:       5368709120
  SectionAlignment: 8192
  FileAlignment:   512
  MajorOperatingSystemVersion: 4
  MinorOperatingSystemVersion: 0
  MajorImageVersion: 0
  MinorImageVersion: 0
  MajorSubsystemVersion: 4
  MinorSubsystemVersion: 0
  Subsystem:       IMAGE_SUBSYSTEM_WINDOWS_CUI
  DLLCharacteristics: [ IMAGE_DLL_CHARACTERISTICS_DYNAMIC_BASE, IMAGE_DLL_CHARACTERISTICS_NX_COMPAT, IMAGE_DLL_CHARACTERISTICS_NO_SEH, IMAGE_DLL_CHARACTERISTICS_TERMINAL_SERVER_AWARE ]
  SizeOfStackReserve: 4194304
  SizeOfStackCommit: 16384
  SizeOfHeapReserve: 1048576
  SizeOfHeapCommit: 8192
  ImportTable:
    RelativeVirtualAddress: 8712
    Size:            83
  BaseRelocationTable:
    RelativeVirtualAddress: 16384
    Size:            12
  IAT:
    RelativeVirtualAddress: 8192
    Size:            16
  ClrRuntimeHeader:
    RelativeVirtualAddress: 8208
    Size:            72
header:
  Machine:         IMAGE_FILE_MACHINE_AMD64
  Characteristics: [ IMAGE_FILE_EXECUTABLE_IMAGE, IMAGE_FILE_LARGE_ADDRESS_AWARE, IMAGE_FILE_DLL ]
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  8192
    VirtualSize:     618
    SectionData:     
  - Name:            .reloc
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_DISCARDABLE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  16384
    VirtualSize:     12
    SectionData:     002000000C00000060A20000
symbols:         []
...
#--- interface.il
// One InterfaceImpl row: the table is outside the writer set of plan 5.7.6.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'interface' { }
.module 'interface.dll'

.class public auto ansi NS.D extends [mscorlib]System.Object
       implements [mscorlib]System.IDisposable
{
  .method public hidebysig newslot virtual final instance void Dispose() cil managed
  {
    .maxstack 8
    ret
  }
}
