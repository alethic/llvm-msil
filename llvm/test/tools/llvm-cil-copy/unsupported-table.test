#--- generic.il
// One GenericParam row: the table is outside the writer set of plan 5.7.6.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'generic' { }
