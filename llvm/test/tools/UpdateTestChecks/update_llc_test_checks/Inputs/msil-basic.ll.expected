; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
;; Check that MSIL methods are found by their one-line '.method' header and
;; '} // end of method' footer, and that their labels anchor on '.method'.
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu-msil | FileCheck %s
; RUN: llc < %s -mtriple=x86_64-pc-windows-msvc-msil | FileCheck %s

;; Check -march=msil with a native triple, and output without asm comments.
; RUN: llc < %s -march=msil -mtriple=x86_64-unknown-linux-gnu -asm-verbose=false | FileCheck %s --check-prefix=MARCH

;; Check that the checks of a non-MSIL RUN line keep their plain labels and
;; come first, separated from the MSIL ones by an empty comment line.
; RUN: llc < %s -mtriple=x86_64-unknown-linux-gnu | FileCheck %s --check-prefix=X64

;; 'add' is called before it is defined, and the call prints "'add'(" too.
define i32 @caller(i32 %x) {
; X64-LABEL: caller:
; X64:       # %bb.0:
; X64-NEXT:    pushq %rbx
; X64-NEXT:    .cfi_def_cfa_offset 16
; X64-NEXT:    .cfi_offset %rbx, -16
; X64-NEXT:    movl $7, %esi
; X64-NEXT:    callq add@PLT
; X64-NEXT:    movl %eax, %ebx
; X64-NEXT:    movl $1, %edi
; X64-NEXT:    movl $2, %esi
; X64-NEXT:    callq add.i64
; X64-NEXT:    addl %ebx, %eax
; X64-NEXT:    # kill: def $eax killed $eax killed $rax
; X64-NEXT:    popq %rbx
; X64-NEXT:    .cfi_def_cfa_offset 8
; X64-NEXT:    retq
;
; CHECK-LABEL: .method {{.*}}'caller'(
; CHECK:         .maxstack 3
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ldarg.0
; CHECK-NEXT:    ldc.i4.7
; CHECK-NEXT:    call int32 'add'(int32, int32)
; CHECK-NEXT:    ldc.i4.1
; CHECK-NEXT:    conv.i
; CHECK-NEXT:    ldc.i4.2
; CHECK-NEXT:    conv.i
; CHECK-NEXT:    call native int 'add.i64'(native int, native int)
; CHECK-NEXT:    conv.i4
; CHECK-NEXT:    add
; CHECK-NEXT:    ret
;
; MARCH-LABEL: .method {{.*}}'caller'(
; MARCH:         .maxstack 3
; MARCH-NEXT:    ldarg.0
; MARCH-NEXT:    ldc.i4.7
; MARCH-NEXT:    call int32 'add'(int32, int32)
; MARCH-NEXT:    ldc.i4.1
; MARCH-NEXT:    conv.i
; MARCH-NEXT:    ldc.i4.2
; MARCH-NEXT:    conv.i
; MARCH-NEXT:    call native int 'add.i64'(native int, native int)
; MARCH-NEXT:    conv.i4
; MARCH-NEXT:    add
; MARCH-NEXT:    ret
  %r = call i32 @add(i32 %x, i32 7)
  %s = call i64 @add.i64(i64 1, i64 2)
  %t = trunc i64 %s to i32
  %u = add i32 %r, %t
  ret i32 %u
}

define i32 @add(i32 %a, i32 %b) {
; X64-LABEL: add:
; X64:       # %bb.0:
; X64-NEXT:    # kill: def $esi killed $esi def $rsi
; X64-NEXT:    # kill: def $edi killed $edi def $rdi
; X64-NEXT:    leal (%rdi,%rsi), %eax
; X64-NEXT:    retq
;
; CHECK-LABEL: .method {{.*}}'add'(
; CHECK:         .maxstack 2
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ldarg.0
; CHECK-NEXT:    ldarg.1
; CHECK-NEXT:    add
; CHECK-NEXT:    ret
;
; MARCH-LABEL: .method {{.*}}'add'(
; MARCH:         .maxstack 2
; MARCH-NEXT:    ldarg.0
; MARCH-NEXT:    ldarg.1
; MARCH-NEXT:    add
; MARCH-NEXT:    ret
  %r = add i32 %a, %b
  ret i32 %r
}

define internal i64 @add.i64(i64 %a, i64 %b) {
; X64-LABEL: add.i64:
; X64:       # %bb.0:
; X64-NEXT:    leaq (%rdi,%rsi), %rax
; X64-NEXT:    retq
;
; CHECK-LABEL: .method {{.*}}'add.i64'(
; CHECK:         .maxstack 2
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ldarg.0
; CHECK-NEXT:    ldarg.1
; CHECK-NEXT:    add
; CHECK-NEXT:    ret
;
; MARCH-LABEL: .method {{.*}}'add.i64'(
; MARCH:         .maxstack 2
; MARCH-NEXT:    ldarg.0
; MARCH-NEXT:    ldarg.1
; MARCH-NEXT:    add
; MARCH-NEXT:    ret
  %r = add i64 %a, %b
  ret i64 %r
}

define i32 @"sel$ect"(i32 %c, i32 %a, i32 %b) {
; X64-LABEL: sel$ect:
; X64:       # %bb.0:
; X64-NEXT:    movl %esi, %eax
; X64-NEXT:    testl %edi, %edi
; X64-NEXT:    cmovel %edx, %eax
; X64-NEXT:    retq
;
; CHECK-LABEL: .method {{.*}}'sel$ect'(
; CHECK:         .maxstack 2
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ldarg.0
; CHECK-NEXT:    ldc.i4.0
; CHECK-NEXT:    cgt.un
; CHECK-NEXT:    brtrue.s @BB3_2
; CHECK-NEXT:  // %bb.1:
; CHECK-NEXT:    ldarg.2
; CHECK-NEXT:    starg.s 1
; CHECK-NEXT:  @BB3_2:
; CHECK-NEXT:    ldarg.1
; CHECK-NEXT:    ret
;
; MARCH-LABEL: .method {{.*}}'sel$ect'(
; MARCH:         .maxstack 2
; MARCH-NEXT:    ldarg.0
; MARCH-NEXT:    ldc.i4.0
; MARCH-NEXT:    cgt.un
; MARCH-NEXT:    brtrue.s @BB3_2
; MARCH-NEXT:    ldarg.2
; MARCH-NEXT:    starg.s 1
; MARCH-NEXT:  @BB3_2:
; MARCH-NEXT:    ldarg.1
; MARCH-NEXT:    ret
  %cc = icmp ne i32 %c, 0
  %r = select i1 %cc, i32 %a, i32 %b
  ret i32 %r
}

define void @nothing() {
; X64-LABEL: nothing:
; X64:       # %bb.0:
; X64-NEXT:    retq
;
; CHECK-LABEL: .method {{.*}}'nothing'(
; CHECK:         .maxstack 0
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ret
;
; MARCH-LABEL: .method {{.*}}'nothing'(
; MARCH:         .maxstack 0
; MARCH-NEXT:    ret
  ret void
}

;; The entry point '<msil>Main' that llc adds for main is not an IR function.
define i32 @main() {
; X64-LABEL: main:
; X64:       # %bb.0:
; X64-NEXT:    pushq %rax
; X64-NEXT:    .cfi_def_cfa_offset 16
; X64-NEXT:    movl $35, %edi
; X64-NEXT:    callq caller@PLT
; X64-NEXT:    popq %rcx
; X64-NEXT:    .cfi_def_cfa_offset 8
; X64-NEXT:    retq
;
; CHECK-LABEL: .method {{.*}}'main'(
; CHECK:         .maxstack 1
; CHECK-NEXT:  // %bb.0:
; CHECK-NEXT:    ldc.i4.s 35
; CHECK-NEXT:    call int32 'caller'(int32)
; CHECK-NEXT:    ret
;
; MARCH-LABEL: .method {{.*}}'main'(
; MARCH:         .maxstack 1
; MARCH-NEXT:    ldc.i4.s 35
; MARCH-NEXT:    call int32 'caller'(int32)
; MARCH-NEXT:    ret
  %r = call i32 @caller(i32 35)
  ret i32 %r
}
