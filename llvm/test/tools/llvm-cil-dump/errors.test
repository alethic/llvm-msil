## A heap index out of range fails when the row is read: the listing and the
## table dump both need the Module row's name.
# RUN: not llvm-cil-dump --canonical %t/string-index.dll 2>&1 \
# RUN:   | FileCheck %s --check-prefix=METADATA -DFILE=%t/string-index.dll \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
