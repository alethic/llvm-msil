## Errors do not stop the other files; the exit status is still 1.
# RUN: not llvm-cil-dump %t/text.dll %t/exit42.dll %t/bad-root.dll > %t/out.txt 2> %t/err.txt
# RUN: FileCheck %s --input-file=%t/out.txt --check-prefix=CONTINUE-OUT -DFILE=%t/exit42.dll
# RUN: FileCheck %s --input-file=%t/err.txt --check-prefix=CONTINUE-ERR \
# RUN:   -DA=%t/text.dll -DB=%t/bad-root.dll \
# RUN:   --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:   --implicit-check-not="Stack dump"
# CONTINUE-OUT: File: [[FILE]]
# CONTINUE-OUT-NEXT: pe PE32+ machine=0x8664 dll subsystem=3
# CONTINUE-ERR: error: '[[A]]': invalid CLI image:
# CONTINUE-ERR: error: '[[B]]': invalid CLI metadata:

#--- mkbad.py
# Writes malformed variants of the PE32+ image argv[1] into the directory
# argv[2], one per kind of damage that llvm-cil-dump must report as an error.
import os
import struct
import sys

src, out = sys.argv[1], sys.argv[2]
with open(src, "rb") as f:
    data = bytes(f.read())


def write(name, b):
    with open(os.path.join(out, name), "wb") as f:
        f.write(bytes(b))


def patched(offset, new):
    b = bytearray(data)
    b[offset : offset + len(new)] = new
    return b


lfanew = struct.unpack_from("<I", data, 0x3C)[0]
opt = lfanew + 24
assert struct.unpack_from("<H", data, opt)[0] == 0x20B, "not PE32+"
cli_dir = opt + 112 + 14 * 8
root = data.index(b"BSJB")
version_len = struct.unpack_from("<I", data, root + 12)[0]
p = root + 16 + version_len + 4
streams = {}
for _ in range(struct.unpack_from("<H", data, root + 16 + version_len + 2)[0]):
    off, size = struct.unpack_from("<II", data, p)
    end = data.index(b"\0", p + 8)
    streams[data[p + 8 : end].decode()] = (p, off, size)
    p = (end + 4) & ~3
tables = root + streams["#~"][1]

write("empty.dll", b"")
write("text.dll", b"this is not a PE image\n")
write("truncated-dos.dll", data[:0x20])
write("bad-lfanew.dll", patched(0x3C, struct.pack("<I", len(data) + 0x100)))
write("bad-signature.dll", patched(lfanew, b"PX\0\0"))
# NumberOfSections 0x0F00: the section table runs past the end of the file.
write("bad-sections.dll", patched(lfanew + 6, struct.pack("<H", 0x0F00)))
write("no-cli-header.dll", patched(cli_dir, bytes(8)))
write("unmapped-cli-header.dll", patched(cli_dir, struct.pack("<I", 0x00F00000)))
write("bad-root.dll", patched(root, b"BSJX"))
# The '#~' stream renamed: there are no tables.
write("no-tables.dll", patched(streams["#~"][0] + 8, b"#X\0\0"))
# The '#US' stream renamed '#-': uncompressed metadata.
write("uncompressed.dll", patched(streams["#US"][0] + 8, b"#-\0\0"))
# The '#Blob' stream's size runs past the metadata.
write("stream-bounds.dll", patched(streams["#Blob"][0] + 4, struct.pack("<I", 0x7FFFFFF0)))
# 0xFFFFFF Module rows: the table data runs past the '#~' stream.
write("row-count.dll", patched(tables + 24, struct.pack("<I", 0x00FFFFFF)))
# The Module row's Name (2-byte #Strings index) points past '#Strings'.
nvalid = bin(struct.unpack_from("<Q", data, tables + 8)[0]).count("1")
write("string-index.dll", patched(tables + 24 + 4 * nvalid + 2, struct.pack("<H", 0xFFFF)))
#--- exit42.il
// A Phase-1-shaped module: one method with the entry point.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'exit42' { }
.module 'exit42.dll'

.method public static int32 'main'() cil managed
{
  .entrypoint
  .maxstack 8
  ldc.i4.s 42
  ret
}
#--- exit42.yaml
--- !COFF
OptionalHeader:
  AddressOfEntryPoint: 8702
  ImageBase:       5368709120
  SectionAlignment: 8192
  FileAlignment:   512
  MajorOperatingSystemVersion: 4
  MinorOperatingSystemVersion: 0
  MajorImageVersion: 0
  MinorImageVersion: 0
  MajorSubsystemVersion: 4
  MinorSubsystemVersion: 0
  Subsystem:       IMAGE_SUBSYSTEM_WINDOWS_CUI
  DLLCharacteristics: [ IMAGE_DLL_CHARACTERISTICS_DYNAMIC_BASE, IMAGE_DLL_CHARACTERISTICS_NX_COMPAT, IMAGE_DLL_CHARACTERISTICS_NO_SEH, IMAGE_DLL_CHARACTERISTICS_TERMINAL_SERVER_AWARE ]
  SizeOfStackReserve: 4194304
  SizeOfStackCommit: 16384
  SizeOfHeapReserve: 1048576
  SizeOfHeapCommit: 8192
  ImportTable:
    RelativeVirtualAddress: 8616
    Size:            83
  BaseRelocationTable:
    RelativeVirtualAddress: 16384
    Size:            12
  IAT:
    RelativeVirtualAddress: 8192
    Size:            16
  ClrRuntimeHeader:
    RelativeVirtualAddress: 8208
    Size:            72
header:
  Machine:         IMAGE_FILE_MACHINE_AMD64
  Characteristics: [ IMAGE_FILE_EXECUTABLE_IMAGE, IMAGE_FILE_LARGE_ADDRESS_AWARE, IMAGE_FILE_DLL ]
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  8192
    VirtualSize:     522
    SectionData:     
  - Name:            .reloc
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_DISCARDABLE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  16384
    VirtualSize:     12
    SectionData:     002000000C00000000A20000
symbols:         []
...
