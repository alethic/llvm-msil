#--- snan.il
// --snan=quiet changes float32 operands only (plan 5.12.6). The YAML is
// patched so that the ldc.r4 operand of 'snan32' is the float32 signaling
// NaN 0x7F80ABCD, which ilasm would quiet (the source has the quiet one).
// The Constant blobs, the FieldRVA data and the ldc.r8 operand hold
// signaling NaNs that ilasm keeps, and 'inf32' an infinity (not a NaN).
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'snan' { }
.module 'snan.dll'

.class public auto ansi NS.C extends [mscorlib]System.Object
{
  .field public static literal float32 'k32' = float32(0x7F80ABCD)
  .field public static literal float64 'k64' = float64(0x7FF0000000000001)
  .field public static float32 'd32' at D32
  .field public static float64 'd64' at D64
}
.data D32 = bytearray (CD AB 80 7F)
.data D64 = bytearray (01 00 00 00 00 00 F0 7F)

.method public static float32 'snan32'() cil managed
{
  .maxstack 1
  ldc.r4 float32(0x7FC0ABCD)
  ret
}
.method public static float32 'inf32'() cil managed
{
  .maxstack 1
  ldc.r4 float32(0x7F800000)
  ret
}
.method public static float64 'snan64'() cil managed
{
  .maxstack 1
  ldc.r8 float64(0x7FF0000000000001)
  ret
}
