## llvm-cil-dump with several files (plan 5.7.10): each file's output is
## preceded by 'File: <path>'; an error names the file on stderr
## ('llvm-cil-dump: error: '<file>': <message>'), the tool goes on with the
## next file and exits 1. One file prints no 'File:' line. The inputs are
## yaml2obj copies of the ilasm (.NET Framework 4.8) images of exit42.il:
## '-dll -pe64 -x64' and '-exe -pe64 -x64'.

# RUN: rm -rf %t && split-file %s %t
# RUN: yaml2obj %t/dll.yaml -o %t/exit42.dll
# RUN: yaml2obj %t/exe.yaml -o %t/exit42.exe

# RUN: llvm-cil-dump %t/exit42.dll \
# RUN:   | FileCheck %s --check-prefix=ONE --match-full-lines --strict-whitespace
# ONE-NOT:File:{{.*}}
# ONE:pe PE32+ machine=0x8664 dll subsystem=3
# ONE-NOT:File:{{.*}}

# RUN: llvm-cil-dump %t/exit42.dll %t/exit42.exe \
# RUN:   | FileCheck %s --check-prefix=TWO --match-full-lines --strict-whitespace \
# RUN:       -DDLL=%t/exit42.dll -DEXE=%t/exit42.exe
# TWO:File: [[DLL]]
# TWO-NEXT:pe PE32+ machine=0x8664 dll subsystem=3
# TWO-NEXT:cor flags=0x00000001 runtime=2.5 metadata-version=v4.0.30319
# TWO-NEXT:entrypoint int32() '<Module>'::'main'
# TWO-NEXT:assembly 'exit42' ver 0.0.0.0 flags=0x00000000 hash=0x00000000 culture='' key=-
# TWO-NEXT:module 'exit42.dll'
# TWO-NEXT:assemblyref 'mscorlib' ver 4.0.0.0 flags=0x00000000 key=B7 7A 5C 56 19 34 E0 89 culture=''
# TWO-EMPTY:
# TWO-NEXT:.class '<Module>' flags=0x00000000
# TWO-NEXT:  .method 'main' int32() flags=0x0016 impl=0x0000
# TWO-NEXT:    .maxstack 8
# TWO-NEXT:    L0: ldc.i4.s 42
# TWO-NEXT:    L1: ret
# TWO-NEXT:File: [[EXE]]
# TWO-NEXT:pe PE32+ machine=0x8664 exe subsystem=3
# TWO-NEXT:cor flags=0x00000001 runtime=2.5 metadata-version=v4.0.30319
# TWO-NEXT:entrypoint int32() '<Module>'::'main'
# TWO-NEXT:assembly 'exit42' ver 0.0.0.0 flags=0x00000000 hash=0x00000000 culture='' key=-
# TWO-NEXT:module 'exit42.dll'
# TWO-NEXT:assemblyref 'mscorlib' ver 4.0.0.0 flags=0x00000000 key=B7 7A 5C 56 19 34 E0 89 culture=''
# TWO-EMPTY:
# TWO-NEXT:.class '<Module>' flags=0x00000000
# TWO-NEXT:  .method 'main' int32() flags=0x0016 impl=0x0000
# TWO-NEXT:    .maxstack 8
# TWO-NEXT:    L0: ldc.i4.s 42
# TWO-NEXT:    L1: ret
# TWO-NOT:{{.}}

# RUN: llvm-cil-dump --headers %t/exit42.dll %t/exit42.exe \
# RUN:   | FileCheck %s --check-prefix=HEADERS --match-full-lines --strict-whitespace \
# RUN:       -DDLL=%t/exit42.dll -DEXE=%t/exit42.exe
# HEADERS:File: [[DLL]]
# HEADERS-NEXT:Format: PE32+ machine=0x8664 dll
# HEADERS-NEXT:COFF: sections=2 timestamp=0x00000000 characteristics=0x2022 symbols=0
# HEADERS-NEXT:Optional: imagebase=0x0000000140000000 sectionalign=0x2000 filealign=0x200 subsystem=3 dllchars=0x8540 stack=0x400000,0x4000 heap=0x100000,0x2000
# HEADERS-NEXT:Section: .text rva=0x00002000 vsize=0x20A raw=0x200 rawsize=0x400 flags=0x60000020
# HEADERS-NEXT:Section: .reloc rva=0x00004000 vsize=0xC raw=0x600 rawsize=0x200 flags=0x42000040
# HEADERS-NEXT:CLI: flags=0x00000001 entrypoint=0x06000001 metadata=0x00002064,0x140 runtime=2.5
# HEADERS-NEXT:Metadata: version='v4.0.30319' heapsizes=0x00 valid=0x0000000900000045 sorted=0x000016003325FA00
# HEADERS-NEXT:Stream: #~ offset=0x6C size=0x80
# HEADERS-NEXT:Stream: #Strings offset=0xEC size=0x2C
# HEADERS-NEXT:Stream: #US offset=0x118 size=0x8
# HEADERS-NEXT:Stream: #GUID offset=0x120 size=0x10
# HEADERS-NEXT:Stream: #Blob offset=0x130 size=0x10
# HEADERS-NEXT:Mvid: ba7b7ae0-8f2d-464b-ba95-38bbd986d1f5
# HEADERS-NEXT:File: [[EXE]]
# HEADERS-NEXT:Format: PE32+ machine=0x8664 exe
# HEADERS-NEXT:COFF: sections=2 timestamp=0x00000000 characteristics=0x0022 symbols=0
# HEADERS-NEXT:Optional: imagebase=0x0000000140000000 sectionalign=0x2000 filealign=0x200 subsystem=3 dllchars=0x8540 stack=0x400000,0x4000 heap=0x100000,0x2000
# HEADERS-NEXT:Section: .text rva=0x00002000 vsize=0x20A raw=0x200 rawsize=0x400 flags=0x60000020
# HEADERS-NEXT:Section: .reloc rva=0x00004000 vsize=0xC raw=0x600 rawsize=0x200 flags=0x42000040
# HEADERS-NEXT:CLI: flags=0x00000001 entrypoint=0x06000001 metadata=0x00002064,0x140 runtime=2.5
# HEADERS-NEXT:Metadata: version='v4.0.30319' heapsizes=0x00 valid=0x0000000900000045 sorted=0x000016003325FA00
# HEADERS-NEXT:Stream: #~ offset=0x6C size=0x80
# HEADERS-NEXT:Stream: #Strings offset=0xEC size=0x2C
# HEADERS-NEXT:Stream: #US offset=0x118 size=0x8
# HEADERS-NEXT:Stream: #GUID offset=0x120 size=0x10
# HEADERS-NEXT:Stream: #Blob offset=0x130 size=0x10
# HEADERS-NEXT:Mvid: e1ba8845-6179-4231-a313-7ef69931ad0d
# HEADERS-NOT:{{.}}

## A missing file between two good ones: both good files are listed, the
## error goes to stderr, and the exit status is 1.
# RUN: not llvm-cil-dump %t/exit42.dll %t/missing.dll %t/exit42.exe \
# RUN:   > %t/out.txt 2> %t/err.txt
# RUN: FileCheck %s --input-file=%t/out.txt --check-prefix=OUT \
# RUN:   --match-full-lines --strict-whitespace -DDLL=%t/exit42.dll -DEXE=%t/exit42.exe
# RUN: FileCheck %s --input-file=%t/err.txt --check-prefix=ERR \
# RUN:   -DFILE=%t/missing.dll -DMSG=%errc_ENOENT \
# RUN:   --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:   --implicit-check-not="Stack dump"
# OUT:File: [[DLL]]
# OUT-NEXT:pe PE32+ machine=0x8664 dll subsystem=3
# OUT:File: [[EXE]]
# OUT-NEXT:pe PE32+ machine=0x8664 exe subsystem=3
# OUT:    L1: ret
# ERR:llvm-cil-dump{{(\.exe)?}}: error: '[[FILE]]': [[MSG]]
# ERR-NOT:error:

## Every file failing still exits 1, after trying each of them.
# RUN: not llvm-cil-dump %t/missing.dll %t/missing2.dll 2>&1 \
# RUN:   | FileCheck %s --check-prefix=BOTH -DA=%t/missing.dll -DB=%t/missing2.dll \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# BOTH:error: '[[A]]':
# BOTH:error: '[[B]]':

#--- exit42.il
// A Phase-1-shaped module: one method with the entry point.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'exit42' { }
.module 'exit42.dll'

.method public static int32 'main'() cil managed
{
  .entrypoint
  .maxstack 8
  ldc.i4.s 42
  ret
}
#--- dll.yaml
--- !COFF
OptionalHeader:
  AddressOfEntryPoint: 8702
  ImageBase:       5368709120
  SectionAlignment: 8192
  FileAlignment:   512
  MajorOperatingSystemVersion: 4
  MinorOperatingSystemVersion: 0
  MajorImageVersion: 0
  MinorImageVersion: 0
  MajorSubsystemVersion: 4
  MinorSubsystemVersion: 0
  Subsystem:       IMAGE_SUBSYSTEM_WINDOWS_CUI
  DLLCharacteristics: [ IMAGE_DLL_CHARACTERISTICS_DYNAMIC_BASE, IMAGE_DLL_CHARACTERISTICS_NX_COMPAT, IMAGE_DLL_CHARACTERISTICS_NO_SEH, IMAGE_DLL_CHARACTERISTICS_TERMINAL_SERVER_AWARE ]
  SizeOfStackReserve: 4194304
  SizeOfStackCommit: 16384
  SizeOfHeapReserve: 1048576
  SizeOfHeapCommit: 8192
  ImportTable:
    RelativeVirtualAddress: 8616
    Size:            83
  BaseRelocationTable:
    RelativeVirtualAddress: 16384
    Size:            12
  IAT:
    RelativeVirtualAddress: 8192
    Size:            16
  ClrRuntimeHeader:
    RelativeVirtualAddress: 8208
    Size:            72
header:
  Machine:         IMAGE_FILE_MACHINE_AMD64
  Characteristics: [ IMAGE_FILE_EXECUTABLE_IMAGE, IMAGE_FILE_LARGE_ADDRESS_AWARE, IMAGE_FILE_DLL ]
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  8192
    VirtualSize:     522
    SectionData:     
  - Name:            .reloc
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_DISCARDABLE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  16384
    VirtualSize:     12
    SectionData:     002000000C00000000A20000
symbols:         []
...
