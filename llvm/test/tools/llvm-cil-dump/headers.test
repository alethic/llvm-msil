## llvm-cil-dump --headers (plan 5.7.10): the PE, COFF, optional, section, CLI
## header and metadata root fields, in this order, hex digits uppercase, the
## MVID as a lowercase GUID. The inputs are yaml2obj copies of the ilasm
## (.NET Framework 4.8) images of exit42.il: '-dll -pe64 -x64' (a Phase-1
## shaped DLL with an entry point), '-exe -pe64 -x64' and '-dll' (PE32). The
## YAML keeps the images' headers, data directories and sections; yaml2obj
## writes a zero TimeDateStamp and its own DOS stub and file offsets. A
## fourth input is a CIL object in 5.8.6's shape (object.il, see below).

# RUN: rm -rf %t && split-file %s %t
# RUN: yaml2obj %t/dll.yaml -o %t/exit42.dll
# RUN: yaml2obj %t/exe.yaml -o %t/exit42.exe
# RUN: yaml2obj %t/pe32.yaml -o %t/exit42-pe32.dll

# RUN: llvm-cil-dump --headers %t/exit42.dll \
# RUN:   | FileCheck %s --check-prefix=DLL --match-full-lines --strict-whitespace
# RUN: llvm-cil-dump --headers %t/exit42.exe \
# RUN:   | FileCheck %s --check-prefix=EXE --match-full-lines --strict-whitespace
# RUN: llvm-cil-dump --headers %t/exit42-pe32.dll \
# RUN:   | FileCheck %s --check-prefix=PE32 --match-full-lines --strict-whitespace

## The canonical listing of the PE32 image starts with its own pe line.
# RUN: llvm-cil-dump --canonical %t/exit42-pe32.dll \
# RUN:   | FileCheck %s --check-prefix=CANON32 --match-full-lines --strict-whitespace

# DLL:Format: PE32+ machine=0x8664 dll
# DLL-NEXT:COFF: sections=2 timestamp=0x00000000 characteristics=0x2022 symbols=0
# DLL-NEXT:Optional: imagebase=0x0000000140000000 sectionalign=0x2000 filealign=0x200 subsystem=3 dllchars=0x8540 stack=0x400000,0x4000 heap=0x100000,0x2000
# DLL-NEXT:Section: .text rva=0x00002000 vsize=0x20A raw=0x200 rawsize=0x400 flags=0x60000020
# DLL-NEXT:Section: .reloc rva=0x00004000 vsize=0xC raw=0x600 rawsize=0x200 flags=0x42000040
# DLL-NEXT:CLI: flags=0x00000001 entrypoint=0x06000001 metadata=0x00002064,0x140 runtime=2.5
# DLL-NEXT:Metadata: version='v4.0.30319' heapsizes=0x00 valid=0x0000000900000045 sorted=0x000016003325FA00
# DLL-NEXT:Stream: #~ offset=0x6C size=0x80
# DLL-NEXT:Stream: #Strings offset=0xEC size=0x2C
# DLL-NEXT:Stream: #US offset=0x118 size=0x8
# DLL-NEXT:Stream: #GUID offset=0x120 size=0x10
# DLL-NEXT:Stream: #Blob offset=0x130 size=0x10
# DLL-NEXT:Mvid: ba7b7ae0-8f2d-464b-ba95-38bbd986d1f5
# DLL-NOT:{{.}}

# EXE:Format: PE32+ machine=0x8664 exe
# EXE-NEXT:COFF: sections=2 timestamp=0x00000000 characteristics=0x0022 symbols=0
# EXE-NEXT:Optional: imagebase=0x0000000140000000 sectionalign=0x2000 filealign=0x200 subsystem=3 dllchars=0x8540 stack=0x400000,0x4000 heap=0x100000,0x2000
# EXE-NEXT:Section: .text rva=0x00002000 vsize=0x20A raw=0x200 rawsize=0x400 flags=0x60000020
# EXE-NEXT:Section: .reloc rva=0x00004000 vsize=0xC raw=0x600 rawsize=0x200 flags=0x42000040
# EXE-NEXT:CLI: flags=0x00000001 entrypoint=0x06000001 metadata=0x00002064,0x140 runtime=2.5
# EXE-NEXT:Metadata: version='v4.0.30319' heapsizes=0x00 valid=0x0000000900000045 sorted=0x000016003325FA00
# EXE-NEXT:Stream: #~ offset=0x6C size=0x80
# EXE-NEXT:Stream: #Strings offset=0xEC size=0x2C
# EXE-NEXT:Stream: #US offset=0x118 size=0x8
# EXE-NEXT:Stream: #GUID offset=0x120 size=0x10
# EXE-NEXT:Stream: #Blob offset=0x130 size=0x10
# EXE-NEXT:Mvid: e1ba8845-6179-4231-a313-7ef69931ad0d
# EXE-NOT:{{.}}

# PE32:Format: PE32 machine=0x014C dll
# PE32-NEXT:COFF: sections=2 timestamp=0x00000000 characteristics=0x2102 symbols=0
# PE32-NEXT:Optional: imagebase=0x0000000000400000 sectionalign=0x2000 filealign=0x200 subsystem=3 dllchars=0x8540 stack=0x100000,0x1000 heap=0x100000,0x1000
# PE32-NEXT:Section: .text rva=0x00002000 vsize=0x1F4 raw=0x200 rawsize=0x200 flags=0x60000020
# PE32-NEXT:Section: .reloc rva=0x00004000 vsize=0xC raw=0x400 rawsize=0x200 flags=0x42000040
# PE32-NEXT:CLI: flags=0x00000001 entrypoint=0x06000001 metadata=0x00002054,0x140 runtime=2.5
# PE32-NEXT:Metadata: version='v4.0.30319' heapsizes=0x00 valid=0x0000000900000045 sorted=0x000016003325FA00
# PE32-NEXT:Stream: #~ offset=0x6C size=0x80
# PE32-NEXT:Stream: #Strings offset=0xEC size=0x2C
# PE32-NEXT:Stream: #US offset=0x118 size=0x8
# PE32-NEXT:Stream: #GUID offset=0x120 size=0x10
# PE32-NEXT:Stream: #Blob offset=0x130 size=0x10
# PE32-NEXT:Mvid: 99c13f3e-ab85-45c8-9b0e-4462e4649a83
# PE32-NOT:{{.}}

# CANON32:pe PE32 machine=0x014C dll subsystem=3
# CANON32-NEXT:cor flags=0x00000001 runtime=2.5 metadata-version=v4.0.30319

## A CIL object with 5.8.6's COFF view: the ilasm (.NET Framework 4.8, -dll
## -pe64 -x64) image of object.il with .reloc and its data directory dropped,
## then the three marker sections .data (0xC0000040), .rdata (0x40000040) and
## .bss (0xC0000080) at the next section-aligned RVA, each with VirtualSize,
## SizeOfRawData and PointerToRawData 0, and one COFF symbol per SYMTAB entry
## of its link-info record ('value' in .data, 'get' in .text, 'abort' and
## 'my_labs' undefined functions). Four section headers need SizeOfHeaders
## 0x400, so .text's raw data starts there.
# RUN: yaml2obj %t/object.yaml -o %t/object.o
# RUN: llvm-cil-dump --headers %t/object.o \
# RUN:   | FileCheck %s --check-prefix=OBJ --match-full-lines --strict-whitespace
# OBJ:Format: PE32+ machine=0x8664 dll
# OBJ-NEXT:COFF: sections=4 timestamp=0x00000000 characteristics=0x2022 symbols=4
# OBJ-NEXT:Optional: imagebase=0x0000000140000000 sectionalign=0x2000 filealign=0x200 subsystem=3 dllchars=0x8540 stack=0x400000,0x4000 heap=0x100000,0x2000
# OBJ-NEXT:Section: .text rva=0x00002000 vsize=0x3AA raw=0x400 rawsize=0x400 flags=0x60000020
# OBJ-NEXT:Section: .data rva=0x00004000 vsize=0x0 raw=0x0 rawsize=0x0 flags=0xC0000040
# OBJ-NEXT:Section: .rdata rva=0x00004000 vsize=0x0 raw=0x0 rawsize=0x0 flags=0x40000040
# OBJ-NEXT:Section: .bss rva=0x00004000 vsize=0x0 raw=0x0 rawsize=0x0 flags=0xC0000080
# OBJ-NEXT:CLI: flags=0x00000001 entrypoint=0x00000000 metadata=0x00002080,0x2BC runtime=2.5
# OBJ-NEXT:Metadata: version='v4.0.30319' heapsizes=0x00 valid=0x0000000814001557 sorted=0x000016003325FA00
# OBJ-NEXT:Stream: #~ offset=0x6C size=0xF8
# OBJ-NEXT:Stream: #Strings offset=0x164 size=0xAC
# OBJ-NEXT:Stream: #US offset=0x210 size=0x10
# OBJ-NEXT:Stream: #GUID offset=0x220 size=0x10
# OBJ-NEXT:Stream: #Blob offset=0x230 size=0x8C
# OBJ-NEXT:Mvid: 2761e41f-be3d-44cd-a261-02c70af0adde
# OBJ-NOT:{{.}}

#--- exit42.il
// A Phase-1-shaped module: one method with the entry point.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'exit42' { }
.module 'exit42.dll'

.method public static int32 'main'() cil managed
{
  .entrypoint
  .maxstack 8
  ldc.i4.s 42
  ret
}
#--- dll.yaml
--- !COFF
OptionalHeader:
  AddressOfEntryPoint: 8702
  ImageBase:       5368709120
  SectionAlignment: 8192
  FileAlignment:   512
  MajorOperatingSystemVersion: 4
  MinorOperatingSystemVersion: 0
  MajorImageVersion: 0
  MinorImageVersion: 0
  MajorSubsystemVersion: 4
  MinorSubsystemVersion: 0
  Subsystem:       IMAGE_SUBSYSTEM_WINDOWS_CUI
  DLLCharacteristics: [ IMAGE_DLL_CHARACTERISTICS_DYNAMIC_BASE, IMAGE_DLL_CHARACTERISTICS_NX_COMPAT, IMAGE_DLL_CHARACTERISTICS_NO_SEH, IMAGE_DLL_CHARACTERISTICS_TERMINAL_SERVER_AWARE ]
  SizeOfStackReserve: 4194304
  SizeOfStackCommit: 16384
  SizeOfHeapReserve: 1048576
  SizeOfHeapCommit: 8192
  ImportTable:
    RelativeVirtualAddress: 8616
    Size:            83
  BaseRelocationTable:
    RelativeVirtualAddress: 16384
    Size:            12
  IAT:
    RelativeVirtualAddress: 8192
    Size:            16
  ClrRuntimeHeader:
    RelativeVirtualAddress: 8208
    Size:            72
header:
  Machine:         IMAGE_FILE_MACHINE_AMD64
  Characteristics: [ IMAGE_FILE_EXECUTABLE_IMAGE, IMAGE_FILE_LARGE_ADDRESS_AWARE, IMAGE_FILE_DLL ]
sections:
  - Name:            .text
    Characteristics: [ IMAGE_SCN_CNT_CODE, IMAGE_SCN_MEM_EXECUTE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  8192
    VirtualSize:     522
    SectionData:     
  - Name:            .reloc
    Characteristics: [ IMAGE_SCN_CNT_INITIALIZED_DATA, IMAGE_SCN_MEM_DISCARDABLE, IMAGE_SCN_MEM_READ ]
    VirtualAddress:  16384
    VirtualSize:     12
    SectionData:     002000000C00000000A20000
symbols:         []
...
