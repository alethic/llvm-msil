#--- both.il
// A CIL object (object.il) that also carries symtab.il's two
// '<msil>SymbolTable' payloads on an Assembly row, with their attribute
// class: --link-info prints the Module-row record, then each payload.
.assembly extern 'msil.extern' { .ver 0:0:0:0 }
.assembly extern 'msil.bcl' { .ver 0:0:0:0 }
.assembly extern 'msil.link' { .ver 0:0:0:0 }
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'lib'
{
  .custom instance void '<msil>SymbolTable'::.ctor(uint8[]) = (
    01 00 87 00 00 00
    4D 53 59 4D 01 00 00 01                   // "MSYM", v1.0, flags 0, ABI 1
    1D 78 38 36 5F 36 34 2D 75 6E 6B 6E 6F 77 6E 2D
    6C 69 6E 75 78 2D 67 6E 75 2D 6D 73 69 6C // 'x86_64-unknown-linux-gnu-msil'
    01 63                                     // C runtime 'c'
    08 08 04 08                               // data model 8,8,4,8
    02                                        // 2 export classes:
    07 6C 69 62 64 65 6D 6F                   //   'libdemo'
    0A 4E 53 2E 45 78 70 6F 72 74 73          //   'NS.Exports'
    05                                        // 5 data symbols:
    07 63 6F 75 6E 74 65 72 04 02 00          //   'counter' size 4, 2^2
    05 74 61 62 6C 65 18 03 01                //   'table' size 24, 2^3, const
    05 74 6C 73 5F 76 04 02 02                //   'tls_v' size 4, 2^2, thread-local
    02 77 6B 08 03 05                         //   'wk' size 8, 2^3, const weak
