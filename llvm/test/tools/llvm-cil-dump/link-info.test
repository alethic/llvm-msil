#--- symtab.il
// A library with two '<msil>SymbolTable' attributes on its Assembly row
// (plan 5.9.15). Their payloads were encoded by hand from M17.c item 8; each
// value is the byte-array framing: 01 00, the u32 payload size, the payload
// and 00 00.
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89 ) .ver 4:0:0:0 }
.assembly 'lib'
{
  .custom instance void '<msil>SymbolTable'::.ctor(uint8[]) = (
    01 00 87 00 00 00
    4D 53 59 4D 01 00 00 01                   // "MSYM", v1.0, flags 0, ABI 1
    1D 78 38 36 5F 36 34 2D 75 6E 6B 6E 6F 77 6E 2D
    6C 69 6E 75 78 2D 67 6E 75 2D 6D 73 69 6C // 'x86_64-unknown-linux-gnu-msil'
    01 63                                     // C runtime 'c'
    08 08 04 08                               // data model 8,8,4,8
    02                                        // 2 export classes:
    07 6C 69 62 64 65 6D 6F                   //   'libdemo'
    0A 4E 53 2E 45 78 70 6F 72 74 73          //   'NS.Exports'
    05                                        // 5 data symbols:
    07 63 6F 75 6E 74 65 72 04 02 00          //   'counter' size 4, 2^2
    05 74 61 62 6C 65 18 03 01                //   'table' size 24, 2^3, const
    05 74 6C 73 5F 76 04 02 02                //   'tls_v' size 4, 2^2, thread-local
    02 77 6B 08 03 05                         //   'wk' size 8, 2^3, const weak
    03 61 6C 6C 10 04 07                      //   'all' size 16, 2^4, all three
    03                                        // 3 flagged functions:
    0B 70 72 69 6E 74 66 5F 6C 69 6B 65 01    //   'printf_like' variadic
    06 77 65 61 6B 66 6E 02                   //   'weakfn' weak
    04 62 6F 74 68 03                         //   'both' variadic weak
    00 00
  )
  .custom instance void '<msil>SymbolTable'::.ctor(uint8[]) = (
    01 00 36 00 00 00
    4D 53 59 4D 01 00 00 01                   // "MSYM", v1.0, flags 0, ABI 1
    1B 78 38 36 5F 36 34 2D 70 63 2D 77 69 6E
    64 6F 77 73 2D 6D 73 76 63 2D 6D 73 69 6C // 'x86_64-pc-windows-msvc-msil'
    04 6E 6F 6E 65                            // C runtime 'none'
    08 04 02 08                               // data model 8,4,2,8
    01 05 4F 74 68 65 72                      // 1 export class: 'Other'
    00                                        // no data symbols
    00                                        // no flagged functions
    00 00
  )
}
.module 'lib.dll'

.class private auto ansi sealed '<msil>SymbolTable' extends [mscorlib]System.Attribute
{
  .method public hidebysig specialname rtspecialname instance void .ctor(uint8[] 'payload') cil managed
  {
    .maxstack 8
    ret
  }
}
