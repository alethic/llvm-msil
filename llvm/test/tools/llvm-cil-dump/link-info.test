## llvm-cil-dump --link-info (plan 5.7.10, 5.8.11): printLinkInfo's lines for
## the link-info record of a CIL object's Module row (5.8.7), in record order,
## with the entity name of each SIGNATURES token (a reader is given). The
## object is the ilasm (.NET Framework 4.8, -dll -pe64 -x64) image of
## object.il, object-form text (5.8.4) whose record was encoded by hand from
## 5.8.8 (426 bytes):
##   4D 53 4C 4B 01 00 00 1B 78 38 36 5F 36 34 2D 70 63 2D 77 69 6E 64 6F 77
##   73 2D 6D 73 76 63 2D 6D 73 69 6C 01 00 00 08 04 02 08 01 D7 01 0E 01 00
##   05 74 61 62 6C 65 01 00 00 04 00 00 18 01 82 01 07 63 6F 75 6E 74 65 72
##   02 00 00 04 01 00 04 01 80 02 05 74 6C 73 5F 76 03 00 00 04 02 00 04 01
##   03 08 63 6F 6D 6D 6F 6E 5F 63 04 00 00 04 04 02 01 90 10 0A 6D 79 5F 63
##   6F 75 6E 74 65 72 00 0E 6E 61 74 69 76 65 5F 63 6F 75 6E 74 65 72 01 91
##   08 08 65 78 74 5F 64 61 74 61 00 20 04 6D 61 69 6E 01 00 00 06 00 01 06
##   77 65 61 6B 66 6E 02 00 00 06 00 02 06 63 74 6F 72 5F 61 03 00 00 06 00
##   10 04 61 64 64 33 00 50 04 74 69 63 6B 00 81 04 04 68 6F 6F 6B 07 01 88
##   04 08 74 61 62 6C 65 5F 68 69 00 08 08 01 90 10 08 6D 6F 64 5F 64 61 74
##   61 09 6C 69 62 66 6F 6F 2E 73 6F 08 66 6F 6F 5F 64 61 74 61 02 35 03 07
##   2E 72 6F 64 61 74 61 10 03 18 00 00 00 00 00 00 00 00 00 00 00 00 00 00
##   00 00 01 02 03 04 05 06 07 08 04 2E 62 73 73 08 02 04 05 2E 74 62 73 73
##   0A 02 04 03 12 03 02 00 00 09 00 01 00 08 01 04 04 00 0C 00 78 04 01 04
##   0C 01 06 77 65 61 6B 66 6E 00 01 00 07 05 05 01 00 65 08 00 06 13 02 02
##   00 00 06 04 0C 02 01 01 08 03 01 00 00 0A 03 01 00 07 2A 02 00 01 6D 01
##   02 16 2F 44 45 46 41 55 4C 54 4C 49 42 3A 77 73 32 5F 33 32 2E 6C 69 62
##   0C 2F 69 6E 63 6C 75 64 65 3A 66 6F 6F 45 03 01 02 03
## It has every symbol kind, binding and flag (an IMPORT data symbol with an
## empty and one with a non-empty ImportModule among them), a READONLY, a
## ZERO and a TLS|ZERO segment, FNADDR64, ADDR32 and DIFF relocations, a
## comdat, an INIT entry, an SRET+byval and a NO_PROTOTYPE+VARARG signature,
## both linker-option kinds and a skippable subsection (kind 0x45), and it
## satisfies C1-C8 (5.8.5). The input is a yaml2obj copy of that image.

# RUN: rm -rf %t && split-file %s %t
# RUN: yaml2obj %t/object.yaml -o %t/a.o
# RUN: llvm-cil-dump --link-info %t/a.o \
# RUN:   | FileCheck %s --match-full-lines --strict-whitespace

# CHECK:LinkInfo v1.0 triple=x86_64-pc-windows-msvc-msil abi=1 abiflags=0x0 features=0x0 datamodel=8,4,2,8
# CHECK-NEXT:Symbol 0 DATA GLOBAL DEFAULT 'table' field=0x04000001 segment=0 offset=0 size=24
# CHECK-NEXT:Symbol 1 DATA LOCAL DEFAULT NO_STRIP 'counter' field=0x04000002 segment=1 offset=0 size=4
# CHECK-NEXT:Symbol 2 DATA GLOBAL DEFAULT TLS 'tls_v' field=0x04000003 segment=2 offset=0 size=4
# CHECK-NEXT:Symbol 3 DATA COMMON DEFAULT 'common_c' field=0x04000004 size=4 align=4
# CHECK-NEXT:Symbol 4 DATA GLOBAL DEFAULT UNDEFINED IMPORT 'my_counter' import_module='' import_name='native_counter'
# CHECK-NEXT:Symbol 5 DATA WEAK DEFAULT UNDEFINED DLLIMPORT 'ext_data'
# CHECK-NEXT:Symbol 6 FUNCTION GLOBAL DEFAULT DLLEXPORT 'main' method=0x06000001
# CHECK-NEXT:Symbol 7 FUNCTION WEAK DEFAULT 'weakfn' method=0x06000002
# CHECK-NEXT:Symbol 8 FUNCTION LOCAL DEFAULT 'ctor_a' method=0x06000003
# CHECK-NEXT:Symbol 9 FUNCTION GLOBAL DEFAULT UNDEFINED 'add3'
# CHECK-NEXT:Symbol 10 FUNCTION GLOBAL DEFAULT UNDEFINED EXPLICIT_IMPORT 'tick'
# CHECK-NEXT:Symbol 11 FUNCTION WEAK DEFAULT ALIAS 'hook' aliasee=7
# CHECK-NEXT:Symbol 12 DATA GLOBAL HIDDEN ALIAS 'table_hi' aliasee=0 offset=8 size=8
# CHECK-NEXT:Symbol 13 DATA GLOBAL DEFAULT UNDEFINED IMPORT 'mod_data' import_module='libfoo.so' import_name='foo_data'
# CHECK-NEXT:Segment 0 '.rodata' align=8 size=24 flags=READONLY
# CHECK-NEXT:  00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 01 02 03 04 05 06 07 08
# CHECK-NEXT:Segment 1 '.bss' align=4 size=4 flags=ZERO
# CHECK-NEXT:Segment 2 '.tbss' align=4 size=4 flags=TLS|ZERO
# CHECK-NEXT:Reloc FNADDR64 segment=0 offset=0 symbol=9 'add3' addend=0
# CHECK-NEXT:Reloc ADDR32 segment=0 offset=8 symbol=1 'counter' addend=4
# CHECK-NEXT:Reloc DIFF width=4 segment=0 offset=12 symbol=0 'table' symbol2=1 'counter' addend=-8
# CHECK-NEXT:Comdat 'weakfn' ANY function=7
# CHECK-NEXT:Init priority=101 symbol=8 'ctor_a'
# CHECK-NEXT:Signature 0x06000002 'weakfn' SRET size=12 align=4 byval=1:8:8
# CHECK-NEXT:Signature 0x0A000001 'add3' NO_PROTOTYPE VARARG fixed=1
# CHECK-NEXT:LinkerOption DEPENDENT_LIB 'm'
# CHECK-NEXT:LinkerOption LINKER_OPTION '/DEFAULTLIB:ws2_32.lib' '/include:foo'
# CHECK-NEXT:Optional kind=0x45 size=3
# CHECK-NOT:{{.}}

## The record also travels as the Module row's custom attribute in the
## canonical listing.
# RUN: llvm-cil-dump --canonical %t/a.o \
# RUN:   | FileCheck %s --check-prefix=CANON --match-full-lines --strict-whitespace
# CANON:module 'a.c'
# CANON:module .custom instance void(uint8[]) [msil.link]<msil>LinkInfo::'.ctor' = 01 00 {{([0-9A-F]{2} )+}}00 00

## An image with neither a link-info record nor a symbol table.
# RUN: yaml2obj %t/exit42.yaml -o %t/exit42.dll
# RUN: not llvm-cil-dump --link-info %t/exit42.dll 2>&1 \
# RUN:   | FileCheck %s --check-prefix=NONE -DFILE=%t/exit42.dll \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# NONE:llvm-cil-dump{{(\.exe)?}}: error: '[[FILE]]': no link-info record or symbol table

## A library's symbol tables (5.9.15): printSymbolTable's lines for each
## '<msil>SymbolTable' payload on the Assembly row, in CustomAttribute table
## order (section 12, '5.7.9, 5.8.11 and M17.c item (7) clarified (printer
## spellings left open)'), which here is not the order of the lines' text.
## The input is a yaml2obj copy of the ilasm (.NET Framework 4.8, -dll -pe64
## -x64) image of symtab.il, whose two payloads were encoded by hand from
## M17.c item 8: every data-symbol and function flag, alignments 2^2 to 2^4,
## two export classes in the first payload and none of the lists in the
## second.
# RUN: yaml2obj %t/symtab.yaml -o %t/symtab.dll
# RUN: llvm-cil-dump --link-info %t/symtab.dll \
# RUN:   | FileCheck %s --check-prefix=SYMTAB --match-full-lines --strict-whitespace
# SYMTAB:SymbolTable v1.0 triple=x86_64-unknown-linux-gnu-msil abi=1 runtime='c' datamodel=8,8,4,8
# SYMTAB-NEXT:ExportClass 'libdemo'
# SYMTAB-NEXT:ExportClass 'NS.Exports'
# SYMTAB-NEXT:Data 'counter' size=4 align=4
# SYMTAB-NEXT:Data CONST 'table' size=24 align=8
# SYMTAB-NEXT:Data TLS 'tls_v' size=4 align=4
# SYMTAB-NEXT:Data CONST WEAK 'wk' size=8 align=8
# SYMTAB-NEXT:Data CONST TLS WEAK 'all' size=16 align=16
# SYMTAB-NEXT:Function VARARG 'printf_like'
# SYMTAB-NEXT:Function WEAK 'weakfn'
# SYMTAB-NEXT:Function VARARG WEAK 'both'
# SYMTAB-NEXT:SymbolTable v1.0 triple=x86_64-pc-windows-msvc-msil abi=1 runtime='none' datamodel=8,4,2,8
# SYMTAB-NEXT:ExportClass 'Other'
# SYMTAB-NOT:{{.}}

## A payload of another major version is refused. The YAML of symtab.il is
## patched where the second payload starts ("MSYM", major 1, minor 0, flags
## 0, ABI 1, a triple of 27 bytes), so that its major version is 2.
# RUN: sed -e "s/4D53594D010000011B/4D53594D020000011B/" %t/symtab.yaml > %t/symtab-v2.yaml
# RUN: yaml2obj %t/symtab-v2.yaml -o %t/symtab-v2.dll
# RUN: not llvm-cil-dump --link-info %t/symtab-v2.dll 2>&1 \
# RUN:   | FileCheck %s --check-prefix=V2 -DFILE=%t/symtab-v2.dll \
# RUN:       --implicit-check-not="LLVM ERROR" --implicit-check-not="PLEASE submit" \
# RUN:       --implicit-check-not="Stack dump"
# V2:llvm-cil-dump{{(\.exe)?}}: error: '[[FILE]]': invalid symbol table: version 2 is newer than this toolchain supports (1)

## Both carriers in one image: both.il is object.il with symtab.il's
## Assembly row (its two '<msil>SymbolTable' payloads) and attribute class
## added, so the record's MethodDef and MemberRef tokens are unchanged. The
## record's lines come first, then each payload's block in CustomAttribute
## table order (section 12, '5.7.9, 5.8.11 and M17.c item (7) clarified
## (printer spellings left open)'): exactly the output for a.o followed by
## the output for symtab.dll. The input is a yaml2obj copy of the ilasm
## (.NET Framework 4.8, -dll -pe64 -x64) image of both.il.
# RUN: yaml2obj %t/both.yaml -o %t/both.dll
# RUN: llvm-cil-dump --link-info %t/both.dll > %t/both.txt
# RUN: llvm-cil-dump --link-info %t/a.o > %t/record.txt
# RUN: llvm-cil-dump --link-info %t/symtab.dll > %t/symtabs.txt
# RUN: cat %t/record.txt %t/symtabs.txt > %t/both-expected.txt
# RUN: diff %t/both-expected.txt %t/both.txt
# RUN: FileCheck %s --input-file=%t/both.txt --check-prefix=BOTH \
# RUN:   --match-full-lines --strict-whitespace
# BOTH:LinkInfo v1.0 triple=x86_64-pc-windows-msvc-msil abi=1 abiflags=0x0 features=0x0 datamodel=8,4,2,8
# BOTH-NEXT:Symbol 0 DATA GLOBAL DEFAULT 'table' field=0x04000001 segment=0 offset=0 size=24
# BOTH:Signature 0x06000002 'weakfn' SRET size=12 align=4 byval=1:8:8
# BOTH-NEXT:Signature 0x0A000001 'add3' NO_PROTOTYPE VARARG fixed=1
# BOTH:Optional kind=0x45 size=3
# BOTH-NEXT:SymbolTable v1.0 triple=x86_64-unknown-linux-gnu-msil abi=1 runtime='c' datamodel=8,8,4,8
# BOTH-NEXT:ExportClass 'libdemo'
# BOTH:Function VARARG WEAK 'both'
# BOTH-NEXT:SymbolTable v1.0 triple=x86_64-pc-windows-msvc-msil abi=1 runtime='none' datamodel=8,4,2,8
# BOTH-NEXT:ExportClass 'Other'
# BOTH-NOT:{{.}}

#--- object.il
// A CIL object in object-form text (plan 5.8.4) whose link-info record
// (5.8.7, 5.8.8) was encoded by hand: every symbol kind, binding and flag,
// three segments, ADDR32, FNADDR64 and DIFF relocations, a comdat, an init
// entry, two signature entries, both linker-option kinds and a skippable
// subsection (kind 0x45).
.assembly extern 'msil.extern' { .ver 0:0:0:0 }
.assembly extern 'msil.bcl' { .ver 0:0:0:0 }
.assembly extern 'msil.link' { .ver 0:0:0:0 }

.method public static int32 'main'() cil managed
{
  .maxstack 8
  ldc.i4.1
  call int32 [msil.extern]'<msil>Symbols'::'add3'(int32)
  pop
  ldsfld native int [msil.extern]'<msil>FnAddr'::'weakfn'
  pop
  ldsfld native int [msil.extern]'<msil>Symbols'::'my_counter'
  pop
  call int32 'tick'()
  ret
}
.method public static void 'weakfn'(native int, native int) cil managed
{
  .maxstack 8
  ret
}
.method assembly static void 'ctor_a'() cil managed
{
  .maxstack 8
  ret
}
.field public static initonly native int 'table'
.field assembly static initonly native int 'counter'
.field public static initonly native int 'tls_v'
.field public static initonly native int 'common_c'
.method public hidebysig static pinvokeimpl("kernel32.dll" as "GetTickCount" nomangle cdecl) int32 'tick'() cil managed preservesig {}

.module 'a.c'
.custom instance void [msil.link]'<msil>LinkInfo'::.ctor(uint8[]) = (
    01 00 AA 01 00 00 4D 53 4C 4B 01 00 00 1B 78 38
    36 5F 36 34 2D 70 63 2D 77 69 6E 64 6F 77 73 2D
    6D 73 76 63 2D 6D 73 69 6C 01 00 00 08 04 02 08
    01 D7 01 0E 01 00 05 74 61 62 6C 65 01 00 00 04
    00 00 18 01 82 01 07 63 6F 75 6E 74 65 72 02 00
    00 04 01 00 04 01 80 02 05 74 6C 73 5F 76 03 00
    00 04 02 00 04 01 03 08 63 6F 6D 6D 6F 6E 5F 63
    04 00 00 04 04 02 01 90 10 0A 6D 79 5F 63 6F 75
    6E 74 65 72 00 0E 6E 61 74 69 76 65 5F 63 6F 75
    6E 74 65 72 01 91 08 08 65 78 74 5F 64 61 74 61
    00 20 04 6D 61 69 6E 01 00 00 06 00 01 06 77 65
    61 6B 66 6E 02 00 00 06 00 02 06 63 74 6F 72 5F
    61 03 00 00 06 00 10 04 61 64 64 33 00 50 04 74
    69 63 6B 00 81 04 04 68 6F 6F 6B 07 01 88 04 08
    74 61 62 6C 65 5F 68 69 00 08 08 01 90 10 08 6D
    6F 64 5F 64 61 74 61 09 6C 69 62 66 6F 6F 2E 73
    6F 08 66 6F 6F 5F 64 61 74 61 02 35 03 07 2E 72
    6F 64 61 74 61 10 03 18 00 00 00 00 00 00 00 00
    00 00 00 00 00 00 00 00 01 02 03 04 05 06 07 08
    04 2E 62 73 73 08 02 04 05 2E 74 62 73 73 0A 02
    04 03 12 03 02 00 00 09 00 01 00 08 01 04 04 00
    0C 00 78 04 01 04 0C 01 06 77 65 61 6B 66 6E 00
    01 00 07 05 05 01 00 65 08 00 06 13 02 02 00 00
    06 04 0C 02 01 01 08 03 01 00 00 0A 03 01 00 07
    2A 02 00 01 6D 01 02 16 2F 44 45 46 41 55 4C 54
    4C 49 42 3A 77 73 32 5F 33 32 2E 6C 69 62 0C 2F
    69 6E 63 6C 75 64 65 3A 66 6F 6F 45 03 01 02 03
    00 00
)
