// PROTOTYPE ONLY: hand-written stand-in for what the backend would emit for
// ../fib.c (no BCL types used, so it runs on .NET Framework and CoreCLR).
.assembly extern mscorlib { .publickeytoken = (B7 7A 5C 56 19 34 E0 89) .ver 4:0:0:0 }
.assembly '@NAME@' { }
.module '@NAME@.dll'

.method assembly static pinvokeimpl("@LIBC@" cdecl) int32 puts(native int s) cil managed preservesig {}

.method assembly static int32 fib(int32 n) cil managed {
  .maxstack 3
  ldarg.0
  ldc.i4.2
  bge L_rec
  ldarg.0
  ret
L_rec:
  ldarg.0
  ldc.i4.1
  sub
  call int32 fib(int32)
  ldarg.0
  ldc.i4.2
  sub
  call int32 fib(int32)
  add
  ret
}

// put_u64 with a 24-byte localloc frame, as the M1 frame lowering would do.
.method assembly static void put_u64(int64 v) cil managed {
  .maxstack 3
  .locals (native int fp, native int p)
  ldc.i4.s 24
  localloc
  stloc fp
  ldloc fp
  ldc.i4.s 23
  add
  dup
  stloc p
  ldc.i4.0
  stind.i1
L_loop:
  ldloc p
  ldc.i4.1
  sub
  dup
  stloc p
  ldarg.0
  ldc.i4.s 10
  conv.i8
  rem.un
  conv.i4
  ldc.i4.s 48
  add
  stind.i1
  ldarg.0
  ldc.i4.s 10
  conv.i8
  div.un
  dup
  starg.s v
  ldc.i4.0
  conv.i8
  bne.un L_loop
  ldloc p
  call int32 puts(native int)
  pop
  ret
}

.method public static int32 main() cil managed {
  .maxstack 2
  .locals (int32 i)
  ldc.i4.0
  stloc i
L0:
  ldloc i
  call int32 fib(int32)
  conv.u8
  call void put_u64(int64)
  ldloc i
  ldc.i4.1
  add
  dup
  stloc i
  ldc.i4.s 10
  blt L0
  ldc.i4.s 10
  call int32 fib(int32)
  ldc.i4 255
  and
  ret
}

.method public static int32 Main(string[] args) cil managed {
  .entrypoint
  .maxstack 1
  call int32 main()
  ret
}
