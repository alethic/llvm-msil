CLI_TABLE(0x17, Property, 0)
CLI_TABLE(0x18, MethodSemantics, 1)
CLI_TABLE(0x19, MethodImpl, 1)
CLI_TABLE(0x1A, ModuleRef, 0)
CLI_TABLE(0x1B, TypeSpec, 0)
CLI_TABLE(0x1C, ImplMap, 1)
CLI_TABLE(0x1D, FieldRVA, 1)
CLI_TABLE(0x1E, ENCLog, 0)
CLI_TABLE(0x1F, ENCMap, 0)
CLI_TABLE(0x20, Assembly, 0)
CLI_TABLE(0x21, AssemblyProcessor, 0)
CLI_TABLE(0x22, AssemblyOS, 0)
CLI_TABLE(0x23, AssemblyRef, 0)
CLI_TABLE(0x24, AssemblyRefProcessor, 0)
CLI_TABLE(0x25, AssemblyRefOS, 0)
CLI_TABLE(0x26, File, 0)
CLI_TABLE(0x27, ExportedType, 0)
CLI_TABLE(0x28, ManifestResource, 0)
CLI_TABLE(0x29, NestedClass, 1)
CLI_TABLE(0x2A, GenericParam, 1)
CLI_TABLE(0x2B, MethodSpec, 0)
CLI_TABLE(0x2C, GenericParamConstraint, 1)
#undef CLI_TABLE
#endif

