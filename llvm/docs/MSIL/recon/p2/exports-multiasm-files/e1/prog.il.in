.assembly 'prog' { .ver 0:0:0:0 }

.method public static void say(string) cil managed { .maxstack 1 ldarg.0 call void [mscorlib]System.Console::WriteLine(string) ret }
.method public static void sayi(string, int32) cil managed
{ .maxstack 2 ldarg.0 ldarg.1 box [mscorlib]System.Int32 call string [mscorlib]System.String::Concat(object, object) call void [mscorlib]System.Console::WriteLine(string) ret }

.method public static void t_ok() cil managed noinlining
{
  .maxstack 3
  ldstr "t_ok entered"
  call void say(string)
  ldstr "add(2,3) = "
  ldc.i4.2
  ldc.i4.3
  call int32 [zlibx]Contoso.Zlib.Native::'add'(int32, int32)
  call void sayi(string, int32)
  ldstr "bump() = "
  call int32 [zlibx]Contoso.Zlib.Native::'bump'()
  call void sayi(string, int32)
  ret
}
// a member that the library does not define
