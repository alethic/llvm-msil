// a global method of the library's <Module> (public, but <Module> is not a public type)
.method public static void t_global() cil managed noinlining
{
  .maxstack 2
  ldstr "t_global entered"
  call void say(string)
  ldstr "helper(4) = "
  ldc.i4.4
  call int32 [zlibx]'<Module>'::'helper'(int32)
  call void sayi(string, int32)
  ret
}
// the missing member only on a path that does not run
.method public static void t_missing_cold(bool) cil managed noinlining
{
  .maxstack 1
  ldstr "t_missing_cold entered"
  call void say(string)
  ldarg.0
  brfalse L1
  call int32 [zlibx]Contoso.Zlib.Native::'gone'()
  pop
L1:
  ldstr "t_missing_cold: cold path skipped"
  call void say(string)
  ret
}

