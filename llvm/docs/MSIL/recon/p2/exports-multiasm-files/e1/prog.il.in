N1: ldloc.0 ldstr "missing" call bool [mscorlib]System.String::op_Equality(string, string) brfalse N2  call void t_missing() br DONE
N2: ldloc.0 ldstr "badsig"  call bool [mscorlib]System.String::op_Equality(string, string) brfalse N3  call void t_badsig()  br DONE
N3: ldloc.0 ldstr "noclass" call bool [mscorlib]System.String::op_Equality(string, string) brfalse N4  call void t_noclass() br DONE
N4: ldloc.0 ldstr "noasm"   call bool [mscorlib]System.String::op_Equality(string, string) brfalse N5  call void t_noasm()   br DONE
N5: ldloc.0 ldstr "global"  call bool [mscorlib]System.String::op_Equality(string, string) brfalse N6  call void t_global()  br DONE
N6: ldloc.0 ldstr "cold"    call bool [mscorlib]System.String::op_Equality(string, string) brfalse DONE ldc.i4.0 call void t_missing_cold(bool) br DONE
DONE: leave END
