+# ---------------------------------------------------------------- Phase-2 pipeline (tests-p2 prototype)
+# --param msil_pipeline=asm (default): clang -S -> ilasm (Phase 1).
+#                       =lto: clang -flto -c -> msil-ld --lto-emit-asm -> ilasm (P2-B first milestone).
+#                       =obj: clang -c -> msil-ld -> PE (P2-A + P2-B; not available in the prototype).
+# --param msil_ld=PATH  the linker (default: <tools>/msil-ld[.exe]).
+pipeline = params.get("msil_pipeline", "asm")
+if pipeline not in ("asm", "lto", "obj"):
+    fatal("--param msil_pipeline=%s: use asm, lto or obj" % pipeline)
+features.add("msil-pipeline=" + pipeline)
+msil_ld = params.get("msil_ld") or lit.util.which("msil-ld", config.llvm_tools_dir)
+if msil_ld and os.path.isfile(msil_ld):
+    features.add("msil-ld")
+elif pipeline != "asm":
+    fatal("--param msil_pipeline=%s needs msil-ld (--param msil_ld=PATH)" % pipeline)
+if pipeline == "obj":
+    fatal("--param msil_pipeline=obj: the prototype msil-ld writes only ILAsm text (--lto-emit-asm)")
+# The libraries a link searches by default (a Phase-2 driver adds the triple's
+# libc itself; the prototype reads only COFF export tables).
+msil_ld_libs = {"windows": '-L "C:/Windows/System32" -lucrtbase'}.get(triple_os, "")
