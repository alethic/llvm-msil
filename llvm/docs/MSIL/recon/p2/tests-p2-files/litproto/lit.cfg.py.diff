+def prog_pipeline(level):
+    """A multi-TU program: compile %{msil_srcs} with -c into a fresh directory,
+    link them with %{msil_libs}, then verify, force-JIT and run as c_pipeline."""
+    t = "%t." + level
+    d = t + ".d"
+    if pipeline == "asm":
+        return "echo multi-TU programs need --param msil_pipeline=lto or obj && false"
+    cmd = (
+        f"rm -rf {d} && mkdir -p {d} && cd {d}"
+        f" && %clang_msil %{{msil_cflags}} -{level} -flto -c %{{msil_srcs}}"
+        f" && %msil_ld --lto-emit-asm -o {t}.il *.o %{{msil_libs}} %{{msil_ld_libs}}"
+        f" && %ilasm -dll -output={t}.dll {t}.il"
+        f" && %msil_verify {t}.dll"
+        f" %if msil-jitall %{{ && %msil_jitall {t}.dll %}}"
+        f" && %msil_exec --expect %S/%{{s:stem}} --out {t}.out {t}.dll"
+    )
+    cmd += (
+        f" %if msil-native-oracle %{{ && %clang_native %{{msil_cflags}} -{level}"
+        f" %{{msil_srcs}}{native_link} -o {t}.native.exe"
+        f" && %msil_exec --native --expect %S/%{{s:stem}}"
+        f" --out {t}.native.out {t}.native.exe %}}"
+    )
+    return cmd
+
