+//===----------------------------------------------------------------------===//
+// MSIL prototype (recon P3 variadics): the native va_list of each MSIL triple,
+// built over the caller's argument buffer.
+//===----------------------------------------------------------------------===//
+
+// Variadic declarations that MSIL leaves alone: prototype-less declarations
+// (whose calls MSILFixFunctionBitcasts makes non-variadic) and the
+// fixed-arity natives.
+static bool msilIgnore(const Function *F) {
+  return F && (F->hasFnAttribute("no-prototype") ||
+               F->hasFnAttribute("msil-fixed-arity"));
+}
+
+// x86-64 SysV: va_list is [1 x {i32 gp_offset, i32 fp_offset, ptr
+// overflow_arg_area, ptr reg_save_area}], passed as a pointer. The buffer is
+// the overflow area: 8-byte slots, by value, 16-byte aligned for types aligned
+// above 8; gp_offset=48 and fp_offset=176 say "registers exhausted".
+struct MSILSysV final : public VariadicABIInfo {
+  bool enableForTarget() override { return true; }
+  bool vaListPassedInSSARegister() override { return false; }
+  Type *vaListType(LLVMContext &Ctx) override {
+    Type *I32 = Type::getInt32Ty(Ctx);
+    Type *P = PointerType::getUnqual(Ctx);
+    return ArrayType::get(StructType::get(Ctx, {I32, I32, P, P}), 1);
+  }
+  Type *vaListParameterType(Module &M) override {
+    return PointerType::getUnqual(M.getContext());
+  }
+  Value *initializeVaList(Module &M, LLVMContext &Ctx, IRBuilder<> &B,
+                          AllocaInst *VaList, Value *Buffer) override {
+    B.CreateStore(B.getInt32(48), VaList);
+    B.CreateStore(B.getInt32(176), B.CreateConstInBoundsGEP1_64(B.getInt8Ty(), VaList, 4));
+    B.CreateStore(Buffer, B.CreateConstInBoundsGEP1_64(B.getInt8Ty(), VaList, 8));
+    B.CreateStore(ConstantPointerNull::get(PointerType::getUnqual(Ctx)),
+                  B.CreateConstInBoundsGEP1_64(B.getInt8Ty(), VaList, 16));
+    return VaList;
+  }
+  VAArgSlotInfo slotInfo(const DataLayout &DL, Type *T) override {
+    Align A = DL.getABITypeAlign(T);
+    return {A > Align(8) ? Align(16) : Align(8), false};
+  }
+  bool ignoreFunction(const Function *F) override { return msilIgnore(F); }
+};
+
+// AAPCS64 (Linux): va_list is {ptr __stack, ptr __gr_top, ptr __vr_top, i32
+// __gr_offs, i32 __vr_offs}; offsets 0 say "registers exhausted". Stack slots
+// are 8 bytes (16-byte aligned for 16-byte aligned types); clang passes
+// composites above 16 bytes by reference already.
+struct MSILAAPCS64 final : public VariadicABIInfo {
+  bool enableForTarget() override { return true; }
+  bool vaListPassedInSSARegister() override { return false; }
+  Type *vaListType(LLVMContext &Ctx) override {
+    Type *I32 = Type::getInt32Ty(Ctx);
+    Type *P = PointerType::getUnqual(Ctx);
+    return StructType::get(Ctx, {P, P, P, I32, I32});
+  }
+  Type *vaListParameterType(Module &M) override {
+    return PointerType::getUnqual(M.getContext());
+  }
+  Value *initializeVaList(Module &M, LLVMContext &Ctx, IRBuilder<> &B,
+                          AllocaInst *VaList, Value *Buffer) override {
+    Value *Null = ConstantPointerNull::get(PointerType::getUnqual(Ctx));
+    B.CreateStore(Buffer, VaList);
+    B.CreateStore(Null, B.CreateConstInBoundsGEP1_64(B.getInt8Ty(), VaList, 8));
+    B.CreateStore(Null, B.CreateConstInBoundsGEP1_64(B.getInt8Ty(), VaList, 16));
+    B.CreateStore(B.getInt32(0), B.CreateConstInBoundsGEP1_64(B.getInt8Ty(), VaList, 24));
+    B.CreateStore(B.getInt32(0), B.CreateConstInBoundsGEP1_64(B.getInt8Ty(), VaList, 28));
+    return VaList;
+  }
+  VAArgSlotInfo slotInfo(const DataLayout &DL, Type *T) override {
+    Align A = DL.getABITypeAlign(T);
+    return {A > Align(8) ? Align(16) : Align(8), false};
+  }
+  bool ignoreFunction(const Function *F) override { return msilIgnore(F); }
+};
+
+// Win64 (x64 and ARM64 Windows, and Apple ARM64 later): va_list is a char*
+// into 8-byte slots. x64: a value that is not 1, 2, 4 or 8 bytes goes by
+// pointer to a caller copy; ARM64 Windows: one above 16 bytes.
+struct MSILCharPtr final : public VariadicABIInfo {
+  uint64_t MaxDirect;
+  bool PowerOf2Only;
+  MSILCharPtr(uint64_t MaxDirect, bool PowerOf2Only)
+      : MaxDirect(MaxDirect), PowerOf2Only(PowerOf2Only) {}
+  bool enableForTarget() override { return true; }
+  bool vaListPassedInSSARegister() override { return true; }
+  Type *vaListType(LLVMContext &Ctx) override { return PointerType::getUnqual(Ctx); }
+  Type *vaListParameterType(Module &M) override {
+    return PointerType::getUnqual(M.getContext());
+  }
+  Value *initializeVaList(Module &M, LLVMContext &Ctx, IRBuilder<> &B,
+                          AllocaInst *, Value *Buffer) override {
+    return Buffer;
+  }
+  VAArgSlotInfo slotInfo(const DataLayout &DL, Type *T) override {
+    uint64_t Size = DL.getTypeAllocSize(T).getFixedValue();
+    bool Indirect = Size > MaxDirect || (PowerOf2Only && !isPowerOf2_64(Size));
+    return {Align(8), Indirect};
+  }
+  bool ignoreFunction(const Function *F) override { return msilIgnore(F); }
+};
