-ExpandVariadicsPass::ExpandVariadicsPass(ExpandVariadicsMode M) : Mode(M) {}
+int main(int argc, char **argv) {
+  InitLLVM X(argc, argv);
+  if (argc != 3) {
+    errs() << "usage: msil-expand-variadics <in.ll> <out.ll>\n";
+    return 2;
+  }
+  LLVMContext Ctx;
+  SMDiagnostic Err;
+  std::unique_ptr<Module> M = parseIRFile(argv[1], Err, Ctx);
+  if (!M) {
+    Err.print(argv[0], errs());
+    return 1;
+  }
+  Triple T(M->getTargetTriple());
+  makeFixedArity(*M, T);
+  std::set<std::string> VariadicDecls;
+  for (Function &F : *M)
+    if (F.isDeclaration() && F.isVarArg() && !F.isIntrinsic() && !msilIgnore(&F))
+      VariadicDecls.insert(F.getName().str());
+  ExpandVariadics Pass(ExpandVariadicsMode::Lowering);
+  Pass.runOnModule(*M);
+  for (const std::string &N : VariadicDecls)
+    if (Function *F = M->getFunction(N)) {
+      auto It = vVariants(T).find(N);
+      if (It != vVariants(T).end() && F->isDeclaration()) {
+        if (Function *E = M->getFunction(It->second)) {
+          F->replaceAllUsesWith(E);
+          F->eraseFromParent();
+        } else {
+          F->setName(It->second);
+        }
+      }
+    }
+  if (verifyModule(*M, &errs()))
+    return 1;
+  std::error_code EC;
+  raw_fd_ostream OS(argv[2], EC);
+  M->print(OS, nullptr);
+  return 0;
+}
