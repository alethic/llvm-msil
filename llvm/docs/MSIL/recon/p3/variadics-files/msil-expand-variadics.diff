+//===----------------------------------------------------------------------===//
+// Prototype driver: msil-expand-variadics <in.ll> <out.ll>
+//  1. Fixed-arity natives (a per-triple name list, or the IR attribute
+//     "msil-fixed-arity" that __attribute__((msil_fixed_arity)) would set):
+//     each direct call becomes the non-variadic call of all of its arguments
+//     (Win64: double variadic arguments passed as their i64 bits, which the
+//     callee reads from the integer register's home slot). The declaration
+//     is replaced by one of the call's type.
+//  2. ExpandVariadics in Lowering mode with the MSIL ABIs above.
+//  3. Stand-in for msil-ld's link-time v-variant binding: an expanded
+//     declaration in the v-variant table is renamed to its v-variant.
+//===----------------------------------------------------------------------===//

-ModulePass *llvm::createExpandVariadicsPass(ExpandVariadicsMode M) {
-  return new ExpandVariadics(M);
+#include "llvm/IR/Verifier.h"
+#include "llvm/IRReader/IRReader.h"
+#include "llvm/Support/SourceMgr.h"
+#include "llvm/Support/raw_ostream.h"
+#include "llvm/Support/InitLLVM.h"
+#include <map>
+#include <set>
+
+static const char *const FixedAritySysV[] = {"open", "open64", "openat", "openat64", "fcntl",
+                                             "fcntl64", "ioctl", "prctl", "syscall", "execl",
+                                             "execlp", "execle", "ulimit", "sem_open",
+                                             "mq_open", "ptrace", "semctl", "mremap"};
+static const char *const FixedArityUCRT[] = {"msvcrt_sprintf", "_open", "_sopen", "_wopen", "_wsopen", "_execl",
+                                             "_execle", "_execlp", "_execlpe", "_spawnl",
+                                             "_spawnle", "_spawnlp", "_spawnlpe"};
+
+static void makeFixedArity(Module &M, const Triple &T) {
+  std::set<std::string> Names;
+  if (T.isOSWindows())
+    for (const char *N : FixedArityUCRT) Names.insert(N);
+  else
+    for (const char *N : FixedAritySysV) Names.insert(N);
+  for (Function &F : make_early_inc_range(M)) {
+    if (!F.isDeclaration() || !F.isVarArg() || F.isIntrinsic())
+      continue;
+    if (!Names.count(F.getName().str()) && !F.hasFnAttribute("msil-fixed-arity"))
+      continue;
+    // Each call keeps its own signature: the mechanism Phase 2 uses for the
+    // calls of a prototype-less declaration (a per-call-site MemberRef,
+    // NO_PROTOTYPE in the record, one P/Invoke per IL signature in msil-ld).
+    F.addFnAttr("msil-fixed-arity");
+    F.addFnAttr("no-prototype");
+    for (User *U : make_early_inc_range(F.users())) {
+      auto *CB = dyn_cast<CallBase>(U);
+      if (!CB || CB->getCalledOperand() != &F)
+        continue;
+      IRBuilder<> B(CB);
+      SmallVector<Value *, 8> Args(CB->args());
+      for (unsigned I = F.getFunctionType()->getNumParams(); I < Args.size(); ++I)
+        if (T.isOSWindows() && Args[I]->getType()->isDoubleTy())
+          Args[I] = B.CreateBitCast(Args[I], B.getInt64Ty());
+        else if (!T.isOSWindows() && Args[I]->getType()->isFloatingPointTy())
+          report_fatal_error(Twine("floating-point argument to native variadic function '") +
+                             F.getName() + "' without a v-variant: MSIL cannot set AL");
+      SmallVector<Type *, 8> Tys;
+      for (Value *A : Args) Tys.push_back(A->getType());
+      FunctionType *FTy = FunctionType::get(CB->getType(), Tys, false);
+      CallInst *NC = B.CreateCall(FTy, &F, Args);
+      NC->setCallingConv(CB->getCallingConv());
+      CB->replaceAllUsesWith(NC);
+      NC->takeName(CB);
+      CB->eraseFromParent();
+    }
+  }
 }

